#!/usr/bin/env bash
# codegen-analyze — scan existing Claude sessions for agent turn-waste, ranked.
# Usage: codegen-analyze [--since YYYY-MM-DD] [--json] [--raw] [--window N]
#                        [--threshold-reread N] [--project-dir DIR]
# Read-only: reads ~/.claude/projects/<cwd-prefix>*/*.jsonl + optional
#            codegen/logging/{failures/*.jsonl,gate-verdicts.jsonl}. Writes nothing.
# Exit: 0 = ok (incl. "no sessions found"); non-zero only on argparse usage error.
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
CODEGEN_DIR="$SCRIPT_DIR"
exec env PYTHONPATH="$CODEGEN_DIR" python3 -m analysis "$@"
