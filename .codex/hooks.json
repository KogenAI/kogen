{
  "description": "Kogen owns Developer verification gates through PreToolUse and Stop hooks.",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/verification_policy.py\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"$(git rev-parse --show-toplevel)/.codex/hooks/check.sh\"",
            "timeout": 600,
            "statusMessage": "Running Kogen provider-free check"
          }
        ]
      }
    ]
  }
}
