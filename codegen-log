#!/usr/bin/env bash
# codegen-log — canonical cycle-log writer.
#
# Usage:
#   codegen-log init --slug <slug>
#   codegen-log section [<role>] [--body @-] [--role <role>] [--slug <slug>]
#   codegen-log append <role> [--body @-] [--slug <slug>]
#   codegen-log append <role> --learned "<text>" [--slug <slug>]
#   codegen-log append <role> --died interrupted|aborted [--cause "<text>"] [--slug <slug>]
#   codegen-log append <role> --verdict clear|failed|inconclusive [--slug <slug>]
#   codegen-log verdict --gate <cmd> --mode <mode> --result "<text>" [--detail "<text>"] [--slug <slug>]
#   codegen-log relocate --new-slug <slug> [--slug <slug>]
#   codegen-log --version
#
# --version: cheap read-only presence/preflight probe. Prints
#   "codegen-log root=<resolved|unresolved-root>" to stdout and exits 0.
#   Always exits 0 when the binary itself runs — an unresolved CODEGEN_ROOT
#   only degrades the printed status, it never fails this probe (root
#   resolution failure is a version_stamp metadata concern, not a binary
#   presence concern). Callers that need root resolution to be authoritative
#   should grep the printed status, not just the exit code.
#
# Positional <role> (taught/default form) and --role/--body @- (accepted
# aliases, kept for existing callers) resolve to the same behavior. When
# --body is omitted, stdin is read implicitly (same as --body @-).
#
# On-disk storage: codegen/logging/<ts>_<slug>_cycle.jsonl — append-only
# JSONL, one JSON object per line, NEVER rewritten/ranked. Every event object
# carries an "ev" discriminator field:
#   init:    {"ev":"init","pitch":<slug>,"path":<pitch-path-or-empty>,
#             "stamp":{"project","context","codegen","claude","at"}}
#   role:    {"ev":"role","role":<role>,"body":<prose>} — one line per
#            section/append call. Re-running `section`/`append` for the same
#            role APPENDS a new "role" event; it never overwrites a prior one
#            (there is no rank/order concept under JSONL).
#   learned: {"ev":"learned","role":<role>,"text":<t>}
#   died:    {"ev":"died","role":<role>,"kind":"interrupted"|"aborted","cause":<c-or-empty>}
#   gate:    {"ev":"gate","role":<role>,"verdict":"clear"|"failed"|"inconclusive",
#             ...gate metadata for the `verdict` subcommand}
#
# init: create a new codegen/logging/<ts>_<slug>_cycle.jsonl containing only
#       the initial "init" event line. Idempotent: re-running init with a
#       slug that already has a matching log prints that log's path and
#       exits 0 WITHOUT creating a second log; more than one match is
#       ambiguous and exits 2.
# section: append ONE "role" event line with the given role + full body.
#          --role overrides AGENT_TYPE/CLAUDE_ROLE-derived role when present.
#          A second `section` call for the same role APPENDS another "role"
#          event line — it does NOT replace the earlier one (append-only
#          storage; there is nothing to overwrite).
# append: append ONE more event line for an EXISTING role (plain body ->
#         another "role" event; marker flags -> "learned"/"died"/"gate"
#         events). JSONL append is unconditional — there is no "section must
#         exist first" precondition (that constraint only existed to protect
#         markdown section-insertion order, which JSONL has no concept of).
#
# Marker flags (append only) — emit a structured event instead of reading
# stdin. Mutually exclusive with --body and with each other.
#   --learned "<text>"            -> {"ev":"learned",...}
#   --died interrupted [--cause]  -> {"ev":"died","kind":"interrupted",...}
#   --died aborted                -> {"ev":"died","kind":"aborted",...}
#   --verdict clear|failed|inconclusive -> {"ev":"gate","verdict":<v>,...}
#
# Target-log resolution (section/append), in precedence order:
#   1. CODEGEN_LOG_PATH env var, if set.
#   2. --slug <slug>, if given — resolves to the single log on disk matching
#      *_<slug>_cycle.jsonl; zero or multiple matches exit 2.
#   3. codegen/logging/.active sentinel (written by init/relocate), if it
#      points at a log that still exists on disk.
#   4. Otherwise, the most recently modified *_cycle.jsonl (mtime).
#
# relocate: rewrite the .active sentinel to point at a RENAMED log file
# (rename in place, no rm+init). Resolves the CURRENT log via the same
# precedence as section/append (CODEGEN_LOG_PATH > --slug > .active > mtime),
# renames it to carry --new-slug, and updates .active to the new path.
#
# verdict: dedicated writer for the Elixir loop's LoopGate deterministic gate
# verdict. Every call APPENDS a brand-new "gate" event line (role="dev-gate")
# — never replaces a prior one, matching one-event-per-gate-run semantics (a
# cycle log commonly carries more than one dev-gate verdict across retries).
# The verdict field is derived from --result text: contains "ALL CLEAR" ->
# clear, "FAILED" -> failed, "INCONCLUSIVE" -> inconclusive; the raw --result
# and --detail text are preserved alongside the classified verdict.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
# Root resolution: prefer a sibling checkout next to this script (self-build
# / repo-relative invocation). When installed as a stable copy (no sibling
# codegen/ dir alongside it — e.g. ~/.local/bin/codegen-log), fall back to
# CODEGEN_DIR (exported by the Elixir orchestration loop) OR OCG_CODEGEN_DIR
# (exported by dispatch.sh/ocg), in that order. Either resolves; CODEGEN_DIR
# takes precedence when both are set. If NEITHER resolves a valid codegen
# root, leave CODEGEN_ROOT empty — this is NOT a hard failure: log writing
# uses LOG_ROOT (cwd), which is unaffected. version_stamp() detects the empty
# root and emits an honest "unresolved-root" marker instead of running git
# blind.
CODEGEN_ROOT="$SCRIPT_DIR"
if [[ ! -d "$SCRIPT_DIR/codegen" ]]; then
    if [[ -n "${CODEGEN_DIR:-}" && -d "$CODEGEN_DIR/codegen" ]]; then
        CODEGEN_ROOT="$CODEGEN_DIR"
    elif [[ -n "${OCG_CODEGEN_DIR:-}" && -d "$OCG_CODEGEN_DIR/codegen" ]]; then
        CODEGEN_ROOT="$OCG_CODEGEN_DIR"
    else
        CODEGEN_ROOT=""
    fi
fi
LOG_ROOT="${CODEGEN_BUILD_CWD:-${CLAUDE_PROJECT_DIR:-$PWD}}"

SUBCOMMAND=""
SLUG=""
SLUG_SET=""
BODY_SOURCE=""
ROLE_OVERRIDE=""
ROLE_POSITIONAL_SEEN=""
LEARNED_TEXT=""
DIED_KIND=""
DIED_CAUSE=""
VERDICT_KIND=""
NEW_SLUG=""
GATE_CMD=""
GATE_MODE=""
RESULT_TEXT=""
DETAIL_TEXT=""

usage() {
    printf 'Usage:\n' >&2
    printf '  codegen-log init --slug <slug>\n' >&2
    printf '  codegen-log section --body @- [--role <role>] [--slug <slug>]\n' >&2
    printf '  codegen-log append --role <role> --body @- [--slug <slug>]\n' >&2
    printf '  codegen-log append --role <role> --learned "<text>" [--slug <slug>]\n' >&2
    printf '  codegen-log append --role <role> --died interrupted|aborted [--cause "<text>"] [--slug <slug>]\n' >&2
    printf '  codegen-log append --role <role> --verdict clear|failed|inconclusive [--slug <slug>]\n' >&2
    printf '  codegen-log verdict --gate <cmd> --mode <mode> --result "<text>" [--detail "<text>"] [--slug <slug>]\n' >&2
    printf '  codegen-log relocate --new-slug <slug> [--slug <slug>]\n' >&2
    printf '  codegen-log --version\n' >&2
    printf '\n' >&2
    printf "section and append both APPEND a new event line to the JSONL cycle log — there is no overwrite/replace semantics.\n" >&2
    exit 2
}

# --version: handled BEFORE subcommand dispatch — it IS the action, requires
# no subcommand. Cheap, read-only, always exits 0 (proves the binary is
# present + runnable; root-resolution status is reported, not enforced).
for _arg in "$@"; do
    if [[ "$_arg" == "--version" ]]; then
        if [[ -n "$CODEGEN_ROOT" ]]; then
            printf 'codegen-log root=resolved\n'
        else
            printf 'codegen-log root=unresolved-root\n'
        fi
        exit 0
    fi
done

while [[ $# -gt 0 ]]; do
    case "$1" in
    init | section | append | relocate | verdict)
        if [[ -n "$SUBCOMMAND" ]]; then
            printf 'codegen-log: only one subcommand is allowed\n' >&2
            usage
        fi
        SUBCOMMAND="$1"
        shift
        ;;
    --slug=*)
        SLUG="${1#--slug=}"
        SLUG_SET=1
        shift
        ;;
    --slug)
        SLUG="$2"
        SLUG_SET=1
        shift 2
        ;;
    --body=*)
        BODY_SOURCE="${1#--body=}"
        shift
        ;;
    --body)
        BODY_SOURCE="$2"
        shift 2
        ;;
    --role=*)
        ROLE_OVERRIDE="${1#--role=}"
        shift
        ;;
    --role)
        ROLE_OVERRIDE="$2"
        shift 2
        ;;
    --learned=*)
        LEARNED_TEXT="${1#--learned=}"
        shift
        ;;
    --learned)
        LEARNED_TEXT="$2"
        shift 2
        ;;
    --died=*)
        DIED_KIND="${1#--died=}"
        shift
        ;;
    --died)
        DIED_KIND="$2"
        shift 2
        ;;
    --cause=*)
        DIED_CAUSE="${1#--cause=}"
        shift
        ;;
    --cause)
        DIED_CAUSE="$2"
        shift 2
        ;;
    --verdict=*)
        VERDICT_KIND="${1#--verdict=}"
        shift
        ;;
    --verdict)
        VERDICT_KIND="$2"
        shift 2
        ;;
    --new-slug=*)
        NEW_SLUG="${1#--new-slug=}"
        shift
        ;;
    --new-slug)
        NEW_SLUG="$2"
        shift 2
        ;;
    --gate=*)
        GATE_CMD="${1#--gate=}"
        shift
        ;;
    --gate)
        GATE_CMD="$2"
        shift 2
        ;;
    --mode=*)
        GATE_MODE="${1#--mode=}"
        shift
        ;;
    --mode)
        GATE_MODE="$2"
        shift 2
        ;;
    --result=*)
        RESULT_TEXT="${1#--result=}"
        shift
        ;;
    --result)
        RESULT_TEXT="$2"
        shift 2
        ;;
    --detail=*)
        DETAIL_TEXT="${1#--detail=}"
        shift
        ;;
    --detail)
        DETAIL_TEXT="$2"
        shift 2
        ;;
    --help | -h)
        usage
        ;;
    --*)
        printf 'codegen-log: unknown flag %q\n' "$1" >&2
        usage
        ;;
    *)
        # Positional role: a bare token (not starting with -) immediately
        # following section/append is accepted as the role, ALIASING
        # --role. Only one positional role is accepted; a second bare
        # token is an error (relocate's NEW_SLUG uses --slug, never a
        # second positional).
        if [[ ("$SUBCOMMAND" == "section" || "$SUBCOMMAND" == "append") && -z "$ROLE_OVERRIDE" && -z "$ROLE_POSITIONAL_SEEN" ]]; then
            ROLE_OVERRIDE="$1"
            ROLE_POSITIONAL_SEEN=1
            shift
        else
            printf 'codegen-log: unexpected argument %q\n' "$1" >&2
            usage
        fi
        ;;
    esac
done

if [[ -z "$SUBCOMMAND" ]]; then
    usage
fi

# Marker flags (--learned/--died/--verdict) are append-only and mutually
# exclusive with each other and with --body.
MARKER_FLAG_COUNT=0
[[ -n "$LEARNED_TEXT" ]] && MARKER_FLAG_COUNT=$((MARKER_FLAG_COUNT + 1))
[[ -n "$DIED_KIND" ]] && MARKER_FLAG_COUNT=$((MARKER_FLAG_COUNT + 1))
[[ -n "$VERDICT_KIND" ]] && MARKER_FLAG_COUNT=$((MARKER_FLAG_COUNT + 1))
if [[ "$MARKER_FLAG_COUNT" -gt 1 ]]; then
    printf 'codegen-log: --learned, --died, and --verdict are mutually exclusive\n' >&2
    exit 2
fi
if [[ "$MARKER_FLAG_COUNT" -gt 0 ]]; then
    if [[ "$SUBCOMMAND" != "append" ]]; then
        printf 'codegen-log: --learned/--died/--verdict are only valid with the append subcommand\n' >&2
        exit 2
    fi
    if [[ -n "$BODY_SOURCE" ]]; then
        printf 'codegen-log: --learned/--died/--verdict are mutually exclusive with --body\n' >&2
        exit 2
    fi
fi

# validate_role — ensure ROLE_OVERRIDE matches the known role-family
# vocabulary. Exits 2 on unknown role (same families the old markdown header
# mapping recognized: planner*/developer-*/reviewer-*/context-curator/
# committer/dev-gate). dev-gate is only ever set internally by the `verdict`
# subcommand, never accepted from a caller-supplied --role for section/append.
validate_role() {
    local role="$1"
    case "$role" in
    planner* | developer-* | reviewer-* | context-curator | committer) ;;
    *)
        printf 'codegen-log: could not resolve role (got %q). Pass the role positionally (codegen-log section <role>) or via --role <planner*|developer-*|reviewer-*|context-curator|committer>.\n' "${role:-unknown}" >&2
        exit 2
        ;;
    esac
}

repo_root() {
    printf '%s' "$LOG_ROOT"
}

active_sentinel_path() {
    printf '%s/codegen/logging/.active' "$(repo_root)"
}

# active_sentinel_log — read the .active sentinel and return its contents
# (an absolute log path) IFF that path still exists on disk. Empty otherwise
# (stale sentinel pointing at a relocated/deleted log falls through to the
# mtime fallback, never a hard error).
active_sentinel_log() {
    local sentinel path
    sentinel="$(active_sentinel_path)"
    [[ -f "$sentinel" ]] || return 0
    path="$(cat "$sentinel" 2>/dev/null || true)"
    [[ -n "$path" && -f "$path" ]] || return 0
    printf '%s' "$path"
}

write_active_sentinel() {
    local log_path="$1"
    local sentinel
    sentinel="$(active_sentinel_path)"
    mkdir -p "$(dirname "$sentinel")"
    printf '%s' "$log_path" >"$sentinel"
}

# latest_cycle_log — most recently MODIFIED *_cycle.jsonl (mtime order via
# `ls -t`), not lexicographic/glob-order. This is the last-resort fallback
# when neither CODEGEN_LOG_PATH, --slug, nor the .active sentinel resolve.
latest_cycle_log() {
    local root
    root="$(repo_root)"
    ls -t "$root"/codegen/logging/*_cycle.jsonl 2>/dev/null | head -n 1
}

validate_slug() {
    local slug="$1"
    if [[ ! "$slug" =~ ^[a-z0-9_-]+$ ]]; then
        printf 'codegen-log: --slug must match [a-z0-9_-]+ (got %q)\n' "$slug" >&2
        exit 2
    fi
}

resolve_by_slug() {
    local slug="$1"
    local root matches=() candidate
    root="$(repo_root)"
    for candidate in "$root"/codegen/logging/*_"${slug}"_cycle.jsonl; do
        [[ -e "$candidate" ]] || continue
        matches+=("$candidate")
    done
    if [[ "${#matches[@]}" -eq 0 ]]; then
        printf 'codegen-log: no cycle log matches slug %s\n' "$slug" >&2
        exit 2
    fi
    if [[ "${#matches[@]}" -gt 1 ]]; then
        printf 'codegen-log: ambiguous slug %s: %d logs match\n' "$slug" "${#matches[@]}" >&2
        printf '%s\n' "${matches[@]}" >&2
        exit 2
    fi
    printf '%s' "${matches[0]}"
}

resolve_log_file() {
    if [[ -n "${CODEGEN_LOG_PATH:-}" ]]; then
        printf '%s' "$CODEGEN_LOG_PATH"
        return
    fi
    if [[ -n "$SLUG_SET" && -z "$SLUG" ]]; then
        printf 'codegen-log: --slug was passed but is empty (refusing to fall back to the newest log)\n' >&2
        exit 2
    fi
    if [[ -n "$SLUG" ]]; then
        validate_slug "$SLUG"
        resolve_by_slug "$SLUG"
        return
    fi
    local sentinel_log
    sentinel_log="$(active_sentinel_log)"
    if [[ -n "$sentinel_log" ]]; then
        printf '%s' "$sentinel_log"
        return
    fi
    latest_cycle_log
}

# version_stamp_json — emit the stamp object fields for the init event as a
# single-line JSON object via jq. Computes the same hash/version values the
# old markdown "## Version Stamp" block carried.
version_stamp_json() {
    local project_hash context_hash codegen_hash claude_version stamped_at
    project_hash="$(git -C "$LOG_ROOT" rev-parse --short HEAD 2>/dev/null || printf 'unknown')"
    if [[ -n "$CODEGEN_ROOT" ]]; then
        context_hash="$(git -C "$CODEGEN_ROOT/codegen/rules" rev-parse --short HEAD 2>/dev/null || printf 'unknown')"
        codegen_hash="$(git -C "$CODEGEN_ROOT" rev-parse --short HEAD 2>/dev/null || printf 'unknown')"
    else
        # CODEGEN_ROOT never resolved (neither CODEGEN_DIR nor OCG_CODEGEN_DIR
        # pointed at a valid codegen checkout, and no sibling codegen/ dir
        # exists next to this script). An honest marker beats running
        # `git -C ""` blind, which would print the misleading `unknown`.
        context_hash="unresolved-root"
        codegen_hash="unresolved-root"
    fi
    if command -v claude >/dev/null 2>&1; then
        claude_version="$(claude --version 2>/dev/null || printf 'unknown')"
    elif command -v pi >/dev/null 2>&1; then
        claude_version="$(pi --version 2>/dev/null || printf 'unknown')"
    else
        claude_version="unknown"
    fi
    stamped_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    jq -c -n \
        --arg project "$project_hash" \
        --arg context "$context_hash" \
        --arg codegen "$codegen_hash" \
        --arg claude "$claude_version" \
        --arg at "$stamped_at" \
        '{project: $project, context: $context, codegen: $codegen, claude: $claude, at: $at}'
}

# append_event_line — append ONE compact JSON line to the given log file.
# `$1` is the log path, `$2` is the already-built compact JSON object string.
append_event_line() {
    local path="$1"
    local line="$2"
    printf '%s\n' "$line" >>"$path"
}

case "$SUBCOMMAND" in
init)
    if [[ -z "$SLUG" ]]; then
        printf 'codegen-log init: --slug is required\n' >&2
        usage
    fi
    if [[ ! "$SLUG" =~ ^[a-z0-9_-]+$ ]]; then
        printf 'codegen-log init: --slug must match [a-z0-9_-]+ (got %q)\n' "$SLUG" >&2
        exit 2
    fi
    root="$(repo_root)"
    existing=()
    for candidate in "$root"/codegen/logging/*_"${SLUG}"_cycle.jsonl; do
        [[ -e "$candidate" ]] || continue
        existing+=("$candidate")
    done
    if [[ "${#existing[@]}" -eq 1 ]]; then
        write_active_sentinel "${existing[0]}"
        printf '%s\n' "${existing[0]}"
        exit 0
    fi
    if [[ "${#existing[@]}" -gt 1 ]]; then
        printf 'codegen-log init: ambiguous slug %s: %d logs match\n' "$SLUG" "${#existing[@]}" >&2
        printf '%s\n' "${existing[@]}" >&2
        exit 2
    fi
    timestamp="$(date -u +%Y%m%d_%H%M%S)"
    path="$root/codegen/logging/${timestamp}_${SLUG}_cycle.jsonl"
    mkdir -p "$(dirname "$path")"
    # Best-effort pitch path — empty string (not a masking-default fake path)
    # when it cannot be resolved. codegen-log has no reliable way to know the
    # pitch file's path at init time; leave it empty rather than guess.
    stamp_json="$(version_stamp_json)"
    init_line="$(jq -c -n --arg pitch "$SLUG" --arg path "" --argjson stamp "$stamp_json" \
        '{ev: "init", pitch: $pitch, path: $path, stamp: $stamp}')"
    printf '%s\n' "$init_line" >"$path"
    write_active_sentinel "$path"
    printf '%s\n' "$path"
    ;;
section)
    # Implicit stdin: --body is optional. Omitted -> read stdin (same as @-).
    [[ -z "$BODY_SOURCE" ]] && BODY_SOURCE="@-"
    if [[ "$BODY_SOURCE" != @* ]]; then
        printf 'codegen-log section: --body must start with @ (got %q)\n' "$BODY_SOURCE" >&2
        exit 2
    fi
    if [[ "$BODY_SOURCE" != @- ]]; then
        body_path="${BODY_SOURCE#@}"
        if [[ ! -f "$body_path" ]]; then
            printf 'codegen-log section: body file not found: %s\n' "$body_path" >&2
            exit 2
        fi
        body="$(cat "$body_path")"
    else
        body="$(cat)"
    fi

    if [[ -z "$ROLE_OVERRIDE" ]]; then
        printf 'codegen-log section: role is required (positional: codegen-log section <role>, or --role <role>)\n' >&2
        usage
    fi
    validate_role "$ROLE_OVERRIDE"

    log_file="$(resolve_log_file)"
    if [[ -z "$log_file" || ! -f "$log_file" ]]; then
        printf 'codegen-log section: no cycle log found (set CODEGEN_LOG_PATH or create one first)\n' >&2
        exit 2
    fi

    line="$(jq -c -n --arg role "$ROLE_OVERRIDE" --arg body "$body" '{ev: "role", role: $role, body: $body}')"
    append_event_line "$log_file" "$line"
    printf '%s\n' "$log_file"
    ;;
append)
    if [[ -z "$ROLE_OVERRIDE" ]]; then
        printf 'codegen-log append: role is required (positional: codegen-log append <role>, or --role <role>)\n' >&2
        usage
    fi
    validate_role "$ROLE_OVERRIDE"

    log_file="$(resolve_log_file)"
    if [[ -z "$log_file" || ! -f "$log_file" ]]; then
        printf 'codegen-log append: no cycle log found (set CODEGEN_LOG_PATH or create one first)\n' >&2
        exit 2
    fi

    if [[ -n "$LEARNED_TEXT" ]]; then
        line="$(jq -c -n --arg role "$ROLE_OVERRIDE" --arg text "$LEARNED_TEXT" '{ev: "learned", role: $role, text: $text}')"
        append_event_line "$log_file" "$line"
        printf '%s\n' "$log_file"
        exit 0
    fi

    if [[ -n "$DIED_KIND" ]]; then
        case "$DIED_KIND" in
        interrupted | aborted) ;;
        *)
            printf 'codegen-log: --died must be interrupted|aborted (got %q)\n' "$DIED_KIND" >&2
            exit 2
            ;;
        esac
        line="$(jq -c -n --arg role "$ROLE_OVERRIDE" --arg kind "$DIED_KIND" --arg cause "${DIED_CAUSE:-}" \
            '{ev: "died", role: $role, kind: $kind, cause: $cause}')"
        append_event_line "$log_file" "$line"
        printf '%s\n' "$log_file"
        exit 0
    fi

    if [[ -n "$VERDICT_KIND" ]]; then
        case "$VERDICT_KIND" in
        clear | failed | inconclusive) ;;
        *)
            printf 'codegen-log: --verdict must be clear|failed|inconclusive (got %q)\n' "$VERDICT_KIND" >&2
            exit 2
            ;;
        esac
        line="$(jq -c -n --arg role "$ROLE_OVERRIDE" --arg verdict "$VERDICT_KIND" '{ev: "gate", role: $role, verdict: $verdict}')"
        append_event_line "$log_file" "$line"
        printf '%s\n' "$log_file"
        exit 0
    fi

    # Plain --body append (no marker flag): implicit stdin when omitted.
    [[ -z "$BODY_SOURCE" ]] && BODY_SOURCE="@-"
    if [[ "$BODY_SOURCE" != @* ]]; then
        printf 'codegen-log append: --body must start with @ (got %q)\n' "$BODY_SOURCE" >&2
        exit 2
    fi
    if [[ "$BODY_SOURCE" != @- ]]; then
        body_path="${BODY_SOURCE#@}"
        if [[ ! -f "$body_path" ]]; then
            printf 'codegen-log append: body file not found: %s\n' "$body_path" >&2
            exit 2
        fi
        body="$(cat "$body_path")"
    else
        body="$(cat)"
    fi

    line="$(jq -c -n --arg role "$ROLE_OVERRIDE" --arg body "$body" '{ev: "role", role: $role, body: $body}')"
    append_event_line "$log_file" "$line"
    printf '%s\n' "$log_file"
    ;;
relocate)
    if [[ -z "$NEW_SLUG" ]]; then
        printf 'codegen-log relocate: --new-slug is required\n' >&2
        usage
    fi
    if [[ ! "$NEW_SLUG" =~ ^[a-z0-9_-]+$ ]]; then
        printf 'codegen-log relocate: --new-slug must match [a-z0-9_-]+ (got %q)\n' "$NEW_SLUG" >&2
        exit 2
    fi
    log_file="$(resolve_log_file)"
    if [[ -z "$log_file" || ! -f "$log_file" ]]; then
        printf 'codegen-log relocate: no cycle log found (set CODEGEN_LOG_PATH or create one first)\n' >&2
        exit 2
    fi
    log_dir="$(dirname "$log_file")"
    log_base="$(basename "$log_file")"
    # Preserve the timestamp prefix, swap the slug. Only the "_cycle.jsonl"
    # suffix form is supported (the dead "_stepN_<slug>.md" alternate was
    # never written by codegen-log and is not ported).
    case "$log_base" in
    [0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]_[0-9][0-9][0-9][0-9][0-9][0-9]_*_cycle.jsonl)
        timestamp_prefix="${log_base:0:15}"
        ;;
    *)
        printf 'codegen-log relocate: could not parse log filename: %s\n' "$log_base" >&2
        exit 2
        ;;
    esac
    new_path="$log_dir/${timestamp_prefix}_${NEW_SLUG}_cycle.jsonl"
    if [[ -e "$new_path" ]]; then
        printf 'codegen-log relocate: target already exists: %s\n' "$new_path" >&2
        exit 2
    fi
    mv "$log_file" "$new_path"
    write_active_sentinel "$new_path"
    printf '%s\n' "$new_path"
    ;;
verdict)
    if [[ -z "$GATE_CMD" ]]; then
        printf 'codegen-log verdict: --gate is required\n' >&2
        usage
    fi
    if [[ -z "$GATE_MODE" ]]; then
        printf 'codegen-log verdict: --mode is required\n' >&2
        usage
    fi
    if [[ -z "$RESULT_TEXT" ]]; then
        printf 'codegen-log verdict: --result is required\n' >&2
        usage
    fi
    log_file="$(resolve_log_file)"
    if [[ -z "$log_file" || ! -f "$log_file" ]]; then
        printf 'codegen-log verdict: no cycle log found (set CODEGEN_LOG_PATH or create one first)\n' >&2
        exit 2
    fi
    # Derive the classified verdict discriminator from the raw --result text.
    # This is the single authoritative field readers key on; the raw result
    # text is preserved alongside it for detail.
    case "$RESULT_TEXT" in
    *'ALL CLEAR'*) derived_verdict="clear" ;;
    *'FAILED'*) derived_verdict="failed" ;;
    *'INCONCLUSIVE'*) derived_verdict="inconclusive" ;;
    *)
        printf 'codegen-log verdict: --result must contain ALL CLEAR, FAILED, or INCONCLUSIVE (got %q)\n' "$RESULT_TEXT" >&2
        exit 2
        ;;
    esac
    line="$(jq -c -n \
        --arg role "dev-gate" \
        --arg verdict "$derived_verdict" \
        --arg gate "$GATE_CMD" \
        --arg mode "$GATE_MODE" \
        --arg result "$RESULT_TEXT" \
        --arg detail "${DETAIL_TEXT:-}" \
        '{ev: "gate", role: $role, verdict: $verdict, gate: $gate, mode: $mode, result: $result, detail: $detail}')"
    append_event_line "$log_file" "$line"
    printf '%s\n' "$log_file"
    ;;
esac
