#!/usr/bin/env bash
# codegen-log — canonical session-log writer.
#
# Usage:
#   codegen-log init --slug <slug>
#   codegen-log section [<role>] [--body @-] [--role <role>] [--slug <slug>]
#   codegen-log append <role> [--body @-] [--slug <slug>]
#   codegen-log append <role> --learned "<text>" [--slug <slug>]
#   codegen-log append <role> --died interrupted|aborted [--cause "<text>"] [--slug <slug>]
#   codegen-log append <role> --verdict clear|failed|inconclusive [--slug <slug>]
#   codegen-log verdict --gate <cmd> --mode <mode> --result "<text>" [--detail "<text>"] [--slug <slug>]
#   codegen-log relocate --new-slug <slug> [--slug <slug>]
#   codegen-log --version
#
# --version: cheap read-only presence/preflight probe. Prints
#   "codegen-log root=<resolved|unresolved-root>" to stdout and exits 0.
#   Always exits 0 when the binary itself runs — an unresolved CODEGEN_ROOT
#   only degrades the printed status, it never fails this probe (root
#   resolution failure is a version_stamp metadata concern, not a binary
#   presence concern). Callers that need root resolution to be authoritative
#   should grep the printed status, not just the exit code.
#
# Positional <role> (taught/default form) and --role/--body @- (accepted
# aliases, kept for existing callers) resolve to the same behavior. When
# --body is omitted, stdin is read implicitly (same as --body @-).
#
# init: create a new codegen/logging/<ts>_<slug>_session.md with only the
#       Version Stamp block. Idempotent: re-running init with a slug that
#       already has a matching log prints that log's path and exits 0
#       WITHOUT creating a second log; more than one match is ambiguous
#       and exits 2.
# section: atomically insert/replace the active role section at canonical rank.
#          --role overrides AGENT_TYPE/CLAUDE_ROLE-derived header when present.
#          REPLACES the whole section body (first/only write for the section).
# append: insert the piped body at the END of an EXISTING section's body
#         (before the next "## " header or EOF), PRESERVING the prior body.
#         Never creates a section — exits 2 if the target section is missing.
#         Use for a SECOND write to the same section this cycle (re-run,
#         death marker) — never use `section` for that, it would overwrite.
#
# Marker flags (append only) — emit a BYTE-EXACT canonical block instead of
# reading stdin. Mutually exclusive with --body and with each other.
#   --learned "<text>"           -> "### What I Learned This Step\n\n<text>"
#   --died interrupted [--cause] -> "### INTERRUPTED ⚠️ — <role> dropped (<cause>); re-spawning (attempt N/2)"
#   --died aborted                -> "### ABORTED 💀 — <role> dropped twice; stage failed."
#   --verdict clear|failed|inconclusive -> a line containing
#       "ALL CLEAR ✅" / "FAILED ❌" / "INCONCLUSIVE ⚠️" respectively.
#
# Target-log resolution (section/append), in precedence order:
#   1. CODEGEN_LOG_PATH env var, if set.
#   2. --slug <slug>, if given — resolves to the single log on disk matching
#      *_<slug>_session.md; zero or multiple matches exit 2.
#   3. codegen/logging/.active sentinel (written by init/relocate), if it
#      points at a log that still exists on disk.
#   4. Otherwise, the most recently modified *_session.md (mtime, latest_session_log).
#
# relocate: rewrite the .active sentinel to point at a RENAMED log file
# (rename in place, no rm+init). Resolves the CURRENT log via the same
# precedence as section/append (CODEGEN_LOG_PATH > --slug > .active > mtime),
# renames it to carry --new-slug, and updates .active to the new path.
#
# verdict: dedicated writer for the freeform "## dev-gate Section" block
# (phoenix-dev-gate.sh's deterministic gate verdict — rank 999, ignored by
# the canonical section-order check). Unlike `section`, EVERY call APPENDS a
# brand-new "## dev-gate Section" block at end-of-file — it never replaces a
# prior one, matching one-block-per-gate-run semantics (a step log commonly
# carries more than one dev-gate verdict block across retries). Emits the
# BYTE-EXACT shape phoenix-dev-gate.sh previously wrote via raw `>>`:
#   \n## dev-gate Section\n\nGate: <gate>\nRan: <gate>\n\n
#   **Rules loaded**: deterministic hook (dev-gate.sh) — no rules loaded\n\n
#   **Commands executed**:\n\n<table>\n\n**Result**: <result>\n[\n<detail>\n]

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
# Root resolution: prefer a sibling checkout next to this script (self-build
# / repo-relative invocation). When installed as a stable copy (no sibling
# codegen/ dir alongside it — e.g. ~/.local/bin/codegen-log), fall back to
# CODEGEN_DIR (exported by the Elixir orchestration loop) OR OCG_CODEGEN_DIR
# (exported by dispatch.sh/ocg), in that order. Either resolves; CODEGEN_DIR
# takes precedence when both are set. If NEITHER resolves a valid codegen
# root, leave CODEGEN_ROOT empty — this is NOT a hard failure: log writing
# uses LOG_ROOT (cwd), which is unaffected. version_stamp() detects the empty
# root and emits an honest "unresolved-root" marker instead of running git
# blind.
CODEGEN_ROOT="$SCRIPT_DIR"
if [[ ! -d "$SCRIPT_DIR/codegen" ]]; then
    if [[ -n "${CODEGEN_DIR:-}" && -d "$CODEGEN_DIR/codegen" ]]; then
        CODEGEN_ROOT="$CODEGEN_DIR"
    elif [[ -n "${OCG_CODEGEN_DIR:-}" && -d "$OCG_CODEGEN_DIR/codegen" ]]; then
        CODEGEN_ROOT="$OCG_CODEGEN_DIR"
    else
        CODEGEN_ROOT=""
    fi
fi
LOG_ROOT="${CODEGEN_BUILD_CWD:-${CLAUDE_PROJECT_DIR:-$PWD}}"

SUBCOMMAND=""
SLUG=""
BODY_SOURCE=""
ROLE_OVERRIDE=""
ROLE_POSITIONAL_SEEN=""
LEARNED_TEXT=""
DIED_KIND=""
DIED_CAUSE=""
VERDICT_KIND=""
NEW_SLUG=""
GATE_CMD=""
GATE_MODE=""
RESULT_TEXT=""
DETAIL_TEXT=""

usage() {
    printf 'Usage:\n' >&2
    printf '  codegen-log init --slug <slug>\n' >&2
    printf '  codegen-log section --body @- [--role <role>] [--slug <slug>]\n' >&2
    printf '  codegen-log append --role <role> --body @- [--slug <slug>]\n' >&2
    printf '  codegen-log append --role <role> --learned "<text>" [--slug <slug>]\n' >&2
    printf '  codegen-log append --role <role> --died interrupted|aborted [--cause "<text>"] [--slug <slug>]\n' >&2
    printf '  codegen-log append --role <role> --verdict clear|failed|inconclusive [--slug <slug>]\n' >&2
    printf '  codegen-log verdict --gate <cmd> --mode <mode> --result "<text>" [--detail "<text>"] [--slug <slug>]\n' >&2
    printf '  codegen-log relocate --new-slug <slug> [--slug <slug>]\n' >&2
    printf '  codegen-log --version\n' >&2
    printf '\n' >&2
    printf "section REPLACES the whole section body (first/only write); append PRESERVES it and adds to the end (re-run, second write, death marker).\n" >&2
    exit 2
}

# --version: handled BEFORE subcommand dispatch — it IS the action, requires
# no subcommand. Cheap, read-only, always exits 0 (proves the binary is
# present + runnable; root-resolution status is reported, not enforced).
for _arg in "$@"; do
    if [[ "$_arg" == "--version" ]]; then
        if [[ -n "$CODEGEN_ROOT" ]]; then
            printf 'codegen-log root=resolved\n'
        else
            printf 'codegen-log root=unresolved-root\n'
        fi
        exit 0
    fi
done

while [[ $# -gt 0 ]]; do
    case "$1" in
    init | section | append | relocate | verdict)
        if [[ -n "$SUBCOMMAND" ]]; then
            printf 'codegen-log: only one subcommand is allowed\n' >&2
            usage
        fi
        SUBCOMMAND="$1"
        shift
        ;;
    --slug=*)
        SLUG="${1#--slug=}"
        shift
        ;;
    --slug)
        SLUG="$2"
        shift 2
        ;;
    --body=*)
        BODY_SOURCE="${1#--body=}"
        shift
        ;;
    --body)
        BODY_SOURCE="$2"
        shift 2
        ;;
    --role=*)
        ROLE_OVERRIDE="${1#--role=}"
        shift
        ;;
    --role)
        ROLE_OVERRIDE="$2"
        shift 2
        ;;
    --learned=*)
        LEARNED_TEXT="${1#--learned=}"
        shift
        ;;
    --learned)
        LEARNED_TEXT="$2"
        shift 2
        ;;
    --died=*)
        DIED_KIND="${1#--died=}"
        shift
        ;;
    --died)
        DIED_KIND="$2"
        shift 2
        ;;
    --cause=*)
        DIED_CAUSE="${1#--cause=}"
        shift
        ;;
    --cause)
        DIED_CAUSE="$2"
        shift 2
        ;;
    --verdict=*)
        VERDICT_KIND="${1#--verdict=}"
        shift
        ;;
    --verdict)
        VERDICT_KIND="$2"
        shift 2
        ;;
    --new-slug=*)
        NEW_SLUG="${1#--new-slug=}"
        shift
        ;;
    --new-slug)
        NEW_SLUG="$2"
        shift 2
        ;;
    --gate=*)
        GATE_CMD="${1#--gate=}"
        shift
        ;;
    --gate)
        GATE_CMD="$2"
        shift 2
        ;;
    --mode=*)
        GATE_MODE="${1#--mode=}"
        shift
        ;;
    --mode)
        GATE_MODE="$2"
        shift 2
        ;;
    --result=*)
        RESULT_TEXT="${1#--result=}"
        shift
        ;;
    --result)
        RESULT_TEXT="$2"
        shift 2
        ;;
    --detail=*)
        DETAIL_TEXT="${1#--detail=}"
        shift
        ;;
    --detail)
        DETAIL_TEXT="$2"
        shift 2
        ;;
    --help | -h)
        usage
        ;;
    --*)
        printf 'codegen-log: unknown flag %q\n' "$1" >&2
        usage
        ;;
    *)
        # Positional role: a bare token (not starting with -) immediately
        # following section/append is accepted as the role, ALIASING
        # --role. Only one positional role is accepted; a second bare
        # token is an error (relocate's NEW_SLUG uses --slug, never a
        # second positional).
        if [[ ("$SUBCOMMAND" == "section" || "$SUBCOMMAND" == "append") && -z "$ROLE_OVERRIDE" && -z "$ROLE_POSITIONAL_SEEN" ]]; then
            ROLE_OVERRIDE="$1"
            ROLE_POSITIONAL_SEEN=1
            shift
        else
            printf 'codegen-log: unexpected argument %q\n' "$1" >&2
            usage
        fi
        ;;
    esac
done

if [[ -z "$SUBCOMMAND" ]]; then
    usage
fi

# Marker flags (--learned/--died/--verdict) are append-only and mutually
# exclusive with each other and with --body.
MARKER_FLAG_COUNT=0
[[ -n "$LEARNED_TEXT" ]] && MARKER_FLAG_COUNT=$((MARKER_FLAG_COUNT + 1))
[[ -n "$DIED_KIND" ]] && MARKER_FLAG_COUNT=$((MARKER_FLAG_COUNT + 1))
[[ -n "$VERDICT_KIND" ]] && MARKER_FLAG_COUNT=$((MARKER_FLAG_COUNT + 1))
if [[ "$MARKER_FLAG_COUNT" -gt 1 ]]; then
    printf 'codegen-log: --learned, --died, and --verdict are mutually exclusive\n' >&2
    exit 2
fi
if [[ "$MARKER_FLAG_COUNT" -gt 0 ]]; then
    if [[ "$SUBCOMMAND" != "append" ]]; then
        printf 'codegen-log: --learned/--died/--verdict are only valid with the append subcommand\n' >&2
        exit 2
    fi
    if [[ -n "$BODY_SOURCE" ]]; then
        printf 'codegen-log: --learned/--died/--verdict are mutually exclusive with --body\n' >&2
        exit 2
    fi
fi

# build_marker_body — emit the byte-exact canonical block for the active
# marker flag. Must be called only when MARKER_FLAG_COUNT -eq 1.
build_marker_body() {
    if [[ -n "$LEARNED_TEXT" ]]; then
        printf '### What I Learned This Step\n\n%s\n' "$LEARNED_TEXT"
        return
    fi
    if [[ -n "$DIED_KIND" ]]; then
        case "$DIED_KIND" in
        interrupted)
            local cause="${DIED_CAUSE:-unknown}"
            printf '### INTERRUPTED ⚠️ — %s dropped (%s); re-spawning (attempt N/2)\n' "$ROLE_OVERRIDE" "$cause"
            ;;
        aborted)
            printf '### ABORTED 💀 — %s dropped twice; stage failed.\n' "$ROLE_OVERRIDE"
            ;;
        *)
            printf 'codegen-log: --died must be interrupted|aborted (got %q)\n' "$DIED_KIND" >&2
            exit 2
            ;;
        esac
        return
    fi
    if [[ -n "$VERDICT_KIND" ]]; then
        case "$VERDICT_KIND" in
        clear)
            printf 'Verdict: ALL CLEAR ✅\n'
            ;;
        failed)
            printf 'Verdict: FAILED ❌\n'
            ;;
        inconclusive)
            printf 'Verdict: INCONCLUSIVE ⚠️\n'
            ;;
        *)
            printf 'codegen-log: --verdict must be clear|failed|inconclusive (got %q)\n' "$VERDICT_KIND" >&2
            exit 2
            ;;
        esac
        return
    fi
}

repo_root() {
    printf '%s' "$LOG_ROOT"
}

active_sentinel_path() {
    printf '%s/codegen/logging/.active' "$(repo_root)"
}

# active_sentinel_log — read the .active sentinel and return its contents
# (an absolute log path) IFF that path still exists on disk. Empty otherwise
# (stale sentinel pointing at a relocated/deleted log falls through to the
# mtime fallback, never a hard error).
active_sentinel_log() {
    local sentinel path
    sentinel="$(active_sentinel_path)"
    [[ -f "$sentinel" ]] || return 0
    path="$(cat "$sentinel" 2>/dev/null || true)"
    [[ -n "$path" && -f "$path" ]] || return 0
    printf '%s' "$path"
}

write_active_sentinel() {
    local log_path="$1"
    local sentinel
    sentinel="$(active_sentinel_path)"
    mkdir -p "$(dirname "$sentinel")"
    printf '%s' "$log_path" >"$sentinel"
}

# latest_session_log — most recently MODIFIED *_session.md (mtime order via
# `ls -t`), not lexicographic/glob-order. This is the last-resort fallback
# when neither CODEGEN_LOG_PATH, --slug, nor the .active sentinel resolve.
latest_session_log() {
    local root
    root="$(repo_root)"
    ls -t "$root"/codegen/logging/*_session.md 2>/dev/null | head -n 1
}

validate_slug() {
    local slug="$1"
    if [[ ! "$slug" =~ ^[a-z0-9_-]+$ ]]; then
        printf 'codegen-log: --slug must match [a-z0-9_-]+ (got %q)\n' "$slug" >&2
        exit 2
    fi
}

resolve_by_slug() {
    local slug="$1"
    local root matches=() candidate
    root="$(repo_root)"
    for candidate in "$root"/codegen/logging/*_"${slug}"_session.md; do
        [[ -e "$candidate" ]] || continue
        matches+=("$candidate")
    done
    if [[ "${#matches[@]}" -eq 0 ]]; then
        printf 'codegen-log: no session log matches slug %s\n' "$slug" >&2
        exit 2
    fi
    if [[ "${#matches[@]}" -gt 1 ]]; then
        printf 'codegen-log: ambiguous slug %s: %d logs match\n' "$slug" "${#matches[@]}" >&2
        printf '%s\n' "${matches[@]}" >&2
        exit 2
    fi
    printf '%s' "${matches[0]}"
}

resolve_log_file() {
    if [[ -n "${CODEGEN_LOG_PATH:-}" ]]; then
        printf '%s' "$CODEGEN_LOG_PATH"
        return
    fi
    if [[ -n "$SLUG" ]]; then
        validate_slug "$SLUG"
        resolve_by_slug "$SLUG"
        return
    fi
    local sentinel_log
    sentinel_log="$(active_sentinel_log)"
    if [[ -n "$sentinel_log" ]]; then
        printf '%s' "$sentinel_log"
        return
    fi
    latest_session_log
}

version_stamp() {
    local project_hash context_hash codegen_hash claude_version stamped_at
    project_hash="$(git -C "$LOG_ROOT" rev-parse --short HEAD 2>/dev/null || printf 'unknown')"
    if [[ -n "$CODEGEN_ROOT" ]]; then
        context_hash="$(git -C "$CODEGEN_ROOT/codegen/rules" rev-parse --short HEAD 2>/dev/null || printf 'unknown')"
        codegen_hash="$(git -C "$CODEGEN_ROOT" rev-parse --short HEAD 2>/dev/null || printf 'unknown')"
    else
        # CODEGEN_ROOT never resolved (neither CODEGEN_DIR nor OCG_CODEGEN_DIR
        # pointed at a valid codegen checkout, and no sibling codegen/ dir
        # exists next to this script). An honest marker beats running
        # `git -C ""` blind, which would print the misleading `unknown`.
        context_hash="unresolved-root"
        codegen_hash="unresolved-root"
    fi
    if command -v claude >/dev/null 2>&1; then
        claude_version="$(claude --version 2>/dev/null || printf 'unknown')"
    elif command -v pi >/dev/null 2>&1; then
        claude_version="$(pi --version 2>/dev/null || printf 'unknown')"
    else
        claude_version="unknown"
    fi
    stamped_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    cat <<EOF
## Version Stamp

- project: $project_hash
- context: $context_hash
- codegen: $codegen_hash
- claude: $claude_version
- stamped_at: $stamped_at
EOF
}

section_header_for_agent() {
    local role="$ROLE_OVERRIDE"
    case "$role" in
    planner*) printf '## Plan' ;;
    developer-*) printf '## %s Section' "$role" ;;
    reviewer-*) printf '## %s Section' "$role" ;;
    context-curator) printf '## context-curator Section' ;;
    committer) printf '## committer Section' ;;
    *)
        printf 'codegen-log: could not resolve role (got %q). Pass the role positionally (codegen-log section <role>) or via --role <planner*|developer-*|reviewer-*|context-curator|committer>.\n' "${role:-unknown}" >&2
        exit 2
        ;;
    esac
}

rank_of() {
    case "$1" in
    '## Version Stamp') printf '1' ;;
    '## Rules Loaded'*) printf '2' ;;
    '## Plan'*) printf '3' ;;
    '## Slices'*) printf '3' ;;
    '## Delegation Timeline') printf '4' ;;
    '## Files Modified') printf '5' ;;
    '## developer-'*' Section'*) printf '6' ;;
    '## reviewer-'*' Section'*) printf '8' ;;
    '## context-curator Section') printf '9' ;;
    '## committer Section') printf '10' ;;
    *) printf '999' ;;
    esac
}

render_section() {
    local header="$1"
    local body="$2"
    printf '%s\n\n%s' "$header" "$body"
    if [[ -z "$body" || "${body: -1}" != $'\n' ]]; then
        printf '\n'
    fi
}

write_atomic() {
    local path="$1"
    local content="$2"
    mkdir -p "$(dirname "$path")"
    local tmp
    tmp="$(mktemp "${path}.XXXXXX")"
    printf '%s' "$content" >"$tmp"
    mv "$tmp" "$path"
}

case "$SUBCOMMAND" in
init)
    if [[ -z "$SLUG" ]]; then
        printf 'codegen-log init: --slug is required\n' >&2
        usage
    fi
    if [[ ! "$SLUG" =~ ^[a-z0-9_-]+$ ]]; then
        printf 'codegen-log init: --slug must match [a-z0-9_-]+ (got %q)\n' "$SLUG" >&2
        exit 2
    fi
    root="$(repo_root)"
    existing=()
    for candidate in "$root"/codegen/logging/*_"${SLUG}"_session.md; do
        [[ -e "$candidate" ]] || continue
        existing+=("$candidate")
    done
    if [[ "${#existing[@]}" -eq 1 ]]; then
        write_active_sentinel "${existing[0]}"
        printf '%s\n' "${existing[0]}"
        exit 0
    fi
    if [[ "${#existing[@]}" -gt 1 ]]; then
        printf 'codegen-log init: ambiguous slug %s: %d logs match\n' "$SLUG" "${#existing[@]}" >&2
        printf '%s\n' "${existing[@]}" >&2
        exit 2
    fi
    timestamp="$(date -u +%Y%m%d_%H%M%S)"
    path="$root/codegen/logging/${timestamp}_${SLUG}_session.md"
    write_atomic "$path" "$(version_stamp)"
    write_active_sentinel "$path"
    printf '%s\n' "$path"
    ;;
section)
    # Implicit stdin: --body is optional. Omitted -> read stdin (same as @-).
    [[ -z "$BODY_SOURCE" ]] && BODY_SOURCE="@-"
    if [[ "$BODY_SOURCE" != @* ]]; then
        printf 'codegen-log section: --body must start with @ (got %q)\n' "$BODY_SOURCE" >&2
        exit 2
    fi
    if [[ "$BODY_SOURCE" != @- ]]; then
        body_path="${BODY_SOURCE#@}"
        if [[ ! -f "$body_path" ]]; then
            printf 'codegen-log section: body file not found: %s\n' "$body_path" >&2
            exit 2
        fi
        body="$(cat "$body_path")"
    else
        body="$(cat)"
    fi

    body_file="$(mktemp "${TMPDIR:-/tmp}/.codegen-log-body.XXXXXX")"
    printf '%s' "$body" >"$body_file"

    log_file="$(resolve_log_file)"
    if [[ -z "$log_file" || ! -f "$log_file" ]]; then
        printf 'codegen-log section: no session log found (set CODEGEN_LOG_PATH or create one first)\n' >&2
        exit 2
    fi

    target_header="$(section_header_for_agent)"
    case "$body" in
    "$target_header"$'\n'*)
        body="${body#"$target_header"}"
        while [[ "$body" == $'\n'* ]]; do
            body="${body#$'\n'}"
        done
        ;;
    esac
    # Opaque-body ingest: indent any stray col-0 "## " (H2) line in the author
    # body so it can never be parsed as a canonical section header by the
    # awk inserter below or by downstream col-0-anchored reader hooks.
    # Deliberately narrow to "^## " (H2 + trailing space) — H3 retro/death
    # markers and H1 titles are untouched.
    body="$(printf '%s' "$body" | sed 's/^## /  ## /')"
    printf '%s' "$body" >"$body_file"

    target_rank="$(rank_of "$target_header")"
    tmp="$(mktemp "${log_file}.XXXXXX")"

    awk -v target="$target_header" -v body_file="$body_file" -v target_rank="$target_rank" '
    function rank_of(h) {
        if (h == "## Version Stamp") return 1
        if (h ~ /^## Rules Loaded/) return 2
        if (h ~ /^## Plan/) return 3
        if (h ~ /^## Slices/) return 3
        if (h == "## Delegation Timeline") return 4
        if (h == "## Files Modified") return 5
        if (h ~ /^## developer-.* Section( \(pass [0-9]+\))?$/) return 6
        if (h ~ /^## reviewer-.* Section( \(pass [0-9]+\))?$/) return 8
        if (h == "## context-curator Section") return 9
        if (h == "## committer Section") return 10
        return 999
    }
    function is_target(h) {
        return h == target || (index(h, target " (pass ") == 1)
    }
    function emit_section(hdr, txt) {
        print hdr
        print ""
        printf "%s", txt
        if (txt == "" || substr(txt, length(txt), 1) != "\n") {
            printf "\n"
        }
    }
    BEGIN {
        inserted = 0
        replaced_target = 0
        skipping = 0
        body = ""
        while ((getline line < body_file) > 0) {
            body = body line "\n"
        }
        close(body_file)
    }
    {
        if ($0 ~ /^## /) {
            if (!inserted && rank_of($0) > target_rank) {
                emit_section(target, body)
                inserted = 1
            }
            if (is_target($0)) {
                if (!replaced_target) {
                    emit_section(target, body)
                    inserted = 1
                    replaced_target = 1
                }
                skipping = 1
                next
            }
            if (skipping) {
                skipping = 0
            }
            print $0
            next
        }
        if (skipping) {
            next
        }
        print $0
    }
    END {
        if (!inserted) {
            emit_section(target, body)
        }
    }
    ' "$log_file" >"$tmp"

    rm -f "$body_file"
    mv "$tmp" "$log_file"
    printf '%s\n' "$log_file"
    ;;
append)
    if [[ -z "$ROLE_OVERRIDE" ]]; then
        printf 'codegen-log append: role is required (positional: codegen-log append <role>, or --role <role>)\n' >&2
        usage
    fi
    # Implicit stdin: --body is optional when no marker flag is given.
    if [[ "$MARKER_FLAG_COUNT" -eq 0 && -z "$BODY_SOURCE" ]]; then
        BODY_SOURCE="@-"
    fi
    if [[ "$MARKER_FLAG_COUNT" -gt 0 ]]; then
        body="$(build_marker_body)"
    elif [[ "$BODY_SOURCE" != @* ]]; then
        printf 'codegen-log append: --body must start with @ (got %q)\n' "$BODY_SOURCE" >&2
        exit 2
    elif [[ "$BODY_SOURCE" != @- ]]; then
        body_path="${BODY_SOURCE#@}"
        if [[ ! -f "$body_path" ]]; then
            printf 'codegen-log append: body file not found: %s\n' "$body_path" >&2
            exit 2
        fi
        body="$(cat "$body_path")"
    else
        body="$(cat)"
    fi

    # Opaque-body ingest: indent any stray col-0 "## " (H2) line in the author
    # body so it can never be parsed as a canonical section header — same
    # transform as the `section` path (parallel-cases: same family, same fix).
    # Marker bodies are tool-generated and never contain a stray H2, but the
    # transform is idempotent/harmless to apply uniformly.
    body="$(printf '%s' "$body" | sed 's/^## /  ## /')"

    body_file="$(mktemp "${TMPDIR:-/tmp}/.codegen-log-append-body.XXXXXX")"
    printf '%s' "$body" >"$body_file"

    log_file="$(resolve_log_file)"
    if [[ -z "$log_file" || ! -f "$log_file" ]]; then
        printf 'codegen-log append: no session log found (set CODEGEN_LOG_PATH or create one first)\n' >&2
        exit 2
    fi

    target_header="$(section_header_for_agent)"
    tmp="$(mktemp "${log_file}.XXXXXX")"

    awk -v target="$target_header" -v body_file="$body_file" '
    function is_target(h) {
        return h == target || (index(h, target " (pass ") == 1)
    }
    BEGIN {
        found = 0
        in_target = 0
        appended = 0
        body = ""
        while ((getline line < body_file) > 0) {
            body = body line "\n"
        }
        close(body_file)
    }
    {
        if ($0 ~ /^## /) {
            if (in_target && !appended) {
                printf "%s", body
                appended = 1
            }
            in_target = is_target($0)
            if (in_target) {
                found = 1
            }
            print $0
            next
        }
        print $0
    }
    END {
        if (in_target && !appended) {
            printf "%s", body
            appended = 1
        }
        if (!found) {
            exit 3
        }
    }
    ' "$log_file" >"$tmp" || awk_rc=$?
    awk_rc="${awk_rc:-0}"

    if [[ "$awk_rc" -eq 3 ]]; then
        rm -f "$body_file" "$tmp"
        printf 'codegen-log append: section not found: %s — run '"'"'codegen-log section --role <role> --body @-'"'"' to create the section first\n' "$target_header" >&2
        exit 2
    fi

    rm -f "$body_file"
    mv "$tmp" "$log_file"
    printf '%s\n' "$log_file"
    ;;
relocate)
    if [[ -z "$NEW_SLUG" ]]; then
        printf 'codegen-log relocate: --new-slug is required\n' >&2
        usage
    fi
    if [[ ! "$NEW_SLUG" =~ ^[a-z0-9_-]+$ ]]; then
        printf 'codegen-log relocate: --new-slug must match [a-z0-9_-]+ (got %q)\n' "$NEW_SLUG" >&2
        exit 2
    fi
    log_file="$(resolve_log_file)"
    if [[ -z "$log_file" || ! -f "$log_file" ]]; then
        printf 'codegen-log relocate: no session log found (set CODEGEN_LOG_PATH or create one first)\n' >&2
        exit 2
    fi
    log_dir="$(dirname "$log_file")"
    log_base="$(basename "$log_file")"
    # Preserve the timestamp + kind suffix (session|stepN_slug), swap the slug.
    case "$log_base" in
    [0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]_[0-9][0-9][0-9][0-9][0-9][0-9]_*)
        timestamp_prefix="${log_base:0:15}"
        rest="${log_base:16}"
        # rest is "<old-slug>_<kind_suffix>"; kind_suffix is either
        # "session.md" or "step[0-9]+_[a-z0-9_-]+.md" — the slug itself may
        # contain "_-", so derive kind_suffix by matching the known kind
        # shapes from the tail of $rest rather than naive splitting.
        case "$rest" in
        *_session.md) kind_suffix="session.md" ;;
        *)
            kind_suffix="$(printf '%s' "$rest" | grep -oE 'step[0-9]+_[a-z0-9_-]+\.md$' || true)"
            ;;
        esac
        if [[ -z "$kind_suffix" ]]; then
            printf 'codegen-log relocate: could not parse log filename: %s\n' "$log_base" >&2
            exit 2
        fi
        ;;
    *)
        printf 'codegen-log relocate: could not parse log filename: %s\n' "$log_base" >&2
        exit 2
        ;;
    esac
    new_path="$log_dir/${timestamp_prefix}_${NEW_SLUG}_${kind_suffix}"
    if [[ -e "$new_path" ]]; then
        printf 'codegen-log relocate: target already exists: %s\n' "$new_path" >&2
        exit 2
    fi
    mv "$log_file" "$new_path"
    write_active_sentinel "$new_path"
    printf '%s\n' "$new_path"
    ;;
verdict)
    if [[ -z "$GATE_CMD" ]]; then
        printf 'codegen-log verdict: --gate is required\n' >&2
        usage
    fi
    if [[ -z "$GATE_MODE" ]]; then
        printf 'codegen-log verdict: --mode is required\n' >&2
        usage
    fi
    if [[ -z "$RESULT_TEXT" ]]; then
        printf 'codegen-log verdict: --result is required\n' >&2
        usage
    fi
    log_file="$(resolve_log_file)"
    if [[ -z "$log_file" || ! -f "$log_file" ]]; then
        printf 'codegen-log verdict: no session log found (set CODEGEN_LOG_PATH or create one first)\n' >&2
        exit 2
    fi
    ts="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    {
        printf '\n## dev-gate Section\n\n'
        printf 'Gate: %s\n' "$GATE_CMD"
        printf 'Ran: %s\n\n' "$GATE_CMD"
        printf '**Rules loaded**: deterministic hook (dev-gate.sh) — no rules loaded\n\n'
        printf '**Commands executed**:\n\n'
        printf '| Time (HH:MM:SS UTC) | Command | Exit | Notes |\n'
        printf '| ------------------- | ------- | ---- | ----- |\n'
        printf '| %s | %s | — | mode=%s |\n\n' "$ts" "$GATE_CMD" "$GATE_MODE"
        printf '**Result**: %s\n' "$RESULT_TEXT"
        if [[ -n "$DETAIL_TEXT" ]]; then
            printf '\n%s\n' "$DETAIL_TEXT"
        fi
    } >>"$log_file"
    printf '%s\n' "$log_file"
    ;;
esac
