#!/usr/bin/env bash
# codegen-log — canonical session-log writer.
#
# Usage:
#   codegen-log init --slug <slug>
#   codegen-log section --body @- [--role <role>] [--slug <slug>]
#   codegen-log append --role <role> --body @- [--slug <slug>]
#
# init: create a new codegen/logging/<ts>_<slug>_session.md with only the
#       Version Stamp block. Idempotent: re-running init with a slug that
#       already has a matching log prints that log's path and exits 0
#       WITHOUT creating a second log; more than one match is ambiguous
#       and exits 2.
# section: atomically insert/replace the active role section at canonical rank.
#          --role overrides AGENT_TYPE/CLAUDE_ROLE-derived header when present.
#          REPLACES the whole section body (first/only write for the section).
# append: insert the piped body at the END of an EXISTING section's body
#         (before the next "## " header or EOF), PRESERVING the prior body.
#         Never creates a section — exits 2 if the target section is missing.
#         Use for a SECOND write to the same section this cycle (re-run,
#         death marker) — never use `section` for that, it would overwrite.
#
# Target-log resolution (section/append), in precedence order:
#   1. CODEGEN_LOG_PATH env var, if set.
#   2. --slug <slug>, if given — resolves to the single log on disk matching
#      *_<slug>_session.md; zero or multiple matches exit 2.
#   3. Otherwise, the most recently modified *_session.md (latest_session_log).

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
if [[ ! -d "$SCRIPT_DIR/codegen" && -n "${OCG_CODEGEN_DIR:-}" ]]; then
    SCRIPT_DIR="$OCG_CODEGEN_DIR"
fi

CODEGEN_ROOT="$SCRIPT_DIR"
LOG_ROOT="${CODEGEN_BUILD_CWD:-${CLAUDE_PROJECT_DIR:-$PWD}}"

SUBCOMMAND=""
SLUG=""
BODY_SOURCE=""
ROLE_OVERRIDE=""

usage() {
    printf 'Usage:\n' >&2
    printf '  codegen-log init --slug <slug>\n' >&2
    printf '  codegen-log section --body @- [--role <role>] [--slug <slug>]\n' >&2
    printf '  codegen-log append --role <role> --body @- [--slug <slug>]\n' >&2
    printf '\n' >&2
    printf "section REPLACES the whole section body (first/only write); append PRESERVES it and adds to the end (re-run, second write, death marker).\n" >&2
    exit 2
}

while [[ $# -gt 0 ]]; do
    case "$1" in
    init | section | append)
        if [[ -n "$SUBCOMMAND" ]]; then
            printf 'codegen-log: only one subcommand is allowed\n' >&2
            usage
        fi
        SUBCOMMAND="$1"
        shift
        ;;
    --slug=*)
        SLUG="${1#--slug=}"
        shift
        ;;
    --slug)
        SLUG="$2"
        shift 2
        ;;
    --body=*)
        BODY_SOURCE="${1#--body=}"
        shift
        ;;
    --body)
        BODY_SOURCE="$2"
        shift 2
        ;;
    --role=*)
        ROLE_OVERRIDE="${1#--role=}"
        shift
        ;;
    --role)
        ROLE_OVERRIDE="$2"
        shift 2
        ;;
    --help | -h)
        usage
        ;;
    --*)
        printf 'codegen-log: unknown flag %q\n' "$1" >&2
        usage
        ;;
    *)
        printf 'codegen-log: unexpected argument %q\n' "$1" >&2
        usage
        ;;
    esac
done

if [[ -z "$SUBCOMMAND" ]]; then
    usage
fi

repo_root() {
    printf '%s' "$LOG_ROOT"
}

latest_session_log() {
    local root latest candidate
    root="$(repo_root)"
    latest=""
    for candidate in "$root"/codegen/logging/*_session.md; do
        [[ -e "$candidate" ]] || continue
        latest="$candidate"
    done
    printf '%s' "$latest"
}

validate_slug() {
    local slug="$1"
    if [[ ! "$slug" =~ ^[a-z0-9_-]+$ ]]; then
        printf 'codegen-log: --slug must match [a-z0-9_-]+ (got %q)\n' "$slug" >&2
        exit 2
    fi
}

resolve_by_slug() {
    local slug="$1"
    local root matches=() candidate
    root="$(repo_root)"
    for candidate in "$root"/codegen/logging/*_"${slug}"_session.md; do
        [[ -e "$candidate" ]] || continue
        matches+=("$candidate")
    done
    if [[ "${#matches[@]}" -eq 0 ]]; then
        printf 'codegen-log: no session log matches slug %s\n' "$slug" >&2
        exit 2
    fi
    if [[ "${#matches[@]}" -gt 1 ]]; then
        printf 'codegen-log: ambiguous slug %s: %d logs match\n' "$slug" "${#matches[@]}" >&2
        printf '%s\n' "${matches[@]}" >&2
        exit 2
    fi
    printf '%s' "${matches[0]}"
}

resolve_log_file() {
    if [[ -n "${CODEGEN_LOG_PATH:-}" ]]; then
        printf '%s' "$CODEGEN_LOG_PATH"
        return
    fi
    if [[ -n "$SLUG" ]]; then
        validate_slug "$SLUG"
        resolve_by_slug "$SLUG"
        return
    fi
    latest_session_log
}

version_stamp() {
    local project_hash context_hash codegen_hash claude_version stamped_at
    project_hash="$(git -C "$LOG_ROOT" rev-parse --short HEAD 2>/dev/null || printf 'unknown')"
    context_hash="$(git -C "$CODEGEN_ROOT/codegen/rules" rev-parse --short HEAD 2>/dev/null || printf 'unknown')"
    codegen_hash="$(git -C "$CODEGEN_ROOT" rev-parse --short HEAD 2>/dev/null || printf 'unknown')"
    if command -v claude >/dev/null 2>&1; then
        claude_version="$(claude --version 2>/dev/null || printf 'unknown')"
    elif command -v pi >/dev/null 2>&1; then
        claude_version="$(pi --version 2>/dev/null || printf 'unknown')"
    else
        claude_version="unknown"
    fi
    stamped_at="$(date -u +%Y-%m-%dT%H:%M:%SZ)"
    cat <<EOF
## Version Stamp

- project: $project_hash
- context: $context_hash
- codegen: $codegen_hash
- claude: $claude_version
- stamped_at: $stamped_at
EOF
}

section_header_for_agent() {
    local role="${ROLE_OVERRIDE:-${AGENT_TYPE:-${CLAUDE_ROLE:-}}}"
    case "$role" in
    planner*) printf '## Plan' ;;
    developer-*) printf '## %s Section' "$role" ;;
    reviewer-*) printf '## %s Section' "$role" ;;
    context-curator) printf '## context-curator Section' ;;
    committer) printf '## committer Section' ;;
    *)
        printf 'codegen-log: unsupported role %q\n' "${role:-unknown}" >&2
        exit 2
        ;;
    esac
}

rank_of() {
    case "$1" in
    '## Version Stamp') printf '1' ;;
    '## Rules Loaded'*) printf '2' ;;
    '## Plan'*) printf '3' ;;
    '## Slices'*) printf '3' ;;
    '## Delegation Timeline') printf '4' ;;
    '## Files Modified') printf '5' ;;
    '## developer-'*' Section'*) printf '6' ;;
    '## reviewer-'*' Section'*) printf '8' ;;
    '## context-curator Section') printf '9' ;;
    '## committer Section') printf '10' ;;
    *) printf '999' ;;
    esac
}

render_section() {
    local header="$1"
    local body="$2"
    printf '%s\n\n%s' "$header" "$body"
    if [[ -z "$body" || "${body: -1}" != $'\n' ]]; then
        printf '\n'
    fi
}

write_atomic() {
    local path="$1"
    local content="$2"
    mkdir -p "$(dirname "$path")"
    local tmp
    tmp="$(mktemp "${path}.XXXXXX")"
    printf '%s' "$content" >"$tmp"
    mv "$tmp" "$path"
}

case "$SUBCOMMAND" in
init)
    if [[ -z "$SLUG" ]]; then
        printf 'codegen-log init: --slug is required\n' >&2
        usage
    fi
    if [[ ! "$SLUG" =~ ^[a-z0-9_-]+$ ]]; then
        printf 'codegen-log init: --slug must match [a-z0-9_-]+ (got %q)\n' "$SLUG" >&2
        exit 2
    fi
    root="$(repo_root)"
    existing=()
    for candidate in "$root"/codegen/logging/*_"${SLUG}"_session.md; do
        [[ -e "$candidate" ]] || continue
        existing+=("$candidate")
    done
    if [[ "${#existing[@]}" -eq 1 ]]; then
        printf '%s\n' "${existing[0]}"
        exit 0
    fi
    if [[ "${#existing[@]}" -gt 1 ]]; then
        printf 'codegen-log init: ambiguous slug %s: %d logs match\n' "$SLUG" "${#existing[@]}" >&2
        printf '%s\n' "${existing[@]}" >&2
        exit 2
    fi
    timestamp="$(date -u +%Y%m%d_%H%M%S)"
    path="$root/codegen/logging/${timestamp}_${SLUG}_session.md"
    write_atomic "$path" "$(version_stamp)"
    printf '%s\n' "$path"
    ;;
section)
    if [[ "$BODY_SOURCE" != @* ]]; then
        printf 'codegen-log section: --body must start with @ (got %q)\n' "$BODY_SOURCE" >&2
        exit 2
    fi
    if [[ "$BODY_SOURCE" != @- ]]; then
        body_path="${BODY_SOURCE#@}"
        if [[ ! -f "$body_path" ]]; then
            printf 'codegen-log section: body file not found: %s\n' "$body_path" >&2
            exit 2
        fi
        body="$(cat "$body_path")"
    else
        body="$(cat)"
    fi

    body_file="$(mktemp "${TMPDIR:-/tmp}/.codegen-log-body.XXXXXX")"
    printf '%s' "$body" >"$body_file"

    log_file="$(resolve_log_file)"
    if [[ -z "$log_file" || ! -f "$log_file" ]]; then
        printf 'codegen-log section: no session log found (set CODEGEN_LOG_PATH or create one first)\n' >&2
        exit 2
    fi

    target_header="$(section_header_for_agent)"
    case "$body" in
    "$target_header"$'\n'*)
        body="${body#"$target_header"}"
        while [[ "$body" == $'\n'* ]]; do
            body="${body#$'\n'}"
        done
        ;;
    esac
    printf '%s' "$body" >"$body_file"

    target_rank="$(rank_of "$target_header")"
    tmp="$(mktemp "${log_file}.XXXXXX")"

    awk -v target="$target_header" -v body_file="$body_file" -v target_rank="$target_rank" '
    function rank_of(h) {
        if (h == "## Version Stamp") return 1
        if (h ~ /^## Rules Loaded/) return 2
        if (h ~ /^## Plan/) return 3
        if (h ~ /^## Slices/) return 3
        if (h == "## Delegation Timeline") return 4
        if (h == "## Files Modified") return 5
        if (h ~ /^## developer-.* Section( \(pass [0-9]+\))?$/) return 6
        if (h ~ /^## reviewer-.* Section( \(pass [0-9]+\))?$/) return 8
        if (h == "## context-curator Section") return 9
        if (h == "## committer Section") return 10
        return 999
    }
    function is_target(h) {
        return h == target || (index(h, target " (pass ") == 1)
    }
    function emit_section(hdr, txt) {
        print hdr
        print ""
        printf "%s", txt
        if (txt == "" || substr(txt, length(txt), 1) != "\n") {
            printf "\n"
        }
    }
    BEGIN {
        inserted = 0
        replaced_target = 0
        skipping = 0
        body = ""
        while ((getline line < body_file) > 0) {
            body = body line "\n"
        }
        close(body_file)
    }
    {
        if ($0 ~ /^## /) {
            if (!inserted && rank_of($0) > target_rank) {
                emit_section(target, body)
                inserted = 1
            }
            if (is_target($0)) {
                if (!replaced_target) {
                    emit_section(target, body)
                    inserted = 1
                    replaced_target = 1
                }
                skipping = 1
                next
            }
            if (skipping) {
                skipping = 0
            }
            print $0
            next
        }
        if (skipping) {
            next
        }
        print $0
    }
    END {
        if (!inserted) {
            emit_section(target, body)
        }
    }
    ' "$log_file" >"$tmp"

    rm -f "$body_file"
    mv "$tmp" "$log_file"
    printf '%s\n' "$log_file"
    ;;
append)
    if [[ -z "$ROLE_OVERRIDE" ]]; then
        printf 'codegen-log append: --role is required\n' >&2
        usage
    fi
    if [[ "$BODY_SOURCE" != @* ]]; then
        printf 'codegen-log append: --body must start with @ (got %q)\n' "$BODY_SOURCE" >&2
        exit 2
    fi
    if [[ "$BODY_SOURCE" != @- ]]; then
        body_path="${BODY_SOURCE#@}"
        if [[ ! -f "$body_path" ]]; then
            printf 'codegen-log append: body file not found: %s\n' "$body_path" >&2
            exit 2
        fi
        body="$(cat "$body_path")"
    else
        body="$(cat)"
    fi

    body_file="$(mktemp "${TMPDIR:-/tmp}/.codegen-log-append-body.XXXXXX")"
    printf '%s' "$body" >"$body_file"

    log_file="$(resolve_log_file)"
    if [[ -z "$log_file" || ! -f "$log_file" ]]; then
        printf 'codegen-log append: no session log found (set CODEGEN_LOG_PATH or create one first)\n' >&2
        exit 2
    fi

    target_header="$(section_header_for_agent)"
    tmp="$(mktemp "${log_file}.XXXXXX")"

    awk -v target="$target_header" -v body_file="$body_file" '
    function is_target(h) {
        return h == target || (index(h, target " (pass ") == 1)
    }
    BEGIN {
        found = 0
        in_target = 0
        appended = 0
        body = ""
        while ((getline line < body_file) > 0) {
            body = body line "\n"
        }
        close(body_file)
    }
    {
        if ($0 ~ /^## /) {
            if (in_target && !appended) {
                printf "%s", body
                appended = 1
            }
            in_target = is_target($0)
            if (in_target) {
                found = 1
            }
            print $0
            next
        }
        print $0
    }
    END {
        if (in_target && !appended) {
            printf "%s", body
            appended = 1
        }
        if (!found) {
            exit 3
        }
    }
    ' "$log_file" >"$tmp" || awk_rc=$?
    awk_rc="${awk_rc:-0}"

    if [[ "$awk_rc" -eq 3 ]]; then
        rm -f "$body_file" "$tmp"
        printf 'codegen-log append: section not found: %s — run '"'"'codegen-log section --role <role> --body @-'"'"' to create the section first\n' "$target_header" >&2
        exit 2
    fi

    rm -f "$body_file"
    mv "$tmp" "$log_file"
    printf '%s\n' "$log_file"
    ;;
esac
