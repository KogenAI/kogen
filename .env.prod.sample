# Test harness diagnostics file (optional)
# When set, writes raw output from each codegen-build invocation.
# The {N} placeholder is replaced with invocation count (1, 2, ...).
DIAGNOSTICS_FILE=

# Keep temp directories created by isolated_tmp_dir (optional)
# Set to "1" to preserve temporary test fixtures for inspection.
KEEP_TMP=

# Consumer-supplied build-worker confinement roots (required in prod for enforcement).
# Set by the consuming platform when invoking the build worker.
# Codegen hooks treat an unknown boundary (unset) as "not a managed build worker"
# and allow all orchestrator I/O — set these in prod to enforce confinement.
OCG_APPS_ROOT=
OCG_PHOENIX_SEED_DIR=
OCG_USER_FILES_DIR=

# Claude investigative mode headless flag (optional).
# Set to "1" to enable one-shot headless mode in shape/refactor/ops/debug launchers.
# Builds 7-flag headless suite (--print, --verbose, --output-format stream-json, etc).
CLAUDE_NONINTERACTIVE=

# Operator toggles for multi-pitch queue draining (optional, build-time).
# CODEGEN_BUILD_QUEUE_MAX_RETRIES: max retry attempts per pitch on transient failure (default 3).
# CODEGEN_BUILD_QUEUE_RETRY_DELAYS: space-separated backoff delays in seconds (default "30 120 300").
# CODEGEN_BUILD_QUEUE_PITCH_BUDGET_SECS: wall-clock timeout per pitch in seconds (default 3600).
# Set via operator environment when invoking claude-build --queue or pi-build --queue.
CODEGEN_BUILD_QUEUE_MAX_RETRIES=
CODEGEN_BUILD_QUEUE_RETRY_DELAYS=
CODEGEN_BUILD_QUEUE_PITCH_BUDGET_SECS=

# Test harness internal variables (not user-facing).
# HARNESS: selected harness name ("claude" or "pi"); set by test fixtures.
HARNESS=
OCG_CODEGEN_DIR=

# PATH (passthrough, not a new operator toggle).
# loop_queue_drain.ex reads the ambient PATH via System.get_env("PATH") and
# forwards it into the spawned child's Port.open :env option so the child
# process can resolve executables. Not settable here — inherited from the
# invoking shell.
