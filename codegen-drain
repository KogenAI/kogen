#!/usr/bin/env bash
# codegen-drain — possession-mover between fleet nodes draining codegen/pitches/ready/.
#
# Possession is the claim: dispatch is `mv` (transfer, then delete the source),
# never `cp`. Exactly one copy of a pitch exists across the fleet at any time —
# two nodes can never build the same pitch, not by policy, by physics.
#
# Usage:
#   codegen-drain assign --slug=<slug> --node=<node> [--cwd=<dir>]
#   codegen-drain status [--json] [--cwd=<dir>]
#   codegen-drain init [--cwd=<dir>]
#
# Subcommands:
#   assign    Move a pitch from THIS box's ready/ into <node>'s ready/. Ack
#             (checksum-verified same-fs mv on the far side) BEFORE deleting
#             the local copy. Refuses (fail-closed) on any doubt.
#   status    ssh every configured node and print which pitches/build state
#             each holds — restores the queue visibility single-copy costs.
#   init      Interactively write codegen/drain-nodes.yaml (gitignored,
#             machine-local fleet inventory).
#
# Options (assign):
#   --slug=<slug>   required: must exist at codegen/pitches/ready/<slug>.md locally
#   --node=<node>   required: must be a key in codegen/drain-nodes.yaml
#
# Options (status):
#   --json          emit machine-readable JSON instead of table text
#
# Options (all subcommands):
#   --cwd=<dir>     codegen repo root (default: $PWD) — codegen-drain is
#                    installed as a FLAT copy (no sibling codegen/ tree), so
#                    it must never derive the repo root from its own install
#                    location; mirrors codegen-build's --cwd contract.
#
# Exit codes: 0 = success, 1 = runtime error, 2 = usage/config error.

set -euo pipefail

CWD="$PWD"

usage() {
    printf 'Usage:\n' >&2
    printf '  codegen-drain assign --slug=<slug> --node=<node> [--cwd=<dir>]\n' >&2
    printf '  codegen-drain status [--json] [--cwd=<dir>]\n' >&2
    printf '  codegen-drain init [--cwd=<dir>]\n' >&2
    exit 2
}

# strip_cwd_flag <argv...> — scans args for --cwd=<dir>/--cwd <dir> BEFORE
# subcommand-specific parsing runs, so every subcommand shares one resolution
# path. Sets global CWD and the global STRIPPED_ARGS array as side effects.
# MUST run in the current shell (no process substitution / subshell) — CWD
# is a plain assignment, and a subshell would mutate only its own copy,
# leaving the parent's CWD (and therefore INVENTORY) unresolved.
STRIPPED_ARGS=()
strip_cwd_flag() {
    STRIPPED_ARGS=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
        --cwd=*)
            CWD="${1#--cwd=}"
            shift
            ;;
        --cwd)
            CWD="$2"
            shift 2
            ;;
        *)
            STRIPPED_ARGS+=("$1")
            shift
            ;;
        esac
    done
}

require_yq() {
    if ! command -v yq >/dev/null 2>&1; then
        printf 'codegen-drain: yq required but not found — install mikefarah/yq\n' >&2
        exit 2
    fi
    if ! yq --version 2>&1 | grep -qi mikefarah; then
        printf 'codegen-drain: installed yq is not mikefarah/yq (apt python-yq is incompatible)\n' >&2
        exit 2
    fi
}

require_inventory() {
    if [[ ! -f "$INVENTORY" ]]; then
        printf 'codegen-drain: no inventory at %s — run `codegen-drain init` first\n' "$INVENTORY" >&2
        exit 2
    fi
}

# node_field <node> <field> — empty string if absent (never fails, tolerates
# a node record with no optional field).
node_field() {
    local node="$1" field="$2"
    yq -r ".nodes[] | select(.name == \"$node\") | .${field} // \"\"" "$INVENTORY"
}

node_exists() {
    local node="$1"
    local hit
    hit="$(yq -r ".nodes[] | select(.name == \"$node\") | .name" "$INVENTORY" 2>/dev/null || true)"
    [[ -n "$hit" ]]
}

# watcher_probe_cmd <repo> — emits a self-contained shell snippet (string)
# that resolves whether <repo> is under queue supervision, by reading the
# single-flight lock BuildLock already writes at
# codegen/gate-pending/queue.lock — NEVER by scanning argv (a process-list
# grep over commandlines matches any process whose argv happens to quote
# the search pattern,
# including a solo `mix codegen.loop --cwd=<repo>` build, or the very agent
# asking the question). Prints "yes" iff the lock names label "queue" AND
# the recorded pid is alive (`kill -0`); "no" on any other state (absent,
# unreadable, malformed, dead pid, or label "solo" — a single build is not
# a watcher). One predicate, textually shared by both the local and remote
# legs of cmd_status, so there is exactly one place this logic can drift.
watcher_probe_cmd() {
    local repo="$1"
    printf 'lockf=%q; if [ -f "$lockf" ]; then read -r wpid wlabel _rest <"$lockf" 2>/dev/null; if [ "$wlabel" = "queue" ] && kill -0 "$wpid" 2>/dev/null; then echo yes; else echo no; fi; else echo no; fi' \
        "$repo/codegen/gate-pending/queue.lock"
}

# remote_run <host> <run_as> <shell-command>
# Wraps in `su - <run_as> -c '...'` when run_as is set (root-landing ssh
# hosts); plain ssh exec otherwise (ssh user already owns the repo).
remote_run() {
    local host="$1" run_as="$2" cmd="$3"
    if [[ -n "$run_as" ]]; then
        ssh -o ConnectTimeout=10 "$host" "su - $run_as -c $(printf '%q' "$cmd")"
    else
        ssh -o ConnectTimeout=10 "$host" "$cmd"
    fi
}

cmd_assign() {
    local slug="" node=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
        --slug=*)
            slug="${1#--slug=}"
            shift
            ;;
        --slug)
            slug="$2"
            shift 2
            ;;
        --node=*)
            node="${1#--node=}"
            shift
            ;;
        --node)
            node="$2"
            shift 2
            ;;
        *)
            printf 'codegen-drain assign: unknown option %q\n' "$1" >&2
            usage
            ;;
        esac
    done

    [[ -n "$slug" ]] || {
        printf 'codegen-drain assign: --slug required\n' >&2
        usage
    }
    [[ -n "$node" ]] || {
        printf 'codegen-drain assign: --node required\n' >&2
        usage
    }

    require_yq
    require_inventory

    local local_path="$CWD/codegen/pitches/ready/${slug}.md"
    if [[ ! -f "$local_path" ]]; then
        printf 'codegen-drain: %s not in ready/ — run `codegen-drain status` to find which node holds it\n' "$slug" >&2
        exit 1
    fi

    if ! node_exists "$node"; then
        printf 'codegen-drain: unknown node %q — valid nodes:\n' "$node" >&2
        yq -r '.nodes[].name' "$INVENTORY" >&2
        exit 2
    fi

    local host repo run_as
    host="$(node_field "$node" host)"
    repo="$(node_field "$node" repo)"
    run_as="$(node_field "$node" run_as)"

    [[ -n "$repo" ]] || {
        printf 'codegen-drain: node %q has no repo path in inventory\n' "$node" >&2
        exit 2
    }

    # local node (no host) — same-filesystem mv, no ssh needed
    if [[ -z "$host" ]]; then
        local dest_dir="$repo/codegen/pitches/ready"
        local dest="$dest_dir/${slug}.md"
        if [[ -f "$dest" ]]; then
            printf 'codegen-drain: %s already exists at node %q — refusing (possession ambiguous)\n' "$dest" "$node" >&2
            exit 1
        fi
        mkdir -p "$dest_dir"
        mv "$local_path" "$dest"
        printf 'assigned %s -> %s (local copy moved)\n' "$slug" "$node"
        return 0
    fi

    # Refuse if destination already holds it (resurrection guard).
    local existing
    existing="$(remote_run "$host" "$run_as" "test -f '$repo/codegen/pitches/ready/${slug}.md' && echo yes || echo no" 2>/dev/null || echo no)"
    if [[ "$existing" == "yes" ]]; then
        printf 'codegen-drain: %s already exists in %s:ready/ — refusing (possession ambiguous)\n' "$slug" "$node" >&2
        exit 1
    fi

    # Stage via /tmp (root-safe hop), install with correct ownership into
    # .incoming/, verify checksum, then atomic same-fs mv into ready/.
    local tmp_remote="/tmp/${slug}.md"
    if ! scp -o ConnectTimeout=10 "$local_path" "${host}:${tmp_remote}" >/dev/null; then
        printf 'codegen-drain: scp to %s failed — local copy kept\n' "$node" >&2
        exit 1
    fi

    local incoming_dir="$repo/codegen/pitches/.incoming"
    local incoming_path="$incoming_dir/${slug}.md"

    if [[ -n "$run_as" ]]; then
        if ! ssh -o ConnectTimeout=10 "$host" "install -d -o $run_as -g $run_as -m 755 '$incoming_dir' && install -o $run_as -g $run_as -m 644 '$tmp_remote' '$incoming_path' && rm -f '$tmp_remote'"; then
            printf 'codegen-drain: install(1) on %s failed — local copy kept; stale bytes may remain at %s:%s\n' "$node" "$node" "$tmp_remote" >&2
            exit 1
        fi
    else
        if ! ssh -o ConnectTimeout=10 "$host" "mkdir -p '$incoming_dir' && mv '$tmp_remote' '$incoming_path'"; then
            printf 'codegen-drain: staging on %s failed — local copy kept\n' "$node" >&2
            exit 1
        fi
    fi

    local local_sum remote_sum
    local_sum="$(shasum "$local_path" | awk '{print $1}')"
    remote_sum="$(remote_run "$host" "$run_as" "shasum '$incoming_path' 2>/dev/null | awk '{print \$1}'" 2>/dev/null || true)"

    if [[ -z "$remote_sum" || "$local_sum" != "$remote_sum" ]]; then
        printf 'codegen-drain: transfer verify FAILED — %s kept locally; stale copy left at %s:%s for inspection\n' "$slug" "$node" "$incoming_path" >&2
        exit 1
    fi

    if ! remote_run "$host" "$run_as" "mv '$incoming_path' '$repo/codegen/pitches/ready/${slug}.md'"; then
        printf 'codegen-drain: final mv on %s failed — local copy kept; verified bytes remain at %s:%s\n' "$node" "$node" "$incoming_path" >&2
        exit 1
    fi

    # Re-verify it landed before deleting the local copy.
    local landed
    landed="$(remote_run "$host" "$run_as" "test -f '$repo/codegen/pitches/ready/${slug}.md' && echo yes || echo no" 2>/dev/null || echo no)"
    if [[ "$landed" != "yes" ]]; then
        printf 'codegen-drain: could not confirm landing on %s — local copy kept for safety\n' "$node" >&2
        exit 1
    fi

    rm -f "$local_path"
    local count
    count="$(remote_run "$host" "$run_as" "find '$repo/codegen/pitches/ready' -maxdepth 1 -name '*.md' | wc -l" 2>/dev/null | tr -d '[:space:]' || echo '?')"
    printf 'assigned %s -> %s (local copy removed; %s holds %s pitches)\n' "$slug" "$node" "$node" "$count"
}

cmd_status() {
    local json=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
        --json)
            json="1"
            shift
            ;;
        *)
            printf 'codegen-drain status: unknown option %q\n' "$1" >&2
            usage
            ;;
        esac
    done

    require_yq
    require_inventory

    local names
    names="$(yq -r '.nodes[].name' "$INVENTORY")"

    [[ -n "$json" ]] && printf '['
    local first=1
    while IFS= read -r node; do
        [[ -n "$node" ]] || continue
        local host repo run_as
        host="$(node_field "$node" host)"
        repo="$(node_field "$node" repo)"
        run_as="$(node_field "$node" run_as)"

        local count="0" reachable="1" watcher="no" incoming="0"

        if [[ -z "$host" ]]; then
            if [[ -d "$repo/codegen/pitches/ready" ]]; then
                count="$(find "$repo/codegen/pitches/ready" -maxdepth 1 -name '*.md' 2>/dev/null | wc -l | tr -d '[:space:]')"
            fi
            if [[ -d "$repo/codegen/pitches/.incoming" ]]; then
                incoming="$(find "$repo/codegen/pitches/.incoming" -maxdepth 1 -name '*.md' 2>/dev/null | wc -l | tr -d '[:space:]')"
            fi
            watcher="$(bash -c "$(watcher_probe_cmd "$repo")" 2>/dev/null || echo no)"
        else
            local remote_out
            remote_out="$(remote_run "$host" "$run_as" "find '$repo/codegen/pitches/ready' -maxdepth 1 -name '*.md' 2>/dev/null | wc -l; find '$repo/codegen/pitches/.incoming' -maxdepth 1 -name '*.md' 2>/dev/null | wc -l; $(watcher_probe_cmd "$repo")" 2>/dev/null || true)"
            if [[ -z "$remote_out" ]]; then
                reachable="0"
            else
                count="$(printf '%s\n' "$remote_out" | sed -n '1p' | tr -d '[:space:]')"
                incoming="$(printf '%s\n' "$remote_out" | sed -n '2p' | tr -d '[:space:]')"
                watcher="$(printf '%s\n' "$remote_out" | sed -n '3p' | tr -d '[:space:]')"
                [[ -z "$count" ]] && count="0"
                [[ -z "$incoming" ]] && incoming="0"
                [[ -z "$watcher" ]] && watcher="no"
            fi
        fi

        if [[ -n "$json" ]]; then
            [[ $first -eq 1 ]] || printf ','
            first=0
            printf '{"node":"%s","reachable":%s,"ready_count":%s,"incoming_count":%s,"watcher":"%s"}' \
                "$node" "$([[ "$reachable" == "1" ]] && echo true || echo false)" "$count" "$incoming" "$watcher"
        else
            if [[ "$reachable" == "0" ]]; then
                printf '%-12s unreachable\n' "$node"
            else
                printf '%-12s ready=%-4s incoming=%-4s watcher=%s\n' "$node" "$count" "$incoming" "$watcher"
                if [[ "$watcher" == "no" ]]; then
                    printf '             not supervised — start with: claude-build --queue --watch\n'
                fi
            fi
        fi
    done <<<"$names"
    [[ -n "$json" ]] && printf ']\n'
    return 0
}

cmd_init() {
    mkdir -p "$(dirname "$INVENTORY")"
    if [[ -f "$INVENTORY" ]]; then
        printf 'codegen-drain init: %s already exists — edit it directly to add/remove nodes\n' "$INVENTORY" >&2
        exit 1
    fi
    cat >"$INVENTORY" <<'YAML'
# codegen/drain-nodes.yaml — fleet inventory for codegen-drain.
# Gitignored: machine-local topology, never committed.
nodes:
  - name: local
    repo: /path/to/local/codegen
YAML
    printf 'wrote %s — edit it to add remote nodes (host, repo, run_as, launch)\n' "$INVENTORY"
}

# ── Subcommand dispatch ──────────────────────────────────────────────────────
if [[ $# -eq 0 ]]; then
    printf 'codegen-drain: subcommand required (assign|status|init)\n' >&2
    usage
fi

SUBCOMMAND="$1"
shift

# Strip --cwd=<dir> / --cwd <dir> from the remaining args wherever it
# appears (mirrors codegen-build's --cwd contract); resolves CWD before any
# subcommand-specific parsing runs, then INVENTORY is derived from CWD, never
# from this script's own install location.
strip_cwd_flag "$@"
set -- "${STRIPPED_ARGS[@]+"${STRIPPED_ARGS[@]}"}"

INVENTORY="${CODEGEN_DRAIN_INVENTORY:-$CWD/codegen/drain-nodes.yaml}"

case "$SUBCOMMAND" in
assign)
    cmd_assign "$@"
    ;;
status)
    cmd_status "$@"
    ;;
init)
    cmd_init "$@"
    ;;
--*)
    printf 'codegen-drain: subcommand required (assign|status|init)\n' >&2
    usage
    ;;
*)
    printf 'codegen-drain: unknown subcommand %q (expected assign|status|init)\n' "$SUBCOMMAND" >&2
    usage
    ;;
esac
