# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where third-party dependencies like ExDoc output generated docs.
/doc/

# Temporary files, for example, from tests.
/tmp/

# If the VM crashes, it generates a dump, let's ignore it too.
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Ignore package tarball (built via "mix hex.build").
kogen-*.tar

# Kogen: release archives built by packaging/package.sh.
/dist/

# Kogen: the Go command built in place by `go build` in cli/.
/cli/kogen

# Kogen: npm dependencies of the spec checks, the acceptance suite, the example and fixtures.
node_modules/

# Go (cli/): test binaries, coverage profiles and workspace files.
/cli/*.test
/cli/*.out
/cli/coverage.*
/cli/*.coverprofile
/cli/profile.cov
/cli/go.work
/cli/go.work.sum

# Credentials and local environment settings.
.env

# Editors and the operating system.
/.elixir_ls/
.DS_Store
.kogen/local/
