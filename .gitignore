# Temporary files, for example, from tests.
/tmp/

# Kogen: release archives built by packaging/package.sh.
/dist/

# Kogen: the Go command built in place by `go build` in cli/.
/cli/kogen

# Kogen: npm dependencies of the spec checks, the acceptance suite, the example and fixtures.
node_modules/

# Go (cli/): test binaries, coverage profiles and workspace files.
/cli/*.test
/cli/*.out
/cli/coverage.*
/cli/*.coverprofile
/cli/profile.cov
/cli/go.work
/cli/go.work.sum

# Credentials and local environment settings.
.env

# Editors and the operating system.
.DS_Store
.kogen/local/

# Keep existing local build caches ignored when upgrading an Elixir checkout.
/_build/
/cover/
/deps/
/doc/
erl_crash.dump
*.ez
kogen-*.tar
/.elixir_ls/
