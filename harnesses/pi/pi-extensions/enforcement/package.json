{
  "name": "pi-enforcement",
  "version": "0.1.0",
  "description": "Pi extension: enforcement hooks ported from Claude Code hook scripts",
  "main": "dist/index.js",
  "engines": {
    "node": "24.14.0",
    "npm": "11.9.0"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p . && node scripts/emit-handlers.js",
    "test": "node --test dist/hooks/__tests__/*.test.js",
    "test:coverage": "c8 --reporter=lcov --reporter=json-summary --reporter=text --report-dir=coverage node --test dist/hooks/__tests__/*.test.js"
  },
  "dependencies": {
    "@sinclair/typebox": "^0.34.48"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "0.81.1",
    "c8": "^10.1.3",
    "typescript": "^5.0.0"
  }
}
