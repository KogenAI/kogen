{
  "name": "pi-web-utils",
  "version": "0.1.1",
  "description": "Configurable web search, markdown-first webpage fetching, GitHub local repo search tools for pi coding agent",
  "type": "module",
  "author": "Shantanu Goel <npm@shantanugoel.com>",
  "keywords": [
    "pi-package",
    "pi",
    "pi-coding-agent",
    "pi-extension",
    "extension",
    "web-search",
    "github",
    "markdown"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shantanugoel/pi-web-utils.git"
  },
  "bugs": {
    "url": "https://github.com/shantanugoel/pi-web-utils/issues"
  },
  "homepage": "https://github.com/shantanugoel/pi-web-utils#readme",
  "files": [
    "index.ts",
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "bun@1.3.9",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run",
    "test:coverage": "vitest run --coverage.enabled --coverage.provider=istanbul --coverage.reportsDirectory=coverage --coverage.reporter=lcov --coverage.reporter=json-summary --coverage.reporter=text",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "prepublishOnly": "bun run typecheck"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "linkedom": "^0.18.12",
    "turndown": "^7.2.2"
  },
  "peerDependencies": {
    "@mariozechner/pi-coding-agent": "*",
    "@sinclair/typebox": "^0.34.48"
  },
  "devDependencies": {
    "@types/node": "^22.19.11",
    "@types/turndown": "^5.0.6",
    "@vitest/coverage-istanbul": "3.2.4",
    "typescript": "^5.9.3",
    "vitest": "^3.0.0"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  }
}
