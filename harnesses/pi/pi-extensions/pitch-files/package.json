{
  "name": "pi-pitch-files",
  "version": "0.1.0",
  "description": "Pi extension: confined no-clobber pitch identity move (draft rename / draft→archive) for shape mode",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage.enabled --coverage.provider=istanbul --coverage.reportsDirectory=coverage --coverage.reporter=lcov --coverage.reporter=json-summary --coverage.reporter=text"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-istanbul": "3.2.4",
    "typescript": "^5.9.3",
    "vitest": "^3.0.0"
  },
  "peerDependencies": {
    "@mariozechner/pi-coding-agent": "*",
    "@sinclair/typebox": "*"
  }
}
