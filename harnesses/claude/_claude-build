#compdef claude-build
# _claude-build — zsh completion for claude-build
# Completes basenames (without .md) from $PWD/codegen/pitches/ready/, plus
# the --queue flag (drain codegen/pitches/ready/ one pitch at a time).

_claude_build() {
    local -a flags
    flags=('--queue')
    _describe 'flag' flags

    local ready_dir="$PWD/codegen/pitches/ready"
    if [[ ! -d "$ready_dir" ]]; then
        return 0
    fi
    local -a pitches
    pitches=("${ready_dir}"/*.md(N:t:r))
    if [[ ${#pitches[@]} -gt 0 ]]; then
        _describe 'ready pitch' pitches
    fi
}

_claude_build "$@"
