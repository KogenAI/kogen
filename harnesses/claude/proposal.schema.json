{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "codegen-propose proposed-change record",
  "type": "object",
  "additionalProperties": false,
  "required": ["cluster", "target_file", "rationale", "confidence"],
  "properties": {
    "cluster": {
      "type": "object",
      "additionalProperties": false,
      "required": ["counter", "pattern_key", "wasted_turns"],
      "properties": {
        "counter": { "type": "string" },
        "pattern_key": { "type": "string" },
        "wasted_turns": { "type": "integer" }
      }
    },
    "target_file": { "type": "string" },
    "anchor": { "type": "string" },
    "change": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["before", "after"],
          "properties": {
            "before": { "type": "string" },
            "after": { "type": "string" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["description"],
          "properties": {
            "description": { "type": "string" }
          }
        },
        { "type": "null" }
      ]
    },
    "rationale": { "type": "string" },
    "confidence": { "type": "string", "enum": ["high", "medium", "low"] }
  }
}
