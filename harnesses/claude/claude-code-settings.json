{
  "includeCoAuthoredBy": false,
  "model": "sonnet",
  "env": {
    "BASH_DEFAULT_TIMEOUT_MS": "600000",
    "BASH_MAX_TIMEOUT_MS": "600000",
    "CLAUDE_CODE_DISABLE_AUTO_MEMORY": "1",
    "DISABLE_AUTOUPDATER": "1",
    "MAX_THINKING_TOKENS": "0",
    "RENDER_CHECK_CMD": "true"
  },
  "permissions": {
    "allow": [
      "Bash(bash:*)",
      "Bash(cat:*)",
      "Bash(cd:*)",
      "Bash(chmod:*)",
      "Bash(cp:*)",
      "Bash(curl:*)",
      "Bash(date:*)",
      "Bash(df:*)",
      "Bash(docker build:*)",
      "Bash(docker compose:*)",
      "Bash(docker cp:*)",
      "Bash(docker exec:*)",
      "Bash(docker logs:*)",
      "Bash(docker ps:*)",
      "Bash(docker rm:*)",
      "Bash(docker run:*)",
      "Bash(docker stop:*)",
      "Bash(echo:*)",
      "Bash(elixir:*)",
      "Bash(find:*)",
      "Bash(git blame:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git ls-files:*)",
      "Bash(git show:*)",
      "Bash(git status:*)",
      "Bash(grep:*)",
      "Bash(head:*)",
      "Bash(iex:*)",
      "Bash(jq:*)",
      "Bash(kill:*)",
      "Bash(ls:*)",
      "Bash(lsof:*)",
      "Bash(lsof -ti:*)",
      "Bash(make:*)",
      "Bash(OCG_CLI=true make:*)",
      "Bash(set -a && source .env && set +a &&:*)",
      "Bash(MIX_ENV=test mix:*)",
      "Bash(mix:*)",
      "Bash(mkdir:*)",
      "Bash(mv:*)",
      "Bash(npm:*)",
      "Bash(npx:*)",
      "Bash(nslookup:*)",
      "Bash(ocg:*)",
      "Bash(osascript:*)",
      "Bash(pkill:*)",
      "Bash(ps:*)",
      "Bash(pwd:*)",
      "Bash(rg:*)",
      "Bash(rm:*)",
      "Bash(rmdir:*)",
      "Bash(sed:*)",
      "Bash(sleep:*)",
      "Bash(source .env &&:*)",
      "Bash(export:*)",
      "Bash(tail:*)",
      "Bash(time:*)",
      "Bash(touch:*)",
      "Bash(tree:*)",
      "Bash(true)",
      "Bash(wget:*)",
      "Bash(which:*)",
      "Bash(xargs:*)",
      "Edit",
      "Glob",
      "Grep",
      "List",
      "mcp__tidewave__execute_sql_query",
      "mcp__tidewave__get_docs",
      "mcp__tidewave__get_ecto_schemas",
      "mcp__tidewave__get_logs",
      "mcp__tidewave__get_package_location",
      "mcp__tidewave__get_source_location",
      "mcp__tidewave__project_eval",
      "mcp__tidewave__search_package_docs",
      "MultiEdit",
      "WebFetch",
      "WebSearch",
      "Write"
    ],
    "deny": ["Bash(fly:*)", "Bash(flyctl:*)", "Bash(sudo:*)"]
  },
  "enabledMcpjsonServers": [],
  "disabledMcpjsonServers": ["tidewave", "claude-in-chrome"],
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'input=$(cat); cmd=$(echo \"$input\" | jq -r \".tool_input.command // \\\"\\\"\"); out=$(echo \"$input\" | jq -r \".tool_response.stdout // \\\"\\\"\"); if [ -n \"${CODEGEN_AUTOVALIDATE_DEBUG:-}\" ]; then printf \"%s cmd=%s\\n\" \"$(date -u +%Y-%m-%dT%H:%M:%SZ)\" \"$cmd\" >>/tmp/autovalidate-debug.log 2>/dev/null || true; fi; if ! echo \"$cmd\" | grep -qE \"\\\\bmake[[:space:]]+llm-phoenix\\\\b\"; then exit 0; fi; if echo \"$cmd\" | grep -qE \"\\\\bmake[[:space:]]+llm-phoenix-(seed|validate|retry|trace|kill|summary|cache)\"; then exit 0; fi; if echo \"$out\" | grep -qE \",[[:space:]]*[1-9][0-9]*[[:space:]]+failures?\\\\b\"; then exit 0; fi; if echo \"$out\" | grep -q \"INFRASTRUCTURE ERROR\"; then exit 0; fi; if [ -d \"$HOME/.codegen_phoenix_seed\" ]; then date -u > \"$HOME/.codegen_phoenix_seed/validated\"; fi'"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/track-tool-failures.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "/orchestrate",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'input=$(cat); session_id=$(echo \"$input\" | jq -r \".session_id\"); prompt=$(echo \"$input\" | jq -r \".user_message // .prompt // \\\"\\\"\"); cwd=$(echo \"$input\" | jq -r \".cwd\"); if echo \"$prompt\" | grep -q \"^/orchestrate\"; then doc_path=$(echo \"$prompt\" | grep -oP \"(?<=@)[^\\\\s]+\" | head -1); echo \"$input\" | jq --arg doc \"$doc_path\" --arg cwd \"$cwd\" --arg prompt \"$prompt\" \"{session_id: .session_id, original_prompt: \\$prompt, document_path: \\$doc, cwd: \\$cwd}\" > \"$HOME/.claude/orchestrate-session-${session_id}.json\"; fi'"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'input=$(cat); session_id=$(echo \"$input\" | jq -r \".session_id\"); state_file=\"$HOME/.claude/orchestrate-session-${session_id}.json\"; if [ -f \"$state_file\" ]; then original_prompt=$(jq -r \".original_prompt\" \"$state_file\"); context=$(printf \"%s\\n\\nWe\\'ve already worked on this for a while so you should be able to find progress and step log files in codegen/logging/ and see where we left off.\" \"$original_prompt\"); jq -n --arg ctx \"$context\" \"{hookSpecificOutput: {hookEventName: \\\"SessionStart\\\", additionalContext: \\$ctx}}\"; fi'"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c 'input=$(cat); session_id=$(echo \"$input\" | jq -r \".session_id\"); rm -f \"$HOME/.claude/orchestrate-session-${session_id}.json\"'"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/llm-pending-sweep.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/pitch-format-validator.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/pitch-shipped-before-stop.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/step-log-completeness.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/step-log-missing-guard.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/stop-cycle-guard.sh"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/stop-resume.sh",
            "timeout": 360
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/stop-verify-planner-gate.sh"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "matcher": "context-curator",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/curator-format.sh"
          }
        ]
      },
      {
        "matcher": "developer-phoenix-backend|developer-phoenix-frontend|developer-html|developer-hugo|developer-vite",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/developer-no-self-gate-reset.sh"
          }
        ]
      },
      {
        "matcher": "developer-phoenix-backend|developer-phoenix-frontend",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/phoenix-dev-gate.sh"
          }
        ]
      },
      {
        "matcher": "developer-phoenix-backend|developer-phoenix-frontend|developer-html|developer-hugo|developer-vite",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/post-developer-format.sh"
          }
        ]
      },
      {
        "matcher": "developer-html|developer-hugo|developer-vite",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/static-site-build-check.sh"
          }
        ]
      },
      {
        "matcher": "developer-phoenix-backend|developer-phoenix-frontend|developer-html|developer-hugo|developer-vite",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/stop-gate-failure-breaker.sh"
          }
        ]
      },
      {
        "matcher": "developer-phoenix-backend|developer-phoenix-frontend|developer-html|developer-hugo|developer-vite",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/stop-spin-guard.sh"
          }
        ]
      },
      {
        "matcher": "developer-phoenix-backend|developer-phoenix-frontend|planner-phoenix|planner-html|planner-hugo|planner-vite|reviewer-phoenix|reviewer-static",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/subagent-retrospective-guard.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/build-no-success-before-commit.sh"
          }
        ]
      },
      {
        "matcher": "Bash|Write|Edit|MultiEdit|Read|Monitor",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/build-worker-cwd-guard.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/claude-debug-bash-guard.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/committer-bash-allowlist.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/committer-no-trailer-guard.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/committer-single-line-guard.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/committer-subject-length.sh"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/committer-write-allowlist.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/context-curator-guard.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/context-file-size-gate.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/context-index-parity.sh"
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/curator-before-committer.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/curator-learning-committed.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/dev-no-ci.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/developer-no-self-gate.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/env-var-sample-consistency.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/llm-suite-guard.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/llm-test-guard.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/no-cat-pipe.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/no-git-stash.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/no-python-json.sh"
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/operator-subagent-allowlist.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/orchestrator-no-ci.sh"
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/orchestrator-no-source-edit.sh"
          }
        ]
      },
      {
        "matcher": "Read|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/orchestrator-read-discipline.sh"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/orchestrator-session-log-name-guard.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/phoenix-backend-developer-guard.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/phoenix-frontend-developer-guard.sh"
          }
        ]
      },
      {
        "matcher": "Bash|Write|Edit|MultiEdit|EnterPlanMode|ExitPlanMode|Read",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/planner-guard.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/pre-commit-guard.sh"
          }
        ]
      },
      {
        "matcher": "Bash|Write|Edit|MultiEdit|Monitor",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/reviewer-guard.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/session-log-no-duplicate-section.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/session-log-section-integrity.sh"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/static-site-ex-guard.sh"
          }
        ]
      },
      {
        "matcher": "Agent",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/step-log-section-before-spawn.sh"
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/subagent-read-discipline.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/track-subagent-edits.sh"
          }
        ]
      },
      {
        "matcher": "Bash|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "$HOME/.claude/hooks/usage-rules-grep-guard.sh"
          }
        ]
      }
    ]
  }
}
