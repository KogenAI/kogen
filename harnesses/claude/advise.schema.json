{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "stronger-model advisor diagnosis",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "diagnosis",
    "falsifier",
    "next_probe",
    "evidence_used",
    "missing_evidence",
    "confidence"
  ],
  "properties": {
    "diagnosis": {
      "type": "string",
      "minLength": 1,
      "description": "The mechanism believed to cause the observed evidence, stated as a claim about a named artifact in the packet."
    },
    "falsifier": {
      "type": "string",
      "minLength": 1,
      "description": "The observation that would show the diagnosis is wrong."
    },
    "next_probe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "expected_outcomes"],
      "properties": {
        "action": {
          "type": "string",
          "minLength": 1
        },
        "expected_outcomes": {
          "type": "array",
          "minItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["if_hypothesis", "then_observe"],
            "properties": {
              "if_hypothesis": { "type": "string", "minLength": 1 },
              "then_observe": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "evidence_used": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string" }
    },
    "missing_evidence": {
      "type": "array",
      "items": { "type": "string" }
    },
    "confidence": {
      "type": "string",
      "enum": ["high", "medium", "low"]
    }
  }
}
