#compdef claude-babysit
# _claude-babysit — zsh completion for claude-babysit
# Completes --studio (route the drain to the resolved codegen-studio ssh target).

_claude_babysit() {
    local -a opts
    opts=('--studio:route the build+shape drain to the resolved studio ssh target')
    _describe 'option' opts
}

_claude_babysit "$@"
