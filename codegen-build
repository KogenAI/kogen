#!/usr/bin/env bash
# codegen-build — canonical entrypoint for all harness-based build invocations.
#
# Usage:
#   codegen-build --harness=<claude|pi> [--stack=<phoenix|static>] [options] PROMPT
#
# Options:
#   --harness=<claude|pi>     required: which harness to use
#   --stack=<phoenix|static>  optional: project stack. When omitted, detected
#                             from cwd markers (mix.exs -> phoenix,
#                             vite.config.js -> static; codegen self-build
#                             markers -> phoenix). Fails loud (non-zero exit)
#                             when undetectable or ambiguous (both markers
#                             present) -- never silent-defaults.
#   --cwd=<dir>               working directory (default: $PWD)
#   --model=<m>               model override
#   --effort=<e>              effort override
#   --max-budget-usd=<n>      passthrough flag forwarded to dispatch
#   --fallback-model=<m>      prepend <m> as rung 0 of every role's
#                             `fallback:` chain for this build only (one-build
#                             override of templates/generator/config.yaml);
#                             threaded via CODEGEN_BUILD_FALLBACK_MODEL, not
#                             EXTRA_FLAGS -- never blind-passed to dispatch
#   --print-dir               print this script's directory and exit 0
#   --print-argv              dry-run: parse + validate every flag, print the
#                             would-be `mix codegen.loop` argv one arg per
#                             line on stdout, exit 0. Skips the integrate
#                             pre-step and the gate-result post-step -- never
#                             mutates the target cwd, never execs the loop.
#   -h, --help                print usage and exit 0
#   PROMPT                    the prompt string (required, positional, last arg)
#
# Exit codes from dispatch propagate (0 = success, 1 = error, 2 = config/usage error, 130 = SIGINT).
# STDERR: diagnostics only. STDOUT: byte-transparent (stream-json from harness).

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"

HARNESS=""
STACK=""
CWD="$PWD"
MODEL=""
EFFORT=""
FALLBACK_MODEL=""
EXTRA_FLAGS=()
PRINT_ARGV=""
PROMPT=""

usage() {
    printf 'Usage: codegen-build --harness=<claude|pi> [--stack=<phoenix|static>] [--cwd=<dir>] [--model=<m>] [--effort=<e>] [--max-budget-usd=<n>] [--fallback-model=<m>] [--print-dir] [--print-argv] [-h|--help] PROMPT\n' >&2
    exit 2
}

while [[ $# -gt 0 ]]; do
    case "$1" in
    --harness=*)
        HARNESS="${1#--harness=}"
        shift
        ;;
    --harness)
        HARNESS="$2"
        shift 2
        ;;
    --stack=*)
        STACK="${1#--stack=}"
        shift
        ;;
    --stack)
        STACK="$2"
        shift 2
        ;;
    --cwd=*)
        CWD="${1#--cwd=}"
        shift
        ;;
    --cwd)
        CWD="$2"
        shift 2
        ;;
    --model=*)
        MODEL="${1#--model=}"
        shift
        ;;
    --model)
        MODEL="$2"
        shift 2
        ;;
    --effort=*)
        EFFORT="${1#--effort=}"
        shift
        ;;
    --effort)
        EFFORT="$2"
        shift 2
        ;;
    --max-budget-usd=* | --max-budget-usd)
        EXTRA_FLAGS+=("$1")
        if [[ "$1" == "--max-budget-usd" ]]; then
            EXTRA_FLAGS+=("$2")
            shift
        fi
        shift
        ;;
    --fallback-model=*)
        FALLBACK_MODEL="${1#--fallback-model=}"
        shift
        ;;
    --fallback-model)
        FALLBACK_MODEL="$2"
        shift 2
        ;;
    --print-dir)
        printf '%s\n' "$SCRIPT_DIR"
        exit 0
        ;;
    --print-argv)
        PRINT_ARGV="1"
        shift
        ;;
    -h | --help)
        printf 'Usage: codegen-build --harness=<claude|pi> [--stack=<phoenix|static>] [--cwd=<dir>] [--model=<m>] [--effort=<e>] [--max-budget-usd=<n>] [--fallback-model=<m>] [--print-dir] [--print-argv] [-h|--help] PROMPT\n'
        exit 0
        ;;
    --)
        shift
        PROMPT="$*"
        break
        ;;
    --*)
        printf 'codegen-build: unknown flag %q\n' "$1" >&2
        usage
        ;;
    *)
        if [[ -z "$PROMPT" ]]; then
            PROMPT="$1"
        else
            PROMPT="$PROMPT $1"
        fi
        shift
        ;;
    esac
done

# Validate required args
if [[ -z "$HARNESS" ]]; then
    printf 'codegen-build: --harness is required\n' >&2
    usage
fi

if [[ "$HARNESS" != "claude" && "$HARNESS" != "pi" ]]; then
    printf 'codegen-build: --harness must be "claude" or "pi", got %q\n' "$HARNESS" >&2
    usage
fi

# --stack is optional: use it when passed; otherwise detect from cwd markers.
# Fail loud when undetectable or ambiguous -- never silent-default (a silent
# phoenix default was removed in 66ec8d5; do not re-introduce it).
if [[ -z "$STACK" ]]; then
    if [[ -f "$CWD/harnesses/claude/manifest.yaml" && -f "$CWD/templates/generator/generate.sh" ]]; then
        # Self-build markers -> phoenix. Fires before the file sniffs so the
        # codegen repo's root index.html fixture never mis-detects.
        STACK="phoenix"
        printf 'codegen-build: stack not passed; detected stack=phoenix from cwd markers\n' >&2
    elif [[ -f "$CWD/mix.exs" && -f "$CWD/vite.config.js" ]]; then
        printf 'codegen-build: ambiguous stack markers in cwd (mix.exs and vite.config.js both present); pass --stack explicitly\n' >&2
        usage
    elif [[ -f "$CWD/mix.exs" ]]; then
        STACK="phoenix"
        printf 'codegen-build: stack not passed; detected stack=phoenix from cwd markers\n' >&2
    elif [[ -f "$CWD/vite.config.js" ]]; then
        STACK="static"
        printf 'codegen-build: stack not passed; detected stack=static from cwd markers\n' >&2
    else
        printf 'codegen-build: cannot detect stack from cwd; pass --stack=<phoenix|static>\n' >&2
        usage
    fi
fi

if [[ "$STACK" != "phoenix" && "$STACK" != "static" ]]; then
    printf 'codegen-build: --stack must be "phoenix" or "static", got %q\n' "$STACK" >&2
    usage
fi

# ── Pre-step: staleness preflight (refuse builds wired at a behind schema) ──
# Fail-closed: an app whose stamped scaffold schema version is BEHIND the
# codegen repo's current version must be consciously re-integrated first.
# Skipped on self-build (codegen repo has no per-app manifest) and when the
# manifest is absent/unparseable (fresh clone / pre-manifest app → the
# integrate pre-step below stamps a baseline).
if [[ ! (-f "$CWD/harnesses/claude/manifest.yaml" && -f "$CWD/templates/generator/generate.sh") ]]; then
    _schema_file="$SCRIPT_DIR/shared/scaffold/SCHEMA_VERSION"
    if [[ -f "$_schema_file" && -f "$CWD/codegen/manifest.yaml" ]]; then
        _current_ver="$(cat "$_schema_file" 2>/dev/null || echo "")"
        _stamped_ver="$(yq '.scaffold_schema_version // ""' "$CWD/codegen/manifest.yaml" 2>/dev/null || echo "")"
        # Only refuse on a positively-parsed integer that is strictly behind.
        if [[ "$_current_ver" =~ ^[0-9]+$ && "$_stamped_ver" =~ ^[0-9]+$ && "$_stamped_ver" -lt "$_current_ver" ]]; then
            printf 'codegen-build: app wired at scaffold schema v%s; codegen now v%s — run '\''codegen-scaffold integrate --stack=%s --cwd=%s'\'' to migrate, then rebuild\n' \
                "$_stamped_ver" "$_current_ver" "$STACK" "$CWD" >&2
            exit 2
        fi
    fi
fi

# ── Pre-step: run integrate stage to wire agent files + PROJECT_CONTEXT.md ──────
# Idempotent: all writes are guarded by existence checks in run_integrate_stage.
# Creates PROJECT_CONTEXT.md, restart_server.sh, codegen/ symlinks, Makefile targets.
# The LLM then commits these along with the app code.
# Skipped entirely under --print-argv: a dry-run must never mutate the target cwd.
SCAFFOLD_CMD="$SCRIPT_DIR/codegen-scaffold"
if [[ -z "$PRINT_ARGV" ]] && [[ -x "$SCAFFOLD_CMD" ]]; then
    # Self-build guard (content-marker, location-independent): when codegen
    # builds itself, $CWD is the codegen repo root. Running integrate would
    # re-symlink AGENTS.md/CLAUDE.md over the committed symlinks and re-append
    # .gitignore entries. $SCRIPT_DIR is unreliable here (the installed launcher
    # lives in ~/.local/bin), so detect the codegen root by the presence of
    # BOTH generator artifacts — never present in a downstream scaffolded app.
    if [[ -f "$CWD/harnesses/claude/manifest.yaml" && -f "$CWD/templates/generator/generate.sh" ]]; then
        printf 'codegen-build: self-build detected (codegen repo markers present in cwd); skipping integrate pre-step\n' >&2
    else
        _integrate_out=$("$SCAFFOLD_CMD" integrate --stack="$STACK" --cwd="$CWD" 2>&1) || {
            printf 'codegen-build: codegen-scaffold integrate failed (non-fatal; continuing):\n%s\n' "$_integrate_out" >&2
        }
    fi
fi

# Export parsed values for dispatch.sh
export CODEGEN_BUILD_HARNESS="$HARNESS"
export CODEGEN_BUILD_STACK="$STACK"
export CODEGEN_BUILD_CWD="$CWD"
export CODEGEN_BUILD_MODEL="${MODEL:-}"
export CODEGEN_BUILD_EFFORT="${EFFORT:-}"
export CODEGEN_BUILD_FALLBACK_MODEL="${FALLBACK_MODEL:-}"
export CODEGEN_BUILD_PRINT_ARGV="${PRINT_ARGV:-}"
export CLAUDE_ASYNC_AGENT_STALL_TIMEOUT_MS=0
export CLAUDE_CODE_PRINT_BG_WAIT_CEILING_MS=0
export CLAUDE_STREAM_IDLE_TIMEOUT_MS=0

DISPATCH="$SCRIPT_DIR/harnesses/$HARNESS/dispatch.sh"

if [[ ! -x "$DISPATCH" ]]; then
    printf 'codegen-build: dispatch script not found or not executable: %s\n' "$DISPATCH" >&2
    exit 2
fi

if [[ -z "$PRINT_ARGV" ]] && [[ "$HARNESS" == "pi" ]]; then
    rm -f "$CWD/codegen/gate-pending/gate-result.json" "$CWD/codegen/gate-pending/cycle-state.json"
fi

_dispatch_rc=0
if [[ -n "$PROMPT" ]]; then
    "$DISPATCH" "${EXTRA_FLAGS[@]+"${EXTRA_FLAGS[@]}"}" "$PROMPT" || _dispatch_rc=$?
else
    "$DISPATCH" "${EXTRA_FLAGS[@]+"${EXTRA_FLAGS[@]}"}" || _dispatch_rc=$?
fi

# ── Post-step: both harnesses must present a structured gate result; a missing
# gate-result.json after a successful dispatch is fail-closed. The loop is the
# sole build engine and always gates, so this branch should never fire on a
# healthy build — if it does, it is a real defect and must be loud, never
# fabricated. Skipped under --print-argv: the dispatch leg exits 0 before
# ever exec'ing the loop, so no gate-result.json is ever written by design —
# this is not a defect under dry-run and must not flip the exit code. ──
_gate_result="$CWD/codegen/gate-pending/gate-result.json"
if [[ -z "$PRINT_ARGV" ]] && [[ "$_dispatch_rc" -eq 0 ]]; then
    if [[ ! -f "$_gate_result" ]]; then
        printf 'codegen-build: %s build missing gate-result.json after successful dispatch\n' "$HARNESS" >&2
        _dispatch_rc=1
    elif [[ "$HARNESS" == "pi" ]]; then
        _pi_verdict=$(jq -r '.verdict // empty' "$_gate_result" 2>/dev/null || true)
        if [[ "$_pi_verdict" != "clear" ]]; then
            if [[ -z "$_pi_verdict" ]]; then
                printf 'codegen-build: pi build gate verdict missing or unreadable\n' >&2
            else
                printf 'codegen-build: pi build gate verdict=%s (expected clear)\n' "$_pi_verdict" >&2
            fi
            _dispatch_rc=1
        fi
    fi
fi

exit "$_dispatch_rc"
