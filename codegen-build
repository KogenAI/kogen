#!/usr/bin/env bash
# codegen-build — canonical entrypoint for all harness-based build invocations.
#
# Usage:
#   codegen-build --harness=<claude|pi> --stack=<phoenix|static> [options] PROMPT
#
# Options:
#   --harness=<claude|pi>     required: which harness to use
#   --stack=<phoenix|static>  required: project stack
#   --cwd=<dir>               working directory (default: $PWD)
#   --elixir                  engine selector: run the deterministic Elixir
#                             orchestration loop (mix codegen.loop) instead of
#                             the legacy self-orchestrating harness session.
#                             Absent (default) selects the legacy engine. The
#                             loop is not resumable — cannot combine with
#                             --resume-id/--resumable.
#   --non-interactive         legacy-engine I/O mode only (stream-json/headless
#                             vs interactive UI); decoupled from engine choice
#   --resumable               opt-in: persist session so --resume can re-attach a dead process (build path only)
#   --resume-id=<id>          re-attach to a persisted session by id (requires --resumable)
#   --model=<m>               model override
#   --effort=<e>              effort override
#   PROMPT                    the prompt string (required, positional, last arg)
#
# Exit codes from dispatch propagate (0 = success, 1 = error, 2 = config/usage error, 130 = SIGINT).
# STDERR: diagnostics only. STDOUT: byte-transparent (stream-json from harness).

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"

HARNESS=""
STACK=""
CWD="$PWD"
ELIXIR=""
NON_INTERACTIVE=""
RESUMABLE=""
RESUME_ID=""
MODEL=""
EFFORT=""
EXTRA_FLAGS=()
PROMPT=""

usage() {
    printf 'Usage: codegen-build --harness=<claude|pi> --stack=<phoenix|static> [--cwd=<dir>] [--elixir] [--non-interactive] [--resumable] [--resume-id=<id>] [--model=<m>] [--effort=<e>] PROMPT\n' >&2
    exit 2
}

while [[ $# -gt 0 ]]; do
    case "$1" in
    --harness=*)
        HARNESS="${1#--harness=}"
        shift
        ;;
    --harness)
        HARNESS="$2"
        shift 2
        ;;
    --stack=*)
        STACK="${1#--stack=}"
        shift
        ;;
    --stack)
        STACK="$2"
        shift 2
        ;;
    --cwd=*)
        CWD="${1#--cwd=}"
        shift
        ;;
    --cwd)
        CWD="$2"
        shift 2
        ;;
    --elixir)
        ELIXIR="1"
        shift
        ;;
    --non-interactive)
        NON_INTERACTIVE="1"
        shift
        ;;
    --resumable)
        RESUMABLE="1"
        shift
        ;;
    --resume-id=*)
        RESUME_ID="${1#--resume-id=}"
        shift
        ;;
    --resume-id)
        RESUME_ID="$2"
        shift 2
        ;;
    --model=*)
        MODEL="${1#--model=}"
        shift
        ;;
    --model)
        MODEL="$2"
        shift 2
        ;;
    --effort=*)
        EFFORT="${1#--effort=}"
        shift
        ;;
    --effort)
        EFFORT="$2"
        shift 2
        ;;
    --max-budget-usd=* | --max-budget-usd)
        EXTRA_FLAGS+=("$1")
        if [[ "$1" == "--max-budget-usd" ]]; then
            EXTRA_FLAGS+=("$2")
            shift
        fi
        shift
        ;;
    --fallback-model=* | --fallback-model)
        EXTRA_FLAGS+=("$1")
        if [[ "$1" == "--fallback-model" ]]; then
            EXTRA_FLAGS+=("$2")
            shift
        fi
        shift
        ;;
    --extension=* | --extension)
        EXTRA_FLAGS+=("$1")
        if [[ "$1" == "--extension" ]]; then
            EXTRA_FLAGS+=("$2")
            shift
        fi
        shift
        ;;
    --print-dir)
        printf '%s\n' "$SCRIPT_DIR"
        exit 0
        ;;
    -h | --help)
        printf 'Usage: codegen-build --harness=<claude|pi> --stack=<phoenix|static> [--cwd=<dir>] [--elixir] [--non-interactive] [--resumable] [--resume-id=<id>] [--model=<m>] [--effort=<e>] PROMPT\n'
        exit 0
        ;;
    --)
        shift
        PROMPT="$*"
        break
        ;;
    --*)
        printf 'codegen-build: unknown flag %q\n' "$1" >&2
        usage
        ;;
    *)
        if [[ -z "$PROMPT" ]]; then
            PROMPT="$1"
        else
            PROMPT="$PROMPT $1"
        fi
        shift
        ;;
    esac
done

# Validate required args
if [[ -z "$HARNESS" ]]; then
    printf 'codegen-build: --harness is required\n' >&2
    usage
fi

if [[ -n "$NON_INTERACTIVE" && -z "$PROMPT" ]]; then
    printf 'codegen-build: PROMPT is required in non-interactive mode\n' >&2
    usage
fi

if [[ "$HARNESS" != "claude" && "$HARNESS" != "pi" ]]; then
    printf 'codegen-build: --harness must be "claude" or "pi", got %q\n' "$HARNESS" >&2
    usage
fi

if [[ -n "$STACK" && "$STACK" != "phoenix" && "$STACK" != "static" ]]; then
    printf 'codegen-build: --stack must be "phoenix" or "static", got %q\n' "$STACK" >&2
    usage
fi

# --resume-id without --resumable would persist nothing → resume hits
# "No conversation found". Reject the contradictory combination.
if [[ -n "$RESUME_ID" && -z "$RESUMABLE" ]]; then
    printf 'codegen-build: --resume-id requires --resumable\n' >&2
    usage
fi

# The Elixir loop is not resumable — reject rather than silently dropping
# --resume-id/--resumable when --elixir is also present.
if [[ -n "$ELIXIR" && (-n "$RESUME_ID" || -n "$RESUMABLE") ]]; then
    printf 'codegen-build: --elixir cannot be combined with --resume-id/--resumable (the Elixir loop is not resumable)\n' >&2
    usage
fi

# ── Pre-step: run integrate stage to wire agent files + PROJECT_CONTEXT.md ──────
# Idempotent: all writes are guarded by existence checks in run_integrate_stage.
# Creates PROJECT_CONTEXT.md, restart_server.sh, codegen/ symlinks, Makefile targets.
# The LLM then commits these along with the app code.
SCAFFOLD_CMD="$SCRIPT_DIR/codegen-scaffold"
if [[ -x "$SCAFFOLD_CMD" ]]; then
    # Self-build guard (content-marker, location-independent): when codegen
    # builds itself, $CWD is the codegen repo root. Running integrate would
    # re-symlink AGENTS.md/CLAUDE.md over the committed symlinks and re-append
    # .gitignore entries. $SCRIPT_DIR is unreliable here (the installed launcher
    # lives in ~/.local/bin), so detect the codegen root by the presence of
    # BOTH generator artifacts — never present in a downstream scaffolded app.
    if [[ -f "$CWD/harnesses/claude/manifest.yaml" && -f "$CWD/templates/generator/generate.sh" ]]; then
        printf 'codegen-build: self-build detected (codegen repo markers present in cwd); skipping integrate pre-step\n' >&2
    else
        STACK_FOR_INTEGRATE="${STACK:-phoenix}"
        _integrate_out=$("$SCAFFOLD_CMD" integrate --stack="$STACK_FOR_INTEGRATE" --cwd="$CWD" 2>&1) || {
            printf 'codegen-build: codegen-scaffold integrate failed (non-fatal; continuing):\n%s\n' "$_integrate_out" >&2
        }
    fi
fi

# Export parsed values for dispatch.sh
export CODEGEN_BUILD_HARNESS="$HARNESS"
export CODEGEN_BUILD_STACK="${STACK:-phoenix}"
export CODEGEN_BUILD_CWD="$CWD"
export CODEGEN_BUILD_ELIXIR="${ELIXIR:-}"
export CODEGEN_BUILD_NON_INTERACTIVE="${NON_INTERACTIVE:-}"
export CODEGEN_BUILD_RESUMABLE="${RESUMABLE:-}"
export CODEGEN_BUILD_RESUME_ID="${RESUME_ID:-}"
export CODEGEN_BUILD_MODEL="${MODEL:-}"
export CODEGEN_BUILD_EFFORT="${EFFORT:-}"
export CLAUDE_ASYNC_AGENT_STALL_TIMEOUT_MS=0
export CLAUDE_CODE_PRINT_BG_WAIT_CEILING_MS=0
export CLAUDE_STREAM_IDLE_TIMEOUT_MS=0

DISPATCH="$SCRIPT_DIR/harnesses/$HARNESS/dispatch.sh"

if [[ ! -x "$DISPATCH" ]]; then
    printf 'codegen-build: dispatch script not found or not executable: %s\n' "$DISPATCH" >&2
    exit 2
fi

if [[ "$HARNESS" == "pi" ]]; then
    rm -f "$CWD/codegen/gate-pending/gate-result.json" "$CWD/codegen/gate-pending/cycle-state.json"
fi

_dispatch_rc=0
if [[ -n "$PROMPT" ]]; then
    "$DISPATCH" "${EXTRA_FLAGS[@]+"${EXTRA_FLAGS[@]}"}" "$PROMPT" || _dispatch_rc=$?
else
    "$DISPATCH" "${EXTRA_FLAGS[@]+"${EXTRA_FLAGS[@]}"}" || _dispatch_rc=$?
fi

# ── Post-step: Pi must present a structured clear gate result; Claude may synthesize one ──
_gate_result="$CWD/codegen/gate-pending/gate-result.json"
if [[ "$_dispatch_rc" -eq 0 ]]; then
    if [[ "$HARNESS" == "pi" ]]; then
        if [[ ! -f "$_gate_result" ]]; then
            printf 'codegen-build: pi build missing gate-result.json after successful dispatch\n' >&2
            _dispatch_rc=1
        else
            _pi_verdict=$(jq -r '.verdict // empty' "$_gate_result" 2>/dev/null || true)
            if [[ "$_pi_verdict" != "clear" ]]; then
                if [[ -z "$_pi_verdict" ]]; then
                    printf 'codegen-build: pi build gate verdict missing or unreadable\n' >&2
                else
                    printf 'codegen-build: pi build gate verdict=%s (expected clear)\n' "$_pi_verdict" >&2
                fi
                _dispatch_rc=1
            fi
        fi
    elif [[ ! -f "$_gate_result" ]]; then
        _ts=$(date -u +%Y-%m-%dT%H:%M:%SZ)
        _diff_sha=$(git -C "$CWD" rev-parse --short HEAD 2>/dev/null || printf 'unknown')
        _diff_count=$(git -C "$CWD" diff --name-only origin/main...HEAD 2>/dev/null | wc -l | tr -d ' ' || printf '0')
        mkdir -p "$(dirname "$_gate_result")"
        jq -n \
            --arg gate "make ci" \
            --arg mode "short" \
            --arg diff_sha "$_diff_sha" \
            --argjson diff_files_count "${_diff_count:-0}" \
            --arg verdict "clear" \
            --arg verdict_marker "ALL CLEAR ✅" \
            --arg started "$_ts" \
            --arg ended "$_ts" \
            --arg session_id "${SESSION_ID:-unknown}" \
            '{gate: $gate, mode: $mode, diff_sha: $diff_sha, diff_files_count: $diff_files_count,
              runner_found: true, exit: 0, execution_evidence: 1, expected_segments: 1,
              render_verdict: "", verdict: $verdict, verdict_marker: $verdict_marker,
              classification: "", started: $started, ended: $ended,
              session_id: $session_id, log: "", witness: ""}' \
            >"$_gate_result" 2>/dev/null || true
    fi
fi

exit "$_dispatch_rc"
