#!/usr/bin/env bash
# codegen-call — one-shot structured LLM call binary.
#
# Usage:
#   codegen-call --harness=<claude_code|pi> [--role=<label>] \
#     --model=<m> --effort=<e> \
#     --system-prompt @<abs-path> \
#     [--json-schema @<abs-path>] \
#     [--allowed-tools=<comma-list>] \
#     [--settings @<abs-path>] \
#     [--extension @<abs-path>] \
#     PROMPT
#
# Flags:
#   --version             print "codegen-call 0.1.0" and exit 0
#   --harness=<h>         REQUIRED: claude_code | pi
#   --role=<label>        OPTIONAL: telemetry label (e.g. bouncer, concierge)
#   --model=<m>           REQUIRED: model string
#   --effort=<e>          REQUIRED: effort string (low/medium/high/…)
#   --system-prompt @<p>  REQUIRED: @<abs-path> to system prompt file
#   --json-schema @<p>    OPTIONAL: @<abs-path> to JSON schema file
#   --allowed-tools=<l>   OPTIONAL: comma-list of tools; empty string → no tools
#   --settings @<p>       OPTIONAL: @<abs-path> to settings JSON (claude only)
#   --extension @<p>      OPTIONAL: @<abs-path> to extension file (pi only)
#   PROMPT                REQUIRED positional arg (last arg or after --)
#
# Exit codes:
#   0  — envelope emitted on stdout (even on LLM-level failure)
#   1  — dispatch infra failure (harness binary error, jq failure, etc.)
#   2  — usage/config error (missing required arg, bad harness, missing file)
#   127 — harness binary not found (propagated from dispatch)

set -euo pipefail

# Resolve the codegen root so that both direct invocations (from repo) and
# installed copies (~/.local/bin/) can locate the harnesses/ directory.
# Priority:
#   1. SCRIPT_DIR has a harnesses/ subdir → use it (direct / test invocation)
#   2. OCG_CODEGEN_DIR env var set         → use it (installed copy with env)
#   3. Fall back to SCRIPT_DIR             → error will surface from dispatch check
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
if [[ ! -d "$SCRIPT_DIR/harnesses" ]] && [[ -n "${OCG_CODEGEN_DIR:-}" ]]; then
    SCRIPT_DIR="$OCG_CODEGEN_DIR"
fi

SHOW_VERSION=""
HARNESS=""
ROLE=""
MODEL=""
EFFORT=""
SYSTEM_PROMPT_PATH=""
JSON_SCHEMA_PATH=""
ALLOWED_TOOLS=""
ALLOWED_TOOLS_SET=""
SETTINGS_PATH=""
EXTENSION_PATH=""
PROMPT=""

usage() {
    printf 'Usage: codegen-call --harness=<claude_code|pi> [--role=<label>] --model=<m> --effort=<e> --system-prompt @<path> [--json-schema @<path>] [--allowed-tools=<list>] [--settings @<path>] [--extension @<path>] PROMPT\n' >&2
    exit 2
}

while [[ $# -gt 0 ]]; do
    case "$1" in
    --version)
        SHOW_VERSION="1"
        shift
        ;;
    --harness=*)
        HARNESS="${1#--harness=}"
        shift
        ;;
    --harness)
        HARNESS="$2"
        shift 2
        ;;
    --role=*)
        ROLE="${1#--role=}"
        shift
        ;;
    --role)
        ROLE="$2"
        shift 2
        ;;
    --model=*)
        MODEL="${1#--model=}"
        shift
        ;;
    --model)
        MODEL="$2"
        shift 2
        ;;
    --effort=*)
        EFFORT="${1#--effort=}"
        shift
        ;;
    --effort)
        EFFORT="$2"
        shift 2
        ;;
    --system-prompt=*)
        SYSTEM_PROMPT_PATH="${1#--system-prompt=}"
        shift
        ;;
    --system-prompt)
        SYSTEM_PROMPT_PATH="$2"
        shift 2
        ;;
    --json-schema=*)
        JSON_SCHEMA_PATH="${1#--json-schema=}"
        shift
        ;;
    --json-schema)
        JSON_SCHEMA_PATH="$2"
        shift 2
        ;;
    --allowed-tools=*)
        ALLOWED_TOOLS="${1#--allowed-tools=}"
        ALLOWED_TOOLS_SET="1"
        shift
        ;;
    --allowed-tools)
        ALLOWED_TOOLS="$2"
        ALLOWED_TOOLS_SET="1"
        shift 2
        ;;
    --settings=*)
        SETTINGS_PATH="${1#--settings=}"
        shift
        ;;
    --settings)
        SETTINGS_PATH="$2"
        shift 2
        ;;
    --extension=*)
        EXTENSION_PATH="${1#--extension=}"
        shift
        ;;
    --extension)
        EXTENSION_PATH="$2"
        shift 2
        ;;
    --)
        shift
        PROMPT="$*"
        break
        ;;
    --*)
        printf 'codegen-call: unknown flag %q\n' "$1" >&2
        usage
        ;;
    *)
        if [[ -z "$PROMPT" ]]; then
            PROMPT="$1"
        else
            PROMPT="$PROMPT $1"
        fi
        shift
        ;;
    esac
done

# Handle --version first (no other args required)
if [[ -n "$SHOW_VERSION" ]]; then
    printf 'codegen-call 0.1.0\n'
    exit 0
fi

# Validate required args
if [[ -z "$HARNESS" ]]; then
    printf 'codegen-call: --harness is required\n' >&2
    usage
fi

if [[ "$HARNESS" != "claude_code" && "$HARNESS" != "pi" ]]; then
    printf 'codegen-call: --harness must be "claude_code" or "pi", got %q\n' "$HARNESS" >&2
    usage
fi

if [[ -z "$MODEL" ]]; then
    printf 'codegen-call: --model is required\n' >&2
    usage
fi

if [[ -z "$EFFORT" ]]; then
    printf 'codegen-call: --effort is required\n' >&2
    usage
fi

if [[ -z "$SYSTEM_PROMPT_PATH" ]]; then
    printf 'codegen-call: --system-prompt @<path> is required\n' >&2
    usage
fi

if [[ -z "$PROMPT" ]]; then
    printf 'codegen-call: PROMPT is required\n' >&2
    usage
fi

# Parse @<path> values and read file contents
_read_at_path() {
    local flag_name="$1"
    local value="$2"
    local path
    if [[ "$value" != @* ]]; then
        printf 'codegen-call: %s value must start with @ (got %q)\n' "$flag_name" "$value" >&2
        exit 2
    fi
    path="${value#@}"
    if [[ ! -f "$path" ]]; then
        printf 'codegen-call: %s file not found: %s\n' "$flag_name" "$path" >&2
        exit 2
    fi
    printf '%s' "$path"
}

# Resolve system-prompt path
SP_PATH="$(_read_at_path "--system-prompt" "$SYSTEM_PROMPT_PATH")"
SYSTEM_PROMPT_CONTENT="$(cat "$SP_PATH")"

# Resolve json-schema path (optional)
JSON_SCHEMA_CONTENT=""
JSON_SCHEMA_ABS_PATH=""
if [[ -n "$JSON_SCHEMA_PATH" ]]; then
    JSON_SCHEMA_ABS_PATH="$(_read_at_path "--json-schema" "$JSON_SCHEMA_PATH")"
    JSON_SCHEMA_CONTENT="$(cat "$JSON_SCHEMA_ABS_PATH")"
fi

# Resolve settings path (optional)
SETTINGS_ABS_PATH=""
if [[ -n "$SETTINGS_PATH" ]]; then
    SETTINGS_ABS_PATH="$(_read_at_path "--settings" "$SETTINGS_PATH")"
fi

# Resolve extension path (optional)
EXTENSION_ABS_PATH=""
if [[ -n "$EXTENSION_PATH" ]]; then
    EXTENSION_ABS_PATH="$(_read_at_path "--extension" "$EXTENSION_PATH")"
fi

# Map harness name to dispatch directory
if [[ "$HARNESS" == "claude_code" ]]; then
    DISPATCH_DIR="claude"
else
    DISPATCH_DIR="pi"
fi

# Export env vars for dispatch script
export CODEGEN_CALL_HARNESS="$HARNESS"
export CODEGEN_CALL_ROLE="$ROLE"
export CODEGEN_CALL_MODEL="$MODEL"
export CODEGEN_CALL_EFFORT="$EFFORT"
export CODEGEN_CALL_SYSTEM_PROMPT="$SYSTEM_PROMPT_CONTENT"
export CODEGEN_CALL_JSON_SCHEMA="$JSON_SCHEMA_CONTENT"
export CODEGEN_CALL_JSON_SCHEMA_PATH="$JSON_SCHEMA_ABS_PATH"
export CODEGEN_CALL_ALLOWED_TOOLS="${ALLOWED_TOOLS:-}"
export CODEGEN_CALL_ALLOWED_TOOLS_SET="${ALLOWED_TOOLS_SET:-}"
export CODEGEN_CALL_SETTINGS_PATH="$SETTINGS_ABS_PATH"
export CODEGEN_CALL_EXTENSION_PATH="$EXTENSION_ABS_PATH"
export CODEGEN_CALL_PROMPT="$PROMPT"

DISPATCH="$SCRIPT_DIR/harnesses/$DISPATCH_DIR/call-dispatch.sh"

if [[ ! -x "$DISPATCH" ]]; then
    printf 'codegen-call: dispatch script not found or not executable: %s\n' "$DISPATCH" >&2
    exit 2
fi

exec "$DISPATCH"
