#!/usr/bin/env bash
# codegen-advise — black-box "problem in, plan out" advisor call, run on the
# OPPOSITE provider from the CURRENT build harness.
#
# Usage:
#   codegen-advise --harness=claude_code --context @<abs-path>
#   codegen-advise --harness=claude_code <<< "problem text on stdin"
#
# --harness names the CURRENT build harness (the one that is stuck); this
# script flips to the OPPOSITE provider via a FIXED internal mapping — this
# is a deliberate operator decision (see pitch "a stuck build asks the other
# provider" § No-gos): not configurable.
#
# STATUS: DORMANT — this repo currently installs exactly one provider
# (Anthropic, via the claude harness). A second-opinion call is only worth
# making against a DIFFERENT vendor: escalating to a bigger Claude model is
# already what the give-up boundary's model escalation does, and the advisor
# exists precisely because another vendor sees different failure modes. With
# one provider there is no opposite row to flip to, so every invocation
# reports that and exits 1 WITHOUT making a model call. No replacement
# provider is invented here.
#
# This degradation is safe by existing contract, not by accident — every
# caller already treats a non-zero exit as ADDITIVE-failure:
#   - OrchestrationLoop.do_maybe_advise/2 maps any non-zero exit to `:error`
#     and returns the context unchanged; the build proceeds.
#   - The `advise` MCP tool returns isError text; the dev's turn continues.
#
# Restoring it: add the second provider's row to the mapping below and drop
# the guard. The argv contract, system prompt, JSON schema and envelope
# handling are all still here and unchanged.
#
# Exit codes:
#   0   — advisor plan printed on stdout
#   1   — no opposite provider configured, or codegen-call returned a
#         non-success envelope / unparseable stdout
#   2   — usage error: missing/unknown --harness, missing/empty --context
#   127 — codegen-call binary not found

set -euo pipefail

# Derive CODEGEN_DIR from this script's own location (works symlinked via PATH).
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd -P)"
CODEGEN_DIR="$SCRIPT_DIR"

CODEGEN_CALL="$CODEGEN_DIR/codegen-call"
SYSTEM_PROMPT_FILE="$CODEGEN_DIR/harnesses/claude/advise-system-prompt.md"
JSON_SCHEMA_FILE="$CODEGEN_DIR/harnesses/claude/advise.schema.json"

HARNESS=""
CONTEXT_PATH=""
CONTEXT_FROM_STDIN=""

usage() {
    printf 'Usage: codegen-advise --harness=claude_code (--context @<path> | via stdin)\n' >&2
    exit 2
}

while [[ $# -gt 0 ]]; do
    case "$1" in
    --harness=*)
        HARNESS="${1#--harness=}"
        shift
        ;;
    --harness)
        HARNESS="$2"
        shift 2
        ;;
    --context=*)
        CONTEXT_PATH="${1#--context=}"
        shift
        ;;
    --context)
        CONTEXT_PATH="$2"
        shift 2
        ;;
    --*)
        printf 'codegen-advise: unknown flag %q\n' "$1" >&2
        usage
        ;;
    *)
        printf 'codegen-advise: unexpected positional arg %q\n' "$1" >&2
        usage
        ;;
    esac
done

if [[ -z "$HARNESS" ]]; then
    printf 'codegen-advise: --harness is required\n' >&2
    usage
fi

if [[ "$HARNESS" != "claude_code" ]]; then
    printf 'codegen-advise: --harness must be "claude_code", got %q\n' "$HARNESS" >&2
    usage
fi

# Resolve the problem context: @<path> flag, or stdin when the flag is absent.
CONTEXT_TEXT=""
if [[ -n "$CONTEXT_PATH" ]]; then
    if [[ "$CONTEXT_PATH" != @* ]]; then
        printf 'codegen-advise: --context value must start with @ (got %q)\n' "$CONTEXT_PATH" >&2
        usage
    fi
    _path="${CONTEXT_PATH#@}"
    if [[ ! -f "$_path" ]]; then
        printf 'codegen-advise: --context file not found: %s\n' "$_path" >&2
        usage
    fi
    CONTEXT_TEXT="$(cat "$_path")"
else
    CONTEXT_TEXT="$(cat)"
    CONTEXT_FROM_STDIN="1"
fi

if [[ -z "${CONTEXT_TEXT//[[:space:]]/}" ]]; then
    if [[ -n "$CONTEXT_FROM_STDIN" ]]; then
        printf 'codegen-advise: stdin context is empty\n' >&2
    else
        printf 'codegen-advise: --context file is empty\n' >&2
    fi
    usage
fi

# Fixed opposite-provider mapping — deliberately not configurable (see
# header + pitch No-gos). One provider is installed, so there is no opposite
# row. Fail additively here rather than silently re-asking the SAME vendor,
# which would be a second opinion in name only.
ADVISOR_HARNESS=""
ADVISOR_MODEL=""
case "$HARNESS" in
claude_code)
    printf 'codegen-advise: no opposite provider is configured — %s is the only installed harness, so a second-opinion call would re-ask the same vendor. Skipping the advisor; the build continues unaffected.\n' "$HARNESS" >&2
    exit 1
    ;;
esac
ADVISOR_EFFORT="high"

if [[ ! -x "$CODEGEN_CALL" ]]; then
    printf 'codegen-advise: codegen-call not found or not executable: %s\n' "$CODEGEN_CALL" >&2
    exit 127
fi

ENVELOPE="$("$CODEGEN_CALL" \
    --harness="$ADVISOR_HARNESS" \
    --model="$ADVISOR_MODEL" \
    --effort="$ADVISOR_EFFORT" \
    --system-prompt="@$SYSTEM_PROMPT_FILE" \
    --json-schema="@$JSON_SCHEMA_FILE" \
    -- "$CONTEXT_TEXT")"

STATUS="$(printf '%s' "$ENVELOPE" | jq -r '.result.status // empty' 2>/dev/null || true)"

if [[ -z "$STATUS" ]]; then
    printf 'codegen-advise: codegen-call produced no parseable envelope\n' >&2
    exit 1
fi

if [[ "$STATUS" != "success" ]]; then
    REASON="$(printf '%s' "$ENVELOPE" | jq -r '.result.reason // "no reason given"' 2>/dev/null || echo "no reason given")"
    printf 'codegen-advise: advisor call did not succeed (status=%s): %s\n' "$STATUS" "$REASON" >&2
    exit 1
fi

VALUE="$(printf '%s' "$ENVELOPE" | jq -c '.result.value' 2>/dev/null || true)"

if [[ -z "$VALUE" || "$VALUE" == "null" ]]; then
    printf 'codegen-advise: advisor call succeeded but returned no structured value\n' >&2
    exit 1
fi

printf '%s\n' "$VALUE"
