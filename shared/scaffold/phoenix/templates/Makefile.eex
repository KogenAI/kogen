CODEGEN_DIR ?= $(shell codegen-build --print-dir 2>/dev/null || echo ~/.local/share/codegen)

format:
	mix format
	npx prettier --write .

test:
	mix test

ci:
	MIX_ENV=test mix compile
	mix ci
	MIX_ENV=test mix ecto.rollback --all --quiet

ci-fast:
	MIX_ENV=test mix compile --warnings-as-errors
	mix format --check-formatted
	npx prettier --check .

llm:
	@codegen-build --harness=claude --stack=phoenix --cwd=$(PWD)

llm-phoenix:
	@codegen-build --harness=claude --stack=phoenix --cwd=$(PWD)

llm-phoenix-validate:
	@codegen-build --harness=claude --stack=phoenix --cwd=$(PWD)

llm-single:
	@codegen-build --harness=claude --stack=phoenix --cwd=$(PWD)

gate-status:
	@$(CODEGEN_DIR)/shared/gate-control.sh status

gate-kill:
	@$(CODEGEN_DIR)/shared/gate-control.sh kill

gate-logs:
	@$(CODEGEN_DIR)/shared/gate-control.sh logs
