#!/usr/bin/env bash
# restart_server.sh — restart the application server.
#
# Generated by codegen-scaffold.

set -euo pipefail

# ── Local dev ────────────────────────────────────────────────────────────────
# Stops any running server processes (best-effort) so you can restart manually.
restart_local() {
    printf '[restart_server] stopping server processes (best-effort)...\n'
    pkill -f 'phx.server\|mix phx\|npm run serve' 2>/dev/null || true
    printf '[restart_server] done — start your server manually\n'
}

# ── Platform ─────────────────────────────────────────────────────────────────
# Sends a restart command via the platform process manager.
restart_platform() {
    printf '[restart_server] restarting via platform RPC...\n'
    <%= restart_rpc_cmd %>
    printf '[restart_server] restart signalled\n'
}

# ── Dispatch ─────────────────────────────────────────────────────────────────
# On the platform: use RPC. Locally: stop running processes.
if [[ "${PLATFORM_ENV:-}" == "1" ]]; then
    restart_platform
else
    restart_local
fi
