CODEGEN_DIR ?= $(shell codegen-build --print-dir 2>/dev/null || echo ~/.local/share/codegen)

format:
	npx prettier --write .

test:
	npm run build

ci:
	[ -d node_modules ] || mise exec -- npm install
	npm run lint
	npx prettier --check .
	npm run build

llm:
	@codegen-build --harness=claude --stack=static --cwd=$(PWD)

llm-static:
	@codegen-build --harness=claude --stack=static --cwd=$(PWD)

gate-status:
	@$(CODEGEN_DIR)/shared/gate-control.sh status

gate-kill:
	@$(CODEGEN_DIR)/shared/gate-control.sh kill

gate-logs:
	@$(CODEGEN_DIR)/shared/gate-control.sh logs
