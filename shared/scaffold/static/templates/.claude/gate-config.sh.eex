#!/usr/bin/env bash
# Per-app gate configuration. Generated by codegen-scaffold.
GATE_STACK=static
GATE_APP_SLUG=<%= slug %>
GATE_COMMAND="make ci"

# Optional. Unset → gate-select.sh derives both from GATE_COMMAND. Set → taken
# verbatim. Uncomment when this app's real gate does not match the heuristics
# (which only recognise `make ci`, `make llm` and `rebuild-seed-then`).
# GATE_MODE=short      # short | long — long gates are polled in the foreground
# GATE_TIMEOUT=900     # seconds, non-negative integer
