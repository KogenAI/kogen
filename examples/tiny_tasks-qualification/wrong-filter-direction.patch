+  def list(open_only) do
+    tasks = Store.read()
+
+    if open_only do
+      Enum.filter(tasks, &(&1.status == "done"))
+    else
+      tasks
+    end
+  end
+
+  def complete(id) do
+    tasks = Store.read()
+    index = Enum.find_index(tasks, &(&1.id == id))
+    updated = List.update_at(tasks, index, &%{&1 | status: "done"})
+    Store.write(updated)
+    Enum.at(updated, index)
   end
 end
