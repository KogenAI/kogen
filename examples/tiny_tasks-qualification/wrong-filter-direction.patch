@@ -0,0 +1,12 @@
+defmodule Mix.Tasks.Todo.Complete do
+  use Mix.Task
+
+  @shortdoc "Complete a task"
+
+  @impl Mix.Task
+  def run([id]) do
+    Mix.Task.run("app.start")
+    task = TinyTasks.complete(String.to_integer(id))
+    Mix.shell().info("Completed task #{task.id}.")
+  end
+end
