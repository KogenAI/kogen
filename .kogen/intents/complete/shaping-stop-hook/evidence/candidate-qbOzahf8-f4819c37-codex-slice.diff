+    def test_a_helper_still_running_near_the_deadline_stops_with_the_session(self):
+        """Build Zuj-YgSG cycle 1 (booking-complete): the root completed its
+        Draft at about 9 minutes while a helper kept probing past the 600 s
+        budget. With the root's turn and Draft complete, the driver waits
+        only until HELPER_STOP_MARGIN_SECONDS remain, then stops the session
+        with the helper and names it in the receipt. The helper counts as
+        terminal only if its own rollout records the interruption."""
+        for records_interruption in (True, False):
+            case, slug = "csv-complete", f"eval-helper-stop-{str(records_interruption).lower()}"
+            shutil.rmtree(self.runtime / "runs" / case, ignore_errors=True)
+            helper_id = f"helper-stuck-{str(records_interruption).lower()}"
+            helper = {}
+
+            class StoppingChild(Child):
+                def wait(self, timeout=None):
+                    # Stopping the session: Codex records the helper's own interruption.
+                    if records_interruption and helper.get("path"):
+                        with helper["path"].open("a") as handle:
+                            handle.write(json.dumps({"type": "event_msg", "payload": {
+                                "type": "turn_aborted", "turn_id": "helper-turn", "reason": "interrupted"}}) + "\n")
+                    return super().wait(timeout)
+
+            def popen(argv, **_kwargs):
+                if "shape_transport.exp" in argv[1]:
+                    fixture = Path(argv[2])
+                    self.rollout(fixture, f"root-{case}-{slug}")
+                    helper["path"] = self.helper_rollout(fixture, helper_id, f"root-{case}-{slug}", complete=False)
+                    return StoppingChild()
+                return Child()
+
+            with self.subTest(records_interruption=records_interruption):
+                _fixture, receipt = self.minimal_real_drive(case, slug, popen)
+                self.assertEqual("completed", receipt["outcome"], receipt)
+                self.assertEqual([helper_id], receipt["helpers_stopped_with_session"])
+                self.assertIs(records_interruption, receipt["correlation"]["all_owned_terminal"], receipt["correlation"])
