+def package_revision(directory):
+    """Exact mirror of `Kogen.ShapingAudit.Package.revision/1`: SHA-256 over
+    the package's sorted relative paths and bytes, so a Draft snapshot this
+    driver captured can be matched to the `revision` a copied `hook.jsonl`
+    entry names."""
+    directory = Path(directory)
+    digest = hashlib.sha256()
+    for path in sorted(p for p in directory.rglob("*") if p.is_file() and not p.is_symlink()):
+        relative = path.relative_to(directory).as_posix()
+        digest.update(relative.encode())
+        digest.update(b"\x00")
+        digest.update(path.read_bytes())
+        digest.update(b"\x00")
+    return digest.hexdigest()
