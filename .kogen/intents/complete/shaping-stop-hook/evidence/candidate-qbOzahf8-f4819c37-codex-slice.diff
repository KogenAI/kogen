+def root_idle_check(events, window_seconds=FIRST_QUESTION_WINDOW_SECONDS):
+    """Before the root's first question (a `request_user_input` or
+    `request_user_input_async` call), its `function_call`s are only helper
+    spawns/waits (`ROOT_IDLE_CALLS`) or question calls — never a file read or
+    shell command of its own. When the root asks, its first accepted
+    question must land within `window_seconds` of the rollout's first
+    timestamped event. Returns `{'asked', 'first_question_index'}`."""
+    start_ts, first_index, first_ts = None, None, None
+    for index, event in enumerate(events):
+        ts = _event_timestamp(event)
+        if start_ts is None and ts is not None:
+            start_ts = ts
+        payload = event.get('payload') or {}
+        if (event.get('type') == 'response_item' and payload.get('type') == 'function_call'
+                and payload.get('name') in QUESTION_CALLS and payload.get('accepted', True) is not False):
+            first_index, first_ts = index, ts
+            break
+    prefix = events[:first_index] if first_index is not None else events
+    for event in prefix:
+        payload = event.get('payload') or {}
+        if event.get('type') == 'response_item' and payload.get('type') == 'function_call':
+            name = payload.get('name')
+            reject(name in ROOT_IDLE_CALLS or name in QUESTION_CALLS,
+                   f'the root called {name!r} before its first question, not a helper spawn or question call')
+    if first_index is not None and start_ts is not None and first_ts is not None:
+        reject(first_ts - start_ts <= window_seconds,
+               f'the first question arrived {first_ts - start_ts:.0f}s after launch, over the {window_seconds}s window')
+    return {'asked': first_index is not None, 'first_question_index': first_index}
+
