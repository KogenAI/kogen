+    def helper_rollout(self, fixture, helper_id, parent_id, *, complete):
+        """A Codex helper rollout: its own session_meta (a `scout` spawned by
+        the root), then its own turn, optionally completed."""
+        path = self.sessions / f"rollout-{helper_id}.jsonl"
+        source = {"subagent": {"thread_spawn": {"parent_thread_id": parent_id, "depth": 1,
+                                                "agent_path": "/root/audit_fix", "agent_role": "scout"}}}
+        events = [
