+def generate_uuid7():
+    """A best-effort UUIDv7 for KOGEN_SHAPING_LAUNCH_ID on the resume path,
+    where nothing else mints one (the resume transport bypasses `mix
+    kogen.shape`, which mints its own for a fresh launch)."""
+    import random
+    millis = int(wall_now() * 1000) & 0xFFFFFFFFFFFF
