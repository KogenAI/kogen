+    def test_a_helper_the_root_interrupted_is_terminal(self):
+        """Build Zuj-YgSG cycle 1 (csv-continuation): the root finished at
+        about 6.5 minutes after interrupting its `probe_runner` helper
+        (`interrupt_agent`); Codex recorded the helper's own `turn_aborted`
+        (reason `interrupted`) and no `task_complete`, so the driver waited
+        for it until the 600 s deadline. A root-interrupted helper is
+        terminal; the case completes at once."""
+        case, slug = "csv-complete", "eval-helper-interrupted"
