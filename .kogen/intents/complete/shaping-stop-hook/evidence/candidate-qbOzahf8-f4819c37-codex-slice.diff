+        "texts = json.loads(sys.stdin.read())\n"
+        "def route(t):\n"
+        "    low = t.lower()\n"
+        "    if 'technical' in low or 'permission' in low or 'process' in low:\n"
+        "        return 'controller'\n"
+        "    if 'already decided' in low:\n"
+        "        return 'cite'\n"
+        "    return 'shaper'\n"
