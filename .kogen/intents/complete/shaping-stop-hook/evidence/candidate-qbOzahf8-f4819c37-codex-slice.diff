+      """)
+
+      # The probe's own reader, run by tclsh on the recorded decisions.
+      [reader] = Regex.run(~r/proc last_hook_decision \{path\} \{.*?\n\}\n/s, File.read!(@probe))
+      script = Path.join(dir, "reader.tcl")
+      File.write!(script, reader <> "puts [last_hook_decision {#{hook_log}}]\n")
+
+      assert {"ready cc33 allow 3\n", 0} = System.cmd("tclsh", [script])
+    end
+  end
