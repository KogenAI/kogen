+# ---------------------------------------------------------------------------
+# The revised flow (`front-loaded-questions`, `shaping-stop-hook`,
+# `evaluation-answers-front-loaded-questions`): question quality is judged
+# only on the asking revision the hook allowed, native picker questions are
+# gated the same way, extra auditor roots are bound to 2 per case and
+# attributed only through the case's own copied auditor records, the copied
+# `.kogen/runtime/shaping-audits/<slug>/` tree is validated, and each case's
+# root rollout must stay idle (only helper spawns and question calls) before
+# its first question, which must arrive within 5 minutes.
+
+HOOK_DECISIONS = {"block", "allow"}
+HOOK_KINDS = {
+    "blocked", "stalled", "block-limit", "environment", "ready", "asking",
+    "auditor-bound", "not-ready", "no-package", "role", "locked",
+    "helper-thread", "error", "skipped",
+}
+AUDITOR_BOUND = 2
+ROOT_IDLE_CALLS = {"spawn_agent", "wait_agent"}
+QUESTION_CALLS = {"request_user_input", "request_user_input_async"}
+FIRST_QUESTION_WINDOW_SECONDS = 300
+
+PROJECT_ROOT = Path(__file__).resolve().parents[3]
+CODE_PATHS_ENV = "KOGEN_SHAPING_EVALUATION_ELIXIR_CODE_PATHS"
+GATE_EXPRESSION = "Kogen.ShapingAudit.JevLayer.gate_questions_main()"
+def question_gate_command():
+    """The question-gate command, overridable via `KOGEN_QUESTION_GATE_COMMAND`
+    (shell-quoted) so the self-test and CI never need the real Jev gate.
+    Under the live evaluation the isolated child has an empty private
+    `MIX_BUILD_PATH`, where `mix run` would cold-compile every dependency
+    inside the case sandbox, so the gate always runs in a bare BEAM on the
+    parent's exact compiled code paths (the same
+    `KOGEN_SHAPING_EVALUATION_ELIXIR_CODE_PATHS` the driver's YAML parser
+    uses), which the suite always supplies. Without them the gate fails fast
+    with a clear error; it never falls back to compiling with `mix`."""
+    override = os.environ.get("KOGEN_QUESTION_GATE_COMMAND")
+    if override:
+        return shlex.split(override)
+    encoded = os.environ.get(CODE_PATHS_ENV)
+    reject(bool(encoded), f'question gate unavailable: {CODE_PATHS_ENV} is not supplied '
+                          '(the gate never compiles dependencies inside a case)')
+    try:
+        paths = json.loads(encoded)
+    except (json.JSONDecodeError, UnicodeDecodeError) as exc:
+        raise ValueError(f'{CODE_PATHS_ENV} is malformed: {exc}') from exc
+    reject(isinstance(paths, list) and paths and all(isinstance(p, str) and os.path.isabs(p) for p in paths),
+           f'{CODE_PATHS_ENV} must be a nonempty JSON array of absolute paths')
+    command = ["elixir"]
+    for path in dict.fromkeys(paths):
+        command.extend(["-pa", path])
+    return command + ["-e", GATE_EXPRESSION]
+
+def gate_questions(texts, command=None):
+    """Runs the question gate over `texts` (a JSON list of strings on stdin)
+    and returns its `results` list of `{text, route, distributions}`.
+    `route` is one of `shaper`, `controller` or `cite`. The gate prints
+    `gate_questions_main/0`'s shape: `{"ok": true, "results": [...]}` or
+    `{"ok": false, "reason": ...}`. It runs from the repository root, where
+    the shipped `priv/kogen/shaping_audit/*.json` tables are read."""
+    reject(isinstance(texts, list) and texts and all(isinstance(t, str) and t for t in texts),
+           'question gate input must be a nonempty list of strings')
+    proc = subprocess.run(command or question_gate_command(), input=json.dumps(texts),
+                           capture_output=True, text=True, timeout=120, cwd=PROJECT_ROOT)
+    reject(proc.returncode == 0, f'question gate command failed (exit {proc.returncode}): {proc.stderr.strip()}')
+    lines = [line for line in proc.stdout.splitlines() if line.strip()]
+    try:
+        payload = json.loads(lines[-1]) if lines else None
+    except json.JSONDecodeError as exc:
+        raise ValueError(f'question gate produced invalid JSON: {exc}') from exc
+    reject(isinstance(payload, dict) and payload.get('ok') in (True, False),
+           'question gate result missing or malformed')
+    reject(payload['ok'] is True, f"question gate unavailable: {payload.get('reason')}")
+    results = payload.get('results')
+    reject(isinstance(results, list) and len(results) == len(texts),
+           'question gate result missing or mismatched')
+    for item in results:
+        reject(isinstance(item, dict) and item.get('text') in texts and item.get('route') in ('shaper', 'controller', 'cite'),
+               'question gate item malformed')
+    return results
+
+def failing_question_routes(texts, command=None):
+    """A question routed `controller` (technical/process/permission) or
+    `cite` (already settled) is a defect; `shaper` is fine. `[]` is a pass."""
+    if not texts:
+        return []
+    return [item for item in gate_questions(texts, command=command) if item['route'] in ('controller', 'cite')]
+
+_PANEL_FOOTER = re.compile(r'enter\s*submit', re.IGNORECASE)
+
+def picker_question_text(recorded_text):
+    """The question body of one recorded native panel, as the gate judges it:
+    whitespace-normalised, after the last "Queued follow-up inputs" status
+    and before the "enter submit" footer, so terminal chrome (model line,
+    working status, cwd) never reaches the gate. Mirrors the driver's
+    `panel_question_key`."""
+    text = ' '.join((recorded_text or '').split())
+    footer = list(_PANEL_FOOTER.finditer(text))
+    if footer:
+        text = text[:footer[-1].start()]
+    marker = text.lower().rfind('queued follow-up inputs')
+    if marker >= 0:
+        text = text[marker + len('queued follow-up inputs'):]
+    return text.strip()
+
+def _question_options(options):
+    labels = []
+    for option in options if isinstance(options, list) else []:
+        label = option.get('label') if isinstance(option, dict) else option
+        if isinstance(label, str) and label.strip():
+            labels.append(' '.join(label.split()))
+    return labels
+
+def native_question_calls(run):
+    """`{title: full question text}` from the case root's own native question
+    calls (`request_user_input` / `request_user_input_async`) in its owned
+    rollout. A Codex picker panel shows only a question's title and options,
+    so the gate judges the question the Shaper was actually asked: title,
+    question text and options. A call without question text never replaces
+    one that has it. `{}` when the evidence has no such calls."""
+    metadata_path = run / 'owned-session-metadata.json'
+    rollouts = run / 'owned-rollouts'
+    if not metadata_path.is_file() or not rollouts.is_dir():
+        return {}
+    metadata = json.loads(metadata_path.read_text())
+    roots = {item.get('id') for item in metadata if isinstance(item, dict)
+             and not (isinstance(item.get('source'), dict) and 'subagent' in item['source'])}
+    texts = {}
+    for path in sorted(rollouts.glob('*.jsonl')):
+        events = rollout_events(path)
+        session = next((event.get('payload', {}).get('id') for event in events if event.get('type') == 'session_meta'), None)
+        if session not in roots:
+            continue
+        for event in events:
+            payload = event.get('payload', {})
+            if not (event.get('type') == 'response_item' and isinstance(payload, dict)
+                    and payload.get('type') == 'function_call' and payload.get('name') in QUESTION_CALLS):
+                continue
+            try:
+                arguments = json.loads(payload.get('arguments') or '{}')
+            except json.JSONDecodeError:
+                continue
+            for question in arguments.get('questions', []) if isinstance(arguments, dict) else []:
+                if not isinstance(question, dict):
+                    continue
+                title = ' '.join(str(question.get('title') or question.get('header') or '').split())
+                body = ' '.join(str(question.get('question') or '').split())
+                if not title or (title in texts and not body):
+                    continue
+                options = _question_options(question.get('options'))
+                text = f'{title}: {body}' if body else title
+                if options:
+                    text += ' Options: ' + ' | '.join(options)
+                if body or title not in texts:
+                    texts[title] = text
+    return texts
+
+def gated_picker_text(panel_text, native_questions):
+    """The text the gate judges for one recorded panel: the matching native
+    question call's full text (the panel body starts with its title; the
+    longest title wins), else the recorded panel body itself."""
+    matches = [title for title in native_questions if panel_text.startswith(title)]
+    return native_questions[max(matches, key=len)] if matches else panel_text
+
+_ASK_ENTRY_SPLIT = re.compile(r'\n(?=\d+\.\s)')
+
+def ask_the_shaper_entries(questions_md_text):
+    """The `## Ask the Shaper` section's numbered entries' raw text, in the
+    fixed `front-loaded-questions` grammar. `[]` when the section is absent
+    or empty."""
+    match = re.search(r'^##\s+Ask the Shaper\s*\n(.*?)(?=^##\s|\Z)', questions_md_text or '',
+                       re.MULTILINE | re.DOTALL)
+    if not match:
+        return []
+    body = match.group(1).strip()
+    if not body:
+        return []
+    return [entry.strip() for entry in _ASK_ENTRY_SPLIT.split('\n' + body) if entry.strip()]
+
+def allowed_asking_revisions(hook_lines):
+    """The hook.jsonl entries the hook allowed while asking (`decision:
+    allow`, `kind: asking`) — never a revision it blocked."""
+    return [entry for entry in hook_lines if entry.get('decision') == 'allow' and entry.get('kind') == 'asking']
+
+def judge_asking_questions(hook_lines, questions_by_revision, picker_questions=None, command=None):
+    """Gates every `## Ask the Shaper` entry from an *allowed* asking
+    revision (never a blocked one) plus every recorded native picker
+    question. Returns the failing items; `[]` means the case passes."""
+    texts = []
+    for entry in allowed_asking_revisions(hook_lines):
+        revision = entry.get('revision')
+        text = questions_by_revision.get(revision)
+        reject(text is not None, f'no questions.md snapshot captured for allowed asking revision {revision!r}')
+        texts.extend(ask_the_shaper_entries(text))
+    texts.extend(picker_questions or [])
+    return failing_question_routes(texts, command=command)
+
+def parse_hook_jsonl(path):
+    """Parses a copied `hook.jsonl`, rejecting a malformed line or an
+    unknown `decision`/`kind`."""
+    entries = []
+    for lineno, raw in enumerate(path.read_text(errors='replace').splitlines(), 1):
+        if not raw.strip():
+            continue
+        try:
+            entry = json.loads(raw)
+        except json.JSONDecodeError as exc:
+            raise ValueError(f'hook.jsonl line {lineno} is malformed: {exc}') from exc
+        reject(entry.get('decision') in HOOK_DECISIONS, f'hook.jsonl line {lineno} has an invalid decision')
+        reject(entry.get('kind') in HOOK_KINDS, f'hook.jsonl line {lineno} has an invalid kind')
+        entries.append(entry)
+    return entries
