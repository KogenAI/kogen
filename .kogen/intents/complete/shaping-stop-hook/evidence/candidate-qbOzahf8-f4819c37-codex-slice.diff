+        'interrupted': [{'type':'event_msg','payload':{'type':'turn_aborted','turn_id':'helper-turn','reason':'interrupted'}}],
+        'none': [],
+    }
+    events = [
+        {'type':'session_meta','payload':{'id':'helper','cwd':'fixture','source':{'subagent':{'thread_spawn':{'parent_thread_id':'root','agent_role':agent_role}}}}},
+        {'type':'session_meta','payload':{'id':'root','cwd':'fixture','source':'cli'}},
+        {'type':'turn_context','payload':{'model':'gpt-6-astra','effort':'low','turn_id':'startup'}},
+        {'type':'turn_context','payload':{'model':helper_model,'effort':'low','turn_id':'helper-turn'}},
+    ] + endings[ending]
+    return '\n'.join(json.dumps(x) for x in events)+'\n'
