+def _event_timestamp(event):
+    ts = event.get('timestamp')
+    if ts is None:
+        ts = (event.get('payload') or {}).get('timestamp')
+    if ts is None:
+        return None
+    if isinstance(ts, (int, float)):
+        return float(ts)
+    try:
+        return datetime.fromisoformat(str(ts).replace('Z', '+00:00')).timestamp()
+    except ValueError:
+        return None
