+def validate_extra_auditor_roots(case_session_ids, extra_roots, expected_profile=('gpt-6-luna', 'low')):
+    """`case_session_ids`: `{case: {session_id, ...}}` from each case's own
+    copied auditor records (`case_auditor_session_ids`). `extra_roots`: every
+    extra Codex root session tagged `KOGEN_ROLE=auditor` observed across the
+    suite, as `{'id', 'model', 'effort', 'completed', 'killed'}`. Every one
+    must run the fixture's auditor profile, attribute to exactly one case,
+    be complete and never killed; the per-case bound is 2 (`AUDITOR_BOUND`).
+    Returns `{case: [session_id, ...]}`."""
+    attribution = {case: [] for case in case_session_ids}
+    for root in extra_roots:
+        label = root.get('id')
+        reject((root.get('model'), root.get('effort')) == expected_profile,
+               f"auditor root {label!r} does not run the fixture's auditor profile")
+        reject(root.get('completed') is True, f"auditor root {label!r} did not complete")
+        reject(root.get('killed') is not True, f"auditor root {label!r} was killed")
+        owners = [case for case, ids in case_session_ids.items() if label in ids]
+        reject(len(owners) == 1, f"auditor root {label!r} is not attributed to exactly one case's own auditor records")
+        attribution[owners[0]].append(label)
+    for case, ids in attribution.items():
+        reject(len(ids) <= AUDITOR_BOUND, f'{case}: {len(ids)} attributed auditor roots exceed the bound of {AUDITOR_BOUND}')
+    return attribution
