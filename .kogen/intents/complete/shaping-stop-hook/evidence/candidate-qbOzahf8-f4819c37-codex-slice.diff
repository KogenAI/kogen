+
+    lines =
+      root
+      |> Path.join(".kogen/runtime/shaping-audits/demo/hook.jsonl")
+      |> File.read!()
+      |> String.split("\n", trim: true)
+      |> Enum.map(&Jason.decode!/1)
+
+    assert Enum.at(lines, 1)["kind"] == "stalled"
+
+    # An allowed stop resets the chain clock; the block count stays.
+    state =
+      root
+      |> Path.join(".kogen/runtime/shaping-audits/demo/hook-state.json")
+      |> File.read!()
