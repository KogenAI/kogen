diff --git a/test/kogen/shaping_audit_hook_test.exs b/test/kogen/shaping_audit_hook_test.exs
new file mode 100644
index 00000000..54a921c0
--- /dev/null
+++ b/test/kogen/shaping_audit_hook_test.exs
@@ -0,0 +1,995 @@
+Code.require_file("../support/shaping_audit/fast_auditor.ex", __DIR__)
+
+defmodule Kogen.ShapingAuditHookTest do
+  @moduledoc """
+  `mix kogen.audit --stop-hook` (`Kogen.ShapingAudit.StopHook`) and
+  `priv/kogen/shaping_audit/stop_hook.sh` (`shaping-stop-hook`).
+  """
+  use ExUnit.Case, async: true
+
+  alias Kogen.ShapingAudit.{FastAuditor, Finding, StopHook}
+
+  @root Path.expand("../..", __DIR__)
+
+  @config_yaml """
+  default_route: codex
+  routes:
+    codex:
+      harness: codex
+      shaping:   {model: fake, effort: low}
+      developer: {model: fake, effort: low}
+      reviewer:  {model: fake, effort: low}
+      helpers:
+        scout:  {model: fake, effort: low}
+        worker: {model: fake, effort: medium}
+        expert: {model: fake, effort: medium}
+  outer_resumptions: 2
+  verification_retries: 2
+  offline_retries: 4
+  """
+
+  @intent_yaml """
+  id: 018f2a3b-0000-7000-8000-000000000002
+  slug: demo
+  title: Demo package
+  """
+
+  @scenarios_yaml """
+  - id: demo-scenario
+    given: something
+    when: something happens
+    then: something else
+    wrong_result: nothing
+    verified_by: [check]
+    proof:
+      offline: [test/kogen/demo_test.exs]
+      paid_target: none
+      paid_reason: offline-sufficient
+      affected_paths: [lib/demo.ex]
+  """
+
+  # --- fixture ---------------------------------------------------------------
+
+  defp checkout! do
+    root =
+      Path.join(
+        System.tmp_dir!(),
+        "kogen-audit-hook-#{System.unique_integer([:positive, :monotonic])}"
+      )
+
+    File.mkdir_p!(root)
+    on_exit(fn -> File.rm_rf(root) end)
+
+    {_out, 0} = System.cmd("git", ["init", "-q"], cd: root)
+    {_out, 0} = System.cmd("git", ["config", "user.email", "test@example.com"], cd: root)
+    {_out, 0} = System.cmd("git", ["config", "user.name", "Test"], cd: root)
+    File.mkdir_p!(Path.join(root, ".kogen"))
+    File.write!(Path.join(root, ".kogen/config.yaml"), @config_yaml)
+    commit!(root, "init")
+    root
+  end
+
+  defp commit!(root, message) do
+    {_out, 0} = System.cmd("git", ["add", "-A"], cd: root)
+    {_out, 0} = System.cmd("git", ["commit", "-q", "-m", message, "--allow-empty"], cd: root)
+    :ok
+  end
+
+  defp write_demo!(root, overrides \\ %{}) do
+    dir = Path.join([root, ".kogen/intents/drafts/demo"])
+    File.mkdir_p!(dir)
+
+    files =
+      Map.merge(
+        %{
+          "intent.yaml" => @intent_yaml,
+          "scenarios.yaml" => @scenarios_yaml,
+          "questions.md" => ""
+        },
+        overrides
+      )
+
+    Enum.each(files, fn {name, contents} ->
+      path = Path.join(dir, name)
+      File.mkdir_p!(Path.dirname(path))
+      File.write!(path, contents)
+    end)
+
+    commit!(root, "demo")
+    dir
+  end
+
+  # --- audit-only fake layers --------------------------------------------------
+
+  defmodule FakeMaterialization do
+    @moduledoc false
+
+    def create(_root, _package_rel, files) do
+      tmp = Path.join(System.tmp_dir!(), "kogen-audit-#{System.unique_integer([:positive])}")
+      work = Path.join(tmp, "work")
+      File.mkdir_p!(work)
+
+      Enum.each(files, fn {rel, bytes} ->
+        path = Path.join(work, rel)
+        File.mkdir_p!(Path.dirname(path))
+        File.write!(path, bytes)
+      end)
+
+      {:ok, %{dir: work, base: tmp}}
+    end
+
+    def remove(%{base: base}), do: File.rm_rf!(base)
+  end
+
+  defmodule FakeJevPassthrough do
+    @moduledoc false
+
+    def run(_ctx, findings_so_far) do
+      auditor_only = Enum.filter(findings_so_far, &(&1["layer"] == "auditor"))
+      %{"status" => "ok", "findings" => [], "routed_findings" => auditor_only}
+    end
+  end
+
+  defmodule FakeAuditorClean do
+    @moduledoc false
+
+    def run(_ctx, _det, _opts) do
+      %{"status" => "ok", "findings" => [], "not_audited" => [], "bound_reached" => false}
+    end
+  end
+
+  defmodule FakeAuditorBound do
+    @moduledoc false
+
+    def run(_ctx, _det, _opts) do
+      %{"status" => "ok", "findings" => [], "not_audited" => [], "bound_reached" => true}
+    end
+  end
+
+  defmodule FakeDeterministicClean do
+    @moduledoc false
+    def run(_ctx), do: %{"status" => "ok", "findings" => []}
+    def prior_failures(_root, _id, _opts), do: []
+  end
+
+  defmodule FakeDeterministicBlocking do
+    @moduledoc false
+
+    def run(_ctx) do
+      %{
+        "status" => "ok",
+        "findings" => [
+          Finding.new("edited-live-owner-unselected", nil, %{
+            "message" => "select a target",
+            "route" => "controller"
+          })
+        ]
+      }
+    end
+
+    def prior_failures(_root, _id, _opts), do: []
+  end
+
+  defmodule FakeDeterministicRaises do
+    @moduledoc false
+    def run(_ctx), do: raise("boom")
+    def prior_failures(_root, _id, _opts), do: []
+  end
+
+  defmodule FakeDeterministicEnvironment do
+    @moduledoc false
+
+    def run(_ctx) do
+      %{
+        "status" => "ok",
+        "findings" => [
+          Finding.new("repository-invalid", nil, %{
+            "scope" => "environment",
+            "message" => "run `security add-generic-password -s dev.kogen.jev`"
+          })
+        ]
+      }
+    end
+
+    def prior_failures(_root, _id, _opts), do: []
+  end
+
+  defmodule FakeDeterministicManyBlocking do
+    @moduledoc false
+
+    def run(_ctx) do
+      findings =
+        for n <- 1..80 do
+          Finding.new("edited-live-owner-unselected", "target-#{n}", %{
+            "message" => String.duplicate("this finding needs a very long explanation ", 6),
+            "route" => "controller"
+          })
+        end
+
+      %{"status" => "ok", "findings" => findings}
+    end
+
+    def prior_failures(_root, _id, _opts), do: []
+  end
+
+  defp clean_layers,
+    do: %{
+      materialization: FakeMaterialization,
+      deterministic: FakeDeterministicClean,
+      auditor: FakeAuditorClean,
+      jev: FakeJevPassthrough
+    }
+
+  defp blocking_layers, do: %{clean_layers() | deterministic: FakeDeterministicBlocking}
+
+  defp bound_layers,
+    do: %{clean_layers() | deterministic: FakeDeterministicBlocking, auditor: FakeAuditorBound}
+
+  defp raising_layers, do: %{clean_layers() | deterministic: FakeDeterministicRaises}
+
+  defp environment_layers, do: %{clean_layers() | deterministic: FakeDeterministicEnvironment}
+
+  defp many_blocking_layers,
+    do: %{clean_layers() | deterministic: FakeDeterministicManyBlocking}
+
+  defp env(root, overrides \\ %{}) do
+    Map.merge(
+      %{
+        "KOGEN_ROLE" => "shaper",
+        "KOGEN_SHAPING_INTENT_ID" => "018f2a3b-0000-7000-8000-000000000002",
+        "KOGEN_SHAPING_ROUTE" => nil
+      },
+      overrides
+    )
+    |> Map.put_new("KOGEN_SHAPING_HOOK_OUTPUT", Path.join(root, "hook-output.json"))
+  end
+
+  defp run_hook(root, env, opts) do
+    opts = Keyword.put_new(opts, :stdin, "")
+    StopHook.run(root, env, opts)
+    output_path = Map.get(env, "KOGEN_SHAPING_HOOK_OUTPUT")
+    output_path |> File.read!() |> Jason.decode!()
+  end
+
+  # Directly writes `hook-state.json`, so a test can start from a chain
+  # already in progress rather than replaying every stop that built it.
+  defp prime_hook_state!(root, slug, fields) do
+    dir = Path.join([root, ".kogen/runtime/shaping-audits", slug])
+    File.mkdir_p!(dir)
+
+    base = %{
+      "chain_start" => nil,
+      "chain_blocks" => 0,
+      "last_revision" => nil,
+      "last_was_block" => false,
+      "audit_total_ms" => 0,
+      "auditor_bound_reached" => false,
+      "skip_key" => nil,
+      "decision" => nil
+    }
+
+    File.write!(Path.join(dir, "hook-state.json"), Jason.encode!(Map.merge(base, fields)))
+  end
+
+  defp read_hook_lines(root, slug) do
+    root
+    |> Path.join(".kogen/runtime/shaping-audits/#{slug}/hook.jsonl")
+    |> File.read!()
+    |> String.split("\n", trim: true)
+    |> Enum.map(&Jason.decode!/1)
+  end
+
+  # --- cases -------------------------------------------------------------------
+
+  test "no package: {\"continue\":true}, no audit" do
+    root = checkout!()
+
+    decision =
+      run_hook(root, env(root, %{"KOGEN_SHAPING_INTENT_ID" => "does-not-exist"}),
+        layers: clean_layers()
+      )
+
+    assert decision == %{"continue" => true}
+    refute File.dir?(Path.join(root, ".kogen/runtime/shaping-audits"))
+  end
+
+  test "blocking findings block, naming the finding, its route, the advisory count and the report path" do
+    root = checkout!()
+    write_demo!(root)
+    decision = run_hook(root, env(root), layers: blocking_layers())
+
+    assert decision["decision"] == "block"
+    assert decision["reason"] =~ "edited-live-owner-unselected"
+    assert decision["reason"] =~ "route: controller"
+    assert decision["reason"] =~ "advisory:"
+    assert decision["reason"] =~ ".kogen/runtime/shaping-audits/demo/"
+    assert byte_size(decision["reason"]) <= 16 * 1024
+  end
+
+  test "a block reason with many findings stays within 16 KiB" do
+    root = checkout!()
+    write_demo!(root)
+    decision = run_hook(root, env(root), layers: many_blocking_layers())
+
+    assert decision["decision"] == "block"
+    assert byte_size(decision["reason"]) <= 16 * 1024
+  end
+
+  test "only an environment finding is allowed, naming the fix" do
+    root = checkout!()
+    write_demo!(root)
+    decision = run_hook(root, env(root), layers: environment_layers())
+
+    assert decision["continue"] == true
+    assert decision["systemMessage"] =~ "security add-generic-password -s dev.kogen.jev"
+
+    lines =
+      root
+      |> Path.join(".kogen/runtime/shaping-audits/demo/hook.jsonl")
+      |> File.read!()
+      |> String.split("\n", trim: true)
+      |> Enum.map(&Jason.decode!/1)
+
+    assert hd(lines)["kind"] == "environment"
+  end
+
+  test "the same revision stopped again is allowed and recorded as stalled" do
+    root = checkout!()
+    write_demo!(root)
+
+    first = run_hook(root, env(root), layers: blocking_layers())
+    assert first["decision"] == "block"
+
+    second = run_hook(root, env(root), layers: blocking_layers())
