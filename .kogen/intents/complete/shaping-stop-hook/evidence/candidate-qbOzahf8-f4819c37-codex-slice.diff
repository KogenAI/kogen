+#!/bin/sh
+# Audit-only fake `mix`, for `stop_hook.sh` tests: logs its argv, env and PATH,
+# then writes a scripted decision to KOGEN_SHAPING_HOOK_OUTPUT.
+set -u
+
+if [ -n "${KOGEN_FAKE_MIX_LOG:-}" ]; then
+  {
+    printf 'argv:%s\n' "$*"
+    printf 'PATH:%s\n' "$PATH"
+    printf 'KOGEN_SHAPING_SKIP_KEY:%s\n' "${KOGEN_SHAPING_SKIP_KEY:-}"
+  } >>"$KOGEN_FAKE_MIX_LOG"
+fi
+
+if [ -n "${KOGEN_FAKE_MIX_DECISION:-}" ]; then
+  decision="$KOGEN_FAKE_MIX_DECISION"
+else
+  decision='{"continue":true}'
+fi
+
+if [ -n "${KOGEN_SHAPING_HOOK_OUTPUT:-}" ]; then
+  printf '%s' "$decision" >"$KOGEN_SHAPING_HOOK_OUTPUT"
+fi
+
+exit 0
diff --git a/test/support/shaping_audit/fast_auditor.ex b/test/support/shaping_audit/fast_auditor.ex
new file mode 100644
index 00000000..ac8c4846
--- /dev/null
+++ b/test/support/shaping_audit/fast_auditor.ex
@@ -0,0 +1,49 @@
+defmodule Kogen.ShapingAudit.FastAuditor do
+  @moduledoc false
+
+  # Live fixtures prove Kogen's real auditor launch path, hook and recorded
+  # times, not the route profile's judgement: a fixture copy of
+  # `.kogen/config.yaml` swaps one route's `auditor` entry for a fast profile
+  # so a real auditor run fits the case budget.
+
+  @doc "The Claude probe's fast auditor profile (`live-shape-to-build`)."
+  def claude_profile, do: %{model: "claude-sonnet-5", effort: "low"}
+
+  @doc "Rewrites `route`'s `auditor` line in the config at `path` to `profile`."
+  def patch!(path, route, %{model: model, effort: effort}) do
+    lines = path |> File.read!() |> String.split("\n")
+    header = "  #{route}:"
+
+    {patched, found?} =
+      Enum.reduce(lines, {[], :outside}, fn line, {acc, state} ->
+        {line, state} = patch_line(line, state, header, model, effort)
+        {[line | acc], state}
+      end)
+
+    unless found? == :done, do: raise("no auditor entry for route #{route} in #{path}")
+    File.write!(path, patched |> Enum.reverse() |> Enum.join("\n"))
+  end
+
+  defp patch_line(line, _state, header, _model, _effort) when line == header, do: {line, :inside}
+
+  defp patch_line(line, :inside, _header, model, effort) do
+    cond do
+      String.starts_with?(line, "    auditor:") ->
+        prefix = if String.contains?(line, "harness:"), do: harness_prefix(line), else: ""
+        {"    auditor:   {#{prefix}model: #{model}, effort: #{effort}}", :done}
+
+      Regex.match?(~r/^  \S/, line) ->
+        {line, :outside}
+
+      true ->
+        {line, :inside}
+    end
+  end
+
+  defp patch_line(line, state, _header, _model, _effort), do: {line, state}
+
+  defp harness_prefix(line) do
+    [_, harness] = Regex.run(~r/harness:\s*([a-z]+)/, line)
+    "harness: #{harness}, "
+  end
+end
