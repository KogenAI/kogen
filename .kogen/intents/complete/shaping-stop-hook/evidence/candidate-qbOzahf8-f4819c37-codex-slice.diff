+
+      [waiting, approval] = String.split(probe, ~s(submit_message "yes" "approval"), parts: 2)
+      assert waiting =~ "PROBE: the Shaping Stop hook presented the Draft"
+      refute approval =~ "presented the Draft"
+      refute probe =~ "do not ask me anything else"
+    end
+
+    test "the probe's hook.jsonl reader returns the last decision of a recorded transcript" do
