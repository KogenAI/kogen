+      # The generic answer is the evaluation driver's, byte for byte.
+      driver = File.read!(Path.join(@root, "test/support/shaping_evaluation/driver.py"))
+      [_, generic] = Regex.run(~r/set GENERIC_QUESTION_ANSWER "([^"]+)"/, probe)
