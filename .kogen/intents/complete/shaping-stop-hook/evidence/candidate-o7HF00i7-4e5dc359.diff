+++ b/test/kogen/shaping_audit_hook_test.exs
@@ -0,0 +1,550 @@
+Code.require_file("../support/shaping_audit/fixture.ex", __DIR__)
+
+defmodule Kogen.ShapingAuditHookTest do
+  use Kogen.IsolatedCase, async: true
+
+  alias Kogen.ShapingAudit.{Fixture, Package, StopHook}
+
+  defp setup_repo!(draft \\ "complete") do
+    root = Fixture.repo!()
+    package_rel = Fixture.add_draft!(root, draft)
+    {:ok, %{files: files}} = Package.load(root, package_rel)
+    {:ok, intent} = YamlElixir.read_from_string(files["intent.yaml"])
+
+    env =
+      Fixture.audit_env!(root)
+      |> Map.merge(%{
+        "KOGEN_ROLE" => "shaper",
+        "KOGEN_SHAPING_INTENT_ID" => intent["id"],
+        "KOGEN_SHAPING_ROUTE" => "codex",
+        "KOGEN_SHAPING_HOOK_OUTPUT" => Path.join(root, "hook-output.json"),
+        "KOGEN_SHAPING_LAUNCH_ID" => "01965000-0000-7000-8000-000000000001"
+      })
+
+    {root, env}
+  end
+
+  defp run_hook!(root, env, opts \\ []) do
+    StopHook.run(root, env, Keyword.put_new(opts, :stdin, ""))
+    env["KOGEN_SHAPING_HOOK_OUTPUT"] |> File.read!() |> Jason.decode!()
+  end
+
+  defp hook_lines(root, slug) do
+    root
+    |> Path.join(".kogen/runtime/shaping-audits/#{slug}/hook.jsonl")
+    |> File.read!()
+    |> String.split("\n", trim: true)
+    |> Enum.map(&Jason.decode!/1)
+  end
+
+  defp hook_state(root, slug),
+    do:
+      root
+      |> Path.join(".kogen/runtime/shaping-audits/#{slug}/hook-state.json")
+      |> File.read!()
+      |> Jason.decode!()
+
+  test "H1 no package allows without creating audit runtime" do
+    root = Fixture.repo!(second_commit: false, working_tree: false, prior_failures: false)
+
+    env =
+      Fixture.audit_env!(root)
+      |> Map.merge(%{
+        "KOGEN_ROLE" => "shaper",
+        "KOGEN_SHAPING_INTENT_ID" => "missing",
+        "KOGEN_SHAPING_HOOK_OUTPUT" => Path.join(root, "out")
+      })
+
+    assert %{"continue" => true} = run_hook!(root, env)
+    refute File.exists?(Path.join(root, ".kogen/runtime/shaping-audits"))
+  end
+
+  test "H2 blocking reason records all blocking details and report last" do
+    {root, env} = setup_repo!("proof-defects")
+    %{"decision" => "block", "reason" => reason} = run_hook!(root, env)
+    assert String.starts_with?(reason, "blocking findings:\n")
+
+    assert String.ends_with?(
+             reason,
+             "report: " <>
+               Path.join(
+                 root,
+                 ".kogen/runtime/shaping-audits/proof-defects/" <>
+                   List.last(hook_lines(root, "proof-defects"))["revision"] <> "/report.json"
+               )
+           )
+
+    assert Enum.at(hook_lines(root, "proof-defects"), 0)["blocking"] |> length() == 9
+  end
+
+  test "H4 a stalled revision keeps the chain count and clears its clock" do
+    {root, env} = setup_repo!("proof-defects")
+    assert %{"decision" => "block"} = run_hook!(root, env)
+    assert %{"continue" => true} = run_hook!(root, env)
+    assert Enum.map(hook_lines(root, "proof-defects"), & &1["kind"]) == ["blocked", "stalled"]
+    state = hook_state(root, "proof-defects")
+    assert state["chain_blocks"] == 1
+    assert state["chain_start"] == nil
+  end
+
+  test "H5 the ninth changed revision escapes the block chain" do
+    {root, env} = setup_repo!("proof-defects")
+    package = Path.join(root, ".kogen/intents/drafts/proof-defects/INTENT.md")
+
+    decisions =
+      for n <- 1..9 do
+        File.write!(package, "revision #{n}\n")
+        run_hook!(root, env)
+      end
+
+    assert Enum.take(decisions, 8) |> Enum.all?(&(Map.get(&1, "decision") == "block"))
+    assert List.last(decisions)["continue"] == true
+
+    assert List.last(decisions)["systemMessage"] =~
+             "not ready after 8 blocks in this chain; allowing the stop to avoid a trap."
+
+    assert hook_state(root, "proof-defects")["chain_blocks"] == 0
+  end
+
+  test "H6 environment-only route is allowed without auditor launch" do
+    {root, env} = setup_repo!()
+    env = %{env | "KOGEN_SHAPING_ROUTE" => "other"}
+    assert %{"continue" => true, "systemMessage" => message} = run_hook!(root, env)
+    assert message == "not ready: environment — route other has no auditor setting"
+    assert Enum.at(hook_lines(root, "complete"), 0)["kind"] == "environment"
+    refute File.exists?(Path.join(root, ".kogen/runtime/fake-auditor/auditor.log"))
+  end
+
+  test "H8 approved packages are audited by intent id" do
+    root = Fixture.repo!()
+    package_rel = Fixture.add_draft!(root, "complete", dir: "approved")
+    {:ok, %{files: files}} = Package.load(root, package_rel)
+    {:ok, intent} = YamlElixir.read_from_string(files["intent.yaml"])
+
+    env =
+      Fixture.audit_env!(root)
+      |> Map.merge(%{
+        "KOGEN_ROLE" => "shaper",
+        "KOGEN_SHAPING_INTENT_ID" => intent["id"],
+        "KOGEN_SHAPING_ROUTE" => "codex",
+        "KOGEN_SHAPING_HOOK_OUTPUT" => Path.join(root, "out")
+      })
+
+    assert %{"continue" => true} = run_hook!(root, env)
+
+    report =
+      hook_lines(root, "complete")
+      |> hd()
+      |> Map.fetch!("report")
+      |> File.read!()
+      |> Jason.decode!()
+
+    assert report["package"] == ".kogen/intents/approved/complete"
+  end
+
+  test "H9 a build lock allows without audit" do
+    {root, env} = setup_repo!()
+    File.write!(Path.join(root, ".kogen/build.lock"), "lock")
+    assert %{"continue" => true} = run_hook!(root, env)
+    refute File.exists?(Path.join(root, ".kogen/runtime/shaping-audits"))
+  end
+
+  test "H10 developer role allows before role refusal" do
+    {root, env} = setup_repo!()
+    assert %{"continue" => true} = run_hook!(root, %{env | "KOGEN_ROLE" => "developer"})
+    refute File.exists?(Path.join(root, ".kogen/runtime/shaping-audits"))
+  end
+
+  test "H12 root rollout is audited while helper rollout is skipped" do
+    {root, env} = setup_repo!()
+    helper = Path.join(root, "helper.jsonl")
+    root_rollout = Path.join(root, "root.jsonl")
+    File.cp!("test/support/shaping_audit/hook/helper-rollout.jsonl", helper)
+    File.cp!("test/support/shaping_audit/hook/root-rollout.jsonl", root_rollout)
+
+    assert %{"continue" => true} =
+             run_hook!(root, env, stdin: Jason.encode!(%{"transcript_path" => helper}))
+
+    refute File.exists?(Path.join(root, ".kogen/runtime/shaping-audits"))
+
+    assert %{"continue" => true, "systemMessage" => _} =
+             run_hook!(root, env, stdin: Jason.encode!(%{"transcript_path" => root_rollout}))
+
+    assert length(hook_lines(root, "complete")) == 1
+  end
+
+  test "H13 audit errors are allowed and never cached" do
+    {root, env} = setup_repo!()
+
+    assert %{"continue" => true, "systemMessage" => message} =
+             run_hook!(root, env, read: fn _ -> raise "boom" end)
+
+    assert message == "shaping audit error: boom; run mix kogen.audit complete"
+    state = hook_state(root, "complete")
+    assert state["skip_key"] == nil
+    assert state["decision"] == nil
+
+    assert StopHook.block_reason([], 0, "/r/report.json") ==
+             "blocking findings:\nadvisory: 0\nreport: /r/report.json"
+  end
+
+  test "H14 auditor bound allows subsequent stops" do
+    {root, env} = setup_repo!("complete")
+    System.put_env("FAKE_AUDITOR_MESSAGE", "three-findings")
+    on_exit(fn -> System.delete_env("FAKE_AUDITOR_MESSAGE") end)
+    first = run_hook!(root, env)
+    File.write!(Path.join(root, ".kogen/intents/drafts/complete/INTENT.md"), "revision\n")
+    second = run_hook!(root, env)
+    assert first["decision"] == "block"
+    assert second["continue"] == true
+    assert Enum.at(hook_lines(root, "complete"), 1)["kind"] == "auditor-bound"
+  end
+
+  test "H15 old chain timestamps affect elapsed reporting but not the decision" do
+    {root, env} = setup_repo!("proof-defects")
+    now = DateTime.from_unix!(10_000_000, :millisecond)
+    dir = Path.join(root, ".kogen/runtime/shaping-audits/proof-defects")
+    File.mkdir_p!(dir)
+
+    File.write!(
+      Path.join(dir, "hook-state.json"),
+      Jason.encode!(%{
+        "chain_start" => 7_600_000,
+        "chain_blocks" => 1,
+        "last_revision" => "old",
+        "last_was_block" => true,
+        "audit_total_ms" => 0,
+        "auditor_bound_reached" => false,
+        "bound_head" => nil,
+        "skip_key" => nil,
+        "decision" => nil
+      })
+    )
+
+    assert %{"decision" => "block"} = run_hook!(root, env, clock: fn -> now end)
+    assert hd(hook_lines(root, "proof-defects"))["elapsed"]["chain_ms"] == 2_400_000
+  end
+
+  test "H17 elapsed fields are copied into reports and hook logs" do
+    {root, env} = setup_repo!()
+
+    assert %{"continue" => true} =
+             run_hook!(root, env, clock: fn -> DateTime.from_unix!(10_000_000, :millisecond) end)
+
+    line = hd(hook_lines(root, "complete"))
+    report = line["report"] |> File.read!() |> Jason.decode!()
+    assert report["elapsed"] == line["elapsed"]
+
+    assert Map.keys(line["elapsed"]) |> Enum.sort() == [
+             "audit_ms",
+             "audit_total_ms",
+             "budget_ms",
+             "chain_ms",
+             "complex",
+             "launch_ms"
+           ]
+  end
+
+  test "H18 the shell hook allows non-shaper roles without mix" do
+    root = Fixture.repo!(second_commit: false, working_tree: false, prior_failures: false)
+
+    {output, status} =
+      System.cmd("sh", [Path.expand("priv/kogen/shaping_audit/stop_hook.sh")],
+        cd: root,
+        env: [{"KOGEN_ROLE", "developer"}, {"KOGEN_ENV_RESTORE_PENDING", nil}]
