+        |> Enum.map(&(Map.keys(&1["questions"]) |> Enum.sort()))
+
+      assert [["gate", "settled_by"], ["confirm"]] = bodies
+    end
+
+    test "one invalid gate answer is retried once, then makes Jev unavailable" do
+      invalid =
+        Jason.encode!(%{
+          "model" => "jev-1.13.0",
+          "answers" => %{
+            "gate" => %{
+              "type" => "choice",
