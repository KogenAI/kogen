+      before = own_tmp_entries.()
+
+      assert Kogen.ShapingAudit.main(["--auditor", "complete"], root: root, env: env) in [0, 1]
+      assert own_tmp_entries.() == before
+    end
+  end
+
+  describe "the setup guard" do
