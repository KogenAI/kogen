+Code.require_file("../support/shaping_audit/fake_jev_audit.ex", __DIR__)
+
+defmodule Kogen.ShapingAuditQuestionGateTest do
+  @moduledoc """
+  The `question-gate` scenario: the shipped question-gate-v1 table against
