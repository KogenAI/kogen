diff --git a/test/support/shaping_audit/fake_jev_audit b/test/support/shaping_audit/fake_jev_audit
new file mode 100755
index 00000000..247f528f
--- /dev/null
+++ b/test/support/shaping_audit/fake_jev_audit
@@ -0,0 +1,127 @@
+#!/usr/bin/env python3
+"""Offline TypeSafe Jev transport for the Shaping audit's `Kogen.Jev.ask/3`
+calls (`question-set-v1`/`question-gate-v1`), selected through
+KOGEN_JEV_TRANSPORT in the audit's own tests. It is a copy of
+`test/support/fake_jev`, not an edit of it: `Kogen.Jev.ask/3` questions carry
+their own `type` (`choice` or `noul`) and `criteria` inline, rather than the
+Build handoff's fixed `status:`/`objection:` id prefixes, so this fake reads
+the question spec itself. It never opens a network connection.
+
+Kogen.Jev writes one length-prefixed JSON request ({url, timeout_ms, headers,
+body}) to stdin; this fake answers with one JSON transport result on stdout:
+{"status": N, "body": "..."} or {"error": "timeout" | reason}.
+
+FAKE_JEV_LOG_DIR (default .kogen/runtime/fake-jev-audit) receives
+request-N.json for every call, with the exact request body and whether the
+Authorization header carried the fake Keychain key. The key itself is never
+written.
+
+FAKE_JEV_RESPONSES names a directory of recorded transport results; call N
+replays N.json when it exists. Otherwise the fake answers every asked
+question with its first criteria option (a `choice`) or 0.05 (a `noul`),
+overridden per question id by FAKE_JEV_ANSWERS, a JSON object
+{question_id: [choice, confidence] | noul_value}.
+"""
+import json
+import os
+import pathlib
+import sys
+
+DEFAULT_KEY = "kogen-offline-sentinel-jev-key"
+
+length = int(sys.stdin.buffer.readline())
+payload = json.loads(sys.stdin.buffer.read(length))
+body = payload["body"]
+authorization = payload.get("headers", {}).get("authorization")
+expected = "Bearer " + os.environ.get("FAKE_JEV_KEY", DEFAULT_KEY)
+
+log_dir_name = os.environ.get("FAKE_JEV_LOG_DIR")
+if not log_dir_name:
+    print("FAKE_JEV_LOG_DIR is required", file=sys.stderr)
+    raise SystemExit(2)
+log_dir = pathlib.Path(log_dir_name)
+log_dir.mkdir(parents=True, exist_ok=True)
+# The audit's Jev layer calls this fake concurrently, so each call claims
+# its number with an exclusive create; counting files alone let two calls
+# pick the same number and interleave their bytes in one log file.
+number = len(list(log_dir.glob("request-*.json"))) + 1
+while True:
+    try:
+        descriptor = os.open(log_dir / f"request-{number}.json", os.O_WRONLY | os.O_CREAT | os.O_EXCL, 0o644)
+        break
+    except FileExistsError:
+        number += 1
+with os.fdopen(descriptor, "w") as handle:
+    handle.write(json.dumps({
+        "url": payload.get("url"),
+        "timeout_ms": payload.get("timeout_ms"),
+        "header_names": sorted(payload.get("headers", {}).keys()),
+        "authorization_matches_keychain": authorization == expected,
+        "body": body,
+    }))
+
+responses = os.environ.get("FAKE_JEV_RESPONSES")
+if responses:
+    recorded = pathlib.Path(responses) / f"{number}.json"
+    if recorded.exists():
+        sys.stdout.write(recorded.read_text())
+        raise SystemExit(0)
+
+request = json.loads(body)
+overrides = json.loads(os.environ.get("FAKE_JEV_ANSWERS", "{}"))
+answers = {}
+
+def default_choice(question_id, criteria):
+    if question_id.startswith("pc:"):
+        return "offline"
+    if question_id == "o" or question_id.startswith("paid"):
+        return "provider_only"
+    if "supported" in criteria:
+        return "supported"
+    if "with_provenance" in criteria:
+        return "with_provenance"
+    if question_id.startswith("kind:"): return "observable"
+    if question_id.startswith("asserted:"): return "asserted"
+    if question_id.startswith("cov:"): return next((c for c in criteria if c != "none"), criteria[0])
+    if question_id.startswith("plaus:"): return "plausible"
+    if question_id.startswith("non_goal") or question_id.startswith("non-goal"): return "none"
+    if question_id.startswith("provenance") or question_id.startswith("question-provenance"): return "with_provenance"
+    if question_id.startswith("caught_choice"): return next((c for c in criteria if c.startswith("e")), criteria[0])
+    if question_id.startswith("citation"): return "supported"
+    if question_id.startswith("paid"): return "provider_only"
+    if question_id.startswith("gate"): return "product_ux"
+    if question_id.startswith("settled_by"): return "none"
+    if question_id.startswith("fix-check"): return "addressed"
+    if question_id.startswith("confirm"): return "none"
+    return criteria[0]
+for question_id, spec in request["questions"].items():
+    if question_id in overrides:
+        override = overrides[question_id]
+    else:
+        override = None
+
+    if spec.get("type") == "noul":
+        noul = override if override is not None else 0.0
+        answers[question_id] = {"type": "noul", "noul": noul}
+    else:
+        criteria = list(spec.get("criteria", {}).keys()) or ["none"]
+        if override is not None:
+            choice, confidence = override
+        else:
+            choice, confidence = default_choice(question_id, criteria), 1.0
+        probabilities = {c: (confidence if c == choice else (1 - confidence) / max(len(criteria) - 1, 1)) for c in criteria}
+        answers[question_id] = {
+            "type": "choice",
+            "choice": choice,
+            "confidence": confidence,
+            "probabilities": probabilities,
+        }
+
+sys.stdout.write(json.dumps({
+    "status": 200,
+    "body": json.dumps({
+        "model": request["model"],
+        "answers": answers,
+        "usage": {"input_tokens": len(body) // 4, "output_tokens": 0},
+    }),
+}))
diff --git a/test/support/shaping_audit/fake_jev_audit.ex b/test/support/shaping_audit/fake_jev_audit.ex
new file mode 100644
index 00000000..e6dd897a
--- /dev/null
+++ b/test/support/shaping_audit/fake_jev_audit.ex
@@ -0,0 +1,99 @@
+defmodule Kogen.ShapingAudit.FakeJevAudit do
+  @moduledoc false
+
+  # In-process fakes for the Shaping audit's `Kogen.Jev.ask/3` requests.
+  # `answering/2` reads each request's own inline `type`/`criteria` (there is
+  # no fixed `status:`/`objection:` id scheme, unlike the Build handoff) and
+  # answers every asked question, by default or by override. `replay/2`
+  # replays a fixed list of raw transport results, like `Kogen.FakeJev`, for
+  # exercising every HTTP/timeout failure mode. Both log every request (with
+  # headers) to `owner` as `{:jev_request, request}` and never touch the
+  # network. The subprocess fakes `test/support/shaping_audit/fake_jev_audit`
+  # and `test/support/shaping_audit/fake_security_audit` exercise the same
+  # contract end-to-end, through KOGEN_JEV_TRANSPORT/KOGEN_JEV_SECURITY.
+
+  @sentinel "kogen-offline-sentinel-jev-key"
+
+  def sentinel_key, do: @sentinel
+
+  def root, do: System.get_env("KOGEN_TEST_ROOT") || Path.expand("../../..", __DIR__)
+  def transport_path, do: Path.join(root(), "test/support/shaping_audit/fake_jev_audit")
+  def security_path, do: Path.join(root(), "test/support/shaping_audit/fake_security_audit")
+
+  @doc """
+  A transport answering every question in every request: an override
+  `%{question_id => {choice, confidence} | confidence}` (Noul), or else the
+  first criteria option at confidence 0.9 (Choice) or 0.05 (Noul).
+  """
+  def answering(overrides \\ %{}, owner \\ self()) do
+    fn request ->
+      send(owner, {:jev_request, request})
+      body = Jason.decode!(request.body)
+
+      answers =
+        Map.new(body["questions"], fn {id, spec} -> {id, answer_for(id, spec, overrides)} end)
+
+      response =
+        Jason.encode!(%{
+          "model" => body["model"],
+          "answers" => answers,
+          "usage" => %{"input_tokens" => byte_size(request.body) |> div(4), "output_tokens" => 0}
+        })
+
+      {:ok, %{status: 200, body: response}}
+    end
+  end
+
+  defp answer_for(id, %{"type" => "noul"}, overrides) do
+    noul = Map.get(overrides, id, 0.05)
+    %{"type" => "noul", "noul" => noul}
+  end
+
+  defp answer_for(id, %{"type" => "choice", "criteria" => criteria}, overrides) do
+    # Erlang map key order is randomized per VM instance for maps beyond a
+    # few entries; sort explicitly so the un-overridden default is the same
+    # answer on every run.
+    options = criteria |> Map.keys() |> Enum.sort()
+
+    {choice, confidence, probabilities} =
+      case Map.get(overrides, id) do
+        nil -> {List.first(options), 0.9, nil}
+        {choice, confidence} -> {choice, confidence, nil}
+        {choice, confidence, probabilities} -> {choice, confidence, probabilities}
+      end
+
+    %{
+      "type" => "choice",
+      "choice" => choice,
+      "confidence" => confidence,
+      "probabilities" => probabilities || uniform(options, choice, confidence)
+    }
+  end
+
+  defp uniform(options, choice, confidence) do
+    rest = max(length(options) - 1, 1)
+
+    Map.new(options, fn option ->
+      {option, if(option == choice, do: confidence, else: (1 - confidence) / rest)}
+    end)
+  end
+
+  @doc "A transport replaying `results` in order (the last one repeats), like `Kogen.FakeJev.transport/2`."
+  def replay(results, owner \\ self()) do
+    {:ok, agent} = Agent.start_link(fn -> results end)
+
+    fn request ->
+      send(owner, {:jev_request, request})
+
+      Agent.get_and_update(agent, fn
+        [last] -> {last, [last]}
+        [next | rest] -> {next, rest}
+      end)
+      |> case do
+        {:timeout} -> {:error, :timeout}
+        {:error, reason} -> {:error, reason}
+        {status, body} -> {:ok, %{status: status, body: body}}
+      end
+    end
+  end
+end
