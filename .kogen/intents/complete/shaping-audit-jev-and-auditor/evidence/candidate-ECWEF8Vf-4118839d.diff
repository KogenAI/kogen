+
+  describe "gate routing of auditor findings in the autonomous state" do
+    setup do
+      root = Path.join(@drafts, "jev-clauses")
+
+      ctx = %{
+        root: root,
+        slug: "jev-clauses",
+        package_rel: ".x",
