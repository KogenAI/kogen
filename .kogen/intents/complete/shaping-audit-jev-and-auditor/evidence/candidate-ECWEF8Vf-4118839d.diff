+    end
+
+    test "a Shaper-routed finding becomes an assumption, never a question", %{
+      ctx: ctx,
+      finding: finding
+    } do
+      transport =
+        FakeJevAudit.answering(%{
+          "gate" =>
+            {"product_ux", 0.9,
+             %{"product_ux" => 0.9, "technical" => 0.05, "already_settled" => 0.05}},
