diff --git a/lib/kogen/build/failure_report.ex b/lib/kogen/build/failure_report.ex
new file mode 100644
index 00000000..89a8b3d9
--- /dev/null
+++ b/lib/kogen/build/failure_report.ex
@@ -0,0 +1,250 @@
+# credo:disable-for-this-file Credo.Check.Design.AliasUsage
+# credo:disable-for-this-file Credo.Check.Refactor.Nesting
+# credo:disable-for-this-file Credo.Check.Refactor.CyclomaticComplexity
+defmodule Kogen.Build.FailureReport do
+  @moduledoc "Durable, one-per-build summaries for terminal Build failures."
+
+  alias Kogen.Build.FailureSignature
+
+  @schema_version 1
+
+  @categories %{
+    "verification-exhausted" => {"item", "rebuild"},
+    "offline-exhausted" => {"item", "rebuild"},
+    "unchanged-candidate" => {"item", "rebuild"},
+    "outer-allowance-exhausted" => {"item", "rebuild"},
+    "guard-violation" => {"item", "rebuild"},
+    "protected-path" => {"item", "rebuild"},
+    "git-policy" => {"item", "rebuild"},
+    "integrity" => {"item", "rebuild"},
+    "review-failure" => {"item", "rebuild"},
+    "cannot-comply" => {"shaping", "reshape_scope"},
+    "environment" => {"environment", "environment"},
+    "provider-failure" => {"environment", "environment"},
+    "write-boundary" => {"environment", "environment"},
+    "admission" => {"environment", "environment"},
+    "publication-failed" => {"environment", "environment"},
+    "accepted-unpublished" => {"environment", "inspect"},
+    "provider" => {"provider", "provider_wait"},
+    "interrupted" => {"interrupted", "continue"},
+    "publication-interrupted" => {"interrupted", "inspect"},
+    "session-lost" => {"interrupted", "rebuild"}
+  }
+
+  def report_path(control, build_id),
+    do:
+      Path.join([
+        Path.expand(control),
+        ".kogen/runtime/scenario-tracking",
+        build_id,
+        "failure-report.json"
+      ])
+
+  def classify(category) do
+    Map.get(@categories, category, {"item", "rebuild"})
+  end
+
+  @doc "Writes a report exactly once. Existing bytes are never replaced."
+  def write(control, build_id, report)
+      when is_binary(control) and is_binary(build_id) and is_map(report) do
+    path = report_path(control, build_id)
+    File.mkdir_p(Path.dirname(path))
+
+    bytes =
+      Jason.encode_to_iodata!(Map.put_new(report, "schema_version", @schema_version),
+        pretty: true
+      )
+
+    case File.open(path, [:write, :exclusive, :binary]) do
+      {:ok, io} ->
+        try do
+          with :ok <- IO.binwrite(io, bytes), :ok <- :file.sync(io) do
+            {:ok, path}
+          end
+        after
+          File.close(io)
+        end
+
+      {:error, :eexist} ->
+        {:ok, path}
+
+      {:error, reason} ->
+        {:error, "could not write failure report #{path}: #{inspect(reason)}"}
+    end
+  end
+
+  @doc "Builds and persists a report from a live Build context."
+  # credo:disable-for-next-line Credo.Check.Refactor.CyclomaticComplexity
+  def record_failure(ctx, category, reason, details \\ %{}) do
+    build_id =
+      get_in(ctx, [:tracking, :record, "build_id"]) || get_in(ctx, [:candidate, :build_id]) ||
+        "unknown"
+
+    control = ctx[:control] || File.cwd!()
+    {class, next_action} = classify(category)
+    attempt = List.last(get_in(ctx, [:tracking, :record, "attempts"]) || []) || %{}
+    signature = details["signature"] || List.last(attempt["failure_signatures"] || [])
+
+    report = %{
+      "build_id" => build_id,
+      "candidate_build_id" => get_in(ctx, [:candidate, :build_id]),
+      "continues" => nil,
+      "slug" => get_in(ctx, [:tracking, :record, "slug"]) || ctx[:slug],
+      "intent_id" => get_in(ctx, [:tracking, :record, "intent_id"]) || ctx[:intent_id],
+      "approved_package_digest" => get_in(ctx, [:tracking, :record, "approved_package_digest"]),
+      "stopped_at" => DateTime.utc_now() |> DateTime.truncate(:second) |> DateTime.to_iso8601(),
+      "category" => category,
+      "stop_class" => details["stop_class"] || attempt["stop_class"],
+      "class" => class,
+      "signature" => signature || FailureSignature.for_stop(category, reason),
+      "budget_state" => details["budget_state"] || attempt["budget_state"] || budget_state(ctx),
+      "published" => nil,
+      "counts_toward" =>
+        if(class in ["item", "shaping"],
+          do: "item",
+          else: if(class == "environment", do: "environment")
+        ),
+      "same_signature_count" =>
+        same_signature_count(
+          control,
+          signature || FailureSignature.for_stop(category, reason),
+          category
+        ),
+      "next_action" => next_action,
+      "next_command" => details["next_command"],
+      "continuable" => category in ["provider", "interrupted"],
+      "developer_session_id" =>
+        details["developer_session_id"] || attempt["developer_session_id"],
+      "reason" => String.slice(to_string(reason), 0, 2_000),
+      "candidate" => candidate_block(ctx),
+      "record" => get_in(ctx, [:tracking, :path]),
+      "record_sha256" => record_sha(ctx)
+    }
+
+    write(control, build_id, report)
+  rescue
+    _error -> {:error, "failure report could not be constructed"}
+  end
+
+  @doc "Reconciles owner records whose controller disappeared while running."
+  # credo:disable-for-next-line Credo.Check.Refactor.CyclomaticComplexity
+  def reconcile(control) when is_binary(control) do
+    control = Path.expand(control)
+
+    for {:ok, owner} <- Kogen.Build.Workspace.list(control),
+        owner["status"] == "stopped: interrupted" do
+      build_id = owner["build_id"]
+      path = report_path(control, build_id)
+
+      unless File.exists?(path) do
+        category =
+          if owner["status"] == "accepted", do: "publication-interrupted", else: "interrupted"
+
+        record_path =
+          Path.join([control, ".kogen/runtime/scenario-tracking", build_id, "record.json"])
+
+        record =
+          case File.read(record_path) do
+            {:ok, bytes} -> Jason.decode(bytes) |> elem(1)
+            _ -> %{}
+          end
+
+        attempt = List.last(record["attempts"] || []) || %{}
+
+        report = %{
+          "build_id" => build_id,
+          "candidate_build_id" => build_id,
+          "continues" => nil,
+          "slug" => record["slug"],
+          "intent_id" => record["intent_id"],
+          "approved_package_digest" => record["approved_package_digest"],
+          "stopped_at" =>
+            DateTime.utc_now() |> DateTime.truncate(:second) |> DateTime.to_iso8601(),
+          "category" => category,
+          "stop_class" => attempt["stop_class"],
+          "class" => elem(classify(category), 0),
+          "signature" =>
+            List.last(attempt["cycle_signatures"] || []) ||
+              List.last(attempt["failure_signatures"] || []) ||
+              FailureSignature.for_stop(category, "controller interrupted"),
+          "budget_state" => attempt["budget_state"],
+          "published" => nil,
+          "counts_toward" => nil,
+          "same_signature_count" => 1,
+          "next_action" => elem(classify(category), 1),
+          "next_command" => nil,
+          "continuable" =>
+            category == "interrupted" and not is_nil(attempt["developer_session_id"]),
+          "developer_session_id" => attempt["developer_session_id"],
+          "reason" => "controller interrupted",
+          "candidate" => owner,
+          "record" => record_path,
+          "record_sha256" => file_sha(record_path)
+        }
+
+        write(control, build_id, report)
+      end
+    end
+
+    :ok
+  end
+
+  def reconcile(_), do: :ok
+
+  defp file_sha(path) do
+    case File.read(path) do
+      {:ok, bytes} -> Base.encode16(:crypto.hash(:sha256, bytes), case: :lower)
+      _ -> nil
+    end
+  end
+
+  defp budget_state(ctx) do
+    case ctx[:execution] do
+      %{state: state} when is_map(state) -> state
+      _ -> nil
+    end
+  end
+
+  # credo:disable-for-next-line Credo.Check.Refactor.Nesting
+  defp same_signature_count(control, signature, category) do
+    digest = signature && signature["digest"]
+
+    if is_nil(digest),
+      do: 1,
+      else:
+        1 +
+          (Path.join(
