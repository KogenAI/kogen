diff --git a/lib/kogen/build/continuation.ex b/lib/kogen/build/continuation.ex
new file mode 100644
index 00000000..1c74c4e9
--- /dev/null
+++ b/lib/kogen/build/continuation.ex
@@ -0,0 +1,47 @@
+defmodule Kogen.Build.Continuation do
+  @moduledoc "Pure checks used when adopting an interrupted Candidate."
+
+  @set ["provider", "interrupted", "publication-interrupted"]
+
+  def continuation_categories, do: @set
+  def member?(category), do: category in @set
+
+  # credo:disable-for-next-line Credo.Check.Refactor.CyclomaticComplexity
+  def decide(reports, current) when is_list(reports) and is_map(current) do
+    cond do
+      length(reports) > 1 ->
+        {:refuse, "ambiguous"}
+
+      reports == [] ->
+        :fresh
+
+      record_changed?(hd(reports)) ->
+        {:refuse, "record-changed"}
+
+      hd(reports)["category"] == "publication-interrupted" ->
+        {:refuse, "publication-started"}
+
+      is_nil(hd(reports)["developer_session_id"]) ->
+        {:refuse, "no-session"}
+
+      hd(reports)["approved_package_digest"] != current["approved_package_digest"] ->
+        {:refuse, "package-changed"}
+
+      hd(reports)["admitted_commit"] != current["admitted_commit"] ->
+        {:refuse, "control-moved"}
+
+      true ->
+        {:continue, hd(reports)}
+    end
+  end
+
+  def decide(_, _), do: :fresh
+
+  defp record_changed?(report) do
+    path = report["record"]
+    expected = report["record_sha256"]
+
+    is_binary(path) and is_binary(expected) and File.exists?(path) and
+      Base.encode16(:crypto.hash(:sha256, File.read!(path)), case: :lower) != expected
+  end
+end
