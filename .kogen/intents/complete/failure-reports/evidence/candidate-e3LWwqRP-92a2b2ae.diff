diff --git a/lib/kogen/build/failure_report.ex b/lib/kogen/build/failure_report.ex
new file mode 100644
index 00000000..fa3f07fe
--- /dev/null
+++ b/lib/kogen/build/failure_report.ex
@@ -0,0 +1,173 @@
+defmodule Kogen.Build.FailureReport do
+  @moduledoc "Durable failure reports for stopped Builds."
+  # credo:disable-for-this-file Credo.Check.Refactor.CyclomaticComplexity
+  # credo:disable-for-this-file Credo.Check.Refactor.Nesting
+  alias Kogen.Build.FailureSignature
+  @schema_version 1
+  @categories %{
+    "verification-exhausted" => {"item", "rebuild"},
+    "offline-exhausted" => {"item", "rebuild"},
+    "unchanged-candidate" => {"item", "rebuild"},
+    "outer-allowance-exhausted" => {"item", "rebuild"},
+    "guard-violation" => {"item", "rebuild"},
+    "protected-path" => {"item", "rebuild"},
+    "git-policy" => {"item", "rebuild"},
+    "integrity" => {"item", "rebuild"},
+    "review-failure" => {"item", "rebuild"},
+    "cannot-comply" => {"shaping", "reshape_scope"},
+    "environment" => {"environment", "environment"},
+    "provider-failure" => {"environment", "environment"},
+    "write-boundary" => {"environment", "environment"},
+    "admission" => {"environment", "environment"},
+    "publication-failed" => {"environment", "environment"},
+    "accepted-unpublished" => {"environment", "inspect"},
+    "provider" => {"provider", "provider_wait"}
+  }
+  def report_path(control, build_id),
+    do:
+      Path.join([
+        Path.expand(control),
+        ".kogen/runtime/scenario-tracking",
+        build_id,
+        "failure-report.json"
+      ])
+
+  def classify(category), do: Map.get(@categories, category, {"item", "rebuild"})
+
+  def write(control, build_id, report) do
+    path = report_path(control, build_id)
+    File.mkdir_p!(Path.dirname(path))
+
+    bytes =
+      Jason.encode_to_iodata!(Map.put_new(report, "schema_version", @schema_version),
+        pretty: true
+      )
+
+    tmp = path <> ".tmp-" <> Integer.to_string(System.unique_integer([:positive]))
+
+    case File.write(tmp, bytes, [:binary, :exclusive]) do
+      :ok ->
+        result =
+          case File.exists?(path) do
+            true ->
+              File.rm(tmp)
+              {:ok, path}
+
+            false ->
+              File.rename(tmp, path)
+          end
+
+        if result != {:ok, path}, do: File.rm(tmp)
+        if result == :ok, do: {:ok, path}, else: result
+
+      {:error, :eexist} ->
+        {:ok, path}
+
+      {:error, reason} ->
+        {:error, inspect(reason)}
+    end
+  end
+
+  def record_failure(ctx, category, reason, details \\ %{}) do
+    control = ctx[:control] || File.cwd!()
+    build_id = Path.basename(Path.dirname(ctx.tracking.path))
+    record = ctx.tracking.record || %{}
+    intent = record["intent"] || %{}
+    attempt = List.last(record["attempts"] || []) || %{}
+
+    signature =
+      details["signature"] || List.last(attempt["failure_signatures"] || []) ||
+        List.last(attempt["cycle_signatures"] || []) ||
+        FailureSignature.for_stop(category, reason)
+
+    {class, base_action} = classify(category)
+
+    count =
+      same_signature_count(
+        control,
+        intent["intent_id"],
+        record["approved_package_digest"],
+        signature["digest"]
+      )
+
+    action = if class == "item" and count >= 2, do: "reshape_details", else: base_action
+
+    report = %{
+      "build_id" => build_id,
+      "candidate_build_id" => get_in(ctx, [:candidate, :build_id]),
+      "slug" => intent["slug"] || ctx[:slug],
+      "intent_id" => intent["intent_id"] || ctx[:intent],
+      "approved_package_digest" => record["approved_package_digest"],
+      "stopped_at" => DateTime.utc_now() |> DateTime.to_iso8601(),
+      "category" => category,
+      "stop_class" => details["stop_class"] || attempt["stop_class"],
+      "class" => class,
+      "counts_toward" =>
+        if(class in ["item", "shaping"],
+          do: "item",
+          else: if(class == "environment", do: "environment")
+        ),
+      "signature" => signature,
+      "same_signature_count" => count,
+      "next_action" => action,
+      "next_command" => details["next_command"] || command_from_reason(reason),
+      "developer_session_id" =>
+        details["developer_session_id"] || attempt["developer_session_id"],
+      "reason" => String.slice(to_string(reason), 0, 2000),
+      "candidate" => candidate_block(ctx),
+      "record" => Path.relative_to(ctx.tracking.path, Path.expand(control)),
+      "record_sha256" =>
+        Base.encode16(
+          :crypto.hash(:sha256, ctx.tracking.bytes || Jason.encode_to_iodata!(record)),
+          case: :lower
+        )
+    }
+
+    write(control, build_id, report)
+  end
+
+  defp command_from_reason(reason) do
+    case Regex.run(~r/Run (mix kogen\.[^\s`]+(?: --project)?)/, to_string(reason)) do
+      [_, cmd] -> cmd
+      _ -> nil
+    end
+  end
+
+  defp candidate_block(ctx),
+    do:
