diff --git a/test/kogen/failure_report_test.exs b/test/kogen/failure_report_test.exs
new file mode 100644
index 00000000..19409212
--- /dev/null
+++ b/test/kogen/failure_report_test.exs
@@ -0,0 +1,70 @@
+defmodule Kogen.FailureReportTest do
+  use ExUnit.Case, async: true
+
+  alias Kogen.Build.{FailureHandoff, FailureReport, FailureSignature}
+  alias Kogen.Harness.ProviderMarker
+
+  test "writes one durable report and never overwrites it" do
+    root = Path.join(System.tmp_dir!(), "kogen-report-#{System.unique_integer([:positive])}")
+    on_exit(fn -> File.rm_rf(root) end)
+
+    assert {:ok, path} = FailureReport.write(root, "build-1", %{"category" => "provider"})
+    assert {:ok, ^path} = FailureReport.write(root, "build-1", %{"category" => "integrity"})
+
+    assert %{"category" => "provider", "schema_version" => 1} =
+             path |> File.read!() |> Jason.decode!()
+  end
+
+  test "classifies terminal categories and produces stable stop signatures" do
+    assert {"provider", "provider_wait"} = FailureReport.classify("provider")
+    assert {"environment", "environment"} = FailureReport.classify("environment")
+    first = FailureSignature.for_stop("integrity", "broken input")
+    assert first["digest"] == FailureSignature.for_stop("integrity", "broken input")["digest"]
+  end
+
+  test "renders the first failure block and reproduction guidance" do
+    prompt =
+      FailureHandoff.render(%{
+        cycle: %{
+          "sequence" => 1,
+          "candidate_id" => "c",
+          "class" => "offline",
+          "failure" => %{
+            "target" => "check",
+            "kind" => "target",
+            "log_path" => "log",
+            "log_sha256" => "x"
+          },
+          "signature" => %{
+            "target" => "check",
+            "first_failure" => "test.exs:1",
+            "error_head" => "boom",
+            "reproduce" => "MIX_ENV=test mix test"
+          }
+        },
+        state: %{},
+        context: %{"verification_retries" => 1},
+        control: "/tmp",
+        candidate_root: "/tmp",
+        receipt_path: fn _, _ -> "none" end
+      })
+
+    assert prompt =~ "## First failure"
+    assert prompt =~ "Reproduce: MIX_ENV=test mix test"
+    assert prompt =~ "Passes in isolation is not acceptable"
+  end
+
+  test "committed login excerpts carry provenance and classify as login rejection" do
+    for file <- ["xfjcrm76_claude_oauth_revoked.json", "synthetic_codex_refresh_failed.json"] do
+      json =
+        Path.join([__DIR__, "../support/provider_tails", file])
+        |> Path.expand()
+        |> File.read!()
+        |> Jason.decode!()
+
+      assert is_map(json["provenance"])
+      assert is_binary(json["output"])
+      assert %{"kind" => "login_rejected"} = ProviderMarker.login_failure(json["output"])
+    end
+  end
+end
