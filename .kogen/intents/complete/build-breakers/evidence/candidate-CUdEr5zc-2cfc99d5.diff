@@ -0,0 +1,214 @@
+defmodule Kogen.BuildBreakersTest do
+  use Kogen.IsolatedCase, async: true
+
+  alias Kogen.Build.{Breakers, FailureHandoff}
+  alias Kogen.WorkspaceFixture, as: Workspace
+
+  defp reports(control) do
+    Breakers.reports(control)
+  end
+
+  defp report!(control, build_id, attrs) do
+    path = Path.join(control, ".kogen/runtime/scenario-tracking/#{build_id}/failure-report.json")
+    File.mkdir_p!(Path.dirname(path))
+    File.write!(path, Jason.encode!(Map.merge(%{"build_id" => build_id}, attrs)))
+    path
+  end
+
+  test "item breaker refuses a third unchanged Build before admission" do
+    control = Workspace.create!()
+    on_exit(fn -> File.rm_rf(control) end)
+
+    opts = [harness: Workspace.support("fake_codex"), env: [{"FAKE_CHECK_FAIL_ALWAYS", "1"}]]
+    assert {:error, first} = Workspace.build!(control, opts)
+    assert first =~ "category: offline-exhausted"
+    assert {:error, second} = Workspace.build!(control, opts)
+    assert second =~ "category: offline-exhausted"
+    [one, two] = reports(control)
+    assert one.report["signature"]["digest"] == two.report["signature"]["digest"]
+
+    marker = Workspace.tmp_dir!("breaker-marker") |> Path.join("launched")
+
+    sentinel =
+      Workspace.fake!(
+        Workspace.tmp_dir!("breaker-sentinel"),
+        "sentinel",
+        "#!/bin/sh\ntouch #{marker}\nexit 1\n"
+      )
+
+    assert {:error, refusal} =
+             Workspace.build!(control,
+               harness: sentinel,
+               env: [{"FAKE_CHECK_FAIL_ALWAYS", "1"}]
+             )
+
+    assert refusal ==
+             "Build refused (item breaker): workspace-fixture stopped 2 times with the same failure signature on this Approved package; next action: reshape_details; first failure: check; signature: #{one.report["signature"]["digest"]}; failure reports: #{one.path}, #{two.path}"
+
+    refute File.exists?(marker)
+    assert length(reports(control)) == 2
+  end
+
+  test "item breaker recounts files and keys package and intent" do
+    control = Workspace.tmp_dir!("breaker-reports")
+    on_exit(fn -> File.rm_rf(control) end)
+
+    base = %{
+      "intent_id" => "intent-1",
+      "approved_package_digest" => "package-1",
+      "counts_toward" => "item",
+      "class" => "item",
+      "stopped_at" => "2026-01-01T00:00:00.000001Z",
+      "signature" => %{"digest" => "same", "first_failure" => "check", "source" => "tail"}
+    }
+
+    first = report!(control, "one", base)
+    report!(control, "two", %{base | "stopped_at" => "2026-01-01T00:00:00.000002Z"})
+    assert {:error, message} = Breakers.item_refusal(control, "intent-1", "package-1", "demo")
+    assert message =~ "next action: reshape_details"
+    File.rm!(first)
+    assert :ok = Breakers.item_refusal(control, "intent-1", "package-1", "demo")
+    report!(control, "other", %{base | "intent_id" => "intent-2"})
+    assert :ok = Breakers.item_refusal(control, "intent-1", "package-1", "demo")
+    assert :ok = Breakers.item_refusal(control, "intent-1", "package-2", "demo")
+  end
+
+  test "environment run spans intents, skips providers, and clears from disk" do
+    control = Workspace.tmp_dir!("environment-reports")
+    on_exit(fn -> File.rm_rf(control) end)
+
+    env = fn id, time ->
+      report!(control, id, %{
+        "intent_id" => id,
+        "counts_toward" => "environment",
+        "stopped_at" => time,
+        "next_command" => "mix kogen.claude.login",
+        "signature" => %{"digest" => id}
+      })
+    end
+
+    p1 = env.("one", "2026-01-01T00:00:00.000001Z")
+    p2 = env.("two", "2026-01-01T00:00:00.000002Z")
+    p3 = env.("three", "2026-01-01T00:00:00.000003Z")
+    assert %{tripped: true, run: run} = Breakers.environment_state(control)
+    assert Enum.map(run, & &1.path) == [p1, p2, p3]
+    tracking = Path.join(control, ".kogen/runtime/scenario-tracking/clear/record.json")
+    assert :ok = Breakers.write_clear(tracking, "readiness", run)
+    assert %{tripped: false, run: []} = Breakers.environment_state(control)
+    clear = Breakers.clear_path(tracking) |> File.read!() |> Jason.decode!()
+    assert clear["reason"] == "readiness"
+    assert clear["reports"] == [p1, p2, p3]
+  end
+
+  test "item reports choose shaping action and stop signatures stay out of prompts" do
+    control = Workspace.tmp_dir!("shaping-reports")
+    on_exit(fn -> File.rm_rf(control) end)
+
+    attrs = %{
+      "intent_id" => "intent-1",
+      "approved_package_digest" => "package-1",
+      "counts_toward" => "item",
+      "class" => "shaping",
+      "stopped_at" => "2026-01-01T00:00:00.000001Z",
+      "signature" => %{
+        "digest" => "shape",
+        "first_failure" => "cannot-comply",
+        "source" => "stop"
+      }
+    }
+
+    report!(control, "a", attrs)
+    report!(control, "b", %{attrs | "stopped_at" => "2026-01-01T00:00:00.000002Z"})
+    assert {:error, message} = Breakers.item_refusal(control, "intent-1", "package-1", "demo")
+    assert message =~ "next action: reshape_scope"
+    assert Breakers.latest_item_report(control, "intent-1", "package-1") == nil
+
+    assert is_binary(
+             FailureHandoff.first_failure_block(%{
+               "source" => "stop",
+               "target" => "cannot-comply"
+             })
+           )
+  end
+
+  test "canonical first failure block is reusable by fresh prompts" do
+    signature = %{
+      "target" => "check",
+      "first_failure" => "check",
+      "error_head" => "make: *** [check] Error 1",
+      "source" => "tail"
+    }
+
+    block = FailureHandoff.first_failure_block(signature)
+    assert block =~ "## First failure"
+    assert block =~ "- Target: check"
+    assert block =~ "Previous failure report" == false
+    assert block =~ "Passes in isolation is not acceptable"
+  end
+
+  test "environment breaker probes only after three consecutive environment stops" do
+    control = Workspace.create!(route: :claude)
+    claude_root = Workspace.claude_root!()
+    on_exit(fn -> File.rm_rf(control) end)
+
+    build = fn logged_out ->
+      cwd = Workspace.tmp_dir!("breaker-cwd")
+
+      env = [
+        {"KOGEN_CLAUDE_ROOT", claude_root},
+        {"KOGEN_HARNESS_HOME", nil},
+        {"FAKE_CLAUDE_LOGGED_OUT", if(logged_out, do: "1", else: "0")}
+      ]
+
+      Workspace.build!(control,
+        route: "claude",
+        cwd: cwd,
+        harness: Workspace.support("fake_claude"),
+        env: env
+      )
+    end
+
+    for _ <- 1..3 do
+      assert {:error, message} = build.(true)
+      assert message =~ "category: environment"
+    end
+
+    cwd4 = Workspace.tmp_dir!("breaker-cwd-refused")
+
+    assert {:error, refusal} =
+             Workspace.build!(control,
+               route: "claude",
+               cwd: cwd4,
+               harness: Workspace.support("fake_claude"),
+               env: [
+                 {"KOGEN_CLAUDE_ROOT", claude_root},
+                 {"KOGEN_HARNESS_HOME", nil},
+                 {"FAKE_CLAUDE_LOGGED_OUT", "1"}
+               ]
+             )
+
+    assert refusal =~ "Build refused (environment breaker): 3 environment stops in a row"
+    assert File.read!(Path.join(cwd4, ".kogen/runtime/fake-harness-log")) =~ "argv: auth status"
+    assert length(reports(control)) == 3
+  end
+
+  test "a second Build carries the latest matching failure into its first prompt" do
+    control = Workspace.create!()
+    on_exit(fn -> File.rm_rf(control) end)
+    opts = [harness: Workspace.support("fake_codex"), env: [{"FAKE_CHECK_FAIL_ALWAYS", "1"}]]
+    assert {:error, _} = Workspace.build!(control, opts)
+    first = reports(control) |> List.first() |> Map.fetch!(:report)
+    assert {:error, _} = Workspace.build!(control, opts)
+    second = reports(control) |> List.last() |> Map.fetch!(:report)
+
+    prompt =
+      second["candidate"]["harness_home"]
+      |> Path.join("fake-state/developer-launch-prompt")
+      |> File.read!()
+
+    assert prompt =~ "## First failure"
+    assert prompt =~ "- Target: #{first["signature"]["target"]}"
+    assert prompt =~ "Previous failure report:"
+    assert prompt =~ Breakers.reports(control) |> List.first() |> Map.fetch!(:path)
+  end
+end
