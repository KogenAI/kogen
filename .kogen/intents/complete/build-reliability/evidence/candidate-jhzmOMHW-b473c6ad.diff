+      quality = mined!("r9oe4fcp_c2_live_shaping_quality")
+      suite = mined!("r9oe4fcp_suite_failure")
+      case_log = mined!("r9oe4fcp_stateful_flawed_case_log")
+
+      evidence = %{
+        "manifest" => %{"path" => "evidence/manifest.json", "sha256" => sha("manifest")},
