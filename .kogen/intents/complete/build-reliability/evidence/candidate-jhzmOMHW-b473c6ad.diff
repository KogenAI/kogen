+        "sequence" => 5,
+        "candidate_id" => String.duplicate("d", 40),
+        "class" => "offline",
+        "receipts" => receipts,
+        "failure" => %{
+          "kind" => "target",
+          "target" => "target-1",
+          "class" => "offline",
+          "log_path" => log("target-1"),
+          "log_sha256" => sha("target-1"),
+          "output" => noise
+        }
+      }
+
+      prompt = render(cycle, %{"failures_since_pass" => 0, "offline_failures" => 1})
