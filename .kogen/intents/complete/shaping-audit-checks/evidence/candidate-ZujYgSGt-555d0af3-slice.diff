+
+  test "asking state: a missing scenarios.yaml is never package-invalid, and only question rules run" do
+    root = fixture_repo!()
+
+    questions_text = """
+    ## Ask the Shaper
+
+    1. Pick a color?
+       Recommendation: blue
+       Evidence: "the Shaper decided in conversation"
+    """
+
+    questions = Questions.parse(questions_text)
+    assert Questions.state(questions) == :asking
+
+    ctx = %{
+      root: root,
+      slug: "asking-case",
+      package_rel: ".kogen/intents/drafts/asking-case",
+      materialization: root,
+      files: %{"intent.yaml" => "id: x\n", "questions.md" => questions_text},
+      intent: nil,
+      scenarios: nil,
+      questions: questions,
+      state: :asking,
+      head: Fixture.head(root),
+      revision: "deadbeef",
+      route: "test",
+      config: nil,
+      env: %{},
+      opts: []
+    }
+
+    result = Deterministic.run(ctx)
+    assert result == %{"status" => "ok", "findings" => []}
+  end
+
+  # -- repository-invalid: committed catalog and Makefile disagree ------------
+
+  test "a committed catalog that does not match the committed Makefile gives repository-invalid instead of the catalog rules" do
+    root = fixture_repo!(working_tree: false)
+    makefile = Path.join(root, "Makefile")
+    File.write!(makefile, File.read!(makefile) <> "live-y:\n\t@true\n")
+    {_out, 0} = System.cmd("git", ["commit", "-q", "-am", "Declare live-y"], cd: root)
+
+    ctx = draft_ctx!(root, "proof-defects")
+    result = Deterministic.run(ctx)
+
+    assert %{"scope" => "environment", "severity" => "blocking"} =
+             invalid = find(result, "repository-invalid")
+
+    assert invalid["message"] =~ "does not match declared Make targets"
+
+    catalog_rules =
+      ~w(unguarded-affected-path proof-selector-missing unsupported-selector unknown-target
+         verified-by-invalid paid-reason-malformed controller-read-path
+         edited-live-owner-unselected paid-path-unproven paid-target-overbroad)
+
+    refute Enum.any?(result["findings"], fn finding ->
+             Enum.any?(catalog_rules, &String.starts_with?(finding["id"], &1))
+           end)
+  end
+
+  # -- complete: build/4 succeeds and proof_errors/4 agrees ------------------
+
+  test "complete: build/4 returns {:ok, _} and proof_errors/4 is empty" do
+    root = fixture_repo!()
+    ctx = draft_ctx!(root, "complete")
+
+    {:ok, catalog} = VerificationPlan.load(ctx.materialization)
+    guards = ctx.intent["may_change_guarded_paths"]
+
+    assert {:ok, _plan} =
+             VerificationPlan.build(ctx.scenarios, guards, catalog, ctx.materialization)
+
+    assert VerificationPlan.proof_errors(ctx.scenarios, guards, catalog, ctx.materialization) ==
+             []
+  end
+
+  test "proof_errors/4 is empty exactly when build/4 returns {:ok, _}, on every fixture Draft" do
+    root = fixture_repo!()
+
+    for name <- @drafts -- ["invalid"] do
+      ctx = draft_ctx!(root, name)
+
+      case VerificationPlan.load(ctx.materialization) do
+        {:ok, catalog} ->
+          guards = List.wrap(ctx.intent["may_change_guarded_paths"])
+          added = get_in(ctx.intent, ["catalog_changes", "add"]) |> List.wrap()
+
+          build_result =
+            VerificationPlan.build(ctx.scenarios, guards, catalog, ctx.materialization,
+              added: added
+            )
+
+          errors =
+            VerificationPlan.proof_errors(ctx.scenarios, guards, catalog, ctx.materialization,
+              added: added
+            )
+
+          case build_result do
+            {:ok, _plan} ->
+              assert errors == [], "#{name}: proof_errors/4 nonempty although build/4 succeeded"
+
+            {:error, _reason} ->
+              assert errors != [], "#{name}: proof_errors/4 empty although build/4 failed"
+          end
+
+        {:error, _reason} ->
+          :ok
+      end
+    end
+  end
+
+  # -- preservation: the Build predicates the deterministic layer reuses ----
+
+  test "preservation: selective_verification_targets_test.exs and verification_policy_test.exs still pass" do
+    for path <- [
