+
+  # -- prior failures -------------------------------------------------------
+
+  test "history: advisory prior-failures lists both retained Build ids and the signature" do
+    root = fixture_repo!()
+    ctx = draft_ctx!(root, "history")
+    result = Deterministic.run(ctx)
