+
+  test "prior_failures/3 is bounded: an oversized record is never read" do
+    root = fixture_repo!()
+    dir = Path.join(root, ".kogen/runtime/scenario-tracking/oversized")
+    File.mkdir_p!(dir)
+    File.write!(Path.join(dir, "record.json"), :binary.copy("a", 33 * 1024 * 1024))
+
+    {:ok, agent} = Agent.start_link(fn -> [] end)
+
+    read = fn path ->
+      Agent.update(agent, &[path | &1])
+      File.read(path)
+    end
+
+    records = Deterministic.prior_failures(root, Fixture.history_intent_id(), read)
+    reads = Agent.get(agent, & &1)
+    Agent.stop(agent)
+
+    refute Enum.any?(reads, &String.contains?(&1, "oversized"))
+    assert length(records) == 2
+    assert Enum.all?(records, &(&1["signature"] == "guarded-path-failure:lib/b.ex"))
+  end
+
+  # -- package-invalid and the asking-state exception -------------------
+
+  test "invalid: an unparseable scenarios.yaml blocks with package-invalid" do
