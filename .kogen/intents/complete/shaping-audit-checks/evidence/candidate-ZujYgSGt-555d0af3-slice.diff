diff --git a/test/kogen/shaping_audit_checks_test.exs b/test/kogen/shaping_audit_checks_test.exs
new file mode 100644
index 00000000..057ccd45
--- /dev/null
+++ b/test/kogen/shaping_audit_checks_test.exs
@@ -0,0 +1,523 @@
+Code.require_file("../support/shaping_audit/fixture.ex", __DIR__)
+
+defmodule Kogen.ShapingAuditChecksTest do
+  use ExUnit.Case, async: true
+
+  alias Kogen.Build.VerificationPlan
+  alias Kogen.ShapingAudit.{Deterministic, Finding, Fixture, Materialization, Questions}
+  alias Kogen.VerificationPolicy
+
+  @root Path.expand("../..", __DIR__)
+
+  @drafts ~w(
+    complete proof-defects ledger-flawed ledger-unstated controller-read catalog-added
+    long-title paid-unproven paid-overbroad paid-provider-only live-owner stale
+    stale-disputed history invalid
+  )
+
+  # -- helpers ---------------------------------------------------------
+
+  defp fixture_repo!(opts \\ []) do
+    root = Fixture.repo!(opts)
+    on_exit(fn -> File.rm_rf!(root) end)
+    root
+  end
+
+  defp draft_ctx!(root, name, opts \\ []) do
+    package_rel = Fixture.add_draft!(root, name, opts)
+    files_dir = Path.join(root, package_rel)
+
+    files =
+      files_dir
+      |> Path.join("**")
+      |> Path.wildcard(match_dot: true)
+      |> Enum.filter(&File.regular?/1)
+      |> Map.new(fn p -> {Path.relative_to(p, files_dir), File.read!(p)} end)
+
+    {:ok, mat} = Materialization.create(root, package_rel, files)
+    on_exit(fn -> Materialization.remove(mat) end)
+
+    intent = parse_yaml_map(files["intent.yaml"])
+    scenarios = parse_yaml_list(files["scenarios.yaml"])
+    questions = Questions.parse(files["questions.md"])
+    state = Questions.state(questions)
+
+    %{
+      root: root,
+      slug: name,
+      package_rel: package_rel,
+      materialization: mat.dir,
+      files: files,
+      intent: intent,
+      scenarios: scenarios,
+      questions: questions,
+      state: state,
+      head: Fixture.head(root),
+      revision: "deadbeef",
+      route: "test",
+      config: nil,
+      env: %{},
+      opts: []
+    }
+  end
+
+  defp parse_yaml_map(nil), do: nil
+
+  defp parse_yaml_map(text) do
+    case YamlElixir.read_from_string(text) do
+      {:ok, data} when is_map(data) -> data
+      _ -> nil
+    end
+  end
+
+  defp parse_yaml_list(nil), do: nil
+
+  defp parse_yaml_list(text) do
+    case YamlElixir.read_from_string(text) do
+      {:ok, data} when is_list(data) -> data
+      _ -> nil
+    end
+  end
+
+  defp finding_ids(result), do: result["findings"] |> Enum.map(& &1["id"]) |> Enum.sort()
+
+  defp find(result, id), do: Enum.find(result["findings"], &(&1["id"] == id))
+
+  defp open_blocking_ids(ctx, result) do
+    result["findings"]
+    |> Finding.apply_dispositions(ctx.questions.dispositions)
+    |> Enum.filter(&Finding.open_blocking?/1)
+    |> Enum.map(& &1["id"])
+    |> Enum.sort()
+  end
+
+  # -- proof_errors/4 (proof-defects) -----------------------------------
+
+  test "proof-defects: every proof predicate fails, never only the first" do
+    root = fixture_repo!()
+    ctx = draft_ctx!(root, "proof-defects")
+    result = Deterministic.run(ctx)
+
+    assert result["status"] == "ok"
+
+    expected =
+      [
+        "unguarded-affected-path lib/unguarded.ex",
+        "proof-selector-missing test/gone_test.exs",
+        "proof-selector-missing test/stray_test.exs",
+        "unsupported-selector test/a_test.exs:3",
+        "unsupported-selector test/**",
+        "unsupported-selector /abs/x_test.exs",
+        "unsupported-selector ../x_test.exs",
+        "paid-reason-malformed not a valid reason",
+        "unknown-target live-extra"
+      ]
+      |> Enum.sort()
+
+    assert finding_ids(result) == expected
+
+    for id <- expected do
+      finding = find(result, id)
+      assert finding["severity"] == "blocking"
+      assert finding["disputable"] == false
+    end
+
+    assert find(result, "unguarded-affected-path lib/unguarded.ex")["paths"] == [
+             "lib/unguarded.ex"
+           ]
+
+    assert find(result, "proof-selector-missing test/stray_test.exs")
+
+    {:ok, catalog} = VerificationPlan.load(ctx.materialization)
+    guards = ctx.intent["may_change_guarded_paths"]
+
+    assert {:error, _reason} =
+             VerificationPlan.build(ctx.scenarios, guards, catalog, ctx.materialization)
+  end
+
+  test "the working tree's stray file and uncommitted target never reach the materialization" do
+    root = fixture_repo!()
+    ctx = draft_ctx!(root, "proof-defects")
+
+    refute File.exists?(Path.join(ctx.materialization, "test/stray_test.exs"))
+    makefile = File.read!(Path.join(ctx.materialization, "Makefile"))
+    refute makefile =~ "live-extra"
+  end
+
+  # -- ledger -------------------------------------------------------------
+
+  test "ledger-flawed: an unguarded maintained-source edit blocks with ledger-closure" do
+    root = fixture_repo!()
+    ctx = draft_ctx!(root, "ledger-flawed")
+    result = Deterministic.run(ctx)
+
+    assert finding_ids(result) == ["ledger-closure"]
+    finding = find(result, "ledger-closure")
+    assert finding["severity"] == "blocking"
+    assert finding["disputable"] == false
+    assert "test/a_test.exs" in finding["paths"]
+    assert "priv/kogen/test-reliability.yaml" in finding["paths"]
+  end
+
+  test "ledger-unstated: a guarded ledger with no refresh command blocks with tracker-refresh-unstated" do
+    root = fixture_repo!()
+    ctx = draft_ctx!(root, "ledger-unstated")
+    result = Deterministic.run(ctx)
+
+    assert finding_ids(result) == ["tracker-refresh-unstated"]
+    finding = find(result, "tracker-refresh-unstated")
+    assert finding["severity"] == "blocking"
+    assert finding["message"] =~ "python3 scripts/check/refresh_test_reliability_sources.py"
+  end
+
+  # -- controller reads -----------------------------------------------------
+
+  test "controller-read: a controller guard file is flagged, never as a literal in the audit" do
+    root = fixture_repo!()
+    ctx = draft_ctx!(root, "controller-read")
+    result = Deterministic.run(ctx)
+
+    id = "controller-read-path .codex/hooks/verification_policy.py"
+    assert finding_ids(result) == [id]
+    finding = find(result, id)
+    assert finding["disputable"] == false
+    assert finding["paths"] == [".codex/hooks/verification_policy.py"]
+  end
+
+  test "catalog-added: the catalog itself never raises controller-read-path, and proof_errors is empty" do
+    root = fixture_repo!()
+    ctx = draft_ctx!(root, "catalog-added")
+    result = Deterministic.run(ctx)
+
+    refute Enum.any?(result["findings"], &(&1["rule"] == "controller-read-path"))
+    assert result["findings"] == []
+  end
+
+  test "controller_paths/0 is the union preflight/2 itself reads, with one control per path" do
+    paths = VerificationPolicy.controller_paths()
+    assert paths == [".codex/hooks.json", ".codex/hooks/verification_policy.py"]
+
+    dir =
+      Path.join(System.tmp_dir!(), "kogen-controller-paths-#{System.unique_integer([:positive])}")
+
+    File.mkdir_p!(Path.join(dir, ".codex/hooks"))
+    on_exit(fn -> File.rm_rf!(dir) end)
+
+    File.cp!(Path.join(@root, ".codex/hooks.json"), Path.join(dir, ".codex/hooks.json"))
+
+    File.cp!(
+      Path.join(@root, ".codex/hooks/verification_policy.py"),
+      Path.join(dir, ".codex/hooks/verification_policy.py")
+    )
+
+    assert VerificationPolicy.preflight(["check"], dir) == :ok
+
+    for path <- paths do
+      full = Path.join(dir, path)
+      backup = full <> ".bak"
+      File.rename!(full, backup)
+      assert {:error, _reason} = VerificationPolicy.preflight(["check"], dir)
