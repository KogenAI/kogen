+
+      assert exit_code == 0, "#{path} failed:\n#{output}"
+    end
+  end
+end
diff --git a/test/kogen/shaping_audit_task_test.exs b/test/kogen/shaping_audit_task_test.exs
new file mode 100644
index 00000000..af5521f2
--- /dev/null
+++ b/test/kogen/shaping_audit_task_test.exs
@@ -0,0 +1,771 @@
+Code.require_file("../support/shaping_audit/fixture.ex", __DIR__)
+
+defmodule Kogen.ShapingAuditTaskTest do
+  @moduledoc """
+  `mix kogen.audit`'s entry function: the revision/report layout, the
+  refused-role, lock, ambiguous-slug and non-regular-entry refusals,
+  `--status` transitions, the Shaper-session message, and the README claims
+  (`revision-report-and-command`). Also drives one true end-to-end run
+  (real `Deterministic`, `Auditor`, `JevLayer`, `Materialization`, the
+  audit-only `fake_auditor`/`fake_jev_audit`/`fake_security_audit`) to a
+  `"ready"` report, both through `main/2` here and through the Stop hook in
+  `Kogen.ShapingAuditHookTest`.
+  """
+  use Kogen.IsolatedCase, async: true
+
+  alias Kogen.ShapingAudit
+  alias Kogen.ShapingAudit.{Fixture, StopHook}
+
+  @config_yaml """
+  default_route: codex
+  routes:
+    codex:
+      harness: codex
+      shaping:   {model: fake, effort: low}
+      developer: {model: fake, effort: low}
+      reviewer:  {model: fake, effort: low}
+      helpers:
+        scout:  {model: fake, effort: low}
+        worker: {model: fake, effort: medium}
+        expert: {model: fake, effort: medium}
+    other:
+      harness: codex
+      shaping:   {model: fake, effort: low}
+      developer: {model: fake, effort: low}
+      reviewer:  {model: fake, effort: low}
+      helpers:
+        scout:  {model: fake, effort: low}
+        worker: {model: fake, effort: medium}
+        expert: {model: fake, effort: medium}
+  outer_resumptions: 2
+  verification_retries: 2
+  """
+
+  @intent_yaml """
+  id: 018f2a3b-0000-7000-8000-000000000001
+  slug: demo
+  title: Demo package
+  """
+
+  @scenarios_yaml """
+  - id: demo-scenario
+    given: something
+    when: something happens
+    then: something else
+    wrong_result: nothing
+    verified_by: [check]
+    proof:
+      offline: [test/kogen/demo_test.exs]
+      paid_target: none
+      paid_reason: offline-sufficient
+      affected_paths: [lib/demo.ex]
+  """
+
+  # --- fixture -------------------------------------------------------------
+
+  defp checkout! do
+    root =
+      Path.join(
+        System.tmp_dir!(),
+        "kogen-audit-task-#{System.unique_integer([:positive, :monotonic])}"
+      )
+
+    File.mkdir_p!(root)
+    on_exit(fn -> File.rm_rf(root) end)
+
+    {_out, 0} = System.cmd("git", ["init", "-q"], cd: root)
+    {_out, 0} = System.cmd("git", ["config", "user.email", "test@example.com"], cd: root)
+    {_out, 0} = System.cmd("git", ["config", "user.name", "Test"], cd: root)
+    File.mkdir_p!(Path.join(root, ".kogen"))
+    File.write!(Path.join(root, ".kogen/config.yaml"), @config_yaml)
+    commit!(root, "init")
+    root
+  end
+
+  defp commit!(root, message) do
+    {_out, 0} = System.cmd("git", ["add", "-A"], cd: root)
+    {_out, 0} = System.cmd("git", ["commit", "-q", "-m", message, "--allow-empty"], cd: root)
+    :ok
+  end
+
+  defp write_package!(root, kind, slug, files) do
+    dir = Path.join([root, ".kogen/intents", kind, slug])
+    File.mkdir_p!(dir)
+
+    Enum.each(files, fn {name, contents} ->
+      path = Path.join(dir, name)
+      File.mkdir_p!(Path.dirname(path))
+      File.write!(path, contents)
+    end)
+
+    dir
+  end
+
+  defp default_package(overrides \\ %{}) do
+    Map.merge(
+      %{"intent.yaml" => @intent_yaml, "scenarios.yaml" => @scenarios_yaml, "questions.md" => ""},
+      overrides
+    )
+  end
+
+  # --- audit-only fake layers (until B/C/D land) ----------------------------
+
+  defmodule FakeMaterialization do
+    @moduledoc false
+
+    def create(_root, _package_rel, files) do
+      tmp =
+        Path.join(System.tmp_dir!(), "kogen-audit-#{System.unique_integer([:positive])}")
+
+      work = Path.join(tmp, "work")
+      File.mkdir_p!(work)
+
+      Enum.each(files, fn {rel, bytes} ->
+        path = Path.join(work, rel)
+        File.mkdir_p!(Path.dirname(path))
+        File.write!(path, bytes)
+      end)
+
+      {:ok, %{dir: work, base: tmp}}
+    end
+
+    def remove(%{base: base}), do: File.rm_rf!(base)
+  end
+
+  defmodule FakeDeterministic do
+    @moduledoc false
+    def run(_ctx), do: %{"status" => "ok", "findings" => []}
+    def prior_failures(_root, _intent_id, _opts), do: []
+  end
+
+  defmodule FakeAuditor do
+    @moduledoc false
+
+    def run(_ctx, _det_findings, _opts) do
+      %{"status" => "ok", "findings" => [], "not_audited" => [], "bound_reached" => false}
+    end
+  end
+
+  defmodule FakeJev do
+    @moduledoc false
+
+    def run(_ctx, findings_so_far) do
+      auditor_only = Enum.filter(findings_so_far, &(&1["layer"] == "auditor"))
+      %{"status" => "ok", "findings" => [], "routed_findings" => auditor_only}
+    end
+  end
+
+  defp ok_layers do
+    %{
+      materialization: FakeMaterialization,
+      deterministic: FakeDeterministic,
+      auditor: FakeAuditor,
+      jev: FakeJev
+    }
+  end
+
+  defp io_spy do
+    %{
+      puts: fn msg -> send(self(), {:stdout, msg}) end,
+      err: fn msg -> send(self(), {:stderr, msg}) end
+    }
+  end
+
+  defp intents_listing(root) do
+    root
+    |> Path.join(".kogen/intents")
+    |> then(fn dir -> if File.dir?(dir), do: Path.wildcard(Path.join(dir, "**/*")), else: [] end)
+    |> Enum.map(fn path ->
+      {Path.relative_to(path, root), File.regular?(path) && File.read!(path)}
+    end)
+    |> Enum.sort()
+  end
+
+  defp tmp_materializations do
+    System.tmp_dir!() |> Path.join("kogen-audit-*") |> Path.wildcard()
+  end
+
+  # --- end-to-end ready audit ------------------------------------------------
+
+  test "a ready audit exits 0, writes the report layout, and leaves .kogen/intents and tmp untouched" do
+    root = checkout!()
+    write_package!(root, "drafts", "demo", default_package())
+    commit!(root, "add demo draft")
+
+    before_listing = intents_listing(root)
+    before_tmp = tmp_materializations()
+    io = io_spy()
+
+    code =
+      ShapingAudit.main(["demo"], root: root, env: %{}, io: io, layers: ok_layers())
+
+    assert code == 0
+    assert_received {:stdout, message}
+    assert message =~ "ready:"
+
+    assert intents_listing(root) == before_listing
+    assert tmp_materializations() == before_tmp
+
+    report_dir =
+      root
+      |> Path.join(".kogen/runtime/shaping-audits/demo")
+      |> File.ls!()
+      |> Enum.reject(&(&1 == "hook.jsonl" or &1 == "hook-state.json" or &1 == "auditor"))
+
+    assert [revision] = report_dir
+    report_path = Path.join([root, ".kogen/runtime/shaping-audits/demo", revision, "report.json"])
+    assert File.exists?(report_path)
+
+    assert File.exists?(
+             Path.join([root, ".kogen/runtime/shaping-audits/demo", revision, "report.md"])
+           )
+
+    report = report_path |> File.read!() |> Jason.decode!()
+    assert report["schema_version"] == 1
+    assert report["slug"] == "demo"
+    assert report["package"] == ".kogen/intents/drafts/demo"
+    assert report["readiness"] == "ready"
+    assert report["state"] == "autonomous"
+    assert is_binary(report["head"])
+    assert report["route"] == "codex"
+    assert Map.has_key?(report["layers"], "deterministic")
+    assert Map.has_key?(report["layers"], "jev")
+    assert Map.has_key?(report["layers"], "auditor")
+  end
+
+  test "--status is current after a ready audit, then stale after a commit, then missing after an edit" do
+    root = checkout!()
+    write_package!(root, "drafts", "demo", default_package())
+    commit!(root, "add demo draft")
+
+    assert ShapingAudit.main(["demo"], root: root, env: %{}, io: io_spy(), layers: ok_layers()) ==
+             0
+
+    assert ShapingAudit.main(["--status", "demo"], root: root, env: %{}, io: io_spy()) == 0
+    assert_received {:stdout, "current"}
+
+    # HEAD moves without touching the package: same revision, stale head.
+    commit!(root, "unrelated")
+
+    assert ShapingAudit.main(["--status", "demo"], root: root, env: %{}, io: io_spy()) == 1
+    assert_received {:stdout, "stale: head"}
+
+    # Editing the draft changes its revision: no report exists for it yet.
+    write_package!(root, "drafts", "demo", %{"questions.md" => "changed\n"})
+
+    assert ShapingAudit.main(["--status", "demo"], root: root, env: %{}, io: io_spy()) == 1
+    assert_received {:stdout, "missing"}
+  end
+
+  test "--status is stale after selecting another route" do
+    root = checkout!()
+    write_package!(root, "drafts", "demo", default_package())
+    commit!(root, "add demo draft")
+
+    assert ShapingAudit.main(["demo"], root: root, env: %{}, io: io_spy(), layers: ok_layers()) ==
+             0
+
+    assert ShapingAudit.main(["--status", "--route", "other", "demo"],
+             root: root,
+             env: %{},
+             io: io_spy()
+           ) == 1
+
+    assert_received {:stdout, "stale: route"}
+  end
+
+  # --- refusals --------------------------------------------------------------
+
+  for role <- ~w(developer reviewer expert auditor) do
+    test "refuses role #{role}: exit 2, no report, no materialization, no read" do
+      role = unquote(role)
+      root = checkout!()
+      write_package!(root, "drafts", "demo", default_package())
+      commit!(root, "add demo draft")
+
+      before_tmp = tmp_materializations()
+      calls = collect_read_calls(root)
+
+      code =
+        ShapingAudit.main(["demo"],
+          root: root,
+          env: %{"KOGEN_ROLE" => role},
+          io: io_spy(),
+          read: calls.read,
+          layers: ok_layers()
+        )
+
+      assert code == 2
+      refute File.dir?(Path.join(root, ".kogen/runtime/shaping-audits/demo"))
+      assert tmp_materializations() == before_tmp
+      assert calls.get.() == []
+    end
+  end
+
+  test "refuses while .kogen/build.lock is present: exit 2, no report, no materialization" do
+    root = checkout!()
+    write_package!(root, "drafts", "demo", default_package())
+    File.write!(Path.join(root, ".kogen/build.lock"), "locked")
+    commit!(root, "add demo draft plus lock")
+
+    before_tmp = tmp_materializations()
+
+    code = ShapingAudit.main(["demo"], root: root, env: %{}, io: io_spy(), layers: ok_layers())
+
+    assert code == 2
+    refute File.dir?(Path.join(root, ".kogen/runtime/shaping-audits/demo"))
+    assert tmp_materializations() == before_tmp
+  end
+
+  test "an ambiguous slug (in both drafts/ and approved/) is refused before any read, exit 2" do
+    root = checkout!()
+    write_package!(root, "drafts", "demo", default_package())
+    write_package!(root, "approved", "demo", default_package())
+    commit!(root, "add demo in both")
+
+    calls = collect_read_calls(root)
+
+    code =
+      ShapingAudit.main(["demo"],
+        root: root,
+        env: %{},
+        io: io_spy(),
+        read: calls.read,
+        layers: ok_layers()
+      )
+
+    assert code == 2
+    assert calls.get.() == []
+  end
+
+  test "a symlinked package entry is refused (exit 2, naming it) before anything is read" do
+    root = checkout!()
+    write_package!(root, "drafts", "demo", default_package())
+    File.write!(Path.join([root, ".kogen/intents/drafts/demo", "target.txt"]), "x")
+    File.ln_s!("target.txt", Path.join([root, ".kogen/intents/drafts/demo", "link.txt"]))
+    commit!(root, "add demo with symlink (working tree only)")
+
+    calls = collect_read_calls(root)
+    io = io_spy()
+
+    code =
+      ShapingAudit.main(["demo"],
+        root: root,
+        env: %{},
+        io: io,
+        read: calls.read,
+        layers: ok_layers()
+      )
+
+    assert code == 2
+    assert_received {:stderr, message}
+    assert message =~ "link.txt"
+    assert calls.get.() == []
+  end
+
+  test "a symlinked scenarios.yaml is refused (exit 2, naming it) before anything is read" do
+    root = checkout!()
+    write_package!(root, "drafts", "demo", default_package())
+    real_path = Path.join([root, ".kogen/intents/drafts/demo", "scenarios.yaml"])
+    File.rm!(real_path)
+
+    File.write!(
+      Path.join([root, ".kogen/intents/drafts/demo", "elsewhere.yaml"]),
+      @scenarios_yaml
+    )
+
+    File.ln_s!("elsewhere.yaml", real_path)
+    commit!(root, "add demo with a symlinked scenarios.yaml (working tree only)")
+
+    calls = collect_read_calls(root)
+    io = io_spy()
+
+    code =
+      ShapingAudit.main(["demo"],
+        root: root,
+        env: %{},
+        io: io,
+        read: calls.read,
+        layers: ok_layers()
+      )
+
+    assert code == 2
+    assert_received {:stderr, message}
+    assert message =~ "scenarios.yaml"
+    assert calls.get.() == []
+  end
+
+  test "a FIFO package entry (mkfifo) is refused (exit 2, naming it) before anything is read" do
+    root = checkout!()
+    write_package!(root, "drafts", "demo", default_package())
+    fifo_path = Path.join([root, ".kogen/intents/drafts/demo", "pipe.fifo"])
+    {_out, 0} = System.cmd("mkfifo", [fifo_path])
+    on_exit(fn -> File.rm(fifo_path) end)
+
+    calls = collect_read_calls(root)
+    io = io_spy()
+
+    code =
+      ShapingAudit.main(["demo"],
+        root: root,
+        env: %{},
+        io: io,
+        read: calls.read,
+        layers: ok_layers()
+      )
+
+    assert code == 2
+    assert_received {:stderr, message}
+    assert message =~ "pipe.fifo"
+    assert calls.get.() == []
+  end
+
+  test "the non-regular fixture Draft with a symlink added is refused (exit 2, naming it) before anything is read" do
+    root = Fixture.repo!()
+    on_exit(fn -> File.rm_rf(root) end)
+    package = Fixture.add_draft!(root, "non-regular")
+    File.ln_s!("target.txt", Path.join([root, package, "link.txt"]))
+
+    calls = collect_read_calls(root)
+    io = io_spy()
+
+    code =
+      ShapingAudit.main(["non-regular"],
+        root: root,
+        env: %{},
+        io: io,
+        read: calls.read,
+        layers: ok_layers()
+      )
+
+    assert code == 2
+    assert_received {:stderr, message}
+    assert message =~ "link.txt"
+    assert calls.get.() == []
+  end
+
+  test "an approved-only package and the Shaper role run normally" do
+    root = checkout!()
+    write_package!(root, "approved", "demo", default_package())
+    commit!(root, "add demo approved")
+
+    code =
+      ShapingAudit.main(["demo"],
+        root: root,
+        env: %{"KOGEN_ROLE" => "shaper", "KOGEN_SHAPING_HOOK_OUTPUT" => "/tmp/does-not-matter"},
+        io: io_spy(),
+        layers: ok_layers()
+      )
+
+    assert code == 0
+  end
+
+  test "inside a Shaping session a manual run audits nothing and prints the hook status" do
+    root = checkout!()
+    write_package!(root, "drafts", "demo", default_package())
+    commit!(root, "add demo draft")
+
+    before_tmp = tmp_materializations()
+    io = io_spy()
+
+    code =
+      ShapingAudit.main(["demo", "--auditor"],
+        root: root,
+        env: %{"KOGEN_ROLE" => "shaper"},
+        io: io,
+        layers: ok_layers()
+      )
+
+    assert code == 1
+    assert_received {:stdout, message}
+    assert message =~ "Stop hook audits the Draft at every stop"
+    assert tmp_materializations() == before_tmp
+    refute File.dir?(Path.join(root, ".kogen/runtime/shaping-audits/demo"))
+  end
+
+  test "inside a Shaping session, with no hook-state.json yet, the status falls back to the newest report directory" do
+    root = checkout!()
+    write_package!(root, "drafts", "demo", default_package())
+    commit!(root, "add demo draft")
+
+    # A report exists (as if `mix kogen.audit` had run once outside the
+    # session), but no hook.jsonl/hook-state.json (as if the Stop hook never
+    # ran yet).
+    assert ShapingAudit.main(["demo"], root: root, env: %{}, io: io_spy(), layers: ok_layers()) ==
+             0
+
+    assert_receive {:stdout, _first_run_message}
+    refute File.exists?(Path.join(root, ".kogen/runtime/shaping-audits/demo/hook-state.json"))
+
+    code =
+      ShapingAudit.main(["demo"],
+        root: root,
+        env: %{"KOGEN_ROLE" => "shaper"},
+        io: io_spy(),
+        layers: ok_layers()
+      )
+
+    assert code == 0
+    assert_receive {:stdout, intro}
+    assert intro =~ "Stop hook audits the Draft at every stop"
+    assert_receive {:stdout, message}
+    assert message =~ "current"
+  end
+
+  defp collect_read_calls(root) do
+    agent_path = Path.join(root, ".read-calls")
+    File.write!(agent_path, "")
+
+    read = fn path ->
+      File.write!(agent_path, path <> "\n", [:append])
+      File.read(path)
+    end
+
+    %{
+      read: read,
+      get: fn ->
+        agent_path
+        |> File.read!()
+        |> String.split("\n", trim: true)
+      end
+    }
+  end
+
+  # --- end to end, with the real layers ---------------------------------------
+
+  @root Path.expand("../..", __DIR__)
+  @fake_auditor Path.join(@root, "test/support/shaping_audit/fake_auditor")
+  @fake_jev_transport Path.join(@root, "test/support/shaping_audit/fake_jev_audit")
+  @fake_jev_security Path.join(@root, "test/support/shaping_audit/fake_security_audit")
+
+  @real_config_yaml """
+  default_route: codex
+  routes:
+    codex:
+      harness: codex
+      shaping:   {model: expert-model, effort: low}
+      developer: {model: expert-model, effort: low}
+      reviewer:  {model: expert-model, effort: low}
+      auditor:   {model: audit-model, effort: high}
+      helpers:
+        scout:  {model: expert-model, effort: low}
+        worker: {model: expert-model, effort: low}
+        expert: {model: expert-model, effort: low}
+  outer_resumptions: 1
+  verification_retries: 1
+  """
+
+  test "end to end with the real layers: the complete fixture Draft reaches readiness ready" do
+    root = Fixture.repo!()
+    on_exit(fn -> File.rm_rf(root) end)
+
+    File.mkdir_p!(Path.join(root, ".kogen"))
+    File.write!(Path.join(root, ".kogen/config.yaml"), @real_config_yaml)
+    Fixture.add_draft!(root, "complete")
+
+    log_dir =
+      Path.join(System.tmp_dir!(), "kogen-e2e-auditor-#{System.unique_integer([:positive])}")
+
+    File.mkdir_p!(log_dir)
+    on_exit(fn -> File.rm_rf(log_dir) end)
+
+    prior_harness = System.get_env("KOGEN_HARNESS")
+    prior_message = System.get_env("FAKE_AUDITOR_MESSAGE")
+    prior_log_dir = System.get_env("FAKE_AUDITOR_LOG_DIR")
+
+    System.put_env("KOGEN_HARNESS", @fake_auditor)
+    System.put_env("FAKE_AUDITOR_MESSAGE", "empty")
+    System.put_env("FAKE_AUDITOR_LOG_DIR", log_dir)
+
+    on_exit(fn ->
+      restore_env("KOGEN_HARNESS", prior_harness)
+      restore_env("FAKE_AUDITOR_MESSAGE", prior_message)
+      restore_env("FAKE_AUDITOR_LOG_DIR", prior_log_dir)
+    end)
+
+    env = %{
+      "KOGEN_JEV_TRANSPORT" => @fake_jev_transport,
+      "KOGEN_JEV_SECURITY" => @fake_jev_security
+    }
+
+    io = io_spy()
+
+    code =
+      ShapingAudit.main(["--auditor", "complete"], root: root, env: env, io: io)
+
+    assert code == 0
+    assert_received {:stdout, message}
+    assert message =~ "ready:"
+
+    [report_json_path] =
+      Path.wildcard(Path.join(root, ".kogen/runtime/shaping-audits/complete/*/report.json"))
+
+    report = report_json_path |> File.read!() |> Jason.decode!()
+
+    assert report["readiness"] == "ready"
+    assert report["layers"]["deterministic"]["status"] == "ok"
+    assert report["layers"]["auditor"]["status"] == "ok"
+    assert report["layers"]["jev"]["status"] == "ok"
+  end
+
+  test "end to end with the real layers, through the Stop hook: the complete fixture Draft is allowed with a ready summary" do
+    root = Fixture.repo!()
+    on_exit(fn -> File.rm_rf(root) end)
+
+    File.mkdir_p!(Path.join(root, ".kogen"))
+    File.write!(Path.join(root, ".kogen/config.yaml"), @real_config_yaml)
+    Fixture.add_draft!(root, "complete")
+
+    log_dir =
+      Path.join(System.tmp_dir!(), "kogen-e2e-hook-auditor-#{System.unique_integer([:positive])}")
+
+    File.mkdir_p!(log_dir)
+    on_exit(fn -> File.rm_rf(log_dir) end)
+
+    prior_harness = System.get_env("KOGEN_HARNESS")
+    prior_message = System.get_env("FAKE_AUDITOR_MESSAGE")
+    prior_log_dir = System.get_env("FAKE_AUDITOR_LOG_DIR")
+
+    System.put_env("KOGEN_HARNESS", @fake_auditor)
+    System.put_env("FAKE_AUDITOR_MESSAGE", "empty")
+    System.put_env("FAKE_AUDITOR_LOG_DIR", log_dir)
+
+    on_exit(fn ->
+      restore_env("KOGEN_HARNESS", prior_harness)
+      restore_env("FAKE_AUDITOR_MESSAGE", prior_message)
+      restore_env("FAKE_AUDITOR_LOG_DIR", prior_log_dir)
+    end)
+
+    output_path = Path.join(root, "hook-output.json")
+
+    env = %{
+      "KOGEN_ROLE" => "shaper",
+      "KOGEN_SHAPING_INTENT_ID" => "01965000-0000-7000-8000-00000000c001",
+      "KOGEN_SHAPING_HOOK_OUTPUT" => output_path,
+      "KOGEN_JEV_TRANSPORT" => @fake_jev_transport,
+      "KOGEN_JEV_SECURITY" => @fake_jev_security
+    }
+
+    StopHook.run(root, env, stdin: "")
+
+    decision = output_path |> File.read!() |> Jason.decode!()
+    assert decision["continue"] == true
+    assert decision["systemMessage"] =~ "ready:"
+
+    [report_json_path] =
+      Path.wildcard(Path.join(root, ".kogen/runtime/shaping-audits/complete/*/report.json"))
+
+    report = report_json_path |> File.read!() |> Jason.decode!()
+    assert report["readiness"] == "ready"
+    assert report["elapsed"] != nil
+
+    hook_line =
+      root
+      |> Path.join(".kogen/runtime/shaping-audits/complete/hook.jsonl")
+      |> File.read!()
+      |> String.split("\n", trim: true)
+      |> hd()
+      |> Jason.decode!()
+
+    assert hook_line["kind"] == "ready"
+  end
+
+  test "a route named ../x writes its auditor record only inside auditor/, named by the route's hash" do
+    root = Fixture.repo!()
+    on_exit(fn -> File.rm_rf(root) end)
+
+    File.mkdir_p!(Path.join(root, ".kogen"))
+
+    config =
+      String.replace(@real_config_yaml, "default_route: codex\nroutes:\n  codex:", """
+      default_route: codex
+      routes:
+        "../x":
+          harness: codex
+          shaping:   {model: expert-model, effort: low}
+          developer: {model: expert-model, effort: low}
+          reviewer:  {model: expert-model, effort: low}
+          auditor:   {model: audit-model, effort: high}
+          helpers:
+            scout:  {model: expert-model, effort: low}
+            worker: {model: expert-model, effort: low}
+            expert: {model: expert-model, effort: low}
+        codex:\
+      """)
+
+    File.write!(Path.join(root, ".kogen/config.yaml"), config)
+    Fixture.add_draft!(root, "complete")
+
+    log_dir =
+      Path.join(System.tmp_dir!(), "kogen-route-auditor-#{System.unique_integer([:positive])}")
+
+    File.mkdir_p!(log_dir)
+    on_exit(fn -> File.rm_rf(log_dir) end)
+
+    prior =
+      Map.new(
+        ~w(KOGEN_HARNESS FAKE_AUDITOR_MESSAGE FAKE_AUDITOR_LOG_DIR),
+        &{&1, System.get_env(&1)}
+      )
+
+    System.put_env("KOGEN_HARNESS", @fake_auditor)
+    System.put_env("FAKE_AUDITOR_MESSAGE", "empty")
+    System.put_env("FAKE_AUDITOR_LOG_DIR", log_dir)
+    on_exit(fn -> Enum.each(prior, fn {key, value} -> restore_env(key, value) end) end)
+
+    env = %{
+      "KOGEN_JEV_TRANSPORT" => @fake_jev_transport,
+      "KOGEN_JEV_SECURITY" => @fake_jev_security
+    }
+
+    code =
+      ShapingAudit.main(["--route", "../x", "--auditor", "complete"],
+        root: root,
+        env: env,
+        io: io_spy()
+      )
+
+    assert code == 0
+    audits = Path.join(root, ".kogen/runtime/shaping-audits")
+    hash = :sha256 |> :crypto.hash("../x") |> Base.encode16(case: :lower) |> binary_part(0, 12)
+
+    assert [record] = Path.wildcard(Path.join(audits, "complete/auditor/*.json"))
+    assert Path.basename(record) =~ ~r/\A[0-9a-f]{64}-#{hash}\.json\z/
+    assert (record |> File.read!() |> Jason.decode!())["route"] == "../x"
+
+    all_files =
+      root
+      |> Path.join("**/*")
+      |> Path.wildcard(match_dot: true)
+      |> Enum.filter(&(File.regular?(&1) and String.contains?(&1, hash)))
+
+    assert all_files == [record]
+    refute File.exists?(Path.join(root, ".kogen/runtime/x"))
+    refute File.exists?(Path.join(audits, "x"))
+  end
+
+  defp restore_env(key, nil), do: System.delete_env(key)
+  defp restore_env(key, value), do: System.put_env(key, value)
+
+  # --- source and README claims ----------------------------------------------
+
+  test "the mix task only delegates to the entry function and halts with its code" do
+    source = File.read!(Path.join(File.cwd!(), "lib/mix/tasks/kogen.audit.ex"))
+    assert source =~ "System.halt(Kogen.ShapingAudit.main(args))"
+    refute source =~ "Kogen.ShapingAudit.audit("
+    refute source =~ "Kogen.ShapingAudit.StopHook.run"
+  end
+
+  test "the README documents the command, the report layout, readiness and that a report is never approval" do
+    readme = File.read!(Path.join(File.cwd!(), "README.md"))
+    assert readme =~ "### Shaping audit"
+    assert readme =~ "mix kogen.audit"
+    assert readme =~ "--status"
+    assert readme =~ ".kogen/runtime/shaping-audits/<slug>/<revision>/"
+
+    assert readme =~ "report is never\napproval" or readme =~ "never\napproval" or
+             readme =~ "never approval"
+
+    assert readme =~ "Stop hook"
+  end
+end
