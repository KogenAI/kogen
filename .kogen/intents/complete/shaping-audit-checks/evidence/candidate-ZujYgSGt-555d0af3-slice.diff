--- /dev/null
+++ b/lib/mix/tasks/kogen.audit.ex
@@ -0,0 +1,26 @@
+defmodule Mix.Tasks.Kogen.Audit do
+  use Mix.Task
+  use Boundary, deps: [Kogen.ShapingAudit, Mix]
+
+  @shortdoc "Audits a Shaping Draft or Approved package"
+  @moduledoc """
+  `mix kogen.audit [--route <name>] [--auditor] <slug>` runs one Shaping
+  audit over `.kogen/intents/drafts/<slug>` (or `approved/<slug>`) and writes
+  its report under `.kogen/runtime/shaping-audits/<slug>/`.
+
+  `mix kogen.audit --status [--route <name>] <slug>` recomputes the current
+  revision and `HEAD` and prints whether the last report for them is
+  `current`, `stale` or `missing`.
+
+  `mix kogen.audit --stop-hook` runs the Shaping session's Stop hook (see
+  `Kogen.ShapingAudit.StopHook`).
+
+  This task only delegates to `Kogen.ShapingAudit.main/2` and halts with its
+  exit code (`0` ready, `1` not ready, `2` on a usage error).
+  """
+
+  @impl Mix.Task
+  def run(args) do
+    System.halt(Kogen.ShapingAudit.main(args))
+  end
+end
