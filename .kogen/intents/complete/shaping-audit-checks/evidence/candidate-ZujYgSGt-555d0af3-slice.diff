+
+  # -- title / commit_subject ------------------------------------------------
+
+  test "long-title: title-format and commit-subject-format both fire, mechanically" do
+    root = fixture_repo!()
+    ctx = draft_ctx!(root, "long-title")
+    result = Deterministic.run(ctx)
+
+    assert finding_ids(result) == ["commit-subject-format", "title-format"]
+
+    for id <- ["title-format", "commit-subject-format"] do
+      finding = find(result, id)
+      assert finding["severity"] == "blocking"
+      assert finding["disputable"] == false
+      # a disposition can never clear a mechanical finding.
+      disposed =
+        Finding.apply_dispositions([finding], %{
+          id => %{"kind" => "not-a-defect", "text" => "irrelevant"}
+        })
+
+      assert Finding.open_blocking?(hd(disposed))
+    end
+
+    assert find(result, "title-format")["message"] =~ "more than 50 characters"
+    assert find(result, "commit-subject-format")["message"] =~ "more than 72 characters"
