diff --git a/test/kogen/process_custody_test.exs b/test/kogen/process_custody_test.exs
index 457202da..165e043d 100644
--- a/test/kogen/process_custody_test.exs
+++ b/test/kogen/process_custody_test.exs
@@ -286,6 +286,38 @@ defmodule Kogen.ProcessCustodyTest do
     Port.close(unrelated)
   end
 
+  test "release cannot race a finishing group into recreating the lock", %{base: base} do
+    control = control_dir(base)
+    {:ok, :fresh} = Kogen.ProcessCustody.acquire(control)
+    Kogen.ProcessCustody.claim(control, "regression")
+    parent = self()
+
+    Kogen.ProcessCustody.set_forget_group_hook(fn ->
+      send(parent, :forget_group_paused)
+
+      receive do
+        :resume_forget_group -> :ok
+      end
+    end)
+
+    on_exit(fn -> Kogen.ProcessCustody.clear_forget_group_hook() end)
+
+    forget_task = Task.async(fn -> Kogen.ProcessCustody.forget_group(control, 123) end)
+    assert_receive :forget_group_paused
+
+    release_task = Task.async(fn -> Kogen.ProcessCustody.release(control) end)
+    Process.sleep(50)
+    send(forget_task.pid, :resume_forget_group)
+
+    assert :ok = Task.await(forget_task, 5_000)
+    assert :ok = Task.await(release_task, 5_000)
+    refute File.exists?(Kogen.ProcessCustody.lock_path(control))
+
+    Kogen.ProcessCustody.record_group(control, "regression", %{"pid" => 123})
+    Kogen.ProcessCustody.forget_group(control, 123)
+    refute File.exists?(Kogen.ProcessCustody.lock_path(control))
+  end
+
