diff --git a/test/kogen/process_custody_test.exs b/test/kogen/process_custody_test.exs
index 457202da..439826f2 100644
--- a/test/kogen/process_custody_test.exs
+++ b/test/kogen/process_custody_test.exs
@@ -123,6 +123,44 @@ defmodule Kogen.ProcessCustodyTest do
     refute alive?(grandchild_pid)
   end
 
+  test "release cannot race a finishing group into recreating the lock", %{base: base} do
+    on_exit(fn ->
+      :persistent_term.erase({Kogen.ProcessCustody, :forget_group_hook})
+    end)
+
+    control = control_dir(base)
+    path = Kogen.ProcessCustody.lock_path(control)
+
+    File.write!(
+      path,
+      Jason.encode!(%{
+        "pid" => 0,
+        "started_at" => "",
+        "build_id" => nil,
+        "groups" => [%{"pid" => 123, "pgid" => 123, "started_at" => "", "role" => "test"}]
+      })
+    )
+
+    parent = self()
+
+    :persistent_term.put({Kogen.ProcessCustody, :forget_group_hook}, fn _ ->
+      send(parent, :forget_read)
+
+      receive do
+        :continue_forget -> :ok
+      end
+    end)
+
+    task = Task.async(fn -> Kogen.ProcessCustody.forget_group(control, 123) end)
+    assert_receive :forget_read, 1_000
+    release_task = Task.async(fn -> Kogen.ProcessCustody.release(control) end)
+
+    send(task.pid, :continue_forget)
+    Task.await(task)
+    assert :ok = Task.await(release_task)
+    refute File.exists?(path)
+  end
+
   test "the supervisor removes the temporary prompt file once the child ends", %{base: base} do
     out = out_dir(base)
     dir = Path.join(base, "stdin-#{System.unique_integer([:positive])}")
