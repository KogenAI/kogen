+fn root_from(arg: Option<&str>) -> Result<PathBuf, (i32, String)> {
+    let p = arg
+        .map(PathBuf::from)
+        .unwrap_or_else(|| env::current_dir().unwrap_or_default());
+    if !p.is_dir() {
+        return Err((1, format!("not a directory: {}", arg.unwrap_or(""))));
+    };
+    let out = Command::new("git")
+        .args([
+            "-C",
+            p.to_string_lossy().as_ref(),
+            "rev-parse",
+            "--show-toplevel",
+        ])
+        .output()
+        .map_err(|e| (1, e.to_string()))?;
+    if !out.status.success() {
+        let c = fs::canonicalize(&p).unwrap_or(p);
+        return Err((1, format!("not a Git checkout: {}", c.display())));
+    };
+    Ok(fs::canonicalize(String::from_utf8_lossy(&out.stdout).trim()).unwrap())
+}
+fn project_id(root: &Path) -> String {
+    sha256::digest(root.to_string_lossy().as_bytes())
