+
+### Context index (`kogen-ctx`)
+
+Rust 1.97.1 is required (pinned in `mise.toml`). Build the native binary once with
+`mix kogen.ctx.build` (or `mix kogen.ctx.build --offline` when the locked crates are cached).
+The binary provides `index`, `search`, `symbols`, `refs`, `map`, and `mcp`; query commands refresh a
+machine-local SQLite index keyed by the canonical checkout path. Set `KOGEN_CTX_HOME` to choose its
+cache directory; nothing is written into or committed from the checkout. `mcp` speaks newline-delimited
+JSON-RPC and can be registered with `claude mcp add kogen-ctx -- <path> mcp`.
diff --git a/lib/kogen/ctx.ex b/lib/kogen/ctx.ex
new file mode 100644
index 00000000..609a0801
--- /dev/null
+++ b/lib/kogen/ctx.ex
@@ -0,0 +1,52 @@
+defmodule Kogen.Ctx do
+  @moduledoc "Builds the native kogen-ctx binary."
+  use Boundary, deps: []
+
+  def fetch(root, opts \\ []) do
+    args =
+      ["fetch", "--locked"] ++
+        if(opts[:offline], do: ["--offline"], else: []) ++
+        ["--manifest-path", Path.join(root, "native/kogen-ctx/Cargo.toml")]
+
+    run_cargo(root, args)
+  end
+
+  def build(root) do
+    args = [
+      "build",
+      "--release",
+      "--locked",
+      "--offline",
+      "--manifest-path",
+      Path.join(root, "native/kogen-ctx/Cargo.toml"),
+      "--target-dir",
+      Path.join(root, "_build/cargo")
+    ]
+
+    case run_cargo(root, args) do
+      :ok -> {:ok, Path.join(root, "_build/cargo/release/kogen-ctx")}
+      {:error, _} = e -> e
+    end
+  end
+
+  defp run_cargo(root, args) do
+    case System.cmd("cargo", args, cd: root, stderr_to_stdout: true) do
+      {_out, 0} -> :ok
+      {out, status} -> {:error, "cargo exited #{status}: #{tail(out)}"}
+    end
+  rescue
+    e in ErlangError ->
+      if Exception.message(e) =~ "enoent" do
+        {:error, "cargo not found on PATH: install Rust 1.97.1 (mise.toml pins it)"}
+      else
+        {:error, Exception.message(e)}
+      end
+
+    e ->
+      {:error, Exception.message(e)}
+  end
+
+  defp tail(out) do
+    out |> String.split("\n") |> Enum.take(-20) |> Enum.join("\n") |> String.trim()
+  end
+end
diff --git a/lib/mix/tasks/kogen.ctx.build.ex b/lib/mix/tasks/kogen.ctx.build.ex
new file mode 100644
index 00000000..3e766c07
--- /dev/null
+++ b/lib/mix/tasks/kogen.ctx.build.ex
@@ -0,0 +1,19 @@
+defmodule Mix.Tasks.Kogen.Ctx.Build do
+  @moduledoc "Builds the native kogen-ctx binary."
+  use Mix.Task
+  use Boundary, deps: [Kogen.Ctx, Mix]
+  @shortdoc "Build the native kogen-ctx binary"
+  def run(args) do
+    Mix.Task.run("app.start")
+    {offline, rest} = Enum.split_with(args, &(&1 == "--offline"))
+    if rest != [], do: Mix.raise("usage: mix kogen.ctx.build [--offline]")
+    root = File.cwd!()
+
+    with :ok <- Kogen.Ctx.fetch(root, offline: offline != []),
+         {:ok, path} <- Kogen.Ctx.build(root) do
+      Mix.shell().info(Path.expand(path))
+    else
+      {:error, reason} -> Mix.raise(reason)
+    end
+  end
+end
