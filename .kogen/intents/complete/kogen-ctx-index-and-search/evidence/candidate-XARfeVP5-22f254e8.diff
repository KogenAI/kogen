+defmodule Kogen.CtxMcpTest do
+  use ExUnit.Case, async: true
+  Code.require_file("../support/ctx_fixture.ex", __DIR__)
+  alias Kogen.Test.CtxFixture
+
+  test "mcp returns initialize and tools list responses" do
+    {root, home} = CtxFixture.create!()
+    binary = CtxFixture.binary()
+
+    request =
+      ~s({"jsonrpc":"2.0","id":1,"method":"initialize","params":{"protocolVersion":"2025-06-18"}}) <>
+        "\n" <>
+        ~s({"jsonrpc":"2.0","id":2,"method":"tools/list","params":{}}) <> "\n"
+
+    path = Path.join(root, "requests.jsonl")
+    File.write!(path, request)
+    shell = ~S(exec "$0" mcp --root "$1" < "$2")
+
+    {out, 0} =
+      System.cmd("/bin/sh", ["-c", shell, binary, root, path],
+        cd: root,
+        env: [{"KOGEN_CTX_HOME", home}]
+      )
+
+    replies = String.split(out, "\n", trim: true) |> Enum.map(&Jason.decode!/1)
+    assert Enum.at(replies, 0)["result"]["protocolVersion"] == "2025-06-18"
+
+    assert Enum.map(Enum.at(replies, 1)["result"]["tools"], & &1["name"]) == [
+             "search",
+             "symbols",
+             "refs",
+             "map"
+           ]
+  end
+
+  test "ctx task is available" do
+    assert Code.ensure_loaded?(Mix.Tasks.Kogen.Ctx.Build)
+  end
+end
