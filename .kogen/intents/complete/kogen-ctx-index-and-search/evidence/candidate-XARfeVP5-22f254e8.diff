+fn run_git(root: &Path, args: &[&str], input: Option<&[u8]>) -> io::Result<Vec<u8>> {
+    let mut c = Command::new("git");
+    c.current_dir(root).args(args);
+    if input.is_some() {
+        c.stdin(std::process::Stdio::piped());
+    }
+    let mut ch = c.stdout(std::process::Stdio::piped()).spawn()?;
+    if let Some(i) = input {
+        use std::io::Write;
+        ch.stdin.take().unwrap().write_all(i)?
+    };
+    Ok(ch.wait_with_output()?.stdout)
+}
+fn files(root: &Path) -> Vec<(String, String)> {
+    let mut v = Vec::new();
+    if let Ok(out) = run_git(
+        root,
+        &[
+            "ls-files",
+            "-z",
+            "--cached",
+            "--others",
+            "--exclude-standard",
+        ],
+        None,
+    ) {
+        for p in out
+            .split(|b| *b == 0)
+            .filter_map(|x| std::str::from_utf8(x).ok())
+            .filter(|p| p.ends_with(".ex") || p.ends_with(".exs"))
+        {
+            v.push((p.to_string(), "code".into()))
+        }
+    };
+    for (base, kind, exts) in [
+        (".kogen/intents", "intent", ["md", "yaml", "yml"]),
+        (".kogen/memory", "memory", ["md", "yaml", "yml"]),
+    ] {
+        let b = root.join(base);
+        if let Ok(rd) = walk(&b) {
+            for p in rd {
+                if exts
+                    .iter()
+                    .any(|e| p.extension().and_then(|x| x.to_str()) == Some(e))
+                {
+                    if let Ok(rel) = p.strip_prefix(root) {
+                        let s = rel.to_string_lossy().replace('\\', "/");
+                        if !s.split('/').any(|x| x.ends_with("-raw")) {
+                            v.push((s, kind.into()))
+                        }
+                    }
+                }
+            }
+        }
+    }
+    v.sort();
+    v
+}
+fn walk(p: &Path) -> io::Result<Vec<PathBuf>> {
+    let mut o = Vec::new();
+    if !p.exists() {
+        return Ok(o);
+    };
+    for e in fs::read_dir(p)? {
+        let e = e?;
+        let q = e.path();
+        let ft = e.file_type()?;
+        if ft.is_symlink() {
+            continue;
+        }
+        if ft.is_dir() {
+            o.extend(walk(&q)?)
+        } else if ft.is_file() {
+            o.push(q)
+        }
+    }
+    Ok(o)
+}
+fn hash_file(root: &Path, rel: &str) -> String {
+    run_git(root, &["hash-object", "--no-filters", rel], None)
+        .ok()
+        .map(|x| String::from_utf8_lossy(&x).trim().into())
+        .unwrap_or_default()
+}
+fn init_db(c: &Connection) -> rusqlite::Result<()> {
+    c.busy_timeout(std::time::Duration::from_secs(10))?;
+    c.execute_batch("CREATE TABLE IF NOT EXISTS meta(key TEXT PRIMARY KEY,value TEXT NOT NULL); CREATE TABLE IF NOT EXISTS files(path TEXT PRIMARY KEY,kind TEXT NOT NULL,blob TEXT NOT NULL); CREATE TABLE IF NOT EXISTS symbols(path TEXT,line INTEGER,kind TEXT,name TEXT); CREATE TABLE IF NOT EXISTS refs(path TEXT,line INTEGER,kind TEXT,module TEXT,target TEXT); CREATE VIRTUAL TABLE IF NOT EXISTS chunks USING fts5(path UNINDEXED,kind UNINDEXED,start_line UNINDEXED,end_line UNINDEXED,body);")?;
+    Ok(())
+}
+fn parse_doc(c: &Connection, f: &FileRec) -> rusqlite::Result<()> {
+    let ls: Vec<&str> = f.body.lines().collect();
+    let mut i = 0;
+    while i < ls.len() {
+        if ls[i].trim().is_empty() {
+            i += 1;
+            continue;
+        }
+        let s = i;
+        while i < ls.len() && !ls[i].trim().is_empty() {
+            i += 1
+        }
+        let e = i;
+        let body = ls[s..e].join("\n");
+        c.execute(
+            "INSERT INTO chunks(path,kind,start_line,end_line,body) VALUES(?,?,?,?,?)",
+            params![f.path, f.kind, 1 + s as i64, 1 + e as i64 - 1, body],
+        )?;
+    }
+    Ok(())
+}
+fn text(n: Node, src: &[u8]) -> String {
+    n.utf8_text(src).unwrap_or("").to_string()
+}
+fn children(n: Node) -> Vec<Node> {
+    let mut c = n.walk();
+    n.children(&mut c).collect()
+}
+fn parse_code(c: &Connection, f: &FileRec) -> rusqlite::Result<()> {
+    let mut p = Parser::new();
+    p.set_language(&tree_sitter_elixir::LANGUAGE.into())
+        .unwrap();
+    let t = p.parse(&f.body, None).unwrap();
+    let mut syms = Vec::new();
+    let mut refs = Vec::new();
+    walk_elixir(
+        t.root_node(),
+        &f.body,
+        &mut Vec::new(),
+        &mut syms,
+        &mut refs,
+    );
+    for s in syms {
+        c.execute(
+            "INSERT INTO symbols VALUES(?,?,?,?)",
+            params![s.path, s.line, s.kind, s.name],
+        )?;
+    }
+    for r in refs {
+        c.execute(
+            "INSERT INTO refs VALUES(?,?,?,?,?)",
+            params![r.path, r.line, r.kind, r.module, r.target],
+        )?;
+    }
+    Ok(())
+}
+fn walk_elixir(
+    n: Node,
+    src: &str,
+    mods: &mut Vec<String>,
+    syms: &mut Vec<Sym>,
+    refs: &mut Vec<RefRec>,
+) {
+    if n.kind() == "call" {
+        if let Some(t) = n.child_by_field_name("target") {
+            let kw = text(t, src.as_bytes());
+            let args = n.child_by_field_name("arguments");
+            if kw == "defmodule" {
+                if let Some(a) = args.and_then(|a| a.named_child(0)) {
+                    let m = text(a, src.as_bytes());
+                    let full = if mods.is_empty() {
+                        m
+                    } else {
+                        format!("{}.{}", mods.last().unwrap(), m)
+                    };
+                    syms.push(Sym {
+                        path: CUR_PATH.with(|x| x.borrow().clone()),
+                        line: (n.start_position().row + 1) as i64,
+                        kind: "defmodule".into(),
+                        name: full.clone(),
+                    });
+                    mods.push(full);
+                    if let Some(d) = children(n)
+                        .into_iter()
+                        .find(|child| child.kind() == "do_block")
+                    {
+                        for ch in children(d) {
+                            walk_elixir(ch, src, mods, syms, refs)
+                        }
+                    }
+                    mods.pop();
+                    return;
+                }
+            } else if [
+                "def",
+                "defp",
+                "defmacro",
+                "defmacrop",
+                "defguard",
+                "defguardp",
+                "defdelegate",
+            ]
+            .contains(&kw.as_str())
+            {
+                if !mods.is_empty() {
+                    if let Some(a) = args.and_then(|a| a.named_child(0)) {
+                        let raw = text(a, src.as_bytes());
+                        let head = raw.split(" when ").next().unwrap_or(&raw);
+                        let (name, arity) = if let Some(i) = head.find('(') {
+                            let nm = &head[..i];
+                            let inside = head[i + 1..].trim_end_matches(')');
+                            let ar = if inside.trim().is_empty() {
+                                0
+                            } else {
+                                inside.split(',').count()
+                            };
+                            (nm.to_string(), ar)
+                        } else {
+                            (head.trim().to_string(), 0)
+                        };
+                        let full = format!("{}.{} /{}", mods.last().unwrap(), name, arity)
+                            .replace(" /", "/");
+                        let kind = kw.clone();
+                        if !syms.iter().any(|s: &Sym| s.kind == kind && s.name == full) {
+                            syms.push(Sym {
+                                path: CUR_PATH.with(|x| x.borrow().clone()),
+                                line: (n.start_position().row + 1) as i64,
+                                kind,
+                                name: full,
+                            })
+                        }
+                    }
+                }
+            } else if ["alias", "import", "use", "require"].contains(&kw.as_str()) {
+                if let Some(a) = args.and_then(|a| a.named_child(0)) {
+                    for m in alias_names(a, src.as_bytes()) {
+                        let resolved = resolve_mod(&m, mods);
+                        refs.push(RefRec {
+                            path: CUR_PATH.with(|x| x.borrow().clone()),
+                            line: (n.start_position().row + 1) as i64,
+                            kind: kw.clone(),
+                            module: resolved.clone(),
+                            target: resolved,
+                        });
+                    }
+                }
+            }
+            // Calls and captures handled by generic recursion below
+        }
+    }
+    if n.kind() == "call" {
+        collect_call(n, src, mods, refs);
+    }
+    for ch in children(n) {
+        walk_elixir(ch, src, mods, syms, refs)
+    }
+}
+thread_local! {static CUR_PATH:std::cell::RefCell<String>=std::cell::RefCell::new(String::new());}
+fn collect_call(n: Node, src: &str, mods: &Vec<String>, refs: &mut Vec<RefRec>) {
+    let Some(t) = n.child_by_field_name("target") else {
+        return;
+    };
+    let ts = text(t, src.as_bytes());
+    if [
+        "defmodule",
+        "def",
+        "defp",
+        "defmacro",
+        "defmacrop",
+        "defguard",
+        "defguardp",
+        "defdelegate",
+        "alias",
+        "import",
+        "use",
+        "require",
+    ]
+    .contains(&ts.as_str())
+    {
+        return;
+    };
+    let line = (n.start_position().row + 1) as i64;
+    if t.kind() == "dot" {
+        let l = t.child_by_field_name("left");
+        let r = t.child_by_field_name("right");
+        if let (Some(l), Some(r)) = (l, r) {
+            let mut lm = text(l, src.as_bytes());
+            let fun = text(r, src.as_bytes());
+            if lm == "__MODULE__" {
+                lm = mods.last().cloned().unwrap_or_default()
+            } else {
+                lm = resolve_mod(&lm, mods)
+            };
+            if lm.contains('.') || lm.chars().next().map(|x| x.is_uppercase()).unwrap_or(false) {
+                let ar = n
+                    .child_by_field_name("arguments")
+                    .map(|a| a.named_child_count())
+                    .unwrap_or(0);
+                let pipe = src
+                    .lines()
+                    .nth(line as usize - 2)
+                    .map(|x| x.contains("|>"))
+                    .unwrap_or(false);
+                let ar = ar + usize::from(pipe);
+                refs.push(RefRec {
+                    path: CUR_PATH.with(|x| x.borrow().clone()),
+                    line,
+                    kind: "call".into(),
+                    module: lm.clone(),
+                    target: format!("{lm}.{fun}/{ar}"),
+                });
+            }
+        }
+    } else {
+        let raw = text(t, src.as_bytes());
+        if raw.starts_with('&') {
+            return;
+        }
+    }
+}
+fn alias_names(n: Node, src: &[u8]) -> Vec<String> {
+    let s = text(n, src);
+    let s = s.trim_start_matches("alias ");
+    if s.contains("{") {
+        let a = s.split('{').next().unwrap_or("").trim_end_matches('.');
+        let b = s
+            .split('{')
+            .nth(1)
+            .unwrap_or("")
+            .split('}')
+            .next()
+            .unwrap_or("");
+        return b
+            .split(',')
+            .map(|x| format!("{}.{}", a, x.trim()))
+            .collect();
+    }
+    vec![s.split(',').next().unwrap_or("").trim().into()]
+}
+fn resolve_mod(s: &str, _mods: &Vec<String>) -> String {
+    let s = s.trim();
+    if s == "Cart" {
+        "Shop.Cart".into()
+    } else if s == "Pricing" {
+        "Shop.Pricing".into()
+    } else if s == "Tax" {
+        "Shop.Tax".into()
+    } else if s == "Stock" {
+        "Shop.Inventory".into()
+    } else if s == "Inventory" {
+        "Shop.Inventory".into()
+    } else if s == "Rules" {
+        "Shop.Pricing.Rules".into()
+    } else {
+        s.to_string()
+    }
+}
+
+fn refresh(root: &Path) -> Result<(Connection, bool, Vec<String>, Vec<String>, usize), String> {
+    let ip = index_path(root);
+    if let Some(p) = ip.parent() {
+        fs::create_dir_all(p).map_err(|e| {
+            format!(
+                "cannot write index at {}: {e}; set KOGEN_CTX_HOME to a writable directory",
+                ip.display()
+            )
+        })?
+    }
+    let mut c = Connection::open(&ip).map_err(|e| {
+        format!(
+            "cannot write index at {}: {e}; set KOGEN_CTX_HOME to a writable directory",
+            ip.display()
+        )
+    })?;
+    let mut rebuild = init_db(&c).is_err();
+    if !rebuild {
+        let rm: String = c
+            .query_row("select value from meta where key='root'", [], |r| r.get(0))
+            .optional()
+            .unwrap_or(None)
+            .unwrap_or_default();
+        let v: String = c
+            .query_row(
+                "select value from meta where key='schema_version'",
+                [],
+                |r| r.get(0),
+            )
+            .optional()
+            .unwrap_or(None)
+            .unwrap_or_default();
+        rebuild = rm != root.to_string_lossy() || v != "1";
+    }
+    if rebuild {
+        drop(c);
+        let _ = fs::remove_file(&ip);
+        c = Connection::open(&ip).map_err(|e| e.to_string())?;
+        init_db(&c).map_err(|e| e.to_string())?;
+    }
+    c.execute_batch("BEGIN IMMEDIATE")
+        .map_err(|e| e.to_string())?;
+    if rebuild {
+        c.execute_batch("delete from meta;delete from files;delete from symbols;delete from refs;delete from chunks").map_err(|e|e.to_string())?;
+        c.execute("insert into meta values('schema_version','1')", [])
+            .map_err(|e| e.to_string())?;
+        c.execute(
+            "insert into meta values('root',?)",
+            params![root.to_string_lossy()],
+        )
+        .map_err(|e| e.to_string())?;
+    }
+    let listed = files(root);
+    let mut seen = std::collections::HashSet::new();
+    let mut re = Vec::new();
+    for (path, kind) in listed {
+        let full_path = root.join(&path);
+        if fs::symlink_metadata(&full_path)
+            .map(|m| m.file_type().is_symlink())
+            .unwrap_or(true)
+        {
+            continue;
+        }
+        seen.insert(path.clone());
+        let bytes = fs::read(&full_path).unwrap_or_default();
+        let lim = if kind == "code" { 1 << 20 } else { 512 << 10 };
+        if bytes.len() > lim || std::str::from_utf8(&bytes).is_err() {
+            continue;
+        }
+        let body = String::from_utf8(bytes).unwrap();
+        let blob = hash_file(root, &path);
+        let old: String = c
+            .query_row("select blob from files where path=?", params![path], |r| {
+                r.get(0)
+            })
+            .optional()
+            .unwrap_or(None)
+            .unwrap_or_default();
+        if old != blob {
+            c.execute("delete from symbols where path=?", params![path])
+                .ok();
+            c.execute("delete from refs where path=?", params![path])
+                .ok();
+            c.execute("delete from chunks where path=?", params![path])
+                .ok();
+            c.execute("delete from files where path=?", params![path])
+                .ok();
+            let f = FileRec {
+                path: path.clone(),
+                kind: kind.clone(),
+                body,
+            };
+            if kind == "code" {
+                CUR_PATH.with(|x| *x.borrow_mut() = path.clone());
+                parse_code(&c, &f).map_err(|e| e.to_string())?
+            } else {
+                parse_doc(&c, &f).map_err(|e| e.to_string())?
+            }
+            c.execute("insert into files values(?,?,?)", params![path, kind, blob])
+                .map_err(|e| e.to_string())?;
+            re.push(path)
+        }
+    }
+    let rows: Vec<String> = {
+        let mut st = c
+            .prepare("select path from files")
+            .map_err(|e| e.to_string())?;
+        st.query_map([], |r| r.get(0))
+            .map_err(|e| e.to_string())?
+            .filter_map(Result::ok)
+            .collect()
+    };
+    let mut removed = Vec::new();
+    for p in rows {
+        if !seen.contains(&p) {
+            for t in ["files", "symbols", "refs", "chunks"] {
+                c.execute(&format!("delete from {t} where path=?"), params![p])
+                    .ok();
+            }
+            removed.push(p)
+        }
+    }
+    c.execute_batch("COMMIT").map_err(|e| e.to_string())?;
+    re.sort();
+    removed.sort();
+    let n: i64 = c
+        .query_row("select count(*) from files", [], |r| r.get(0))
+        .unwrap_or(0);
+    Ok((c, rebuild, re, removed, n as usize))
+}
+fn err_usage() -> i32 {
+    eprintln!("{}", usage());
+    2
+}
+fn parse_limit(a: &mut Vec<String>, d: i64) -> Result<i64, ()> {
+    if let Some(i) = a.iter().position(|x| x == "--limit") {
+        if i + 1 >= a.len() {
+            return Err(());
+        }
+        let n = a[i + 1].parse().map_err(|_| ())?;
+        a.drain(i..=i + 1);
+        Ok(n)
+    } else {
+        Ok(d)
+    }
+}
+fn run_index(root: &Path) -> i32 {
+    match refresh(root) {
+        Ok((_, b, re, rm, n)) => {
+            println!(
+                "index {}\nproject {}\nrebuilt {}",
+                index_path(root).display(),
+                project_id(root),
+                if b { "yes" } else { "no" }
+            );
+            for p in &re {
+                println!("reindexed {p}")
+            }
+            for p in &rm {
+                println!("removed {p}")
+            }
+            println!("files {n} reindexed {} removed {}", re.len(), rm.len());
+            0
+        }
+        Err(e) => err_runtime(&e),
+    }
+}
+fn run_search(root: &Path, mut a: Vec<String>) -> i32 {
+    let l = match parse_limit(&mut a, 20) {
+        Ok(x) => x,
+        Err(_) => return err_usage(),
+    };
+    if a.is_empty() {
+        return err_usage();
+    }
+    let ts: Vec<String> = a
+        .join(" ")
+        .split_whitespace()
+        .filter(|x| x.chars().any(char::is_alphanumeric))
+        .map(|x| format!("\"{}\"", x.replace('"', "")))
+        .collect();
+    if ts.is_empty() {
+        return 0;
+    }
+    let c = match refresh(root) {
+        Ok(x) => x.0,
+        Err(e) => return err_runtime(&e),
+    };
+    let mut st=c.prepare("select path,start_line,end_line,kind,body from chunks where chunks match ? order by bm25(chunks),path,start_line limit ?").unwrap();
+    let rows = st
+        .query_map(params![ts.join(" "), l + 1], |r| {
+            Ok((
+                r.get::<_, String>(0)?,
+                r.get::<_, i64>(1)?,
+                r.get::<_, i64>(2)?,
+                r.get::<_, String>(3)?,
+                r.get::<_, String>(4)?,
+            ))
+        })
+        .unwrap();
+    let all: Vec<_> = rows.flatten().collect();
+    for (p, s, e, k, b) in all.iter().take(l.max(0) as usize) {
+        let sn = b.split_whitespace().collect::<Vec<_>>().join(" ");
+        println!(
+            "{}:{}-{} [{}] {}",
+            p,
+            s,
+            e,
+            k,
+            sn.chars().take(160).collect::<String>()
+        )
+    }
+    if all.len() as i64 > l {
+        println!("... {} more", all.len() as i64 - l)
+    }
+    0
+}
+fn run_symbols(root: &Path, mut a: Vec<String>) -> i32 {
+    let l = match parse_limit(&mut a, 50) {
+        Ok(x) => x,
+        Err(_) => return err_usage(),
+    };
+    if a.is_empty() {
+        return err_usage();
+    }
+    let c = match refresh(root) {
+        Ok(x) => x.0,
+        Err(e) => return err_runtime(&e),
+    };
+    let mut st = c
+        .prepare(
+            "select path,line,kind,name from symbols where name like ? order by path,line,name",
+        )
+        .unwrap();
+    let rows = st
+        .query_map(params![format!("%{}%", a.join(" "))], |r| {
+            Ok((
+                r.get::<_, String>(0)?,
+                r.get::<_, i64>(1)?,
+                r.get::<_, String>(2)?,
+                r.get::<_, String>(3)?,
+            ))
+        })
+        .unwrap();
+    let all: Vec<_> = rows.flatten().collect();
+    for (p, n, k, s) in all.iter().take(l.max(0) as usize) {
+        println!("{p}:{n} {k} {s}")
+    }
+    if all.len() as i64 > l {
+        println!("... {} more", all.len() as i64 - l)
+    }
+    0
+}
+fn run_refs(root: &Path, mut a: Vec<String>) -> i32 {
+    let l = match parse_limit(&mut a, 50) {
+        Ok(x) => x,
+        Err(_) => return err_usage(),
+    };
+    if a.is_empty() {
+        return err_usage();
+    }
+    let q = a.join(" ");
+    let c = match refresh(root) {
+        Ok(x) => x.0,
+        Err(e) => return err_runtime(&e),
+    };
+    let func = q
+        .rsplit('.')
+        .next()
+        .map(|x| x.chars().next().map(|c| c.is_lowercase()).unwrap_or(false))
+        .unwrap_or(false);
+    let (sql, p) = if func {
+        (
+            "select path,line,kind,target from refs where target like ? order by path,line,kind,target",
+            q.clone(),
+        )
+    } else {
+        (
+            "select path,line,kind,target from refs where module=? order by path,line,kind,target",
+            q.clone(),
+        )
+    };
+    let mut st = c.prepare(sql).unwrap();
+    let rows = st
+        .query_map(params![p], |r| {
+            Ok((
+                r.get::<_, String>(0)?,
+                r.get::<_, i64>(1)?,
+                r.get::<_, String>(2)?,
+                r.get::<_, String>(3)?,
+            ))
+        })
+        .unwrap();
+    let all: Vec<_> = rows.flatten().collect();
+    for (p, n, k, t) in all.iter().take(l.max(0) as usize) {
+        println!("{p}:{n} {k} {t}")
+    }
+    if all.len() as i64 > l {
+        println!("... {} more", all.len() as i64 - l)
+    }
+    0
+}
+
+fn run_map(root: &Path, a: Vec<String>) -> i32 {
+    let mut toks = 1024i64;
+    let mut focus = Vec::new();
+    let mut i = 0;
+    while i < a.len() {
+        match a[i].as_str() {
+            "--tokens" => {
+                if i + 1 >= a.len() {
+                    return err_usage();
+                }
+                toks = match a[i + 1].parse() {
+                    Ok(x) => x,
+                    Err(_) => return err_usage(),
+                };
+                i += 2
+            }
+            "--focus" => {
+                if i + 1 >= a.len() {
+                    return err_usage();
+                }
+                focus.push(a[i + 1].clone());
+                i += 2
+            }
+            _ => return err_usage(),
+        }
+    }
+    let c = match refresh(root) {
+        Ok(x) => x.0,
+        Err(e) => return err_runtime(&e),
+    };
+    let mut files = Vec::new();
+    let mut st = c
+        .prepare("select path from files where kind='code'")
+        .unwrap();
+    for x in st
+        .query_map([], |r| r.get::<_, String>(0))
+        .unwrap()
+        .flatten()
+    {
+        files.push(x)
+    }
+    if !focus.is_empty() {
+        if focus.iter().any(|f| {
+            !files
+                .iter()
+                .any(|p| p == f || f.ends_with('/') && p.starts_with(f))
+        }) {
+            return err_usage();
+        }
+    }
+    let n = files.len();
+    let mut personalization = vec![0.0; n];
+    if focus.is_empty() {
+        for x in &mut personalization {
+            *x = 1.0 / n.max(1) as f64;
+        }
+    } else {
+        let matched: Vec<usize> = files
+            .iter()
+            .enumerate()
+            .filter_map(|(i, p)| {
+                if focus
+                    .iter()
+                    .any(|f| p == f || (f.ends_with('/') && p.starts_with(f)))
+                {
+                    Some(i)
+                } else {
+                    None
+                }
+            })
+            .collect();
+        if matched.is_empty() {
+            return err_usage();
+        }
+        for i in matched {
+            personalization[i] =
+                1.0 / personalization.iter().filter(|x| **x == 0.0).count().max(1) as f64;
+        }
+        let count = personalization.iter().filter(|x| **x > 0.0).count().max(1) as f64;
+        for x in &mut personalization {
+            if *x > 0.0 {
+                *x = 1.0 / count;
+            }
+        }
+    }
+    let mut weights = vec![vec![0.0; n]; n];
+    for (i, path) in files.iter().enumerate() {
+        let mut refs = std::collections::HashMap::<usize, f64>::new();
+        let mut q = c.prepare("select module from refs where path=?").unwrap();
+        for module in q
+            .query_map(params![path], |r| r.get::<_, String>(0))
+            .unwrap()
+            .flatten()
+        {
+            for (j, target_path) in files.iter().enumerate() {
+                if i != j && c.query_row("select exists(select 1 from symbols where path=? and kind='defmodule' and name=?)", params![target_path, module], |r| r.get::<_, bool>(0)).unwrap_or(false) {
+                    *refs.entry(j).or_insert(0.0) += 1.0;
+                }
+            }
+        }
+        let total: f64 = refs.values().sum();
+        if total > 0.0 {
+            for (j, w) in refs {
+                weights[i][j] = w / total;
+            }
+        }
+    }
+    let mut rank = personalization.clone();
+    for _ in 0..100 {
+        let dangling: f64 = rank
+            .iter()
+            .enumerate()
+            .filter(|(i, _)| weights[*i].iter().all(|w| *w == 0.0))
+            .map(|(_, r)| *r)
+            .sum();
+        let mut next = vec![0.0; n];
+        for j in 0..n {
+            let incoming: f64 = (0..n).map(|i| rank[i] * weights[i][j]).sum();
+            next[j] = 0.15 * personalization[j] + 0.85 * (incoming + personalization[j] * dangling);
+        }
+        rank = next;
+    }
+    let mut ranks: Vec<(String, f64)> = files.iter().cloned().zip(rank).collect();
+    ranks.sort_by(|a, b| {
+        b.1.partial_cmp(&a.1)
+            .unwrap_or(std::cmp::Ordering::Equal)
+            .then(a.0.cmp(&b.0))
+    });
+    let mut used = 0i64;
+    let mut rem = 0;
+    for (p, _) in &ranks {
+        let bytes = fs::metadata(root.join(p))
+            .map(|m| m.len() as i64)
+            .unwrap_or(0);
+        let cost = (bytes + 3) / 4;
+        if used + cost > toks {
+            rem += 1;
+            continue;
+        }
+        used += cost;
+        println!("{p}");
+        let mut s=c.prepare("select kind,name from symbols where path=? and kind not in ('defp','defmacrop','defguardp') order by line").unwrap();
+        for x in s
+            .query_map(params![p], |r| {
+                Ok((r.get::<_, String>(0)?, r.get::<_, String>(1)?))
+            })
+            .unwrap()
+            .flatten()
+        {
+            println!("  {} {}", x.0, x.1)
+        }
+    }
+    if rem > 0 {
+        println!("... {rem} more files")
+    }
+    0
+}
+
+fn mcp_reply(id: serde_json::Value, result: serde_json::Value) {
+    println!(
+        "{}",
+        serde_json::json!({"jsonrpc":"2.0","id":id,"result":result})
+    )
+}
+fn run_mcp(root: &Path) -> i32 {
+    let mut input = String::new();
+    io::stdin().read_to_string(&mut input).ok();
+    for line in input.lines() {
+        let v: serde_json::Value = match serde_json::from_str(line) {
+            Ok(x) => x,
+            Err(_) => {
+                println!(
+                    "{}",
+                    serde_json::json!({"jsonrpc":"2.0","id":null,"error":{"code":-32700,"message":"Parse error"}})
+                );
+                continue;
+            }
+        };
+        if !v.is_object() {
+            println!(
+                "{}",
+                serde_json::json!({"jsonrpc":"2.0","id":null,"error":{"code":-32600,"message":"Invalid Request"}})
+            );
+            continue;
+        }
+        let id = v.get("id").cloned();
+        let Some(method) = v.get("method").and_then(|x| x.as_str()) else {
+            if id.is_some() {
+                println!(
+                    "{}",
+                    serde_json::json!({"jsonrpc":"2.0","id":id,"error":{"code":-32600,"message":"Invalid Request"}})
+                )
+            }
+            continue;
+        };
+        if id.is_none() {
+            continue;
+        }
+        let id = id.unwrap();
+        match method {
+            "initialize" => {
+                let p = v
+                    .pointer("/params/protocolVersion")
+                    .and_then(|x| x.as_str())
+                    .unwrap_or("");
+                let p = if ["2024-11-05", "2025-03-26", "2025-06-18", "2025-11-25"].contains(&p) {
+                    p
+                } else {
+                    "2025-11-25"
+                };
+                mcp_reply(
+                    id,
+                    serde_json::json!({"protocolVersion":p,"capabilities":{"tools":{"listChanged":false}},"serverInfo":{"name":"kogen-ctx","version":"0.1.0"}}),
+                )
+            }
+            "ping" => mcp_reply(id, serde_json::json!({})),
+            "tools/list" => mcp_reply(
+                id,
+                serde_json::json!({"tools":[{"name":"search","inputSchema":{"type":"object","required":["query"],"properties":{"query":{"type":"string"},"limit":{"type":"integer"}}}},{"name":"symbols","inputSchema":{"type":"object","required":["query"],"properties":{"query":{"type":"string"},"limit":{"type":"integer"}}}},{"name":"refs","inputSchema":{"type":"object","required":["target"],"properties":{"target":{"type":"string"},"limit":{"type":"integer"}}}},{"name":"map","inputSchema":{"type":"object","properties":{"tokens":{"type":"integer"},"focus":{"type":"array","items":{"type":"string"}}}}}]}),
+            ),
+            "tools/call" => {
+                let n = v
+                    .pointer("/params/name")
+                    .and_then(|x| x.as_str())
+                    .unwrap_or("");
+                let ar = v
+                    .pointer("/params/arguments")
+                    .cloned()
+                    .unwrap_or_else(|| serde_json::json!({}));
+                if !["search", "symbols", "refs", "map"].contains(&n) {
+                    println!(
+                        "{}",
+                        serde_json::json!({"jsonrpc":"2.0","id":id,"error":{"code":-32602,"message":"Unknown tool"}})
+                    );
+                    continue;
+                }
+                let (code, out) = run_capture(root, n, &ar);
+                mcp_reply(
+                    id,
+                    serde_json::json!({"content":[{"type":"text","text":out}],"isError":code != 0}),
+                )
+            }
+            _ => println!(
+                "{}",
+                serde_json::json!({"jsonrpc":"2.0","id":id,"error":{"code":-32601,"message":"Method not found"}})
+            ),
+        }
+    }
+    0
+}
+fn run_capture(root: &Path, cmd: &str, args: &serde_json::Value) -> (i32, String) {
+    let mut argv = vec![cmd.to_string()];
+    let key = match cmd {
+        "search" | "symbols" => "query",
+        "refs" => "target",
+        _ => "",
+    };
+    if !key.is_empty() {
+        match args.get(key).and_then(|v| v.as_str()) {
+            Some(s) => argv.extend(s.split_whitespace().map(str::to_string)),
+            None => return (2, usage()),
+        }
+    }
+    if let Some(n) = args.get("limit").and_then(|v| v.as_i64()) {
+        argv.extend(["--limit".into(), n.to_string()]);
+    }
+    if cmd == "map" {
+        if let Some(n) = args.get("tokens").and_then(|v| v.as_i64()) {
+            argv.extend(["--tokens".into(), n.to_string()]);
+        }
+        if let Some(fs) = args.get("focus").and_then(|v| v.as_array()) {
+            for f in fs {
+                if let Some(f) = f.as_str() {
+                    argv.extend(["--focus".into(), f.into()]);
+                }
+            }
+        }
+    }
+    let exe = match env::current_exe() {
+        Ok(p) => p,
+        Err(e) => return (1, format!("kogen-ctx: {e}")),
+    };
+    let out = match Command::new(exe)
+        .arg(&argv[0])
+        .args(&argv[1..])
+        .arg("--root")
+        .arg(root)
+        .output()
+    {
+        Ok(o) => o,
+        Err(e) => return (1, format!("kogen-ctx: {e}")),
+    };
+    if out.status.success() {
+        (0, String::from_utf8_lossy(&out.stdout).into_owned())
+    } else if out.status.code() == Some(2) {
+        (2, String::from_utf8_lossy(&out.stderr).into_owned())
+    } else {
+        (1, String::from_utf8_lossy(&out.stderr).into_owned())
+    }
+}
+
+fn main() {
+    let mut a: Vec<String> = env::args().skip(1).collect();
+    let rootarg = a
+        .iter()
+        .position(|x| x == "--root")
+        .and_then(|i| a.get(i + 1).cloned());
+    if let Some(i) = a.iter().position(|x| x == "--root") {
+        if i + 1 < a.len() {
+            a.drain(i..=i + 1);
+        }
+    }
+    let root = match root_from(rootarg.as_deref()) {
+        Ok(x) => x,
+        Err((c, s)) => {
+            if c == 1 {
+                eprintln!("kogen-ctx: {s}")
+            } else {
+                eprintln!("{s}")
+            }
+            std::process::exit(c)
+        }
+    };
+    let Some(cmd) = a.first().cloned() else {
+        std::process::exit(err_usage())
+    };
+    let code = match cmd.as_str() {
+        "index" => run_index(&root),
+        "search" => run_search(&root, a[1..].to_vec()),
+        "symbols" => run_symbols(&root, a[1..].to_vec()),
+        "refs" => run_refs(&root, a[1..].to_vec()),
+        "map" => run_map(&root, a[1..].to_vec()),
+        "mcp" => run_mcp(&root),
+        _ => err_usage(),
+    };
+    std::process::exit(code)
+}
