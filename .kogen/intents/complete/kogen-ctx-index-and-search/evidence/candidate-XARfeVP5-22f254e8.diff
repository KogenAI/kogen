+#![deny(warnings)]
+mod sha256;
+use rusqlite::{params,Connection,OptionalExtension};
+use std::{env,fs,io::{self,Read},path::{Path,PathBuf},process::Command};
+use tree_sitter::{Node,Parser};
+
+#[derive(Clone,Debug)] struct FileRec { path:String, kind:String, blob:String, body:String }
+#[derive(Clone,Debug)] struct Sym {path:String,line:i64,kind:String,name:String}
+#[derive(Clone,Debug)] struct RefRec {path:String,line:i64,kind:String,module:String,target:String}
+fn usage()->String{"usage: kogen-ctx <index|search|symbols|refs|map|mcp> [--root DIR]".into()}
+fn err_runtime(s:&str)->i32 { eprintln!("kogen-ctx: {s}"); 1 }
+fn root_from(arg:Option<&str>)->Result<PathBuf,(i32,String)> { let p=arg.map(PathBuf::from).unwrap_or_else(||env::current_dir().unwrap_or_default()); if !p.is_dir(){return Err((1,format!("not a directory: {}",arg.unwrap_or(""))))}; let out=Command::new("git").args(["-C",p.to_string_lossy().as_ref(),"rev-parse","--show-toplevel"]).output().map_err(|e|(1,e.to_string()))?; if !out.status.success(){let c=fs::canonicalize(&p).unwrap_or(p); return Err((1,format!("not a Git checkout: {}",c.display())))}; Ok(fs::canonicalize(String::from_utf8_lossy(&out.stdout).trim()).unwrap()) }
+fn project_id(root:&Path)->String {sha256::digest(root.to_string_lossy().as_bytes())}
