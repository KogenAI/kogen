+fn index_path(root: &Path) -> PathBuf {
+    let home = env::var("KOGEN_CTX_HOME")
+        .ok()
+        .filter(|s| !s.is_empty())
+        .map(PathBuf::from)
+        .or_else(|| {
+            env::var("HOME")
+                .ok()
+                .map(|h| PathBuf::from(h).join("Library/Caches/Kogen/ctx"))
+        })
+        .unwrap_or_else(|| PathBuf::from("Library/Caches/Kogen/ctx"));
+    home.join(project_id(root)).join("index.sqlite")
