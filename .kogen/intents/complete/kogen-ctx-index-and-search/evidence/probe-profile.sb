(version 1)
(allow default)
(deny file-write*)
(allow file-write*
  (subpath "/private/tmp/claude-501/-Users-almirsarajcic-Areas-Kogen-kogen/e3f094ff-2fa9-429c-a66b-e6608d653666/scratchpad/ctx-edit/probe/crate")
  (subpath "/private/tmp/claude-501/-Users-almirsarajcic-Areas-Kogen-kogen/e3f094ff-2fa9-429c-a66b-e6608d653666/scratchpad/ctx-edit/probe/sb-tmp")
  (literal "/dev/null") (literal "/dev/zero") (literal "/dev/tty") (literal "/dev/ptmx") (literal "/dev/dtracehelper")
  (regex #"^/dev/fd/[0-9]+$") (regex #"^/dev/ttys[0-9]+$"))
(deny lsopen)
(deny appleevent-send)
