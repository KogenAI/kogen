--- /dev/null
+++ b/test/kogen/ctx_index_test.exs
@@ -0,0 +1,72 @@
+Code.require_file("../support/ctx_fixture.ex", __DIR__)
+
+defmodule Kogen.CtxIndexTest do
+  use ExUnit.Case, async: true
+  alias Kogen.Test.CtxFixture
+
+  test "A1 indexes canonical fixture outside repository" do
+    {root, home} = CtxFixture.create!()
+    {out, err, 0} = CtxFixture.run(CtxFixture.binary(), root, home, ["index"])
+    assert err == ""
+    assert out =~ "rebuilt yes"
+    assert out =~ "files 11 reindexed 11 removed 0"
+  end
+
+  test "A5 usage errors happen before filesystem work" do
+    {root, home} = CtxFixture.create!()
+
+    for args <- [
+          [],
+          ["bogus"],
+          ["index", "--root"],
+          ["index", "extra"],
+          ["search", "x", "--limit", "0"],
+          ["search", "x", "--limit", "00"],
+          ["search", "x", "--limit", "1", "--limit", "2"]
+        ] do
+      {out, err, 2} = CtxFixture.run(CtxFixture.binary(), root, home, args)
+      assert out == ""
+      assert String.starts_with?(err, "usage: kogen-ctx")
+    end
+  end
+
+  test "A6 rejects missing HOME" do
+    {root, home} = CtxFixture.create!()
+
+    {out, err, 1} =
+      CtxFixture.run(CtxFixture.binary(), root, home, ["index"], [
+        {"HOME", nil},
+        {"KOGEN_CTX_HOME", nil}
+      ])
+
+    assert out == ""
+    assert err == "kogen-ctx: HOME is not set; set KOGEN_CTX_HOME to a writable directory\n"
+  end
+
+  test "A2 canonical link and subdirectory reuse the index" do
+    {root, home} = CtxFixture.create!()
+    {_, _, 0} = CtxFixture.run(CtxFixture.binary(), root, home, ["index"])
+    link = Path.join(System.tmp_dir!(), "ctx-link-#{System.unique_integer([:positive])}")
+    File.ln_s!(root, link)
+    {out, _, 0} = CtxFixture.run(CtxFixture.binary(), root, home, ["index", "--root", link])
+    assert out =~ "rebuilt no"
+    assert out =~ "files 11 reindexed 0 removed 0"
+  end
+
+  test "B1 mtime-only changes do not reindex" do
+    {root, home} = CtxFixture.create!()
+    {_, _, 0} = CtxFixture.run(CtxFixture.binary(), root, home, ["index"])
+    {out, _, 0} = CtxFixture.run(CtxFixture.binary(), root, home, ["index"])
+    assert out =~ "files 11 reindexed 0 removed 0"
+  end
+
+  test "B3 additions and deletions refresh rows" do
+    {root, home} = CtxFixture.create!()
+    {_, _, 0} = CtxFixture.run(CtxFixture.binary(), root, home, ["index"])
+    File.write!(Path.join(root, "lib/shop/extra.ex"), "defmodule Shop.Extra do\nend\n")
+    File.rm!(Path.join(root, "lib/shop/format.ex"))
+    {out, _, 0} = CtxFixture.run(CtxFixture.binary(), root, home, ["index"])
+    assert out =~ "reindexed lib/shop/extra.ex"
+    assert out =~ "removed lib/shop/format.ex"
+  end
+end
