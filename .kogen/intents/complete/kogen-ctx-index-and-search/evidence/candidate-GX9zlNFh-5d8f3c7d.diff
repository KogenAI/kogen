@@ -0,0 +1,67 @@
+Code.require_file("../support/ctx_fixture.ex", __DIR__)
+
+defmodule Kogen.CtxSearchTest do
+  use ExUnit.Case, async: true
+  alias Kogen.Test.CtxFixture
+
+  setup do
+    {root, home} = CtxFixture.create!()
+    {_, _, 0} = CtxFixture.run(CtxFixture.binary(), root, home, ["index"])
+    %{root: root, home: home, binary: CtxFixture.binary()}
+  end
+
+  test "C1 ranks search results and refreshes", %{root: root, home: home, binary: binary} do
+    {out, "", 0} = CtxFixture.run(binary, root, home, ["search", "the"])
+    assert out =~ "The Developer deletes each stray path"
+  end
+
+  test "C2 searches intents and memory, with safe quoting and limits", %{
+    root: root,
+    home: home,
+    binary: binary
+  } do
+    {out, "", 0} = CtxFixture.run(binary, root, home, ["search", "stray"])
+    assert length(String.split(out, "\n", trim: true)) == 5
+    {limited, "", 0} = CtxFixture.run(binary, root, home, ["search", "stray", "--limit", "2"])
+    assert String.ends_with?(limited, "... 3 more\n")
+    {empty, "", 0} = CtxFixture.run(binary, root, home, ["search", "-", ":"])
+    assert empty == ""
+  end
+
+  test "C9 chunks long runs at sixty lines", %{root: root, home: home, binary: binary} do
+    path = Path.join(root, ".kogen/memory/lesson/long-run.md")
+    File.mkdir_p!(Path.dirname(path))
+    File.write!(path, Enum.map_join(1..130, "\n", &"row #{&1} marker") <> "\n")
+    {out, "", 0} = CtxFixture.run(binary, root, home, ["search", "marker"])
+    assert out =~ "long-run.md:1-60"
+    assert out =~ "long-run.md:61-120"
+    assert out =~ "long-run.md:121-130"
+  end
+
+  test "C4 joins query arguments and C5 does not stem", %{root: root, home: home, binary: binary} do
+    {joined, "", 0} = CtxFixture.run(binary, root, home, ["search", "Mix", "lock"])
+    {single, "", 0} = CtxFixture.run(binary, root, home, ["search", "Mix lock"])
+    assert joined == single
+    {rework, "", 0} = CtxFixture.run(binary, root, home, ["search", "rework"])
+    refute rework =~ "reworked"
+  end
+
+  test "C6 searches drafts but not code and C7 escapes quotes", %{
+    root: root,
+    home: home,
+    binary: binary
+  } do
+    {draft, "", 0} = CtxFixture.run(binary, root, home, ["search", "discounts"])
+    assert draft =~ "cart-discounts/INTENT.md"
+    {quoted, "", 0} = CtxFixture.run(binary, root, home, ["search", ~s(guard\"passes)])
+    assert quoted =~ "guard passes"
+  end
+
+  test "C8 punctuation-only terms are successful empty searches", %{
+    root: root,
+    home: home,
+    binary: binary
+  } do
+    assert {"", "", 0} = CtxFixture.run(binary, root, home, ["search", "-", ":"])
+  end
+end
