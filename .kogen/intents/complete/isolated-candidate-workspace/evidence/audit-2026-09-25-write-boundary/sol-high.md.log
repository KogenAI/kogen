   143	    token = ctx.get("attempt_token", "")
   144	    reason = context_error
   145	    expected_session = ctx.get("session_id", ctx.get("developer_session_id"))
   146	    if not reason and not session: reason = "Kogen Stop Check did not receive the Developer session id."
   147	    if not reason and ctx.get("_unified") and not token: reason = "versioned verification context is missing attempt binding."
   148	    if not reason and expected_session and expected_session != session: reason = "Developer session does not match the supplied verification context."
   149	    if not session:
   150	        print(json.dumps({"decision": "block", "reason": reason}, separators=(",", ":")))
   151	        return
   152	    if context_error:
   153	        print(json.dumps({"continue":False,"stopReason":f"verification context integrity failure: {context_error}"}, separators=(",", ":")))
   154	        return
   155	    outputs, code, status = [], 1 if reason else 0, "failed" if reason else "passed"
   156	    targets = list(dict.fromkeys(ctx.get("targets", ctx.get("verification_targets", ["check"]))))
   157	    if "check" not in targets: targets.insert(0, "check")
   158	    prior = {"cycles": [], "failures_since_pass": 0}
   159	    if not reason and ctx.get("_unified"):
   160	        try:
   161	            context_bytes = Path(os.environ["KOGEN_VERIFICATION_CONTEXT"]).read_bytes()
