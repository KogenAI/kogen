   169	      :ok ->
   170	        :ok
   171	
   172	      {:error, :enoent} ->
   173	        :ok
   174	
   175	      {:error, reason} ->
   176	        {:error, "could not clear stale #{label}: #{:file.format_error(reason)}"}
   177	    end
   178	  end
   179	
   180	  defp record_failure_reason(record, candidate_id, session_id) do
   181	    [
   182	      {"session_id", session_id,
   183	       fn -> "Verification Record session_id does not match the Developer session" end},
   184	      {"candidate", candidate_id,
   185	       fn -> "Verification Record candidate does not match the current tree" end},
   186	      {"status", "passed",
   187	       fn ->
   188	         tail = Map.get(record, "reason") || Map.get(record, "status")
