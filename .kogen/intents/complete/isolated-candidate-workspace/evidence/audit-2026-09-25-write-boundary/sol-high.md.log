   148	  @doc "The selected scope; a project selector is explicit and never inferred."
   149	  def effective_scope(project \\ File.cwd!()) do
   150	    {:ok, scope(scope_name(project), project)}
   151	  rescue
   152	    error -> {:error, Exception.message(error)}
   153	  end
   154	
   155	  defp scope(name, project) do
   156	    suffix = if name == :shared, do: "shared", else: "projects/" <> project_id(project)
   157	    %{name: name, path: Path.join([root(), "accounts", suffix]) |> Path.expand()}
