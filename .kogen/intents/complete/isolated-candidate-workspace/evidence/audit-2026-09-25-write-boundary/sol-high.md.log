    66	       %{
    67	         targets: ["check" | ordered],
    68	         offline: offline,
    69	         offline_commands: offline_commands,
    70	         affected_paths: affected,
    71	         rehearsals: rehearsals,
    72	         catalog_sha256: catalog.sha256
    73	       }}
    74	    end
    75	  end
