   209	      _ -> raise "unexpected occupant at Kogen Claude Code scope: #{path}"
   210	    end
   211	  end
   212	
   213	  defp private_directory!(path) do
   214	    path = Path.expand(path)
   215	
   216	    case File.lstat(path) do
   217	      {:ok, %{type: :directory}} ->
   218	        :ok
   219	
   220	      {:error, :enoent} ->
   221	        private_directory!(Path.dirname(path))
   222	
   223	        case File.mkdir(path) do
   224	          :ok -> File.chmod!(path, 0o700)
   225	          {:error, :eexist} -> private_directory!(path)
   226	          {:error, reason} -> raise File.Error, reason: reason, action: "create", path: path
   227	        end
   228	
   229	      _ ->
   230	        raise "unexpected occupant at Kogen directory: #{path}"
   231	    end
   232	  end
