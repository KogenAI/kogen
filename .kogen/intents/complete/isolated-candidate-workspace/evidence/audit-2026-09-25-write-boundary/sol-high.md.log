    21	  # Provider credentials and routing switches must never fund or redirect a
    22	  # Kogen launch, and an inherited Claude Code session must not leak into one.
    23	  @removed_prefixes ["ANTHROPIC_", "CLAUDE_CODE_", "CLAUDE_CONFIG_DIR", "CLAUDECODE"]
    24	  @removed_names ["AWS_BEARER_TOKEN_BEDROCK", "VERTEX_REGION_CLAUDE"]
