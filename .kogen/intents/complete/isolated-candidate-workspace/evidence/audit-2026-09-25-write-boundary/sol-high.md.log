     1	defmodule Kogen.Check do
     2	  @moduledoc """
     3	  The Verification Record (written by the tracked Stop hook,
     4	  `.codex/hooks/check.sh`) and declared-target verification. Never depends
     5	  on `Kogen.Harness`: whether a Verification Record is trustworthy must be
     6	  decidable without knowing anything about how the Developer was launched.
     7	  """
     8	  use Boundary, deps: [], exports: [MakeInventory]
     9	  alias __MODULE__.MakeInventory
    10	
    11	  @record_path ".kogen/runtime/verification.json"
    12	  @history_path ".kogen/runtime/verification-history.jsonl"
    13	  @target_name_re ~r/^[a-z][a-z0-9_-]*$/
    14	
    15	  @doc "Path to the ignored Verification Record the Stop hook writes."
    16	  def record_path, do: @record_path
    17	
    18	  @doc """
    19	  Path to the ignored, append-only history of every hook invocation (one
    20	  JSON line each) for the current attempt. A later passing
    21	  `verification.json` overwrites the evidence that an earlier attempt
    22	  within the same turn failed; this file is what still has it, so a real
    23	  failed-Check -> in-turn-continuation -> pass arc can be proven after the
    24	  fact instead of merely inferred from a higher turn count.
    25	  """
    26	  def history_path, do: @history_path
    27	
    28	  @doc """
    29	  Deletes any prior local Verification Record and history. When private raw
    30	  logging is enabled, preserves the prior history in the requested private
    31	  log directory first.
    32	  This keeps each outer attempt's active history fresh without discarding
    33	  evidence needed to audit a later resume.
    34	  """
    35	  @spec invalidate!() :: :ok | {:error, String.t()}
    36	  def invalidate! do
    37	    with :ok <- archive_history_if_requested(),
    38	         :ok <- remove_stale_file(@record_path, "Verification Record") do
    39	      remove_stale_file(@history_path, "Verification Record history")
    40	    end
    41	  end
    42	
    43	  @doc "Reads and parses the Verification Record, or `:error` if absent/invalid JSON."
    44	  @spec read_record(Path.t()) :: {:ok, map()} | :error
    45	  def read_record(root \\ ".") do
    46	    with {:ok, content} <- File.read(Path.join(root, @record_path)),
    47	         {:ok, json} when is_map(json) <- Jason.decode(content) do
    48	      {:ok, json}
    49	    else
    50	      _ -> :error
    51	    end
    52	  end
    53	
    54	  @doc """
    55	  Whether the current Verification Record proves a settled Check pass for
    56	  exactly `candidate_id` and `session_id`. A missing, stale (different
    57	  candidate or session), wrong target, nonzero Check exit, or failed record
    58	  is not a pass.
    59	  """
    60	  @spec settled_pass?(String.t(), String.t(), Path.t()) :: boolean()
    61	  def settled_pass?(candidate_id, session_id, root \\ ".") do
    62	    case read_record(root) do
    63	      {:ok,
    64	       %{
    65	         "candidate" => ^candidate_id,
    66	         "status" => "passed",
    67	         "target" => "check",
    68	         "session_id" => ^session_id,
    69	         "exit_code" => 0
    70	       }} ->
    71	        true
    72	
    73	      _ ->
    74	        false
    75	    end
    76	  end
    77	
    78	  @doc "A short, human reason describing why the current record does not settle a pass."
    79	  @spec settlement_failure_reason(String.t(), String.t(), Path.t()) :: String.t()
    80	  def settlement_failure_reason(candidate_id, session_id, root \\ ".") do
