    15	def atomic(path, value):
    16	    path.parent.mkdir(parents=True, exist_ok=True)
    17	    fd, name = tempfile.mkstemp(prefix=".hook.", dir=str(path.parent))
    18	    try:
    19	        with os.fdopen(fd, "w", encoding="utf-8") as stream:
    20	            stream.write(value); stream.flush(); os.fsync(stream.fileno())
    21	        os.replace(name, path)
    22	    finally:
    23	        try: os.unlink(name)
    24	        except FileNotFoundError: pass
