    31	def load_context():
    32	    for key, legacy in (("KOGEN_VERIFICATION_CONTEXT", False), ("KOGEN_TRACKING_CONTEXT", True)):
    33	        value = os.environ.get(key)
    34	        if not value: continue
    35	        try:
    36	            path = Path(value)
    37	            obj = json.loads(path.read_text() if value.startswith("/") and path.is_file() else value)
    38	            if not isinstance(obj, dict): raise ValueError("context is not an object")
    39	            if not legacy and obj.get("schema_version") != 1: raise ValueError("unsupported schema_version")
    40	            if not legacy and obj.get("mode") != "unified": raise ValueError("invalid unified mode")
    41	            if not legacy and any(key not in obj for key in ("attempt_token", "outer_attempt", "project_root", "verification_retries", "state_path", "history_path")):
    42	                raise ValueError("unified context is missing required fields")
    43	            targets = obj.get("targets", obj.get("verification_targets", ["check"]))
    44	            if not isinstance(targets, list) or any(not isinstance(x, str) or not x.strip() for x in targets): raise ValueError("invalid targets")
    45	            if not legacy and Path(obj.get("project_root", "")).resolve() != ROOT.resolve():
    46	                raise ValueError("project_root does not match the active repository")
    47	            obj["_unified"] = not legacy
    48	            return obj, None
    49	        except Exception as exc:
    50	            return {}, f"invalid {key}: {exc}"
    51	    return {"_unified": False}, None
