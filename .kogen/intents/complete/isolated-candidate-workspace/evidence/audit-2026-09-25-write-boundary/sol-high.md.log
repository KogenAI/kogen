    53	def candidate():
    54	    listing = subprocess.run(["git", "ls-files", "-v"], cwd=ROOT, text=True, capture_output=True)
    55	    if listing.returncode: return "", listing.stderr.strip()
    56	    if any(x[:1] == "S" or x[:1].islower() for x in listing.stdout.splitlines()): return "", "Candidate identity refused: Git index contains assume-unchanged or skip-worktree flags"
    57	    private = tempfile.NamedTemporaryFile(prefix="kogen-index.", delete=False); private.close()
    58	    try:
    59	        index = subprocess.check_output(["git", "rev-parse", "--git-path", "index"], cwd=ROOT, text=True).strip()
    60	        subprocess.run(["cp", index, private.name], check=True)
    61	        env = {**os.environ, "GIT_INDEX_FILE": private.name}
    62	        if subprocess.run(["git", "add", "-A"], cwd=ROOT, env=env, capture_output=True).returncode: return "", "git add -A failed"
    63	        tree = subprocess.run(["git", "write-tree"], cwd=ROOT, env=env, text=True, capture_output=True)
    64	        return (tree.stdout.strip(), "") if tree.returncode == 0 else ("", tree.stderr.strip())
    65	    finally:
    66	        try: os.unlink(private.name)
    67	        except FileNotFoundError: pass
