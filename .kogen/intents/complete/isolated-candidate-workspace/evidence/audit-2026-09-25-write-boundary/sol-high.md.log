   200	  # Existing scope contents are Claude Code's; only a missing directory is created.
   201	  defp ensure_scope!(path) do
   202	    private_directory!(path)
   203	    validate_scope!(path)
   204	  end
   205	
   206	  defp validate_scope!(path) do
   207	    case File.lstat(path) do
