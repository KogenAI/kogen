     1	defmodule Kogen.Codex.State do
     2	  @moduledoc false
     3	
     4	  # Resolved from the source tree, like the managed installer.
     5	  @native_settings Path.expand("../../../priv/kogen/codex/native_settings.py", __DIR__)
     6	
     7	  def project_id(project),
     8	    do: :crypto.hash(:sha256, Path.expand(project)) |> Base.encode16(case: :lower)
     9	
    10	  def scope_name(root, project) do
    11	    path = selector(root, project)
    12	
    13	    case File.lstat(path) do
    14	      {:error, :enoent} ->
    15	        :shared
    16	
    17	      {:ok, %{type: :regular}} ->
    18	        case File.read!(path) do
    19	          "project\n" -> :project
    20	          "shared\n" -> :shared
    21	          _ -> raise "unrecognized Kogen account selector: #{path}"
    22	        end
    23	
    24	      _ ->
    25	        raise "unsafe Kogen account selector: #{path}"
    26	    end
    27	  end
    28	
    29	  def select_scope!(root, project, name) do
    30	    path = selector(root, project)
