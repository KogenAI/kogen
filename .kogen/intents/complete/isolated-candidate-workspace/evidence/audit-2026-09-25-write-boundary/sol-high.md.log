     1	defmodule Kogen.VerificationPolicy do
     2	  @moduledoc """
     3	  The Build-side half of the Developer verification guard.
     4	
     5	  The PreToolUse hook performs command classification before Codex dispatches a
     6	  Bash request. This module derives the immutable policy passed to that hook
     7	  and proves the tracked hook is installed before a Developer is launched.
     8	  """
     9	  use Boundary, deps: [Kogen.Check]
    10	
    11	  @hooks_path ".codex/hooks.json"
    12	  @script_path ".codex/hooks/verification_policy.py"
    13	  @stop_script_path ".codex/hooks/check.sh"
    14	  @hook_command "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/verification_policy.py\""
    15	
    16	  @spec normalized_targets([String.t()]) :: [String.t()]
    17	  def normalized_targets(targets), do: Enum.uniq(["check", "live" | targets])
    18	
    19	  @spec environment([String.t()], Path.t()) :: [{String.t(), String.t()}]
    20	  def environment(targets, root \\ File.cwd!()) do
    21	    [
    22	      {"KOGEN_VERIFICATION_TARGETS", Jason.encode!(normalized_targets(targets))},
    23	      {"KOGEN_PROJECT_ROOT", root}
    24	    ]
    25	  end
    26	
    27	  @spec preflight([String.t()], Path.t()) :: :ok | {:error, String.t()}
    28	  def preflight(targets, root \\ ".")
    29	
    30	  def preflight(targets, root) when is_list(targets) do
    31	    with true <- Enum.all?(normalized_targets(targets), &Kogen.Check.valid_target_name?/1),
    32	         :ok <- required_file(@script_path, root),
    33	         :ok <- required_file(@stop_script_path, root),
    34	         :ok <- registered_hook(root) do
    35	      :ok
    36	    else
    37	      false -> {:error, "verification policy has an invalid target name"}
    38	      {:error, _reason} = error -> error
    39	    end
    40	  end
    41	
    42	  def preflight(_, _root), do: {:error, "verification policy targets are missing or invalid"}
    43	
    44	  @spec developer_instruction([String.t()]) :: String.t()
    45	  def developer_instruction(targets) do
    46	    names = Enum.map_join(normalized_targets(targets), ", ", &"`make #{&1}`")
    47	
    48	    "Kogen machinery owns verification gates. Do not run #{names}, the Stop script " <>
    49	      "`.codex/hooks/check.sh`, or any indirect equivalent — including for early signal " <>
    50	      "or through delegated helpers. Focused non-gate tests remain allowed."
    51	  end
    52	
    53	  defp required_file(path, root) do
    54	    if File.regular?(Path.join(root, path)),
    55	      do: :ok,
    56	      else: {:error, "required verification policy file is missing: #{path}"}
    57	  end
    58	
    59	  defp registered_hook(root) do
    60	    with {:ok, contents} <- File.read(Path.join(root, @hooks_path)),
    61	         {:ok, json} <- Jason.decode(contents),
    62	         true <- pretooluse_registration?(json) do
    63	      :ok
    64	    else
    65	      _ -> {:error, "required Developer Bash verification-policy hook is not registered"}
    66	    end
    67	  end
    68	
    69	  defp pretooluse_registration?(%{"hooks" => %{"PreToolUse" => entries}}) when is_list(entries) do
    70	    Enum.any?(entries, fn
    71	      %{"matcher" => "Bash", "hooks" => hooks} when is_list(hooks) ->
    72	        Enum.any?(hooks, fn
    73	          %{"type" => "command", "command" => @hook_command} ->
    74	            true
    75	
    76	          _ ->
    77	            false
    78	        end)
    79	
    80	      _ ->
    81	        false
    82	    end)
    83	  end
    84	
    85	  defp pretooluse_registration?(_), do: false
    86	end

