     1	defmodule Kogen.Build.Tracking do
     2	  @moduledoc """
     3	  Build-owned, append-oriented persistence for one scenario-tracking run.
     4	
     5	  A tracking state is deliberately process-local: it contains the exact bytes
     6	  last written by this controller. `verify/1` compares those bytes before an
     7	  external boundary, and `update/2` refuses to replace a record that changed
     8	  underneath the controller. Records are evidence only; this module never
     9	  reloads one as Build state.
    10	  """
    11	
    12	  @runtime_base ".kogen/runtime/scenario-tracking"
    13	  @record_name "record.json"
    14	  @schema_version 2
    15	
    16	  @type tracking_record :: %{required(String.t()) => term()}
    17	  @type state :: %{path: Path.t(), bytes: binary(), record: tracking_record()}
    18	
    19	  @doc """
    20	  Creates one exclusively-owned runtime record for this Build.
    21	
    22	  `contract` is the already validated Approved contract and must contain its
    23	  scenarios and risks under either string or atom keys. `approved_entries` is
    24	  the Build's frozen package-entry snapshot; only its SHA-256 digest is stored.
    25	  `route` is the Build's resolved route (`Kogen.Intent.read_config/2`); its
    26	  name, harness and every role and helper profile are frozen in the record,
    27	  and its complete role matrix under `role_assignment`.
    28	  """
    29	  @spec new(map(), map(), list(), map()) :: {:ok, state()} | {:error, String.t()}
    30	  def new(intent, contract, approved_entries, route)
    31	      when is_map(intent) and is_map(contract) and is_map(route) do
    32	    with {:ok, frozen_intent} <- freeze_intent(intent),
    33	         {:ok, frozen_route} <- freeze_route(route),
    34	         {:ok, role_assignment} <- freeze_role_assignment(route),
    35	         {:ok, scenarios} <- required_json_value(contract, "scenarios"),
    36	         {:ok, risks, risks_supplied} <- frozen_risks(contract),
    37	         true <- is_list(scenarios),
    38	         {:ok, path} <- create_record_path(),
    39	         record <-
    40	           initial_record(
    41	             frozen_intent,
    42	             frozen_route,
    43	             role_assignment,
    44	             scenarios,
    45	             risks,
    46	             risks_supplied,
    47	             approved_entries
    48	           ),
    49	         {:ok, state} <- write_initial(path, record) do
    50	      {:ok, state}
    51	    else
    52	      false -> {:error, "scenario tracking contract has invalid scenarios"}
    53	      {:error, _reason} = error -> error
    54	    end
    55	  end
    56	
    57	  def new(_intent, _contract, _approved_entries, _route),
    58	    do: {:error, "scenario tracking requires intent, contract and route maps"}
    59	
    60	  @doc """
    61	  Confirms that the record on disk remains byte-for-byte the controller's last
    62	  persisted state. It never writes or attempts recovery.
    63	  """
    64	  @spec verify(state()) :: :ok | {:error, String.t()}
    65	  def verify(%{path: path, bytes: expected}) when is_binary(path) and is_binary(expected) do
    66	    case File.read(path) do
    67	      {:ok, ^expected} ->
    68	        :ok
    69	
    70	      {:ok, _other} ->
    71	        {:error, "scenario tracking record changed outside Build: #{path}"}
    72	
    73	      {:error, reason} ->
    74	        {:error, "could not read scenario tracking record #{path}: #{inspect(reason)}"}
    75	    end
    76	  end
    77	
    78	  def verify(_state), do: {:error, "invalid scenario tracking state"}
    79	
    80	  @doc """
    81	  Verifies a cited file using its actual owner. Ordinary evidence stays frozen
    82	  to the inspected digest. A citation of this Build's authoritative record is
    83	  retained as a historical version, while the live file must match the latest
    84	  controller-owned bytes. Only this exact path receives that ownership rule;
    85	  external edits still fail `verify/1`, even when a role cited the record.
    86	  """
    87	  @spec verify_reference(state(), Path.t(), map()) :: :ok | {:error, String.t()}
    88	  def verify_reference(state, path, snapshot) do
    89	    if Path.expand(path) == Path.expand(state.path) do
    90	      with :ok <- verify(state), do: verify_record_version(state, snapshot)
    91	    else
    92	      verify_frozen_reference(path, snapshot)
    93	    end
    94	  end
    95	
    96	  @doc """
    97	  Retains `bytes`, one cited version of this Build's own record, as an
    98	  immutable sidecar next to the record and returns the metadata snapshot that
    99	  replaces an inline copy. The record therefore never contains an earlier
   100	  version of itself. The sidecar is created exclusively: identical bytes reuse
   101	  it, and different bytes under the same digest name are an integrity failure.
   102	  """
   103	  @spec retain_record_version(state(), binary()) :: {:ok, map()} | {:error, String.t()}
   104	  def retain_record_version(%{path: path}, bytes) when is_binary(bytes) do
   105	    sha256 = Base.encode16(:crypto.hash(:sha256, bytes), case: :lower)
   106	    sidecar = record_version_path(path, sha256)
   107	
   108	    with :ok <- mkdir_owned(Path.dirname(sidecar)),
   109	         :ok <- write_record_version(sidecar, bytes) do
   110	      {:ok,
   111	       %{
   112	         "path" => checkout_relative(path),
   113	         "sha256" => sha256,
   114	         "byte_count" => byte_size(bytes),
   115	         "binding" => "controller_record_version",
   116	         "sidecar" => checkout_relative(sidecar)
   117	       }}
   118	    end
   119	  end
   120	
   121	  @doc """
   122	  Verifies every record-version sidecar that any attempt of the record
   123	  references: it exists at its digest name and its exact bytes match the
   124	  snapshot's SHA-256 and byte count. Older inline snapshots carry no sidecar
   125	  and stay valid as written.
   126	  """
   127	  @spec verify_record_versions(state()) :: :ok | {:error, String.t()}
   128	  def verify_record_versions(%{record: record} = state) do
   129	    record
   130	    |> Map.get("attempts", [])
   131	    |> Enum.flat_map(fn attempt ->
   132	      ~w(developer_reference_snapshots reviewer_reference_snapshots reference_snapshots)
   133	      |> Enum.flat_map(&Map.values(Map.get(attempt, &1) || %{}))
   134	    end)
   135	    |> Enum.filter(&(is_map(&1) and Map.has_key?(&1, "sidecar")))
   136	    |> Enum.uniq()
   137	    |> Enum.reduce_while(:ok, fn snapshot, :ok ->
   138	      case verify_record_version(state, snapshot) do
   139	        :ok -> {:cont, :ok}
   140	        error -> {:halt, error}
   141	      end
   142	    end)
   143	  end
   144	
   145	  defp verify_record_version(state, %{"sidecar" => sidecar} = snapshot) do
   146	    expected = checkout_relative(record_version_path(state.path, snapshot["sha256"]))
   147	
   148	    with true <- is_binary(sidecar) and sidecar == expected,
   149	         {:ok, bytes} <- File.read(sidecar),
   150	         true <- byte_size(bytes) == snapshot["byte_count"],
   151	         true <- Base.encode16(:crypto.hash(:sha256, bytes), case: :lower) == snapshot["sha256"] do
   152	      :ok
   153	    else
   154	      {:error, _reason} -> {:error, "record version sidecar missing: #{inspect(sidecar)}"}
   155	      false -> {:error, "record version sidecar mutated: #{inspect(sidecar)}"}
   156	    end
   157	  end
   158	
   159	  # Records written before sidecars inline the cited record version.
   160	  defp verify_record_version(_state, _legacy_snapshot), do: :ok
   161	
   162	  defp record_version_path(record_path, sha256) when is_binary(sha256),
   163	    do: Path.join([Path.dirname(record_path), "record-versions", sha256 <> ".json"])
   164	
   165	  defp record_version_path(record_path, _sha256),
   166	    do: Path.join([Path.dirname(record_path), "record-versions", "invalid"])
   167	
   168	  defp write_record_version(sidecar, bytes) do
   169	    case File.open(sidecar, [:write, :exclusive, :binary]) do
   170	      {:ok, io} ->
   171	        try do
   172	          with :ok <- IO.binwrite(io, bytes), :ok <- :file.sync(io) do
   173	            :ok
   174	          else
   175	            {:error, reason} ->
   176	              {:error, "could not write record version sidecar: #{inspect(reason)}"}
   177	          end
   178	        after
   179	          File.close(io)
   180	        end
   181	
   182	      {:error, :eexist} ->
   183	        case File.read(sidecar) do
   184	          {:ok, ^bytes} ->
   185	            :ok
   186	
   187	          _ ->
   188	            {:error, "record version sidecar integrity failure: different bytes under #{sidecar}"}
   189	        end
   190	
   191	      {:error, reason} ->
   192	        {:error, "could not create record version sidecar: #{inspect(reason)}"}
   193	    end
   194	  end
   195	
   196	  defp mkdir_owned(directory) do
   197	    case File.mkdir(directory) do
   198	      :ok ->
   199	        File.chmod(directory, 0o700)
   200	
   201	      {:error, :eexist} ->
   202	        if File.dir?(directory),
   203	          do: :ok,
   204	          else: {:error, "controller evidence directory is not a directory: #{directory}"}
   205	
   206	      {:error, reason} ->
   207	        {:error, "could not create controller evidence directory: #{inspect(reason)}"}
   208	    end
   209	  end
   210	
   211	  defp checkout_relative(path), do: Path.relative_to(Path.expand(path), File.cwd!())
   212	
   213	  defp verify_frozen_reference(path, snapshot) do
   214	    case File.read(path) do
   215	      {:ok, bytes} ->
   216	        if Base.encode16(:crypto.hash(:sha256, bytes)) == snapshot["sha256"],
   217	          do: :ok,
   218	          else: {:error, "bound evidence reference mutated: #{path}"}
   219	
   220	      _ ->
   221	        {:error, "bound evidence reference missing: #{path}"}
   222	    end
   223	  end
   224	
   225	  @doc """
   226	  Atomically replaces the record after verifying its previous exact bytes.
   227	
   228	  The immutable Approved snapshot fields cannot change through this generic
   229	  update. Callers supply a complete string-keyed record so the controller's
   230	  state remains explicit rather than hidden in this module.
   231	  """
   232	  @spec update(state(), tracking_record()) :: {:ok, state()} | {:error, String.t()}
   233	  def update(%{path: path, record: previous} = state, record)
