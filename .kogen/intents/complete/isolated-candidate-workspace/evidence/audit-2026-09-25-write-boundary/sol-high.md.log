    86	def snapshot(relative, expected=None):
    87	    value = safe_file(relative).read_bytes()
    88	    digest = sha256(value)
    89	    if expected is not None and digest != expected: raise ValueError("target evidence digest mismatch")
    90	    return {"path": relative, "sha256": digest, "content_base64": base64.b64encode(value).decode()}
