     1	defmodule Mix.Tasks.Kogen.Expert do
     2	  use Mix.Task
     3	
     4	  use Boundary, deps: [Kogen.Harness, Kogen.ExecutionPolicy, Mix]
     5	
     6	  @shortdoc "Consults the route's Expert on its assigned harness (run by a Kogen role)"
     7	  @moduledoc """
     8	  `mix kogen.expert < question` launches one fresh, read-only Expert for the
     9	  question on stdin and prints its final answer.
    10	
    11	  Only a Kogen role whose route assigns the Expert to another harness can run
    12	  it: that role's launch carries the frozen Expert assignment (harness, model,
    13	  effort and that harness's native helpers) in `KOGEN_EXPERT`. The task never
    14	  reads `.kogen/config.yaml`, never substitutes another harness, model or
    15	  effort, and fails naming the Expert role and harness when that harness is
    16	  not ready or the launch fails.
    17	  """
    18	
    19	  @prompt_path "priv/kogen/prompts/expert.md"
    20	
    21	  @impl Mix.Task
    22	  def run(args) do
    23	    with {:ok, config} <- assignment(System.get_env(Kogen.Harness.expert_variable())),
    24	         {:ok, question} <- question(args) do
    25	      consult(config, question)
    26	    else
    27	      {:error, reason} -> fail(reason)
    28	    end
    29	  end
    30	
    31	  @doc false
    32	  def assignment(nil),
    33	    do:
    34	      {:error,
    35	       "mix kogen.expert: missing #{Kogen.Harness.expert_variable()} assignment; this role has no cross-harness Expert, so use its native expert helper"}
    36	
    37	  def assignment(json) do
    38	    with {:ok, %{} = data} <- Jason.decode(json),
    39	         {:ok, harness} when harness in ["claude", "codex"] <- field(data, "harness"),
    40	         {:ok, route} <- field(data, "route"),
    41	         {:ok, caller} <- field(data, "caller"),
    42	         {:ok, expert} <- profile(data),
