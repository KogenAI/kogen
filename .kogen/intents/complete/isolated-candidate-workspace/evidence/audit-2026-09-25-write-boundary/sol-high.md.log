    58	    for name <- [
    59	          "config.d",
    60	          "AGENTS.md",
    61	          "AGENTS.override.md",
    62	          "rules",
    63	          "hooks.json",
    64	          "plugins"
    65	        ] do
    66	      case File.lstat(Path.join(path, name)) do
    67	        {:error, :enoent} ->
    68	          :ok
    69	
    70	        _ ->
    71	          raise "unexpected discovery settings in Kogen credential store: #{Path.join(path, name)}"
    72	      end
    73	    end
    74	
    75	    native_projects!(path)
    76	    :ok
    77	  end
    78	
    79	  defp validate_scope_owner!(path) do
    80	    unless File.lstat!(path).type == :directory and
    81	             match?({:ok, %{type: :regular}}, File.lstat(Path.join(path, ".kogen-owned"))) and
    82	             File.read(Path.join(path, ".kogen-owned")) == {:ok, "account-v1\n"} do
    83	      raise "unrecognized Kogen credential store: #{path}"
    84	    end
    85	  end
    86	
    87	  def native_projects!(path) do
    88	    config = Path.join(path, "config.toml")
    89	
    90	    case File.lstat(config) do
    91	      {:error, :enoent} ->
    92	        read_native_projects!(config)
    93	
    94	      {:ok, %{type: :regular}} ->
    95	        read_native_projects!(config)
    96	
    97	      _ ->
    98	        raise "unexpected discovery settings in Kogen credential store: #{config}"
    99	    end
   100	  end
   101	
   102	  defp read_native_projects!(config) do
   103	    python =
   104	      System.find_executable("python3") ||
