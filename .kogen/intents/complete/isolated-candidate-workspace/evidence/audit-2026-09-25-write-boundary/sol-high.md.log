    92	def capture_evidence(output, target, token):
    93	    prefix = "KOGEN_TARGET_EVIDENCE_MANIFEST\t"
    94	    frames = [line.split(prefix, 1)[1].rstrip("\r") for line in output.splitlines() if prefix in line]
    95	    if not frames: return None
    96	    if len(frames) != 1: raise ValueError("target emitted duplicate evidence manifest frames")
    97	    locator = json.loads(frames[0])
    98	    if set(locator) != {"manifest_path", "sha256"}: raise ValueError("invalid target evidence frame")
    99	    manifest_snapshot = snapshot(locator["manifest_path"], locator["sha256"])
   100	    manifest = json.loads(base64.b64decode(manifest_snapshot["content_base64"]))
   101	    if set(manifest) != {"schema_version", "required_evidence"} or manifest["schema_version"] != 1:
   102	        raise ValueError("invalid target evidence manifest")
   103	    entries, seen = [], set()
   104	    if not isinstance(manifest["required_evidence"], list) or not manifest["required_evidence"]:
   105	        raise ValueError("target evidence manifest requires evidence")
   106	    for entry in manifest["required_evidence"]:
   107	        if not isinstance(entry, dict) or set(entry) != {"path", "sha256"} or entry["path"] in seen:
   108	            raise ValueError("invalid target evidence entry")
   109	        seen.add(entry["path"]); entries.append(snapshot(entry["path"], entry["sha256"]))
   110	    return {"target": target, "attempt_token": token, "manifest": manifest_snapshot, "required_evidence": entries}
