    72	def safe_file(relative):
    73	    if not isinstance(relative, str) or not relative or "\\" in relative:
    74	        raise ValueError("unsafe target evidence path")
    75	    parts = Path(relative).parts
    76	    if Path(relative).is_absolute() or any(part in ("", ".", "..") for part in parts):
    77	        raise ValueError("unsafe target evidence path")
    78	    path = ROOT.joinpath(*parts)
    79	    current = ROOT
    80	    for part in parts:
    81	        current = current / part
    82	        if current.is_symlink(): raise ValueError("unsafe target evidence path")
    83	    if not path.is_file(): raise ValueError("target evidence path is missing or not regular")
    84	    return path
