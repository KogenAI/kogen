   141	  defp archive_history_if_requested do
   142	    case {System.get_env("KOGEN_RAW_LOG_DIR"), File.read(@history_path)} do
   143	      {dir, {:ok, history}} when is_binary(dir) and byte_size(history) > 0 ->
   144	        name =
   145	          "verification-history-#{System.pid()}-#{:erlang.unique_integer([:positive, :monotonic])}.jsonl"
   146	
   147	        with :ok <- File.mkdir_p(dir),
   148	             :ok <- File.write(Path.join(dir, name), history) do
   149	          :ok
   150	        else
   151	          {:error, reason} ->
   152	            {:error,
   153	             "could not archive Verification Record history: #{:file.format_error(reason)}"}
   154	        end
   155	
   156	      {_dir, {:error, :enoent}} ->
   157	        :ok
   158	
   159	      {_dir, {:error, reason}} ->
   160	        {:error, "could not read Verification Record history: #{:file.format_error(reason)}"}
   161	
   162	      _ ->
   163	        :ok
   164	    end
   165	  end
