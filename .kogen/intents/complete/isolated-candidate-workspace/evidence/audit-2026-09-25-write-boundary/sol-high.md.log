   164	  defp selector(project), do: Path.join([root(), "preferences", project_id(project)])
   165	
   166	  defp scope_name(project) do
   167	    path = selector(project)
   168	
   169	    case File.lstat(path) do
   170	      {:error, :enoent} ->
   171	        :shared
   172	
   173	      {:ok, %{type: :regular}} ->
   174	        case File.read!(path) do
   175	          "project\n" -> :project
   176	          "shared\n" -> :shared
   177	          _ -> raise "unrecognized Kogen Claude Code account selector: #{path}"
   178	        end
   179	
   180	      _ ->
   181	        raise "unsafe Kogen Claude Code account selector: #{path}"
   182	    end
   183	  end
   184	
   185	  defp select_scope!(project, name) do
   186	    path = selector(project)
   187	    scope_name(project)
   188	    private_directory!(Path.dirname(path))
   189	    temporary = path <> "." <> Integer.to_string(System.unique_integer([:positive]))
   190	
   191	    try do
   192	      File.write!(temporary, "#{name}\n", [:exclusive])
   193	      File.chmod!(temporary, 0o600)
   194	      File.rename!(temporary, path)
