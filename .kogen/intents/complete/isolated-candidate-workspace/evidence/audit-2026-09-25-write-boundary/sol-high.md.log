   104	  @doc """
   105	  Opens the assigned Expert harness, launches one fresh Expert with the
   106	  rendered Expert prompt and releases the selection. Returns the Expert's
   107	  session and final message, or an error naming the Expert role and harness.
   108	  """
   109	  def launch(config, question, project \\ File.cwd!()) do
   110	    case Kogen.Harness.open(config, project) do
   111	      {:ok, selection} ->
   112	        try do
   113	          launch_selected(config, question, selection)
   114	        after
   115	          Kogen.Harness.close(selection)
   116	        end
   117	
   118	      {:error, reason} ->
   119	        {:error, "expert harness #{config.harness} is not ready: #{reason}"}
   120	    end
   121	  end
   122	
   123	  defp launch_selected(config, question, selection) do
   124	    label =
   125	      "expert on harness #{config.harness} (#{config.expert.model} at #{config.expert.effort})"
   126	
   127	    prompt =
   128	      File.read!(@prompt_path)
   129	      |> String.replace("{{caller}}", config.caller)
   130	      |> String.replace("{{route}}", config.route)
   131	      |> String.replace("{{execution_policy}}", Kogen.ExecutionPolicy.render(config, "expert"))
   132	      |> String.replace("{{question}}", question)
   133	
   134	    context = Kogen.Harness.launch_context(selection)
   135	
   136	    case Kogen.Harness.launch_expert(prompt, config.expert.model, config.expert.effort, context) do
   137	      {:ok, result} -> {:ok, result}
   138	      {:error, reason} -> {:error, "#{label} failed: #{inspect(reason)}"}
   139	    end
   140	  rescue
   141	    error -> {:error, "expert on harness #{config.harness} failed: #{Exception.message(error)}"}
   142	  end
   143	
   144	  defp fail(reason) do
   145	    IO.puts(:stderr, reason)
   146	    System.halt(1)
   147	  end
   148	end
