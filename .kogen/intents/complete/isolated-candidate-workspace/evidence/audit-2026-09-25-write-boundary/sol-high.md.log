   112	def admit(state, history_text, ctx, context_sha, session, targets):
   113	    required = {"schema_version", "context_sha256", "attempt_token", "outer_attempt", "developer_session_id", "candidate_id", "cycles", "failures_since_pass", "terminal_state"}
   114	    if not isinstance(state, dict) or set(state) != required: raise ValueError("state shape is invalid")
   115	    if (state["schema_version"], state["context_sha256"], state["attempt_token"], state["outer_attempt"]) != (1, context_sha, ctx["attempt_token"], ctx["outer_attempt"]): raise ValueError("state binding is invalid")
   116	    try: history = [json.loads(line) for line in history_text.splitlines() if line]
   117	    except Exception as exc: raise ValueError(f"chronology is malformed: {exc}")
   118	    cycles = state["cycles"]
   119	    if not history or history[-1] != state or not isinstance(cycles, list) or len(history) != len(cycles) + 1: raise ValueError("state is missing, rolled back, or chronology is incomplete")
   120	    initial = history[0]
   121	    if initial.get("cycles") != [] or initial.get("failures_since_pass") != 0 or initial.get("terminal_state") != "pending": raise ValueError("initial chronology is invalid")
   122	    bound_session, failures = state["developer_session_id"], 0
   123	    if bound_session is not None and bound_session != session: raise ValueError("session binding changed")
   124	    for index, cycle in enumerate(cycles, 1):
   125	        receipts = cycle.get("receipts") if isinstance(cycle, dict) else None
   126	        names = [receipt.get("target") for receipt in receipts] if isinstance(receipts, list) and all(isinstance(receipt, dict) for receipt in receipts) else []
   127	        status = cycle.get("status") if isinstance(cycle, dict) else None
   128	        failed = [receipt for receipt in receipts or [] if receipt.get("status") == "failed"]
   129	        valid = cycle.get("sequence") == index and cycle.get("attempt_token") == ctx["attempt_token"] and cycle.get("outer_attempt") == ctx["outer_attempt"] and cycle.get("developer_session_id") == bound_session and cycle.get("failures_before") == failures and receipts and names == targets[:len(names)]
   130	        after = 0 if status == "passed" else failures + 1
   131	        valid = valid and cycle.get("failures_after") == after and ((status == "passed" and names == targets and not failed) or (status == "failed" and len(failed) == 1 and receipts[-1] is failed[0]))
   132	        valid = valid and all(receipt.get("candidate_id") == cycle.get("candidate_id") and receipt.get("developer_session_id") == bound_session and receipt.get("attempt_token") == ctx["attempt_token"] and receipt.get("cycle_sequence") == index and ((receipt.get("status") == "passed" and receipt.get("exit_code") == 0) or (receipt.get("status") == "failed" and isinstance(receipt.get("exit_code"), int) and receipt.get("exit_code") != 0)) for receipt in receipts or [])
   133	        if not valid or history[index].get("cycles") != cycles[:index] or history[index].get("failures_since_pass") != after: raise ValueError(f"cycle {index} chronology is inconsistent")
   134	        failures = after
   135	    terminal = "passed" if cycles and cycles[-1].get("status") == "passed" else ("exhausted" if failures > int(ctx["verification_retries"]) else "pending")
   136	    if state["failures_since_pass"] != failures or state["terminal_state"] != terminal: raise ValueError("terminal counter is inconsistent")
   137	    return state
