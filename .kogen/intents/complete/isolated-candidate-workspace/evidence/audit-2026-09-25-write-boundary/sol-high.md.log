   243	    with {:ok, selection, forwarded} <- login_arguments(args),
   244	         :ok <- require_project(selection) do
   245	      delegate_login(selection, forwarded)
   246	    end
   247	  end
   248	
   249	  defp delegate_login(:default, []) do
   250	    select_scope!(File.cwd!(), :shared)

