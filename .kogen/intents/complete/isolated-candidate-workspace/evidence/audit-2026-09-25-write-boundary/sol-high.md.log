    83	    (removed ++
    84	       [
    85	         {"CLAUDE_CONFIG_DIR", scope.path},
    86	         {"DISABLE_AUTOUPDATER", "1"},
    87	         {"CLAUDE_CODE_DISABLE_AUTO_MEMORY", "1"},
