    44	  def build(scenarios, guards, catalog, root \\ File.cwd!())
    45	      when is_list(scenarios) and is_list(guards) and is_map(catalog) do
    46	    with :ok <- validate_proofs(scenarios, guards, catalog, root),
    47	         selected <-
    48	           scenarios
    49	           |> Enum.map(&get_in(&1, ["proof", "paid_target"]))
    50	           |> Enum.reject(&(&1 == "none"))
    51	           |> Enum.uniq(),
    52	         {:ok, ordered} <- selected_order(selected, catalog) do
    53	      offline = scenarios |> Enum.flat_map(&get_in(&1, ["proof", "offline"])) |> Enum.uniq()
    54	
    55	      affected =
    56	        scenarios |> Enum.flat_map(&get_in(&1, ["proof", "affected_paths"])) |> Enum.uniq()
    57	
    58	      offline_commands = Enum.map(offline, &selector_command(&1, catalog))
    59	
    60	      rehearsals =
    61	        ordered
    62	        |> Enum.map(&get_in(catalog, [:targets, &1, "rehearsal", "command"]))
    63	        |> Enum.reject(&is_nil/1)
