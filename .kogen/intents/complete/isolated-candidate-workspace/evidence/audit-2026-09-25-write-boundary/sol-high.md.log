    26	def append_locked(path, value):
    27	    path.parent.mkdir(parents=True, exist_ok=True)
    28	    with open(path, "a", encoding="utf-8") as stream:
    29	        fcntl.flock(stream.fileno(), fcntl.LOCK_EX); stream.write(value); stream.flush(); os.fsync(stream.fileno()); fcntl.flock(stream.fileno(), fcntl.LOCK_UN)
