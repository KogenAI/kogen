    88	  end
    89	
    90	  @doc "Whether `name` is safe to interpolate into a shell `make` invocation."
    91	  @spec valid_target_name?(String.t()) :: boolean()
    92	  def valid_target_name?(name), do: is_binary(name) and Regex.match?(@target_name_re, name)
    93	
    94	  @doc "The set of target names declared in `makefile_path` (rule lines only, not recipes)."
    95	  @spec declared_targets(Path.t()) :: MapSet.t(String.t())
    96	  def declared_targets(makefile_path \\ "Makefile") do
    97	    MakeInventory.declared_targets(makefile_path)
    98	  end
    99	
   100	  @doc """
   101	  Validates every name in `names` (excluding `"check"`, which already ran)
   102	  is both a safe shell token and a target actually declared in the
   103	  Makefile. Must be called, and must succeed, before the Developer is
   104	  launched.
   105	  """
   106	  @spec validate_targets([String.t()], Path.t()) :: :ok | {:error, String.t()}
   107	  def validate_targets(names, makefile_path \\ "Makefile") do
   108	    with {:ok, declared} <- MakeInventory.load(makefile_path) do
   109	      validate_declared_names(names, declared)
   110	    end
   111	  end
   112	
   113	  defp validate_declared_names(names, declared) do
   114	    names
   115	    |> Enum.reject(&(&1 == "check"))
   116	    |> Enum.uniq()
   117	    |> Enum.reduce_while(:ok, fn name, :ok ->
   118	      cond do
   119	        not valid_target_name?(name) ->
   120	          {:halt, {:error, "refused unsafe target name: #{inspect(name)}"}}
   121	
   122	        not MapSet.member?(declared, name) ->
   123	          {:halt, {:error, "undeclared make target: #{name}"}}
   124	
   125	        true ->
   126	          {:cont, :ok}
   127	      end
   128	    end)
   129	  end
   130	
   131	  @doc "Runs `make <name>`, returning captured combined output either way."
   132	  @spec run_target(String.t(), Path.t()) ::
   133	          {:ok, String.t()} | {:error, {non_neg_integer(), String.t()}}
   134	  def run_target(name, root \\ ".") do
   135	    case System.cmd("make", [name], cd: root, stderr_to_stdout: true) do
   136	      {out, 0} -> {:ok, out}
   137	      {out, code} -> {:error, {code, out}}
   138	    end
   139	  end
