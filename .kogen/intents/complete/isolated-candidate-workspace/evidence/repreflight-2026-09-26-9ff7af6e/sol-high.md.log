    40	         {:ok, route} <- field(data, "route"),
    41	         {:ok, caller} <- field(data, "caller"),
    42	         {:ok, expert} <- profile(data),
    43	         {:ok, helpers} <- helpers(data) do
    44	      {:ok,
    45	       %{
    46	         route: route,
    47	         caller: caller,
    48	         harness: harness,
    49	         expert: expert,
    50	         helpers: helpers,
    51	         roles: %{expert: harness},
    52	         native_helpers: %{harness => helpers}
    53	       }}
    54	    else
    55	      _invalid ->
    56	        {:error, "mix kogen.expert: invalid #{Kogen.Harness.expert_variable()} assignment"}
    57	    end
    58	  end
    59	
    60	  defp field(data, key) do
