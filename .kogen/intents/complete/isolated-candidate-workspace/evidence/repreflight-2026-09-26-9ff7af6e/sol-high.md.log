     1	defmodule Kogen.Build.VerificationRunner do
     2	  @moduledoc """
     3	  Runs one verification command as a child of the Build controller.
     4	
     5	  The command runs outside the Developer process tree, in its own process
     6	  group, with the controller's environment minus every verification or
     7	  tracking context. Its combined output goes to a controller-owned log file
     8	  created exclusively. After the command exits, any remaining member of its
     9	  process group is terminated; a member that cannot be reaped marks the run
    10	  `cleanup: failed`. Status comes only from the exit code, a time limit and
    11	  cleanup, never from anything the command prints.
    12	
    13	  The small process supervisor below is part of this compiled module, so the
    14	  controller never loads or executes supervisor code from the Candidate.
    15	  """
    16	
    17	  @scrubbed ~w(KOGEN_VERIFICATION_CONTEXT KOGEN_TRACKING_CONTEXT KOGEN_VERIFICATION_RETRY_LIMIT KOGEN_ROLE)
    18	
    19	  @supervisor ~S"""
    20	  import datetime, json, os, signal, subprocess, sys, time
    21	
    22	  spec = json.loads(sys.argv[1])
    23	
    24	  def now():
    25	      value = datetime.datetime.now(datetime.timezone.utc).isoformat(timespec="milliseconds")
    26	      return value.replace("+00:00", "Z")
    27	
    28	  def alive(group):
    29	      try:
    30	          os.killpg(group, 0)
    31	          return True
    32	      except ProcessLookupError:
    33	          return False
    34	      except PermissionError:
    35	          return True
    36	
    37	  def settle(group, grace):
    38	      deadline = time.monotonic() + grace
    39	      while alive(group) and time.monotonic() < deadline:
    40	          time.sleep(0.05)
    41	      return not alive(group)
    42	
    43	  def signal_group(group, number):
    44	      try:
    45	          os.killpg(group, number)
    46	      except (ProcessLookupError, PermissionError):
    47	          pass
    48	
    49	  started, clock = now(), time.monotonic()
    50	  timed_out, spawn_error, code, cleanup = False, None, 1, "clean"
    51	  with open(spec["log"], "xb") as log:
    52	      try:
    53	          child = subprocess.Popen(spec["argv"], cwd=spec["cwd"], stdin=subprocess.DEVNULL,
    54	                                   stdout=log, stderr=subprocess.STDOUT, start_new_session=True)
    55	      except OSError as error:
    56	          spawn_error = str(error)
    57	          log.write(("Kogen could not start verification command: %s\n" % error).encode())
    58	      if spawn_error is None:
    59	          try:
    60	              code = child.wait(timeout=spec.get("timeout"))
    61	          except subprocess.TimeoutExpired:
    62	              timed_out = True
    63	              signal_group(child.pid, signal.SIGKILL)
    64	              code = child.wait()
    65	          if code < 0:
    66	              code = 128 - code
    67	          if alive(child.pid):
    68	              cleanup = "terminated"
    69	              signal_group(child.pid, signal.SIGTERM)
    70	              if not settle(child.pid, spec["grace"]):
    71	                  signal_group(child.pid, signal.SIGKILL)
    72	                  if not settle(child.pid, spec["grace"]):
    73	                      cleanup = "failed"
    74	  finished = now()
    75	  print(json.dumps({"exit_code": code, "cleanup": cleanup, "timed_out": timed_out,
    76	                    "spawn_error": spawn_error, "started_at": started, "finished_at": finished,
    77	                    "elapsed_ms": int((time.monotonic() - clock) * 1000)}))
    78	  """
    79	
    80	  @doc "Environment entries removed from every controller-launched child."
    81	  def scrubbed_environment, do: Enum.map(@scrubbed, &{&1, nil})
    82	
    83	  @doc "Names of the environment variables removed from every child."
    84	  def scrubbed_names, do: @scrubbed
    85	
    86	  @doc """
    87	  Runs `make <target>` in `root`, writing combined output to `log_path`.
    88	  Returns the run facts and the log's bytes and digest.
    89	  """
    90	  @spec run_target(Path.t(), String.t(), Path.t(), keyword()) ::
    91	          {:ok, map()} | {:error, String.t()}
    92	  def run_target(root, target, log_path, opts \\ []) do
    93	    if Kogen.Check.valid_target_name?(target),
    94	      do: run(["make", "-C", Path.expand(root), target], root, log_path, opts),
    95	      else: {:error, "refused unsafe target name: #{inspect(target)}"}
    96	  end
    97	
    98	  @doc """
    99	  Runs `argv` in `cwd`. Options: `:timeout_ms` (default none), `:grace_ms`
   100	  (default 2000) and `:env` (extra entries, applied after the scrub).
   101	  """
   102	  @spec run([String.t()], Path.t(), Path.t(), keyword()) :: {:ok, map()} | {:error, String.t()}
   103	  def run(argv, cwd, log_path, opts \\ []) when is_list(argv) and argv != [] do
   104	    timeout = Keyword.get(opts, :timeout_ms)
   105	
   106	    spec = %{
   107	      "argv" => argv,
   108	      "cwd" => Path.expand(cwd),
   109	      "log" => Path.expand(log_path),
   110	      "timeout" => timeout && timeout / 1000,
   111	      "grace" => Keyword.get(opts, :grace_ms, 2_000) / 1000
   112	    }
   113	
   114	    env = scrubbed_environment() ++ Keyword.get(opts, :env, [])
   115	
   116	    with :ok <- File.mkdir_p(Path.dirname(log_path)),
   117	         {output, 0} <-
   118	           System.cmd("python3", ["-c", @supervisor, Jason.encode!(spec)],
   119	             env: env,
   120	             stderr_to_stdout: true
   121	           ),
   122	         {:ok, facts} <- decode_facts(output),
   123	         {:ok, bytes} <- File.read(log_path) do
   124	      {:ok,
   125	       Map.merge(facts, %{
   126	         "log_path" => Path.expand(log_path),
   127	         "log_sha256" => sha256(bytes),
   128	         "log_bytes" => bytes
   129	       })}
   130	    else
   131	      {output, code} when is_binary(output) ->
   132	        {:error, "verification supervisor failed (#{code}): #{String.slice(output, -2000, 2000)}"}
   133	
   134	      {:error, reason} when is_binary(reason) ->
   135	        {:error, reason}
   136	
   137	      {:error, reason} ->
   138	        {:error, "verification supervisor failed: #{inspect(reason)}"}
   139	    end
   140	  end
   141	
   142	  @doc "Receipt status from the exit code, time limit and cleanup only."
   143	  @spec status(map()) :: String.t()
   144	  def status(%{"exit_code" => 0, "timed_out" => false, "cleanup" => cleanup})
   145	      when cleanup in ["clean", "terminated"],
   146	      do: "passed"
   147	
   148	  def status(_facts), do: "failed"
   149	
   150	  defp decode_facts(output) do
   151	    line = output |> String.split("\n", trim: true) |> List.last()
   152	
   153	    case line && Jason.decode(line) do
   154	      {:ok, %{"exit_code" => code, "cleanup" => cleanup} = facts}
   155	      when is_integer(code) and cleanup in ["clean", "terminated", "failed"] ->
   156	        {:ok, facts}
   157	
   158	      _ ->
   159	        {:error, "verification supervisor returned malformed facts"}
   160	    end
   161	  end
   162	
   163	  defp sha256(bytes), do: Base.encode16(:crypto.hash(:sha256, bytes), case: :lower)
   164	end
--- base ---
     1	defmodule Kogen.Build.BaseWorkspace do
     2	  @moduledoc """
     3	  Controller-owned workspaces outside the repository for proof runs.
     4	
     5	  The base workspace is a `git archive` export of the admission commit plus
     6	  copies of the admission catalog's `base_cache` paths (the catalog loader
     7	  already refused controller volatile state such as `.kogen/runtime` or
     8	  `.kogen/build.lock`). The controller records its digest at creation and
     9	  re-checks it before each use, rebuilding it on a mismatch. Runs never
    10	  mutate it: each run works in a scratch copy with only the permitted
    11	  overlay applied. Every run there uses the workspace's own `MIX_BUILD_PATH`
    12	  and working directory, so `priv/` and prompts resolve inside it, never in
    13	  the parent checkout or the controller's application directory.
    14	  """
    15	
    16	  @doc """
    17	  Exports `tree` (a commit or tree id) of the repository at `root` into a new
    18	  directory outside it, copies `cache` paths from `root`, and records its
    19	  digest.
    20	  """
    21	  @spec create(Path.t(), String.t(), [String.t()], String.t()) ::
    22	          {:ok, map()} | {:error, String.t()}
    23	  def create(root, tree, cache, label \\ "base") do
    24	    path =
    25	      Path.join(
    26	        System.tmp_dir!(),
    27	        "kogen-#{label}-#{Base.url_encode64(:crypto.strong_rand_bytes(9), padding: false)}"
    28	      )
    29	
    30	    with :ok <- File.mkdir_p(path),
    31	         :ok <- export(root, tree, path),
    32	         :ok <- copy_cache(root, cache, path) do
    33	      {:ok,
    34	       %{path: path, tree: tree, cache: cache, root: Path.expand(root), digest: digest(path)}}
    35	    else
    36	      {:error, reason} ->
    37	        File.rm_rf(path)
    38	        {:error, "could not build #{label} workspace: #{reason}"}
    39	    end
    40	  end
    41	
    42	  @doc "Re-checks a workspace's digest, rebuilding it at a new path on a mismatch."
    43	  @spec ensure(map()) :: {:ok, map(), boolean()} | {:error, String.t()}
    44	  def ensure(workspace) do
    45	    if File.dir?(workspace.path) and digest(workspace.path) == workspace.digest do
    46	      {:ok, workspace, false}
    47	    else
    48	      File.rm_rf(workspace.path)
    49	
    50	      with {:ok, rebuilt} <- create(workspace.root, workspace.tree, workspace.cache) do
    51	        {:ok, rebuilt, true}
    52	      end
    53	    end
    54	  end
    55	
    56	  @doc """
    57	  Copies `workspace` to a fresh scratch directory and applies `overlays`
    58	  (`{relative_path, bytes}` or `{relative_path, :delete}`).
    59	  """
    60	  @spec scratch(map(), [{String.t(), binary() | :delete}]) ::
    61	          {:ok, Path.t()} | {:error, String.t()}
    62	  def scratch(workspace, overlays) do
    63	    dir = workspace.path <> "-run-" <> Integer.to_string(System.unique_integer([:positive]))
    64	
    65	    with {_out, 0} <- System.cmd("cp", ["-R", workspace.path, dir], stderr_to_stdout: true),
    66	         :ok <- apply_overlays(dir, overlays) do
    67	      {:ok, dir}
    68	    else
    69	      {out, code} when is_binary(out) ->
    70	        File.rm_rf(dir)
    71	        {:error, "could not copy workspace (#{code}): #{String.trim(out)}"}
    72	
    73	      {:error, reason} ->
    74	        File.rm_rf(dir)
    75	        {:error, reason}
    76	    end
    77	  end
    78	
    79	  @doc "Environment for a run inside workspace directory `dir`."
    80	  def run_environment(dir),
    81	    do: [
    82	      {"MIX_BUILD_PATH", Path.join([dir, "_build", "test"])},
    83	      {"MIX_ENV", "test"},
    84	      {"MIX_EXS", nil},
    85	      {"MIX_DEPS_PATH", nil}
    86	    ]
    87	
    88	  @doc "Removes a workspace."
    89	  def remove(nil), do: :ok
    90	
    91	  def remove(%{path: path}) do
    92	    File.rm_rf(path)
    93	    :ok
    94	  end
    95	
    96	  @doc """
    97	  Digest over every entry's relative path, type, executable bit and content.
    98	  """
    99	  @spec digest(Path.t()) :: String.t()
   100	  def digest(path) do
   101	    path
   102	    |> entries("")
   103	    |> Enum.sort()
   104	    |> Enum.map_join("\n", fn {relative, kind, value} -> "#{kind}\t#{relative}\t#{value}" end)
   105	    |> then(&Base.encode16(:crypto.hash(:sha256, &1), case: :lower))
   106	  end
   107	
   108	  @doc "The sha256 digest of a list of overlays."
   109	  def overlay_digest(overlays) do
   110	    overlays
   111	    |> Enum.sort()
   112	    |> Enum.map_join("\n", fn
   113	      {path, :delete} -> "delete\t#{path}"
   114	      {path, bytes} -> "write\t#{path}\t#{sha256(bytes)}"
   115	    end)
   116	    |> sha256()
   117	  end
   118	
   119	  defp entries(root, relative) do
   120	    path = Path.join(root, relative)
   121	
   122	    case File.lstat(path) do
   123	      {:ok, %{type: :directory}} ->
   124	        path
   125	        |> File.ls!()
   126	        |> Enum.flat_map(&entries(root, Path.join(relative, &1) |> String.trim_leading("/")))
   127	
   128	      {:ok, %{type: :regular, mode: mode}} ->
   129	        [{relative, "file#{Bitwise.band(mode, 0o111)}", sha256(File.read!(path))}]
   130	
   131	      {:ok, %{type: :symlink}} ->
   132	        [{relative, "link", File.read_link!(path)}]
   133	
   134	      _ ->
   135	        [{relative, "other", ""}]
   136	    end
   137	  end
   138	
   139	  defp export(root, tree, path) do
   140	    command =
   141	      "git -C #{shell_quote(Path.expand(root))} archive --format=tar #{shell_quote(tree)} | tar -x -C #{shell_quote(path)}"
   142	
   143	    case System.cmd("sh", ["-c", "set -o pipefail 2>/dev/null; " <> command],
   144	           stderr_to_stdout: true
   145	         ) do
   146	      {_out, 0} -> :ok
   147	      {out, code} -> {:error, "git archive failed (#{code}): #{String.trim(out)}"}
   148	    end
   149	  end
   150	
   151	  defp copy_cache(root, cache, path) do
   152	    Enum.reduce_while(cache, :ok, fn relative, :ok ->
   153	      case copy_entry(Path.join(root, relative), Path.join(path, relative)) do
   154	        :ok -> {:cont, :ok}
   155	        {:error, out} -> {:halt, {:error, "could not copy base_cache #{relative}: #{out}"}}
   156	      end
   157	    end)
