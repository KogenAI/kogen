     1	defmodule Kogen.Build.CatalogChange do
     2	  @moduledoc """
     3	  Checks the Candidate's verification-target catalog each cycle.
     4	
     5	  The catalog is no longer byte-frozen after admission. The controller reads
     6	  the Candidate's catalog and Makefile only as data (never loading Candidate
     7	  code) and requires that every planned target exists in both and that the
     8	  whole catalog still meets every catalog rule. The admission catalog stays
     9	  the trust anchor: a target that existed at admission keeps its admission
    10	  entry (rank, dependencies, provider backing), and only targets the Intent
    11	  declared in `catalog_changes.add` take their entry from the Candidate.
    12	  Removing, renaming or editing unselected targets needs no declaration; the
    13	  verification-surface ledger shows it. Any violation is a verification
    14	  failure that returns to the same Developer, never a Build stop.
    15	  """
    16	
    17	  alias Kogen.Build.VerificationPlan
    18	
    19	  @doc """
    20	  Returns `{:ok, %{sha256, order, provider_backed, entries}}` for the
    21	  Candidate in `root`, or `{:error, reason}`.
    22	  """
    23	  def check(root, admission, plan, scenarios) do
    24	    added = Map.get(plan, :added, [])
    25	
    26	    with {:ok, candidate} <- load(root),
    27	         :ok <- selected_present(plan.targets, candidate),
    28	         entries = effective_entries(plan.targets, admission, candidate, added),
    29	         :ok <- scenario_rules(scenarios, entries),
    30	         :ok <- added_rehearsals(scenarios, entries, added),
    31	         {:ok, order} <- VerificationPlan.order_names(plan.targets, entries) do
    32	      {:ok,
    33	       %{
    34	         sha256: candidate.sha256,
    35	         order: order,
    36	         provider_backed:
    37	           Map.new(entries, fn {name, entry} -> {name, entry["provider_backed"]} end),
    38	         entries: entries
    39	       }}
    40	    end
    41	  end
    42	
    43	  defp load(root) do
    44	    case VerificationPlan.load(root) do
    45	      {:ok, catalog} -> {:ok, catalog}
    46	      {:error, reason} -> {:error, "Candidate verification target catalog is invalid: #{reason}"}
    47	    end
    48	  end
    49	
    50	  defp selected_present(targets, candidate) do
    51	    case Enum.reject(targets, &Map.has_key?(candidate.targets, &1)) do
    52	      [] ->
    53	        :ok
    54	
    55	      missing ->
    56	        {:error,
    57	         "selected verification target missing from the Candidate catalog or Makefile: " <>
    58	           Enum.join(missing, ", ")}
    59	    end
    60	  end
    61	
    62	  defp effective_entries(targets, admission, candidate, added) do
    63	    Map.new(targets, fn name ->
    64	      entry =
    65	        if name in added,
    66	          do: candidate.targets[name],
    67	          else: admission.targets[name]
    68	
    69	      {name, entry}
    70	    end)
    71	  end
    72	
    73	  defp scenario_rules(scenarios, entries) do
    74	    scenarios
    75	    |> Enum.flat_map(fn scenario ->
    76	      scenario
    77	      |> VerificationPlan.verified_by_errors(entries)
    78	      |> Enum.map(&"scenario #{scenario["id"]}: #{&1}")
    79	    end)
    80	    |> case do
    81	      [] ->
    82	        :ok
    83	
    84	      errors ->
    85	        {:error, "Candidate catalog breaks a selected target rule: " <> Enum.join(errors, "; ")}
    86	    end
    87	  end
    88	
    89	  # A scenario selecting an added provider-backed target lists that target's
    90	  # rehearsal test as a file selector, so the controller runs it.
    91	  defp added_rehearsals(scenarios, entries, added) do
    92	    scenarios
    93	    |> Enum.flat_map(fn scenario ->
    94	      offline = get_in(scenario, ["proof", "offline"]) || []
    95	
    96	      for name <- scenario["verified_by"],
    97	          name in added,
    98	          entries[name]["provider_backed"] == true,
    99	          command = get_in(entries[name], ["rehearsal", "command"]) || "",
   100	          not Enum.any?(
   101	            offline,
   102	            &(String.ends_with?(&1, ".exs") and String.contains?(command, &1))
   103	          ) do
   104	        "scenario #{scenario["id"]} selects added provider-backed target #{name} without listing its rehearsal test as a file selector"
   105	      end
   106	    end)
   107	    |> case do
   108	      [] -> :ok
   109	      errors -> {:error, Enum.join(errors, "; ")}
   110	    end
   111	  end
   112	end

