     7	  @spec capture(binary(), String.t(), String.t(), Path.t()) ::
     8	          {:ok, nil | map()} | {:error, String.t()}
     9	  def capture(output, target, attempt_token, root \\ ".")
    10	      when is_binary(output) and is_binary(target) and is_binary(attempt_token) do
    11	    case frames(output) do
    12	      [] ->
    13	        {:ok, nil}
    14	
    15	      [encoded] ->
    16	        with {:ok, locator} <- decode_object(encoded, "target evidence frame"),
    17	             :ok <- exact_keys(locator, ~w(manifest_path sha256), "target evidence frame"),
    18	             {:ok, manifest_path} <- safe_path(locator["manifest_path"], root),
    19	             :ok <- digest(locator["sha256"], "manifest"),
    20	             {:ok, manifest_bytes} <- read_regular(manifest_path, root),
    21	             :ok <- matches_digest(manifest_bytes, locator["sha256"], "manifest"),
    22	             {:ok, manifest} <- decode_object(manifest_bytes, "target evidence manifest"),
    23	             :ok <-
    24	               exact_keys(
    25	                 manifest,
    26	                 ~w(required_evidence schema_version),
    27	                 "target evidence manifest"
    28	               ),
    29	             :ok <- schema_version(manifest["schema_version"]),
    30	             {:ok, entries} <- entries(manifest["required_evidence"], root) do
    31	          {:ok,
    32	           %{
    33	             "target" => target,
    34	             "attempt_token" => attempt_token,
    35	             "manifest" => snapshot(locator["manifest_path"], manifest_bytes),
    36	             "required_evidence" => entries
    37	           }}
    38	        end
    39	
    40	      _many ->
    41	        {:error, "target emitted duplicate evidence manifest frames"}
    42	    end
    43	  end
    44	
    45	  @spec verify(map(), Path.t()) :: :ok | {:error, String.t()}
    46	  def verify(snapshot, root \\ ".")
    47	
    48	  def verify(snapshot, root) when is_map(snapshot) do
    49	    with true <- is_binary(snapshot["target"]) and snapshot["target"] != "",
    50	         true <- is_binary(snapshot["attempt_token"]) and snapshot["attempt_token"] != "",
    51	         :ok <- verify_snapshot(snapshot["manifest"], root),
    52	         entries when is_list(entries) and entries != [] <- snapshot["required_evidence"],
    53	         :ok <- verify_snapshots(entries, root) do
    54	      :ok
    55	    else
    56	      false -> {:error, "retained target evidence has invalid provenance"}
    57	      _ -> {:error, "retained target evidence has invalid schema or bytes"}
    58	    end
    59	  end
    60	
    61	  def verify(_snapshot, _root), do: {:error, "retained target evidence must be an object"}
    62	
    63	  defp frames(output) do
    64	    lines = :binary.split(output, "\n", [:global])
    65	    complete_lines = if String.ends_with?(output, "\n"), do: lines, else: Enum.drop(lines, -1)
    66	
    67	    complete_lines
    68	    |> Enum.flat_map(&Regex.scan(~r/#{@prefix}([^\r]*)/, &1, capture: :all_but_first))
    69	    |> Enum.map(&hd/1)
    70	  end
    71	
    72	  defp decode_object(bytes, label) do
    73	    case Jason.decode(bytes) do
    74	      {:ok, value} when is_map(value) -> {:ok, value}
    75	      _ -> {:error, "#{label} must contain one valid JSON object"}
    76	    end
    77	  end
    78	
    79	  defp exact_keys(value, expected, label) do
    80	    if Enum.sort(Map.keys(value)) == Enum.sort(expected),
    81	      do: :ok,
    82	      else: {:error, "#{label} must contain exactly #{Enum.join(expected, ", ")}"}
    83	  end
    84	
    85	  defp schema_version(1), do: :ok
    86	  defp schema_version(_), do: {:error, "target evidence manifest has unsupported schema_version"}
    87	
    88	  defp entries(entries, root) when is_list(entries) and entries != [] do
    89	    Enum.reduce_while(entries, {:ok, {MapSet.new(), []}}, fn entry, {:ok, {seen, acc}} ->
    90	      with true <- is_map(entry),
    91	           :ok <- exact_keys(entry, ~w(path sha256), "required evidence entry"),
    92	           {:ok, path} <- safe_path(entry["path"], root),
    93	           false <- MapSet.member?(seen, entry["path"]),
    94	           :ok <- digest(entry["sha256"], "required evidence"),
    95	           {:ok, bytes} <- read_regular(path, root),
    96	           :ok <- matches_digest(bytes, entry["sha256"], "required evidence #{entry["path"]}") do
    97	        {:cont, {:ok, {MapSet.put(seen, entry["path"]), acc ++ [snapshot(entry["path"], bytes)]}}}
    98	      else
    99	        false -> {:halt, {:error, "target evidence manifest contains a duplicate path"}}
   100	        {:error, _reason} = error -> {:halt, error}
   101	        _ -> {:halt, {:error, "required evidence entry must be an object"}}
   102	      end
   103	    end)
   104	    |> case do
   105	      {:ok, {_seen, snapshots}} -> {:ok, snapshots}
   106	      error -> error
   107	    end
   108	  end
   109	
   110	  defp entries(_, _root),
   111	    do: {:error, "target evidence manifest requires a nonempty required_evidence list"}
   112	
   113	  defp safe_path(path, root) when is_binary(path) and path != "" do
   114	    segments = String.split(path, "/", trim: false)
   115	
   116	    if Path.type(path) == :relative and not String.contains?(path, [<<0>>, "\\"]) and
   117	         Enum.all?(segments, &(&1 not in ["", ".", ".."])) do
   118	      expanded_root = Path.expand(root)
   119	      expanded = Path.expand(path, expanded_root)
   120	
   121	      if String.starts_with?(expanded, expanded_root <> "/") and
   122	           no_symlink_components?(expanded_root, segments),
   123	         do: {:ok, expanded},
   124	         else: {:error, "unsafe target evidence path: #{inspect(path)}"}
   125	    else
   126	      {:error, "unsafe target evidence path: #{inspect(path)}"}
   127	    end
   128	  end
   129	
   130	  defp safe_path(path, _root), do: {:error, "unsafe target evidence path: #{inspect(path)}"}
   131	
   132	  defp no_symlink_components?(root, segments) do
   133	    segments
   134	    |> Enum.scan(root, &Path.join(&2, &1))
   135	    |> Enum.all?(fn path ->
   136	      case File.lstat(path) do
   137	        {:ok, %{type: :symlink}} -> false
   138	        _ -> true
   139	      end
   140	    end)
   141	  end
   142	
   143	  defp read_regular(path, root) do
   144	    with {:ok, %{type: :regular}} <- File.stat(path),
   145	         {:ok, bytes} <- File.read(path) do
   146	      {:ok, bytes}
   147	    else
   148	      _ ->
   149	        {:error,
   150	         "target evidence path is missing or not a regular file: #{Path.relative_to(path, Path.expand(root))}"}
   151	    end
   152	  end
   153	
   154	  defp digest(value, _label) when is_binary(value) do
   155	    if Regex.match?(@digest, value),
   156	      do: :ok,
   157	      else: {:error, "target evidence digest must be lowercase SHA-256"}
   158	  end
   159	
   160	  defp digest(_value, _label), do: {:error, "target evidence digest must be lowercase SHA-256"}
   161	
   162	  defp matches_digest(bytes, expected, label) do
   163	    if sha256(bytes) == expected,
   164	      do: :ok,
   165	      else: {:error, "#{label} digest mismatch"}
   166	  end
   167	
   168	  defp snapshot(path, bytes) do
   169	    %{"path" => path, "sha256" => sha256(bytes), "content_base64" => Base.encode64(bytes)}
   170	  end
   171	
   172	  defp verify_snapshots(snapshots, root) do
   173	    Enum.reduce_while(snapshots, :ok, fn item, :ok ->
   174	      case verify_snapshot(item, root) do
   175	        :ok -> {:cont, :ok}
   176	        error -> {:halt, error}
   177	      end
   178	    end)
   179	  end
   180	
     1	defmodule Kogen.Build.BaseWorkspace do
     2	  @moduledoc """
     3	  Controller-owned workspaces outside the repository for proof runs.
     4	
     5	  The base workspace is a `git archive` export of the admission commit plus
     6	  copies of the admission catalog's `base_cache` paths (the catalog loader
     7	  already refused controller volatile state such as `.kogen/runtime` or
     8	  `.kogen/build.lock`). The controller records its digest at creation and
     9	  re-checks it before each use, rebuilding it on a mismatch. Runs never
    10	  mutate it: each run works in a scratch copy with only the permitted
    11	  overlay applied. Every run there uses the workspace's own `MIX_BUILD_PATH`
    12	  and working directory, so `priv/` and prompts resolve inside it, never in
    13	  the parent checkout or the controller's application directory.
    14	  """
    15	
    16	  @doc """
    17	  Exports `tree` (a commit or tree id) of the repository at `root` into a new
    18	  directory outside it, copies `cache` paths from `root`, and records its
    19	  digest.
    20	  """
    21	  @spec create(Path.t(), String.t(), [String.t()], String.t()) ::
    22	          {:ok, map()} | {:error, String.t()}
    23	  def create(root, tree, cache, label \\ "base") do
    24	    path =
    25	      Path.join(
    26	        System.tmp_dir!(),
    27	        "kogen-#{label}-#{Base.url_encode64(:crypto.strong_rand_bytes(9), padding: false)}"
    28	      )
    29	
    30	    with :ok <- File.mkdir_p(path),
    31	         :ok <- export(root, tree, path),
    32	         :ok <- copy_cache(root, cache, path) do
    33	      {:ok,
    34	       %{path: path, tree: tree, cache: cache, root: Path.expand(root), digest: digest(path)}}
    35	    else
    36	      {:error, reason} ->
    37	        File.rm_rf(path)
    38	        {:error, "could not build #{label} workspace: #{reason}"}
    39	    end
    40	  end
    41	
    42	  @doc "Re-checks a workspace's digest, rebuilding it at a new path on a mismatch."
    43	  @spec ensure(map()) :: {:ok, map(), boolean()} | {:error, String.t()}
    44	  def ensure(workspace) do
    45	    if File.dir?(workspace.path) and digest(workspace.path) == workspace.digest do
    46	      {:ok, workspace, false}
    47	    else
    48	      File.rm_rf(workspace.path)
    49	
    50	      with {:ok, rebuilt} <- create(workspace.root, workspace.tree, workspace.cache) do
    51	        {:ok, rebuilt, true}
    52	      end
    53	    end
    54	  end
    55	
    56	  @doc """
    57	  Copies `workspace` to a fresh scratch directory and applies `overlays`
    58	  (`{relative_path, bytes}` or `{relative_path, :delete}`).
    59	  """
    60	  @spec scratch(map(), [{String.t(), binary() | :delete}]) ::
    61	          {:ok, Path.t()} | {:error, String.t()}
    62	  def scratch(workspace, overlays) do
    63	    dir = workspace.path <> "-run-" <> Integer.to_string(System.unique_integer([:positive]))
    64	
    65	    with {_out, 0} <- System.cmd("cp", ["-R", workspace.path, dir], stderr_to_stdout: true),
    66	         :ok <- apply_overlays(dir, overlays) do
    67	      {:ok, dir}
    68	    else
    69	      {out, code} when is_binary(out) ->
    70	        File.rm_rf(dir)
    71	        {:error, "could not copy workspace (#{code}): #{String.trim(out)}"}
    72	
    73	      {:error, reason} ->
    74	        File.rm_rf(dir)
    75	        {:error, reason}
    76	    end
    77	  end
    78	
    79	  @doc "Environment for a run inside workspace directory `dir`."
    80	  def run_environment(dir),
    81	    do: [
    82	      {"MIX_BUILD_PATH", Path.join([dir, "_build", "test"])},
    83	      {"MIX_ENV", "test"},
    84	      {"MIX_EXS", nil},
    85	      {"MIX_DEPS_PATH", nil}
    86	    ]
    87	
    88	  @doc "Removes a workspace."
    89	  def remove(nil), do: :ok
    90	
    91	  def remove(%{path: path}) do
    92	    File.rm_rf(path)
    93	    :ok
    94	  end
    95	
    96	  @doc """
    97	  Digest over every entry's relative path, type, executable bit and content.
    98	  """
    99	  @spec digest(Path.t()) :: String.t()
   100	  def digest(path) do
   101	    path
   102	    |> entries("")
   103	    |> Enum.sort()
   104	    |> Enum.map_join("\n", fn {relative, kind, value} -> "#{kind}\t#{relative}\t#{value}" end)
   105	    |> then(&Base.encode16(:crypto.hash(:sha256, &1), case: :lower))
   106	  end
   107	
   108	  @doc "The sha256 digest of a list of overlays."
   109	  def overlay_digest(overlays) do
   110	    overlays
   111	    |> Enum.sort()
   112	    |> Enum.map_join("\n", fn
   113	      {path, :delete} -> "delete\t#{path}"
   114	      {path, bytes} -> "write\t#{path}\t#{sha256(bytes)}"
   115	    end)
   116	    |> sha256()
   117	  end
   118	
   119	  defp entries(root, relative) do
   120	    path = Path.join(root, relative)
   121	
   122	    case File.lstat(path) do
   123	      {:ok, %{type: :directory}} ->
   124	        path
   125	        |> File.ls!()
   126	        |> Enum.flat_map(&entries(root, Path.join(relative, &1) |> String.trim_leading("/")))
   127	
   128	      {:ok, %{type: :regular, mode: mode}} ->
   129	        [{relative, "file#{Bitwise.band(mode, 0o111)}", sha256(File.read!(path))}]
   130	
   131	      {:ok, %{type: :symlink}} ->
   132	        [{relative, "link", File.read_link!(path)}]
   133	
   134	      _ ->
   135	        [{relative, "other", ""}]
   136	    end
   137	  end
   138	
   139	  defp export(root, tree, path) do
   140	    command =
   141	      "git -C #{shell_quote(Path.expand(root))} archive --format=tar #{shell_quote(tree)} | tar -x -C #{shell_quote(path)}"
   142	
   143	    case System.cmd("sh", ["-c", "set -o pipefail 2>/dev/null; " <> command],
   144	           stderr_to_stdout: true
   145	         ) do
   146	      {_out, 0} -> :ok
   147	      {out, code} -> {:error, "git archive failed (#{code}): #{String.trim(out)}"}
   148	    end
   149	  end
   150	
   151	  defp copy_cache(root, cache, path) do
   152	    Enum.reduce_while(cache, :ok, fn relative, :ok ->
   153	      case copy_entry(Path.join(root, relative), Path.join(path, relative)) do
   154	        :ok -> {:cont, :ok}
   155	        {:error, out} -> {:halt, {:error, "could not copy base_cache #{relative}: #{out}"}}
   156	      end
   157	    end)
   158	  end
   159	
   160	  # An absent cache path is skipped; the base then compiles cold.
   161	  defp copy_entry(source, target) do
   162	    if File.exists?(source) do
   163	      File.mkdir_p!(Path.dirname(target))
   164	
   165	      case System.cmd("cp", ["-R", source, target], stderr_to_stdout: true) do
   166	        {_out, 0} -> :ok
   167	        {out, _code} -> {:error, out}
   168	      end
   169	    else
   170	      :ok
   171	    end
   172	  end
   173	
   174	  defp apply_overlays(dir, overlays) do
   175	    Enum.reduce_while(overlays, :ok, fn
   176	      {relative, :delete}, :ok ->
   177	        File.rm_rf(Path.join(dir, relative))
   178	        {:cont, :ok}
   179	
   180	      {relative, bytes}, :ok ->
   181	        target = Path.join(dir, relative)
   182	
   183	        with :ok <- File.mkdir_p(Path.dirname(target)),
   184	             :ok <- File.write(target, bytes) do
   185	          {:cont, :ok}
   186	        else
   187	          {:error, reason} ->
   188	            {:halt, {:error, "could not overlay #{relative}: #{inspect(reason)}"}}
   189	        end
   190	    end)
   191	  end
   192	
   193	  defp shell_quote(value), do: "'" <> String.replace(value, "'", "'\\''") <> "'"
   194	  defp sha256(bytes), do: Base.encode16(:crypto.hash(:sha256, bytes), case: :lower)
   195	end
     1	defmodule Kogen.Build.ReviewPacket do
     2	  @moduledoc """
     3	  The bounded, Candidate-bound evidence a fresh Reviewer starts from.
     4	
     5	  Before each Review the controller writes one immutable packet per attempt
     6	  next to the tracking record. It is canonical JSON (keys sorted) and never
     7	  larger than #{65_536} bytes. Long string fields are cut at a UTF-8 boundary
     8	  with a per-field cap; a cut or left-out value is replaced by a stub carrying
     9	  the SHA-256 and byte count of the full source and a JSON pointer into the
    10	  record, and is listed in `omitted`. Serialized JSON is never byte-sliced.
    11	  The scenario, risk and open finding ids are always present, and so is one
    12	  complete index entry per verification-surface ledger item (its full diff
    13	  stays a retained file cited by locator and sha256, never inlined): if they
    14	  alone cannot fit, building fails instead of dropping them.
    15	
    16	  Digests of structured values are over their canonical JSON encoding; digests
    17	  of strings are over the string's bytes.
    18	  """
    19	
    20	  @limit 65_536
    21	  @schema_version 1
    22	  @directory "review-packets"
    23	
    24	  @keys ~w(schema_version build_id attempt_number attempt_token candidate_id scenario_ids
    25	           risk_ids handoff developer_notes receipts open_findings superseded_objection
    26	           verification_ledger base_suite omitted record)
    27	
    28	  # Tried in order until the whole packet fits. The first profile holds the
    29	  # per-field caps; later profiles only tighten them, and the last one keeps
    30	  # nothing beyond the required ids and digest-bound stubs.
    31	  @profiles [
    32	    %{notes: 16_384, output: 2_048, handoff: 24_576, finding: 8_192},
    33	    %{notes: 8_192, output: 1_024, handoff: 12_288, finding: 2_048},
    34	    %{notes: 2_048, output: 256, handoff: 2_048, finding: 256},
    35	    %{notes: 0, output: 0, handoff: 0, finding: 0}
    36	  ]
    37	
    38	  @inner_caps [4_096, 1_024, 256, 64]
    39	
    40	  @superseded_label "advisory: a contract objection Jev read in the Developer's notes was written before controller verification of this same attempt passed; it did not stop the Build and is not a finding. Judge every scenario yourself."
    41	
    42	  @record_use "audit locator only: start from this packet and never dump the whole record; open a record section only through a locator named here"
    43	
    44	  @doc "The packet byte bound."
    45	  def limit, do: @limit
    46	
    47	  @doc "The exact top-level packet keys."
    48	  def keys, do: @keys
    49	
    50	  @doc """
    51	  Builds canonical packet bytes. `input` holds `:record` (the current tracking
    52	  record map), `:record_path`, `:record_bytes`, `:candidate_id` and
    53	  `:open_findings` (the open finding ids). The packet is bound to the
    54	  record's latest attempt, whose `verification_ledger` and `base_suite` it
    55	  carries when present.
    56	  """
    57	  @spec build(map()) :: {:ok, binary()} | {:error, String.t()}
    58	  def build(input) do
    59	    record = input.record
    60	    index = length(record["attempts"]) - 1
    61	    attempt = List.last(record["attempts"])
    62	
    63	    result =
    64	      Enum.find_value(@profiles, fn profile ->
    65	        bytes = input |> packet(record, index, attempt, profile) |> encode()
    66	        if byte_size(bytes) <= @limit, do: bytes
    67	      end)
    68	
    69	    case result do
    70	      nil ->
    71	        {:error,
    72	         "review packet integrity failure: the required scenario, risk and open finding ids alone exceed #{@limit} bytes"}
    73	
    74	      bytes ->
    75	        {:ok, bytes}
    76	    end
    77	  end
    78	
    79	  @doc """
    80	  Writes packet bytes once, with exclusive create, at
    81	  `<record dir>/review-packets/<attempt-number>.json` and returns the binding
    82	  the controller keeps in its state and in the attempt.
    83	  """
    84	  @spec write(Path.t(), non_neg_integer(), binary(), String.t(), String.t()) ::
    85	          {:ok, map()} | {:error, String.t()}
    86	  def write(record_path, number, bytes, token, candidate_id) do
    87	    directory = Path.join(Path.dirname(record_path), @directory)
    88	    path = Path.join(directory, "#{number}.json")
    89	
    90	    with :ok <- owned_directory(directory),
    91	         :ok <- exclusive_write(path, bytes) do
    92	      {:ok,
    93	       %{
    94	         "path" => Path.relative_to(Path.expand(path), File.cwd!()),
    95	         "sha256" => sha256(bytes),
    96	         "byte_count" => byte_size(bytes),
    97	         "attempt_token" => token,
    98	         "candidate_id" => candidate_id
    99	       }}
   100	    end
   101	  end
   102	
   103	  @doc "Confirms that a written packet still has exactly its bound bytes."
   104	  @spec verify(map()) :: :ok | {:error, String.t()}
   105	  def verify(%{"path" => path, "sha256" => digest, "byte_count" => count})
   106	      when is_binary(path) do
   107	    case File.read(path) do
   108	      {:ok, bytes} ->
   109	        if byte_size(bytes) == count and sha256(bytes) == digest,
   110	          do: :ok,
   111	          else: {:error, "review packet mutated: #{path}"}
   112	
   113	      {:error, _reason} ->
   114	        {:error, "review packet missing: #{path}"}
   115	    end
   116	  end
   117	
   118	  def verify(_binding), do: {:error, "review packet binding is malformed"}
   119	
   120	  @doc """
   121	  Returns the superseded-objection record, or `nil` when `objections` must
   122	  still stop the Build. A confident objection is superseded only when it is
   123	  stale in this exact attempt: the settled verification passed, every cycle
   124	  belongs to the same verification history (`binding`'s attempt token and
   125	  Developer session), an earlier cycle failed, and the final cycle passed on
   126	  the settled Candidate. It then stays in the record and reaches the fresh
   127	  Reviewer as a labelled advisory item.
   128	  """
   129	  @spec superseded_objection(map(), map(), [map()], number()) :: map() | nil
   130	  def superseded_objection(_verification, _binding, [], _threshold), do: nil
   131	
   132	  def superseded_objection(verification, binding, objections, threshold) do
   133	    cycles = verification["cycles"] || []
   134	    final = List.last(cycles) || %{}
   135	
   136	    failed =
   137	      for cycle <- Enum.drop(cycles, -1), cycle["status"] == "failed", do: cycle["sequence"]
   138	
   139	    if verification["terminal_state"] == "passed" and same_history?(cycles, binding) and
   140	         failed != [] and final_pass?(final, binding) do
   141	      %{
   142	        "items" => objections,
   143	        "confidences" => Map.new(objections, &{"#{&1["kind"]}:#{&1["id"]}", &1["confidence"]}),
   144	        "threshold" => threshold,
   145	        "failed_cycle_sequences" => failed,
   146	        "passing_cycle_sequence" => final["sequence"],
   147	        "attempt_token" => binding.attempt_token,
   148	        "developer_session_id" => binding.developer_session_id,
   149	        "candidate_id" => binding.candidate_id
   150	      }
   151	    end
   152	  end
   153	
   154	  defp same_history?(cycles, binding) do
   155	    Enum.all?(
   156	      cycles,
   157	      &(&1["attempt_token"] == binding.attempt_token and
