   173	    terminal =
   174	      cond do
   175	        status == "passed" -> "passed"
   176	        after_count > execution.context["verification_retries"] -> "exhausted"
   177	        true -> "pending"
   178	      end
   179	
   180	    state =
   181	      state
   182	      |> Map.merge(%{
   183	        "developer_session_id" => session_id,
   184	        "candidate_id" => candidate_id,
   185	        "cycles" => state["cycles"] ++ [cycle],
   186	        "failures_since_pass" => after_count,
   187	        "terminal_state" => terminal
   188	      })
   189	
   190	    persist(execution, state, session_id, candidate_id, cycle)
   191	  end
   192	
   193	  defp run_targets(execution, base, catalog, env) do
   194	    base = Map.put(base, "catalog_sha256", catalog.sha256)
   195	
   196	    {receipts, failure} =
   197	      Enum.reduce_while(catalog.order, {[], nil}, fn target, {acc, nil} ->
   198	        {receipt, failure} = target_receipt(execution, base, target, catalog, env)
   199	        step = if failure, do: :halt, else: :cont
   200	        {step, {acc ++ [receipt], failure}}
   201	      end)
   202	
   203	    {proofs, failure, execution} =
   204	      if failure == nil and env.catalog.integrity do
   205	        ProofSelectors.run(execution, base, env)
   206	      else
   207	        {[], failure, execution}
   208	      end
   209	
   210	    {Map.merge(base, %{"receipts" => receipts, "proofs" => proofs, "failure" => failure}),
   211	     execution}
   212	  end
   213	
   214	  defp target_receipt(execution, base, target, catalog, env) do
   215	    case reusable(execution.state["cycles"], target, base, catalog) do
   216	      {:ok, receipt} -> {receipt, nil}
   217	      :none -> run_target(execution, base, target, catalog, env)
   218	    end
   219	  end
   220	
   221	  # A provider-backed target reuses the latest earlier passed receipt of this
   222	  # attempt bound to the same Candidate id and catalog digest. Offline
   223	  # targets always run fresh, whatever their name.
   224	  defp reusable(cycles, target, base, catalog) do
   225	    if catalog.provider_backed[target] == true do
   226	      cycles
   227	      |> Enum.reverse()
   228	      |> Enum.find_value(:none, &reuse_from(&1, target, base))
   229	    else
   230	      :none
   231	    end
   232	  end
   233	
   234	  defp reuse_from(cycle, target, base) do
   235	    receipt = Enum.find(cycle["receipts"] || [], &(&1["target"] == target))
   236	
   237	    if receipt && receipt["status"] == "passed" && is_nil(receipt["target_evidence_error"]) &&
   238	         receipt["candidate_id"] == base["candidate_id"] &&
   239	         receipt["catalog_sha256"] == base["catalog_sha256"] &&
   240	         receipt["context_sha256"] == base["context_sha256"] do
   240	         receipt["context_sha256"] == base["context_sha256"] do
   241	      origin =
   242	        receipt["reused_from"] ||
   243	          %{"cycle_sequence" => cycle["sequence"], "log_sha256" => receipt["log_sha256"]}
   244	
   245	      {:ok,
   246	       receipt
   247	       |> Map.put("cycle_sequence", base["sequence"])
   248	       |> Map.put("developer_session_id", base["developer_session_id"])
   249	       |> Map.put("reused_from", origin)}
   250	    end
   251	  end
   252	
   253	  defp run_target(execution, base, target, catalog, env) do
   254	    log = Path.join(execution.log_root, "cycle-#{base["sequence"]}-#{target}.log")
   255	
   256	    case VerificationRunner.run_target(env.root, target, log) do
   257	      {:ok, facts} ->
   258	        receipt = receipt(execution, base, target, catalog, facts, env.root)
   259	        {receipt, receipt_failure(receipt, base, env)}
   260	
   261	      {:error, reason} ->
   262	        failure = write_failure_log(execution, base["sequence"], "#{target}-supervisor", reason)
   263	        {nil, Map.merge(failure, %{"kind" => "runner", "target" => target})}
   264	    end
   265	    |> case do
   266	      {nil, failure} -> {placeholder(base, target, catalog, failure), failure}
   267	      result -> result
   268	    end
   269	  end
   270	
   271	  # A runner error still leaves a failed receipt, bound to its failure log.
   272	  defp placeholder(base, target, catalog, failure) do
   273	    base
   274	    |> receipt_binding(target, catalog)
   275	    |> Map.merge(%{
   276	      "status" => "failed",
   277	      "exit_code" => 1,
   278	      "cleanup" => "failed",
   279	      "timed_out" => false,
   280	      "started_at" => base["started_at"],
   281	      "finished_at" => now(),
   282	      "elapsed_ms" => 0,
   283	      "log_path" => failure["log_path"],
   284	      "log_sha256" => failure["log_sha256"],
   285	      "output" => failure["output"]
   286	    })
   287	  end
   288	
   289	  defp receipt(execution, base, target, catalog, facts, root) do
   290	    output = facts["log_bytes"]
   291	
   292	    receipt =
   293	      base
   294	      |> receipt_binding(target, catalog)
   295	      |> Map.merge(%{
   296	        "status" => VerificationRunner.status(facts),
   297	        "exit_code" => facts["exit_code"],
   298	        "cleanup" => facts["cleanup"],
   299	        "timed_out" => facts["timed_out"],
   300	        "started_at" => facts["started_at"],
   301	        "finished_at" => facts["finished_at"],
   302	        "elapsed_ms" => facts["elapsed_ms"],
   303	        "log_path" => relative(facts["log_path"], root),
   304	        "log_sha256" => facts["log_sha256"],
   305	        "output" => tail(output)
   306	      })
   307	
   308	    case TargetEvidence.capture(output, target, execution.context["attempt_token"], root) do
   309	      {:ok, nil} -> receipt
   310	      {:ok, evidence} -> Map.put(receipt, "target_evidence", evidence)
   311	      {:error, reason} -> Map.put(receipt, "target_evidence_error", reason)
   312	    end
   313	  end
   314	
   315	  defp receipt_binding(base, target, catalog) do
   316	    %{
   317	      "target" => target,
   318	      "provider_backed" => catalog.provider_backed[target] == true,
   319	      "candidate_id" => base["candidate_id"],
   320	      "attempt_token" => base["attempt_token"],
   321	      "developer_session_id" => base["developer_session_id"],
   322	      "context_sha256" => base["context_sha256"],
   323	      "catalog_sha256" => base["catalog_sha256"],
   324	      "cycle_sequence" => base["sequence"]
   325	    }
   326	  end
   327	
   328	  defp receipt_failure(receipt, base, env) do
   329	    cond do
   330	      receipt["status"] == "failed" ->
   331	        %{
   332	          "kind" => "target",
   333	          "target" => receipt["target"],
   334	          "log_path" => receipt["log_path"],
   335	          "log_sha256" => receipt["log_sha256"],
   336	          "output" => receipt["output"]
   337	        }
   338	
   339	      receipt["target_evidence_error"] ->
   340	        %{
   341	          "kind" => "target_evidence",
   342	          "target" => receipt["target"],
   343	          "log_path" => receipt["log_path"],
   344	          "log_sha256" => receipt["log_sha256"],
   345	          "output" =>
   346	            "Kogen target evidence validation failed: " <> receipt["target_evidence_error"]
   347	        }
   348	
   349	      true ->
   350	        candidate_mutation(receipt, base, env)
   351	    end
   352	  end
   353	
   354	  defp candidate_mutation(receipt, base, env) do
   355	    expected = base["candidate_id"]
   356	
   357	    case candidate_id(env) do
   358	      {:ok, ^expected} ->
   359	        nil
   360	
   361	      other ->
   362	        detail =
   363	          case other do
   364	            {:ok, id} ->
   365	              "Candidate mutated during verification (#{base["candidate_id"]} -> #{id})"
   366	
   367	            {:error, reason} ->
   368	              "Candidate identity failed during verification: #{reason}"
   369	          end
   370	
   371	        %{
   372	          "kind" => "candidate_mutation",
   373	          "target" => receipt["target"],
   374	          "log_path" => receipt["log_path"],
   375	          "log_sha256" => receipt["log_sha256"],
   376	          "output" => detail
   377	        }
   378	    end
   379	  end
   380	
   381	  defp candidate_id(env) do
   382	    case Map.get(env, :candidate_id) do
   383	      fun when is_function(fun, 0) -> fun.()
   384	      _ -> Kogen.Git.candidate_id()
   385	    end
   386	  end
   387	
   388	  @doc false
   389	  def write_failure_log(execution, sequence, name, reason) do
   390	    path = Path.join(execution.log_root, "cycle-#{sequence}-#{name}.log")
   391	    bytes = reason <> "\n"
   392	    _ = exclusive_write(path, bytes)
   393	
   394	    %{
   395	      "log_path" => relative(path, execution.context["project_root"]),
   396	      "log_sha256" => sha256(bytes),
   397	      "output" => tail(bytes)
   398	    }
   399	  end
   400	
   401	  # Writes the receipts, state and history, then the local Verification
   402	  # Record in its established line format.
   403	  defp persist(execution, state, session_id, candidate_id, cycle) do
   404	    bytes = Jason.encode!(state) <> "\n"
   405	
   406	    with :ok <- write_receipts(execution, cycle),
   407	         :ok <- atomic_write(execution.state_path, bytes),
   408	         :ok <- File.write(execution.history_path, bytes, [:append]),
   409	         :ok <- local_record(execution, session_id, candidate_id, cycle) do
   410	      {:ok,
   411	       %{
   412	         execution
   413	         | state: state,
   414	           state_bytes: bytes,
   415	           history_bytes: execution.history_bytes <> bytes
   416	       }, state}
   417	    else
   418	      {:error, reason} ->
   419	        {:error, "could not persist controller verification: #{inspect(reason)}"}
   420	    end
   421	  end
   422	
   423	  defp write_receipts(execution, cycle) do
   424	    Enum.reduce_while(cycle["receipts"], :ok, fn receipt, :ok ->
   425	      path = receipt_path(execution, cycle["sequence"], receipt["target"])
   426	
   427	      case exclusive_write(path, Jason.encode!(receipt) <> "\n") do
   428	        :ok -> {:cont, :ok}
   429	        error -> {:halt, error}
   430	      end
   431	    end)
   432	  end
   433	
   434	  @doc "The retained receipt file of `target` in cycle `sequence`."
   435	  def receipt_path(execution, sequence, target),
   436	    do: Path.join(execution.receipt_root, "cycle-#{sequence}-#{target}.json")
   437	
   438	  defp local_record(execution, session_id, candidate_id, cycle) do
   439	    failure = cycle["failure"]
   440	
   441	    reason =
   442	      if failure,
   443	        do:
   444	          "controller verification cycle #{cycle["sequence"]} failed at #{failure["target"]} (log #{failure["log_path"]}):\n" <>
   445	            String.slice(failure["output"] || "", -2_000, 2_000),
   446	        else: "controller verification cycle #{cycle["sequence"]} passed"
   447	
   448	    Kogen.Check.write_record(
   449	      %{
   450	        "candidate" => candidate_id,
   451	        "status" => cycle["status"],
   452	        "target" => "check",
   453	        "exit_code" => failed_exit(cycle),
   454	        "session_id" => session_id,
   455	        "attempt_token" => execution.context["attempt_token"],
   456	        # The record describes the cycle's last target run, so it carries that
   457	        # receipt's own finished_at: one clock for receipts and history.
   458	        "finished_at" => record_finished_at(cycle),
   459	        "reason" => reason
   460	      },
   461	      execution.context["project_root"]
   462	    )
   463	  end
   464	
   465	  defp failed_exit(%{"status" => "passed"}), do: 0
   466	
   467	  defp failed_exit(cycle) do
   468	    case Enum.find(cycle["receipts"], &(&1["status"] == "failed")) do
   469	      %{"exit_code" => code} when is_integer(code) and code != 0 -> code
   470	      _ -> 1
   471	    end
   472	  end
   473	
   474	  @doc """
   475	  Settles the attempt's verification for `session_id` and `candidate_id`.
   476	  The in-memory state is authoritative; the controller's files must still
   477	  hold exactly its bytes, and every cycle and receipt must be bound and
   478	  consistent. Returns the settled state.
   479	  """
   480	  def settle(execution, session_id, candidate_id) do
   481	    VerificationPlan.trace("Kogen.Build.Verification.settle")
   482	    state = execution.state
   483	
   484	    with :ok <- files_unchanged(execution),
   485	         :ok <- validate_state(state, execution),
   486	         true <- state["developer_session_id"] == session_id,
   487	         true <- state["terminal_state"] in ["passed", "exhausted"],
   488	         true <- List.last(state["cycles"])["candidate_id"] == candidate_id do
   489	      {:ok, execution, state}
   490	    else
   491	      false -> {:error, "controller verification settlement has stale or contradictory binding"}
   492	      {:error, _reason} = error -> error
   493	    end
   494	  end
   495	
   496	  def unchanged?(%{state_bytes: bytes} = execution) when is_binary(bytes),
   497	    do: files_unchanged(execution) == :ok and logs_unchanged(execution.state, execution) == :ok
   498	
   499	  def unchanged?(_), do: false
   500	
   501	  defp files_unchanged(execution) do
   502	    cond do
   503	      File.read(execution.context_path) != {:ok, execution.context_bytes} ->
   504	        {:error, "controller verification context changed on disk"}
   505	
   506	      File.read(execution.state_path) != {:ok, execution.state_bytes} ->
   507	        {:error, "controller verification state changed on disk"}
   508	
   509	      File.read(execution.history_path) != {:ok, execution.history_bytes} ->
   510	        {:error, "controller verification chronology is incomplete or rolled back"}
   511	
   512	      true ->
   513	        :ok
   514	    end
   515	  end
   516	
   517	  def final_receipts(%{"cycles" => cycles}), do: List.last(cycles)["receipts"]
   518	
   519	  @doc """
   520	  Validates a controller state against its execution: every cycle's
   520	  Validates a controller state against its execution: every cycle's
   521	  sequence, attempt, session and failure counters, and every receipt's
   522	  binding (Candidate id, attempt token, context and catalog digests, cycle),
   523	  its status (exit code, time limit and cleanup only), its log digest, and
   524	  for a reused receipt the earlier passed receipt it names.
   525	  """
   526	  def validate_state(state, execution) do
   527	    context = execution.context
   528	
   529	    with true <- is_map(state) and state["schema_version"] == @version,
   530	         true <- state["context_sha256"] == execution.context_sha256,
   531	         true <- state["attempt_token"] == context["attempt_token"],
   532	         true <- state["outer_attempt"] == context["outer_attempt"],
   533	         cycles when is_list(cycles) and cycles != [] <- state["cycles"],
   534	         :ok <- validate_cycles(cycles, execution),
   535	         :ok <- validate_terminal(state, context),
   536	         :ok <- logs_unchanged(state, execution) do
   537	      :ok
   538	    else
   539	      {:error, _reason} = error -> error
   540	      _ -> {:error, "controller verification settlement has stale or contradictory binding"}
   541	    end
   542	  end
   543	
   544	  defp validate_cycles(cycles, execution) do
   545	    cycles
   546	    |> Enum.with_index(1)
   547	    |> Enum.reduce_while({:ok, 0}, fn {cycle, sequence}, {:ok, failures} ->
   548	      after_count = if cycle["status"] == "passed", do: 0, else: failures + 1
   549	
   550	      if valid_cycle?(cycle, sequence, failures, after_count, execution) and
   551	           Enum.all?(cycle["receipts"], &valid_receipt?(&1, cycle, cycles, execution)),
   552	         do: {:cont, {:ok, after_count}},
   553	         else:
   554	           {:halt,
   555	            {:error, "controller verification cycle #{sequence} is incomplete or contradictory"}}
   556	    end)
   557	    |> case do
   558	      {:ok, _} -> :ok
   559	      error -> error
   560	    end
   561	  end
   562	
   563	  # credo:disable-for-next-line Credo.Check.Refactor.CyclomaticComplexity
   564	  defp valid_cycle?(cycle, sequence, failures, after_count, execution) do
   565	    context = execution.context
   566	    receipts = cycle["receipts"]
   567	    failure = cycle["failure"]
   568	    passed = cycle["status"] == "passed"
   569	
   570	    is_map(cycle) and cycle["sequence"] == sequence and
   571	      cycle["attempt_token"] == context["attempt_token"] and
   572	      cycle["outer_attempt"] == context["outer_attempt"] and
   573	      cycle["context_sha256"] == execution.context_sha256 and
   574	      is_binary(cycle["candidate_id"]) and cycle["candidate_id"] != "" and
   575	      cycle["failures_before"] == failures and cycle["failures_after"] == after_count and
   576	      cycle["status"] in ["passed", "failed"] and is_list(receipts) and
   577	      ((passed and is_nil(failure) and receipts != [] and
   578	          Enum.all?(receipts, &(&1["status"] == "passed"))) or
   579	         (not passed and is_map(failure)))
   580	  end
   581	
   582	  # credo:disable-for-next-line Credo.Check.Refactor.CyclomaticComplexity
   583	  defp valid_receipt?(receipt, cycle, cycles, execution) do
   584	    is_map(receipt) and receipt["status"] in ["passed", "failed"] and
   585	      is_integer(receipt["exit_code"]) and
   586	      receipt["status"] ==
   587	        VerificationRunner.status(%{
   588	          "exit_code" => receipt["exit_code"],
   589	          "timed_out" => receipt["timed_out"],
   590	          "cleanup" => receipt["cleanup"]
   591	        }) and
   592	      receipt["candidate_id"] == cycle["candidate_id"] and
   593	      receipt["attempt_token"] == cycle["attempt_token"] and
   594	      receipt["context_sha256"] == execution.context_sha256 and
   595	      receipt["catalog_sha256"] == cycle["catalog_sha256"] and
   596	      receipt["cycle_sequence"] == cycle["sequence"] and
   597	      valid_timestamp?(receipt["finished_at"]) and is_binary(receipt["log_path"]) and
   598	      is_binary(receipt["log_sha256"]) and Regex.match?(@digest, receipt["log_sha256"]) and
   599	      valid_evidence?(receipt) and valid_reuse?(receipt, cycle, cycles)
   600	  end
   601	
   602	  defp valid_evidence?(%{"target_evidence" => evidence} = receipt),
   603	    do:
   604	      evidence["attempt_token"] == receipt["attempt_token"] and
   605	        evidence["target"] == receipt["target"] and TargetEvidence.verify(evidence) == :ok
   606	
   607	  defp valid_evidence?(_receipt), do: true
   608	
   609	  # One conjunction binds a reused receipt to the earlier passed run it names,
   610	  # so no partial validator can accept a forged or stale reuse.
   611	  # credo:disable-for-next-line Credo.Check.Refactor.CyclomaticComplexity
   612	  defp valid_reuse?(%{"reused_from" => origin} = receipt, cycle, cycles) do
   613	    source_cycle = is_map(origin) && Enum.at(cycles, origin["cycle_sequence"] - 1)
   614	
   615	    source =
   616	      source_cycle &&
   617	        Enum.find(source_cycle["receipts"] || [], &(&1["target"] == receipt["target"]))
   618	
   619	    is_map(source) and is_integer(origin["cycle_sequence"]) and
   620	      origin["cycle_sequence"] < cycle["sequence"] and receipt["provider_backed"] == true and
   621	      source["status"] == "passed" and is_nil(source["reused_from"]) and
   622	      is_nil(source["target_evidence_error"]) and
   623	      source["cycle_sequence"] == origin["cycle_sequence"] and
   624	      source["candidate_id"] == receipt["candidate_id"] and
   625	      source["catalog_sha256"] == receipt["catalog_sha256"] and
   626	      source["context_sha256"] == receipt["context_sha256"] and
   627	      source["log_sha256"] == receipt["log_sha256"] and
   628	      origin["log_sha256"] == receipt["log_sha256"]
   629	  rescue
   630	    _ -> false
   631	  end
   632	
   633	  defp valid_reuse?(_receipt, _cycle, _cycles), do: true
   634	
   635	  defp logs_unchanged(state, execution) do
   636	    root = execution.context["project_root"]
   637	
   638	    state["cycles"]
   639	    |> Enum.flat_map(&((&1["receipts"] || []) ++ List.wrap(&1["proofs"])))
   640	    |> Enum.reject(&Map.has_key?(&1, "reused_from"))
   641	    |> Enum.reduce_while(:ok, fn receipt, :ok ->
   642	      case log_unchanged(receipt, root) do
   643	        :ok -> {:cont, :ok}
   644	        error -> {:halt, error}
   645	      end
   646	    end)
   647	  end
   648	
   649	  defp log_unchanged(receipt, root) do
   650	    case File.read(Path.expand(receipt["log_path"], root)) do
   651	      {:ok, bytes} ->
   652	        if sha256(bytes) == receipt["log_sha256"],
   653	          do: :ok,
   654	          else: {:error, "controller verification log digest changed: #{receipt["log_path"]}"}
   655	
   656	      _ ->
   657	        {:error, "controller verification log is missing: #{receipt["log_path"]}"}
   658	    end
   659	  end
   660	
   661	  defp validate_terminal(state, context) do
   662	    last = List.last(state["cycles"])
   663	
   664	    if valid_terminal?(state["terminal_state"], last, state, context["verification_retries"]),
   665	      do: :ok,
   666	      else: {:error, "controller verification terminal counter is inconsistent"}
   667	  end
   668	
   669	  defp valid_terminal?("passed", last, state, _retries),
   670	    do: last["status"] == "passed" and state["failures_since_pass"] == 0
   671	
   672	  defp valid_terminal?("exhausted", last, state, retries),
   673	    do:
   674	      last["status"] == "failed" and last["failures_after"] == retries + 1 and
   675	        state["failures_since_pass"] == last["failures_after"]
   676	
   677	  defp valid_terminal?("pending", last, state, retries),
   678	    do:
   679	      last["status"] == "failed" and last["failures_after"] <= retries and
   680	        state["failures_since_pass"] == last["failures_after"]
   681	
   682	  defp valid_terminal?(_terminal, _last, _state, _retries), do: false
   683	
   684	  defp valid_timestamp?(value) when is_binary(value),
   685	    do: match?({:ok, _datetime, 0}, DateTime.from_iso8601(value))
   686	
   687	  defp valid_timestamp?(_value), do: false
   688	
   689	  defp project_root(tracking_path) do
   690	    expanded = Path.expand(tracking_path)
   691	    marker = Path.join([".kogen", "runtime", "scenario-tracking"])
   692	
   693	    case String.split(expanded, marker, parts: 2) do
   694	      [prefix, _suffix] when prefix != "" -> String.trim_trailing(prefix, "/")
   695	      _ -> File.cwd!() |> Path.expand()
   696	    end
   697	  end
   698	
   699	  defp relative(path, root), do: Path.relative_to(Path.expand(path), Path.expand(root))
   700	
   701	  defp tail(bytes) when byte_size(bytes) <= @output_tail, do: valid_utf8(bytes)
   702	
   703	  defp tail(bytes),
   704	    do: valid_utf8(binary_part(bytes, byte_size(bytes) - @output_tail, @output_tail))
   705	
   706	  defp valid_utf8(bytes) do
   707	    if String.valid?(bytes), do: bytes, else: String.replace_invalid(bytes)
   708	  end
   709	
   710	  defp now do
   711	    DateTime.utc_now() |> DateTime.truncate(:millisecond) |> DateTime.to_iso8601()
   712	  end
