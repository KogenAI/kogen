     1	defmodule Kogen.VerificationPolicy do
     2	  @moduledoc """
     3	  The Build-side half of the Developer verification guard.
     4	
     5	  The PreToolUse hook performs command classification before Codex dispatches a
     6	  Bash request. This module derives the immutable policy passed to that hook
     7	  and proves the tracked hook is installed before a Developer is launched.
     8	
     9	  No target name is special: the guard blocks `make <goal>` for every selected
    10	  catalog target, whatever it is named, never a hardcoded `check`/`live` pair.
    11	  Preflight requires only this Build's own PreToolUse guard files and
    12	  registration — never the bootstrap Stop script (`.codex/hooks/check.sh`),
    13	  which a follow-up Intent deletes once the Build controller owns every
    14	  verification gate.
    15	  """
    16	  use Boundary, deps: [Kogen.Check]
    17	
    18	  @hooks_path ".codex/hooks.json"
    19	  @script_path ".codex/hooks/verification_policy.py"
    20	  @hook_command "python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/verification_policy.py\""
    21	
    22	  @spec normalized_targets([String.t()]) :: [String.t()]
    23	  def normalized_targets(targets), do: Enum.uniq(targets)
    24	
    25	  @spec environment([String.t()], Path.t()) :: [{String.t(), String.t()}]
    26	  def environment(targets, root \\ File.cwd!()) do
    27	    [
    28	      {"KOGEN_VERIFICATION_TARGETS", Jason.encode!(normalized_targets(targets))},
    29	      {"KOGEN_PROJECT_ROOT", root}
    30	    ]
    31	  end
    32	
    33	  @spec preflight([String.t()], Path.t()) :: :ok | {:error, String.t()}
    34	  def preflight(targets, root \\ ".")
    35	
    36	  def preflight(targets, root) when is_list(targets) do
    37	    normalized = normalized_targets(targets)
    38	
    39	    with true <- normalized != [] and Enum.all?(normalized, &Kogen.Check.valid_target_name?/1),
    40	         :ok <- required_file(@script_path, root),
    41	         :ok <- registered_hook(root) do
    42	      :ok
    43	    else
    44	      false -> {:error, "verification policy has an invalid target name"}
    45	      {:error, _reason} = error -> error
    46	    end
    47	  end
    48	
    49	  def preflight(_, _root), do: {:error, "verification policy targets are missing or invalid"}
    50	
    51	  @spec developer_instruction([String.t()]) :: String.t()
    52	  def developer_instruction(targets) do
    53	    names = Enum.map_join(normalized_targets(targets), ", ", &"`make #{&1}`")
    54	
    55	    "Kogen's Build controller owns verification gates. Do not run #{names}, the bootstrap " <>
    56	      "Stop script `.codex/hooks/check.sh`, or any indirect equivalent — including for early " <>
    57	      "signal or through delegated helpers. Focused non-gate tests remain allowed."
    58	  end
    59	
    60	  defp required_file(path, root) do
    61	    if File.regular?(Path.join(root, path)),
    62	      do: :ok,
    63	      else: {:error, "required verification policy file is missing: #{path}"}
    64	  end
    65	
    66	  defp registered_hook(root) do
    67	    with {:ok, contents} <- File.read(Path.join(root, @hooks_path)),
    68	         {:ok, json} <- Jason.decode(contents),
    69	         true <- pretooluse_registration?(json) do
    70	      :ok
    71	    else
    72	      _ -> {:error, "required Developer Bash verification-policy hook is not registered"}
    73	    end
    74	  end
    75	
    76	  defp pretooluse_registration?(%{"hooks" => %{"PreToolUse" => entries}}) when is_list(entries) do
    77	    Enum.any?(entries, fn
    78	      %{"matcher" => "Bash", "hooks" => hooks} when is_list(hooks) ->
    79	        Enum.any?(hooks, fn
    80	          %{"type" => "command", "command" => @hook_command} ->
    81	            true
    82	
    83	          _ ->
    84	            false
    85	        end)
    86	
    87	      _ ->
    88	        false
    89	    end)
    90	  end
    91	
    92	  defp pretooluse_registration?(_), do: false
    93	end
