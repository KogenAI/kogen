     6	  computes the ledger from Git (Candidate tree against the admission commit)
     7	  before Review. Every changed, deleted or renamed path matching the test or
     8	  runner globs is an item, including paths outside every scenario's
     9	  `affected_paths`; an added test-class file is left out and an added
    10	  runner-class file is included. An edited `proof.base: pass` selector is an
    11	  item too. Each item's full diff is a controller-retained file under the
    12	  attempt's verification directory, bound by sha256; only its index entry
    13	  travels in the handoff report and the review packet, never to Jev. The
    14	  ledger also names the receipts that ran with changed runner-class files and
    15	  the catalog digest change.
    16	
    17	  The base-suite report runs base's test files and runner in a scratch copy
    18	  of the base workspace with only the Candidate's implementation files
    19	  overlaid. It is a report for Review, not a gate.
    20	  """
    21	
    22	  alias Kogen.Build.{BaseWorkspace, ProofSelectors, VerificationPlan, VerificationRunner}
    23	
    24	  @doc """
    25	  Computes the ledger, or `{:ok, nil}` without integrity fields. `input`
    26	  holds `:root`, `:base_commit`, `:candidate_id`, `:integrity`,
    27	  `:admission_sha256`, `:candidate_sha256`, `:receipts`, `:directory` and
    28	  `:preservation` (edited preservation selector paths).
    29	  """
    30	  def compute(%{integrity: nil}), do: {:ok, nil}
    31	
    32	  def compute(input) do
    33	    surface = input.integrity["verification_surface"]
    34	
    35	    with {:ok, changes} <-
    36	           Kogen.Git.tree_changes(input.base_commit, input.candidate_id, input.root),
    37	         :ok <- File.mkdir_p(Path.join(input.directory, "ledger")) do
    38	      surface_changes =
    39	        Enum.filter(changes, fn change ->
    40	          paths = Enum.reject([change["path"], change["old_path"]], &is_nil/1)
    41	          runner? = Enum.any?(paths, &ProofSelectors.runner_class?(&1, surface))
    42	          test? = Enum.any?(paths, &ProofSelectors.test_class?(&1, surface))
    43	
    44	          runner? or (test? and change["status"] != "added") or
    45	            change["path"] in input.preservation
    46	        end)
    47	
    48	      items =
    49	        surface_changes
    50	        |> Enum.with_index(1)
    51	        |> Enum.map(fn {change, index} -> item(input, surface, change, index) end)
    52	
    53	      case Enum.find(items, &match?({:error, _}, &1)) do
    54	        nil -> {:ok, ledger(input, Enum.map(items, &elem(&1, 1)))}
    55	        error -> error
    56	      end
    57	    end
    58	  end
    59	
    60	  defp item(input, surface, change, index) do
    61	    paths = Enum.reject([change["old_path"], change["path"]], &is_nil/1)
    62	    name = "#{String.pad_leading(Integer.to_string(index), 4, "0")}.diff"
    63	    diff_path = Path.join([input.directory, "ledger", name])
    64	
    65	    with {:ok, diff} <-
    66	           Kogen.Git.path_diff(input.base_commit, input.candidate_id, paths, input.root),
    67	         :ok <- exclusive_write(diff_path, diff) do
    68	      {:ok,
    69	       %{
    70	         "path" => change["path"],
    71	         "status" => change["status"],
    72	         "old_path" => change["old_path"],
    73	         "runner_class" => Enum.any?(paths, &ProofSelectors.runner_class?(&1, surface)),
    74	         "preservation_selector" => change["path"] in input.preservation,
    75	         "base_blob" => change["base_blob"],
    76	         "candidate_blob" => change["candidate_blob"],
    77	         "diff_stat" => %{"added" => change["added"], "deleted" => change["deleted"]},
    78	         "diff" => %{
    79	           "path" => Path.relative_to(Path.expand(diff_path), Path.expand(input.root)),
    80	           "sha256" => sha256(diff),
    81	           "byte_count" => byte_size(diff)
    82	         }
    83	       }}
    84	    end
    85	  end
    86	
    87	  defp ledger(input, items) do
    88	    runner_changed? = Enum.any?(items, & &1["runner_class"])
    89	
    90	    %{
    91	      "schema_version" => 1,
    92	      "base_commit" => input.base_commit,
    93	      "candidate_id" => input.candidate_id,
    94	      "items" => items,
    95	      "receipts_with_changed_runner" =>
    96	        if(runner_changed?,
    97	          do:
    98	            Enum.map(
    99	              input.receipts,
   100	              &%{"target" => &1["target"], "cycle_sequence" => &1["cycle_sequence"]}
   101	            ),
   102	          else: []
   103	        ),
   104	      "catalog" => %{
   105	        "admission_sha256" => input.admission_sha256,
   106	        "candidate_sha256" => input.candidate_sha256,
   107	        "changed" => input.admission_sha256 != input.candidate_sha256
   108	      }
   109	    }
   110	  end
   111	
   112	  @doc "Confirms every retained ledger diff still has its bound bytes."
   113	  def verify(nil, _root), do: :ok
   114	
   115	  def verify(ledger, root) do
   116	    Enum.reduce_while(ledger["items"], :ok, fn item, :ok ->
   117	      case diff_unchanged(item["diff"], root) do
   118	        :ok -> {:cont, :ok}
   119	        error -> {:halt, error}
   120	      end
   121	    end)
   122	  end
   123	
   124	  defp diff_unchanged(diff, root) do
   125	    case File.read(Path.expand(diff["path"], root)) do
   126	      {:ok, bytes} ->
   127	        if sha256(bytes) == diff["sha256"],
   128	          do: :ok,
   129	          else: {:error, "ledger diff mutated: #{diff["path"]}"}
   130	
   131	      _ ->
   132	        {:error, "ledger diff missing: #{diff["path"]}"}
   133	    end
   134	  end
   135	
   136	  @doc "The ledger paths the Reviewer must disposition."
   137	  def paths(nil), do: []
   138	  def paths(ledger), do: Enum.map(ledger["items"], & &1["path"])
   139	
   140	  @doc """
   141	  Runs base's test suite (the base files matching the test globs, with base's
   142	  runner) against the Candidate's implementation files in a scratch copy of
   143	  the base workspace. Returns `{report, workspace}`; the report is never a
   144	  gate.
   145	  """
   146	  def base_suite(%{integrity: nil}), do: {nil, nil}
   147	
   148	  def base_suite(input) do
   149	    integrity = input.integrity
   150	    surface = integrity["verification_surface"]
   151	
   152	    with {:ok, changes} <-
   153	           Kogen.Git.tree_changes(input.base_commit, input.candidate_id, input.root),
   154	         {:ok, files} <- Kogen.Git.tree_files(input.base_commit, input.root),
   155	         {:ok, workspace, _rebuilt?} <- BaseWorkspace.ensure(input.workspace) do
   156	      tests = Enum.filter(files, &ProofSelectors.test_class?(&1, surface))
   157	      overlays = implementation_overlays(changes, surface, input)
   158	      {run_suite(input, workspace, tests, overlays), workspace}
   159	    else
   160	      {:error, reason} -> {error_report(input, reason), input.workspace}
   161	    end
   162	  end
   163	
   164	  # Only the Candidate's implementation (non-surface) files are overlaid.
   165	  defp implementation_overlays(changes, surface, input) do
   166	    changes
   167	    |> Enum.reject(fn change ->
   168	      [change["path"], change["old_path"]]
   169	      |> Enum.reject(&is_nil/1)
   170	      |> Enum.any?(
   171	        &(ProofSelectors.test_class?(&1, surface) or ProofSelectors.runner_class?(&1, surface))
   172	      )
   173	    end)
   174	    |> Enum.flat_map(fn change ->
   175	      removed = if change["old_path"], do: [{change["old_path"], :delete}], else: []
   176	      removed ++ [implementation_overlay(change["path"], input)]
   177	    end)
   178	  end
   179	
   180	  defp implementation_overlay(path, input) do
   181	    case Kogen.Git.blob(input.candidate_id, path, input.root) do
   182	      {:ok, bytes} -> {path, bytes}
   183	      :absent -> {path, :delete}
   184	    end
   185	  end
   186	
   187	  defp run_suite(input, _workspace, [], _overlays),
   188	    do: %{
   189	      "status" => "skipped",
   190	      "reason" => "base has no test-class files",
   191	      "base_commit" => input.base_commit,
   192	      "use" => "report for Review, not a gate"
   193	    }
   194	
   195	  defp run_suite(input, workspace, tests, overlays) do
   196	    argv =
   197	      Enum.flat_map(
   198	        input.integrity["focused_runner"],
   199	        &if(&1 == "{paths}", do: tests, else: [&1])
   200	      )
   201	
   202	    log = Path.join(input.directory, "base-suite.log")
   203	    timeout = Application.get_env(:kogen, :focused_runner_timeout_ms, 1_800_000)
   204	
   205	    case BaseWorkspace.scratch(workspace, overlays) do
   206	      {:ok, dir} ->
   207	        try do
   208	          case VerificationRunner.run(argv, dir, log,
   209	                 timeout_ms: timeout,
   210	                 env: BaseWorkspace.run_environment(dir)
   211	               ) do
   212	            {:ok, facts} ->
   213	              %{
   214	                "status" => VerificationRunner.status(facts),
   215	                "exit_code" => facts["exit_code"],
   216	                "timed_out" => facts["timed_out"],
   217	                "base_commit" => input.base_commit,
   218	                "candidate_id" => input.candidate_id,
   219	                "overlay_sha256" => BaseWorkspace.overlay_digest(overlays),
   220	                "log_path" => Path.relative_to(facts["log_path"], Path.expand(input.root)),
   221	                "log_sha256" => facts["log_sha256"],
   222	                "use" => "report for Review, not a gate"
   223	              }
   224	
   225	            {:error, reason} ->
   226	              error_report(input, reason)
   227	          end
   228	        after
   229	          File.rm_rf(dir)
   230	        end
   231	
   232	      {:error, reason} ->
   233	        error_report(input, reason)
   234	    end
   235	  end
   236	
   237	  defp error_report(input, reason),
   238	    do: %{
   239	      "status" => "error",
   240	      "reason" => reason,
   241	      "base_commit" => input.base_commit,
   242	      "use" => "report for Review, not a gate"
   243	    }
   244	
   245	  @doc "Whether `path` lies in the admission verification surface."
   246	  def surface?(path, integrity) do
   247	    surface = integrity["verification_surface"]
   248	
   249	    Enum.any?(surface["tests"] ++ surface["runner"], &VerificationPlan.path_matches?(path, &1))
   250	  end
   251	
   252	  defp exclusive_write(path, bytes) do
   253	    case File.open(path, [:write, :exclusive, :binary]) do
   254	      {:ok, io} ->
   255	        result = IO.binwrite(io, bytes)
   256	        File.close(io)
   257	        result
   258	
   259	      {:error, reason} ->
   260	        {:error, "could not retain ledger diff #{path}: #{inspect(reason)}"}
   261	    end
   262	  end
   263	
   264	  defp sha256(bytes), do: Base.encode16(:crypto.hash(:sha256, bytes), case: :lower)
   265	end
     1	defmodule Kogen.Build.ProofSelectors do
     2	  @moduledoc """
     3	  Controller-run scenario proof selectors, used when the admission catalog
     4	  declares the integrity fields.
     5	
     6	  After a cycle's targets pass, the controller runs each scenario's file
     7	  selectors on the Candidate with the admission `focused_runner`; they must
     8	  pass. For `proof.base: fail` it also runs them in a scratch copy of the
     9	  admission base workspace, overlaying only the Candidate's bytes of that
    10	  scenario's selector files and of changed test-class files (never
    11	  runner-class or implementation files). There the run must exit nonzero:
    12	  exit zero means the proof cannot detect the change, and a timeout or
    13	  infrastructure error is an error, never a red result. A red receipt is
    14	  reused while the overlay and base workspace digests are unchanged. For
    15	  `proof.base: pass`, a selector differing from base must still pass with
    16	  base's bytes on the Candidate. Contracts without `proof.base` get only the
    17	  Candidate run and the `unproven-on-base` label.
    18	  """
    19	
    20	  alias Kogen.Build.{BaseWorkspace, Verification, VerificationPlan, VerificationRunner}
    21	
    22	  @load_error ~r/CompileError|SyntaxError|TokenMissingError|MismatchedDelimiterError|== Compilation error|could not compile|\(module [^)]+ is not available\)/
    23	
    24	  @doc """
    25	  Runs the proof selectors of every planned scenario. Returns
    26	  `{proofs, failure_or_nil, execution}`; the execution carries the (possibly
    27	  rebuilt) base workspace.
    28	  """
    29	  def run(execution, base, env) do
    30	    integrity = env.catalog.integrity
    31	    workspace = execution.workspace || Map.get(env, :workspace)
    32	    state = %{execution: %{execution | workspace: workspace}, proofs: [], failure: nil}
    33	
    34	    env.plan.scenarios
    35	    |> Enum.reject(&(&1["file_selectors"] == []))
    36	    |> Enum.reduce_while(state, fn scenario, acc ->
    37	      acc = run_scenario(acc, scenario, base, env, integrity)
    38	      if acc.failure, do: {:halt, acc}, else: {:cont, acc}
    39	    end)
    40	    |> then(&{&1.proofs, &1.failure, &1.execution})
    41	  end
    42	
    43	  defp run_scenario(acc, scenario, base, env, integrity) do
    44	    selectors = scenario["file_selectors"]
    45	
    46	    receipt =
    47	      focused(acc.execution, base, env, integrity, env.root, selectors, [], %{
    48	        "scenario" => scenario["id"],
    49	        "kind" => "candidate",
    50	        "label" => scenario["label"]
    51	      })
    52	
    53	    acc = add(acc, receipt)
    54	
    55	    cond do
    56	      receipt["status"] != "passed" ->
    57	        fail(acc, receipt, "scenario #{scenario["id"]} proof selectors fail on the Candidate")
    58	
    59	      scenario["base"] == "fail" ->
    60	        red_on_base(acc, scenario, base, env, integrity)
    61	
    62	      scenario["base"] == "pass" ->
    63	        preservation(acc, scenario, base, env, integrity)
    64	
    65	      true ->
    66	        acc
    67	    end
    68	  end
    69	
    70	  defp red_on_base(acc, scenario, base, env, integrity) do
    71	    with {:ok, overlays} <- red_overlays(scenario, base, env, integrity),
    72	         {:ok, workspace, rebuilt?} <- BaseWorkspace.ensure(acc.execution.workspace) do
    73	      acc = %{acc | execution: %{acc.execution | workspace: workspace}}
    74	      overlay_sha = BaseWorkspace.overlay_digest(overlays)
    75	
    76	      case prior_red(acc.execution.state["cycles"], scenario["id"], overlay_sha, workspace) do
    77	        {:ok, reused} ->
    78	          add(acc, Map.merge(reused, %{"cycle_sequence" => base["sequence"]}))
    79	
    80	        :none ->
    81	          meta = %{
    82	            "scenario" => scenario["id"],
    83	            "kind" => "base_red",
    84	            "label" => scenario["label"],
    85	            "base_commit" => env.base_commit,
    86	            "overlay_sha256" => overlay_sha,
    87	            "workspace_sha256" => workspace.digest,
    88	            "workspace_rebuilt" => rebuilt?
    89	          }
    90	
    91	          run_red(acc, workspace, overlays, scenario, base, env, integrity, meta)
    92	      end
    93	    else
    94	      {:error, reason} ->
    95	        error(acc, base, scenario, "base workspace unavailable: #{reason}")
    96	    end
    97	  end
    98	
    99	  # credo:disable-for-next-line Credo.Check.Refactor.FunctionArity
   100	  defp run_red(acc, workspace, overlays, scenario, base, env, integrity, meta) do
   101	    case BaseWorkspace.scratch(workspace, overlays) do
   102	      {:ok, dir} ->
   103	        try do
   104	          receipt =
   105	            focused(
   106	              acc.execution,
   107	              base,
   108	              env,
   109	              integrity,
   110	              dir,
   111	              scenario["file_selectors"],
   112	              BaseWorkspace.run_environment(dir),
   113	              meta
   114	            )
   115	
   116	          classify_red(acc, receipt, scenario)
   117	        after
   118	          File.rm_rf(dir)
   119	        end
   120	
   121	      {:error, reason} ->
   122	        error(acc, base, scenario, reason)
   123	    end
   124	  end
   125	
   126	  defp classify_red(acc, receipt, scenario) do
   127	    cond do
   128	      receipt["timed_out"] or receipt["spawn_error"] ->
   129	        receipt = Map.merge(receipt, %{"status" => "error", "red" => false})
   130	
   131	        acc
   132	        |> add(receipt)
   133	        |> fail(
   134	          receipt,
   135	          "scenario #{scenario["id"]} red-on-base run did not complete (timeout or infrastructure error; not a red result)"
   136	        )
   137	
   138	      receipt["exit_code"] == 0 ->
   139	        receipt = Map.merge(receipt, %{"status" => "failed", "red" => false})
   140	
   141	        acc
   142	        |> add(receipt)
   143	        |> fail(
   144	          receipt,
   145	          "scenario #{scenario["id"]}: proof cannot detect the change (its selectors pass on the admission base)"
   146	        )
   147	
   148	      true ->
   149	        output = receipt["output"] || ""
   150	        red_kind = if Regex.match?(@load_error, output), do: "load", else: "assertion"
   151	
   152	        add(
   153	          acc,
   154	          Map.merge(receipt, %{"status" => "passed", "red" => true, "red_kind" => red_kind})
   155	        )
   156	    end
   157	  end
   158	
   159	  defp prior_red(cycles, scenario_id, overlay_sha, workspace) do
   160	    cycles
   161	    |> Enum.reverse()
   162	    |> Enum.flat_map(&List.wrap(&1["proofs"]))
   163	    |> Enum.find_value(:none, fn proof ->
   164	      if proof["scenario"] == scenario_id and proof["kind"] == "base_red" and proof["red"] == true and
   165	           proof["overlay_sha256"] == overlay_sha and
   166	           proof["workspace_sha256"] == workspace.digest do
   167	        origin = proof["reused_from"] || %{"cycle_sequence" => proof["cycle_sequence"]}
   168	        {:ok, Map.put(proof, "reused_from", origin)}
   169	      end
   170	    end)
   171	  end
   172	
   173	  defp red_overlays(scenario, base, env, integrity) do
   174	    with {:ok, changes} <- Kogen.Git.tree_changes(env.base_commit, base["candidate_id"], env.root) do
   175	      selector_files =
   176	        expand_selectors(scenario["file_selectors"], base["candidate_id"], env.root)
   177	
   178	      surface = integrity["verification_surface"]
   179	
   180	      changed_tests =
   181	        for change <- changes,
   182	            test_class?(change["path"], surface),
   183	            not runner_class?(change["path"], surface),
   184	            do: change
   185	
   186	      paths =
   187	        (selector_files -- Enum.filter(selector_files, &runner_class?(&1, surface))) ++
   188	          Enum.map(changed_tests, & &1["path"])
   189	
   190	      overlays =
   191	        paths
   192	        |> Enum.uniq()
   193	        |> Enum.map(&candidate_overlay(&1, base["candidate_id"], env.root))
   194	
   195	      renamed_away =
   196	        for change <- changed_tests,
   197	            change["status"] == "renamed",
   198	            test_class?(change["old_path"], surface),
   199	            do: {change["old_path"], :delete}
   200	
   201	      {:ok, Enum.uniq(overlays ++ renamed_away)}
   202	    end
   203	  end
   204	
   205	  defp candidate_overlay(path, tree, root) do
   206	    case Kogen.Git.blob(tree, path, root) do
   207	      {:ok, bytes} -> {path, bytes}
   208	      :absent -> {path, :delete}
   209	    end
   210	  end
   211	
   212	  defp preservation(acc, scenario, base, env, integrity) do
   213	    files = expand_selectors(scenario["file_selectors"], base["candidate_id"], env.root)
   214	
   215	    changed =
   216	      Enum.filter(files, fn path ->
   217	        Kogen.Git.blob(env.base_commit, path, env.root) !=
   218	          Kogen.Git.blob(base["candidate_id"], path, env.root)
   219	      end)
   220	
   221	    base_bytes =
   222	      for path <- changed,
   223	          {:ok, bytes} <- [Kogen.Git.blob(env.base_commit, path, env.root)],
   224	          do: {path, bytes}
   225	
   226	    if base_bytes == [] do
   227	      acc
   228	    else
   229	      preservation_run(acc, scenario, base, env, integrity, base_bytes)
   230	    end
   231	  end
   232	
   233	  defp preservation_run(acc, scenario, base, env, integrity, base_bytes) do
   234	    cache = integrity["base_cache"]
   235	
   236	    with {:ok, workspace} <-
   237	           BaseWorkspace.create(env.root, base["candidate_id"], cache, "candidate"),
   238	         {:ok, dir} <- BaseWorkspace.scratch(workspace, base_bytes) do
   239	      try do
   240	        receipt =
   241	          focused(
   242	            acc.execution,
   243	            base,
   244	            env,
   245	            integrity,
   246	            dir,
   247	            Enum.map(base_bytes, &elem(&1, 0)),
   248	            BaseWorkspace.run_environment(dir),
   249	            %{
   250	              "scenario" => scenario["id"],
   251	              "kind" => "base_preservation",
   252	              "label" => scenario["label"],
   253	              "base_commit" => env.base_commit,
   254	              "overlay_sha256" => BaseWorkspace.overlay_digest(base_bytes),
   255	              "changed_selectors" => Enum.map(base_bytes, &elem(&1, 0))
   256	            }
   257	          )
   258	
   259	        acc = add(acc, receipt)
   260	
   261	        if receipt["status"] == "passed",
   262	          do: acc,
   263	          else:
   264	            fail(
   265	              acc,
   266	              receipt,
   267	              "scenario #{scenario["id"]}: base's bytes of its edited preservation selectors fail on the Candidate"
   268	            )
   269	      after
   270	        File.rm_rf(dir)
   271	        BaseWorkspace.remove(workspace)
   272	      end
   273	    else
   274	      {:error, reason} -> error(acc, base, scenario, reason)
   275	    end
   276	  end
   277	
   278	  # credo:disable-for-next-line Credo.Check.Refactor.FunctionArity
   279	  defp focused(execution, base, env, integrity, cwd, paths, run_env, meta) do
   280	    argv = Enum.flat_map(integrity["focused_runner"], &if(&1 == "{paths}", do: paths, else: [&1]))
   281	    index = System.unique_integer([:positive])
   282	    name = "cycle-#{base["sequence"]}-proof-#{meta["kind"]}-#{safe(meta["scenario"])}-#{index}"
   283	    log = Path.join(execution.log_root, name <> ".log")
   284	    timeout = Application.get_env(:kogen, :focused_runner_timeout_ms, 1_800_000)
   285	
   286	    case VerificationRunner.run(argv, cwd, log, timeout_ms: timeout, env: run_env) do
   287	      {:ok, facts} ->
   288	        meta
   289	        |> Map.merge(%{
   290	          "candidate_id" => base["candidate_id"],
