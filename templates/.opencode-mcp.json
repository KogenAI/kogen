{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "figma": {
      "type": "remote",
      "url": "http://localhost:3845/mcp",
      "enabled": true
    },
    "tidewave": {
      "type": "local",
      "command": ["mcp-proxy", "http://localhost:{{PORT}}/tidewave/mcp"],
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": ["mcp-proxy", "http://localhost:{{PLAYWRIGHT_MCP_PORT}}/mcp"],
      "enabled": true
    }
  }
}
