{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "🚀 Startup",
      "type": "shell",
      "command": "./.vscode/startup.sh",
      "group": "build",
      "runOptions": {
        "runOn": "folderOpen"
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": false,
        "close": true
      },
      "problemMatcher": [],
      "options": {
        "shell": {
          "executable": "/bin/zsh",
          "args": ["-l", "-c"]
        }
      }
    },
    {
      "label": "🤖 Claude Code",
      "type": "shell",
      "command": "echo '⏳ Waiting for Claude Code to be ready...' && while [ -f codegen/.claude_wait ]; do sleep 1; done && echo '🤖 Starting Claude Code...' && export CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR=true && claude --model sonnet <codegen/PROMPT.md",
      "group": "build",
      "runOptions": {
        "runOn": "folderOpen"
      },
      "presentation": {
        "echo": true,
        "reveal": "silent",
        "focus": false,
        "panel": "new",
        "showReuseMessage": false,
        "clear": false
      },
      "problemMatcher": [],
      "options": {
        "shell": {
          "executable": "/bin/bash",
          "args": ["-l", "-c"]
        }
      }
    },
    {
      "label": "📋 Workspace Info",
      "type": "shell",
      "command": "./.vscode/workspace-info.sh",
      "group": "build",
      "runOptions": {
        "runOn": "folderOpen"
      },
      "presentation": {
        "echo": false,
        "reveal": "silent",
        "focus": false,
        "panel": "new",
        "showReuseMessage": false,
        "clear": true
      },
      "problemMatcher": [],
      "options": {
        "shell": {
          "executable": "/bin/zsh",
          "args": ["-l", "-c"]
        }
      }
    },
    {
      "label": "📊 Server Logs",
      "type": "shell",
      "command": "touch codegen/mix_phx_server.log && tail -f codegen/mix_phx_server.log",
      "group": "build",
      "runOptions": {
        "runOn": "folderOpen"
      },
      "presentation": {
        "echo": false,
        "reveal": "silent",
        "focus": false,
        "panel": "new",
        "showReuseMessage": false,
        "clear": true
      },
      "problemMatcher": [],
      "options": {
        "shell": {
          "executable": "/bin/zsh",
          "args": ["-l", "-c"]
        }
      }
    }
  ]
}
