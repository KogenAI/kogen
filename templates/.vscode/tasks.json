{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "🚀 Startup",
      "type": "shell",
      "command": "./.vscode/startup.sh",
      "group": "build",
      "runOptions": {
        "runOn": "folderOpen"
      },
      "presentation": {
        "echo": true,
        "reveal": "always",
        "focus": true,
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": false,
        "close": true
      },
      "problemMatcher": []
    },
    {
      "label": "🤖 AI Assistant",
      "type": "shell",
      "command": "sleep 3 && ./.vscode/ai-agent.sh",
      "group": "build",
      "runOptions": {
        "runOn": "folderOpen"
      },
      "presentation": {
        "echo": true,
        "reveal": "silent",
        "focus": false,
        "panel": "new",
        "showReuseMessage": false,
        "clear": false
      },
      "problemMatcher": []
    },
    {
      "label": "📋 Workspace Info",
      "type": "shell",
      "command": "./.vscode/workspace-info.sh",
      "group": "build",
      "runOptions": {
        "runOn": "folderOpen"
      },
      "presentation": {
        "echo": false,
        "reveal": "silent",
        "focus": false,
        "panel": "new",
        "showReuseMessage": false,
        "clear": true
      },
      "problemMatcher": []
    },
    {
      "label": "📊 Server Logs",
      "type": "shell",
      "command": "touch codegen/mix_phx_server.log && tail -f codegen/mix_phx_server.log",
      "group": "build",
      "runOptions": {
        "runOn": "folderOpen"
      },
      "presentation": {
        "echo": false,
        "reveal": "silent",
        "focus": false,
        "panel": "new",
        "showReuseMessage": false,
        "clear": true
      },
      "problemMatcher": []
    }
  ]
}
