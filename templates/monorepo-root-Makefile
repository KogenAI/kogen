# Monorepo Root Makefile
# Auto-generated by OCG for monorepo structure (backend/ + mobile/)

.PHONY: ci backend-ci mobile-ci format test

# Run CI for both backend and mobile
ci: backend-ci mobile-ci
	@echo ""
	@echo "✅ All CI checks passed (backend + mobile)"

# Backend CI
backend-ci:
	@echo "📦 Running backend CI..."
	@cd backend && make ci

# Mobile CI
mobile-ci:
	@echo "📱 Running mobile CI..."
	@cd mobile && make ci

# Format both
format:
	@echo "✨ Formatting backend..."
	@cd backend && mix format
	@echo "✨ Formatting mobile..."
	@cd mobile && dart format lib/ test/

# Test both
test:
	@echo "🧪 Running backend tests..."
	@cd backend && MIX_ENV=test mix test
	@echo "🧪 Running mobile tests..."
	@cd mobile && flutter test
