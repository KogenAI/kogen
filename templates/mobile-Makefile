# Flutter Mobile CI Makefile
# Auto-generated by OCG for monorepo structure

.PHONY: ci format test analyze run run-profile run-release

ci: analyze test format-check
	@echo "✅ Mobile CI checks passed"

analyze:
	@echo "🔍 Running Flutter analyzer..."
	@flutter analyze

test:
	@echo "🧪 Running Flutter tests..."
	@flutter test

format:
	@echo "✨ Formatting Flutter code..."
	@dart format lib/ test/

format-check:
	@echo "🔍 Checking Flutter code formatting..."
	@dart format --output=none --set-exit-if-changed lib/ test/

# Development run commands (read API_URL from ../.env if it exists)
run:
	@echo "🚀 Running Flutter app in debug mode..."
	@if [ -f ../.env ]; then \
		flutter run --dart-define-from-file=../.env; \
	else \
		flutter run; \
	fi

run-profile:
	@echo "🚀 Running Flutter app in profile mode..."
	@if [ -f ../.env ]; then \
		flutter run --profile --dart-define-from-file=../.env; \
	else \
		flutter run --profile; \
	fi

run-release:
	@echo "🚀 Running Flutter app in release mode..."
	@if [ -f ../.env ]; then \
		flutter run --release --dart-define-from-file=../.env; \
	else \
		flutter run --release; \
	fi
