#!/bin/sh
# Offline Claude Code fixture: `auth status` metadata, Developer stream-json
# turns with real tracked Stop-hook invocations, and Reviewer structured output.
# FAKE_CLAUDE_REVIEW=accept|rework fixes the verdict; FAKE_CLAUDE_REVIEWER_MUTATES=1
# makes the Reviewer write a file it must never write; FAKE_CLAUDE_STOP_BLOCK=0
# skips the deliberately failing first Stop for fixtures whose Check always passes.
set -eu
script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
response_helper="$script_dir/scenario_response.py"
stream="$script_dir/claude_stream.py"
state_dir=.kogen/runtime; mkdir -p "$state_dir"
log="$state_dir/fake-harness-log"
printf 'argv:' >>"$log"; for a in "$@"; do printf ' %s' "$a" >>"$log"; done; printf '\n' >>"$log"
printf 'env: CLAUDE_CONFIG_DIR=%s DISABLE_AUTOUPDATER=%s CLAUDE_CODE_DISABLE_SUBSTITUTION_RM_PROMPT=%s ANTHROPIC_API_KEY=%s KOGEN_ROLE=%s\n' \
  "${CLAUDE_CONFIG_DIR:-}" "${DISABLE_AUTOUPDATER:-}" "${CLAUDE_CODE_DISABLE_SUBSTITUTION_RM_PROMPT:-unset}" "${ANTHROPIC_API_KEY:-unset}" "${KOGEN_ROLE:-}" >>"$log"
if [ "${1:-}" = auth ] && [ "${2:-}" = status ]; then
  if [ "${FAKE_CLAUDE_LOGGED_OUT:-0}" = 1 ]; then
    printf '{"loggedIn":false,"authMethod":"none","apiProvider":"firstParty"}\n'; exit 1
  fi
  printf '{"loggedIn":true,"authMethod":"claude.ai","apiProvider":"firstParty","email":"secret@example.invalid"}\n'; exit 0
fi
stop_check() {
 expected="$1"; active="$2"
 response="$(printf '{"session_id":"%s","stop_hook_active":%s,"hook_event_name":"Stop"}' "$sid" "$active" | sh .codex/hooks/check.sh)"
 printf '%s\n' "$response" >> "$state_dir/fake-hook-responses"
 if [ "$expected" = pass ] && printf '%s' "$response" | grep -q '"decision":"block"'; then
  stop_check pass true
  return
 fi
 case "$expected:$response" in
  block:*'"decision":"block"'*|pass:*'"continue":true'*) return 0 ;;
 esac
 printf 'Unexpected Stop response (expected %s): %s\n' "$expected" "$response" >&2
 exit 1
}
input="$(cat)"
session=; resume=; model=; previous=
for a in "$@"; do
 [ "$previous" = --session-id ] && session="$a"
 [ "$previous" = --resume ] && resume="$a"
 [ "$previous" = --model ] && model="$a"
 previous="$a"
done
if [ "${KOGEN_ROLE:-}" = reviewer ]; then
 n=0; [ -f "$state_dir/fake-reviewer-calls" ] && n="$(cat "$state_dir/fake-reviewer-calls")"; n=$((n+1)); echo "$n" >"$state_dir/fake-reviewer-calls"
 printf '%s' "$input" > "$state_dir/reviewer-prompt-$n"
 [ "${FAKE_CLAUDE_REVIEWER_MUTATES:-0}" = 1 ] && echo 'tampered by a reviewer that should never write anything' >tampered.txt
 decision="${FAKE_CLAUDE_REVIEW:-}"
 if [ -z "$decision" ]; then
  decision=accept
  approved_path="$(printf '%s' "$input" | python3 -c 'import json,sys; lines=sys.stdin.read().splitlines(); i=max(i for i,v in enumerate(lines) if v=="KOGEN_TASK_CONTEXT"); print(json.loads(lines[i+1])["approved_path"])')"
  if [ -f "$approved_path/requirement.json" ]; then
   python3 - "$approved_path/requirement.json" <<'PY' || decision=rework
import json, pathlib, sys
requirement = json.loads(pathlib.Path(sys.argv[1]).read_text())
actual = pathlib.Path(requirement["path"]).read_text().rstrip("\n")
raise SystemExit(0 if actual == requirement["expected"] else 1)
PY
  fi
 fi
 printf '%s' "$input" | python3 "$response_helper" reviewer "$decision" | python3 "$stream" reviewer "$session" "$model"
 exit 0
fi
if [ -n "$resume" ]; then
 if [ ! -f "$state_dir/fake-claude-session-$resume" ]; then
  printf 'No conversation found with session ID: %s\n' "$resume" >&2; exit 1
 fi
 sid="$resume"
 printf '%s' "$input" >> "$state_dir/developer-resume-prompts"
 case "$input" in
  *'Rework required (category: declared_target;'*) ;;
  *)
   if [ "${FAKE_CLAUDE_RESUME_EDITS:-1}" = 1 ]; then
    printf 'reviewed fixture value\n' > dummy.txt
    printf 'Reviewer-directed rework applied\n' > reviewer-rework-marker.txt
   fi
   ;;
 esac
 stop_check pass false
 printf '%s' "$input" | python3 "$response_helper" developer | python3 "$stream" developer "$sid" "$model"
 exit 0
fi
sid="$session"; : > "$state_dir/fake-claude-session-$sid"
n=0; [ -f "$state_dir/fake-dev-calls" ] && n="$(cat "$state_dir/fake-dev-calls")"; n=$((n+1)); echo "$n" >"$state_dir/fake-dev-calls"
printf '%s' "$input" > "$state_dir/developer-launch-prompt"
printf 'initial fixture value\n' > dummy.txt
if [ "${FAKE_CLAUDE_STOP_BLOCK:-1}" = 1 ]; then
 printf 'defmodule Kogen.FakeBreak do\n  this is not valid elixir(((\nend\n' > lib/kogen_fake_break.ex
 stop_check block false
 rm -f lib/kogen_fake_break.ex
 stop_check pass true
else
 stop_check pass false
fi
printf '%s' "$input" | python3 "$response_helper" developer | python3 "$stream" developer "$sid" "$model"
