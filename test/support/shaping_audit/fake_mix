#!/bin/sh
# Audit-only fake `mix`, for `stop_hook.sh` tests: logs its argv, working
# directory, PATH and skip key, then writes a scripted decision to
# KOGEN_SHAPING_HOOK_OUTPUT.
set -u

if [ -n "${KOGEN_FAKE_MIX_LOG:-}" ]; then
  {
    printf 'argv:%s\n' "$*"
    printf 'PWD:%s\n' "$(pwd -P)"
    printf 'PATH:%s\n' "$PATH"
    printf 'KOGEN_SHAPING_SKIP_KEY:%s\n' "${KOGEN_SHAPING_SKIP_KEY:-}"
  } >>"$KOGEN_FAKE_MIX_LOG"
fi

if [ -n "${KOGEN_FAKE_MIX_DECISION:-}" ]; then
  decision="$KOGEN_FAKE_MIX_DECISION"
else
  decision='{"continue":true}'
fi

if [ -n "${KOGEN_SHAPING_HOOK_OUTPUT:-}" ]; then
  printf '%s' "$decision" >"$KOGEN_SHAPING_HOOK_OUTPUT"
fi

exit 0
