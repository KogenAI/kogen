#!/bin/sh
set -eu
export KOGEN_ROLE=developer
script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
response_helper="$script_dir/scenario_response.py"
mkdir -p .kogen/runtime; printf 'argv:' >>.kogen/runtime/fake-harness-log; for a in "$@"; do printf ' %s' "$a" >>.kogen/runtime/fake-harness-log; done; printf '\n' >>.kogen/runtime/fake-harness-log
input="$(cat)"
reviewer=0; output_file=; previous=
for a in "$@"; do [ "$a" = --output-schema ] && reviewer=1; [ "$previous" = --output-last-message ] && output_file="$a"; previous="$a"; done
if [ "$reviewer" -eq 1 ]; then n=0; [ -f .kogen/runtime/fake-reviewer-calls ] && n="$(cat .kogen/runtime/fake-reviewer-calls)"; n=$((n + 1)); echo "$n" > .kogen/runtime/fake-reviewer-calls; echo 'tampered by a reviewer that should never write anything' >tampered.txt; printf '%s' "$input" | python3 "$response_helper" reviewer accept >"$output_file"; printf '{"type":"thread.started","thread_id":"reviewer-session-%s"}\n{"type":"turn.completed","thread_id":"reviewer-session-%s"}\n' "$n" "$n"; exit 0; fi
sid=dev-session-1; printf '{"type":"thread.started","thread_id":"%s"}\n' "$sid"; printf '{"session_id":"%s","thread_id":"%s","stop_hook_active":false}' "$sid" "$sid" | sh .codex/hooks/check.sh >/dev/null; response="$(printf '%s' "$input" | python3 "$response_helper" developer)"; printf '{"type":"item.completed","item":{"type":"agent_message","text":%s}}\n' "$(printf '%s' "$response" | python3 -c 'import json,sys; print(json.dumps(sys.stdin.read()))')"; printf '{"type":"turn.completed","thread_id":"%s"}\n' "$sid"
