#!/bin/sh
set -eu
script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
response_helper="$script_dir/scenario_response.py"
# Scratch state lives in the Build's harness home (inside the write
# boundary, and kept after publication removes the Candidate); outside a
# Build it falls back to the cwd's ignored .kogen/runtime.
state_dir="${KOGEN_HARNESS_HOME:+$KOGEN_HARNESS_HOME/fake-state}"; state_dir="${state_dir:-.kogen/runtime}"; mkdir -p "$state_dir"
printf 'argv:' >>"$state_dir/fake-harness-log"; for a in "$@"; do printf ' %s' "$a" >>"$state_dir/fake-harness-log"; done; printf '\n' >>"$state_dir/fake-harness-log"
input="$(cat)"
printf '%s' "$input" | python3 "$script_dir/launch_receipt.py" "$@"
reviewer=0; output_file=; previous=
[ "${KOGEN_ROLE:-}" = reviewer ] && reviewer=1
for a in "$@"; do [ "$previous" = --output-last-message ] && output_file="$a"; previous="$a"; done
if [ "$reviewer" -eq 1 ]; then n=0; [ -f "$state_dir/fake-reviewer-calls" ] && n="$(cat "$state_dir/fake-reviewer-calls")"; n=$((n + 1)); echo "$n" > "$state_dir/fake-reviewer-calls"; echo 'tampered by a reviewer that should never write anything' >tampered.txt; printf '%s' "$input" | python3 "$response_helper" reviewer accept >"$output_file"; printf '{"type":"thread.started","thread_id":"reviewer-session-%s"}\n{"type":"turn.completed","thread_id":"reviewer-session-%s"}\n' "$n" "$n"; exit 0; fi
sid=dev-session-1; printf '{"type":"thread.started","thread_id":"%s"}\n' "$sid"; printf '{"session_id":"%s","thread_id":"%s","stop_hook_active":false}' "$sid" "$sid" | sh .codex/hooks/check.sh >/dev/null; response="$(printf '%s' "$input" | python3 "$response_helper" developer)"; if [ -n "$output_file" ]; then printf '%s\n' "$response" > "$output_file"; fi; printf '{"type":"item.completed","item":{"type":"agent_message","text":%s}}\n' "$(printf '%s' "$response" | python3 -c 'import json,sys; print(json.dumps(sys.stdin.read()))')"; printf '{"type":"turn.completed","thread_id":"%s"}\n' "$sid"
