#!/usr/bin/expect -f
# Drives the real, public `mix kogen.shape` under a genuine pty for one
# bounded fixture. Tolerates either trust state (the workspace-trust
# dialog only appears in a not-yet-trusted directory). Every readiness
# signal is real disk state (Draft files existing, then Approved files
# existing and Draft gone), not fragile text pattern matching -- exactly
# what the caller independently re-verifies afterward. Fails loudly (a
# distinct non-zero exit code, logged) on a timeout or an early process
# exit instead of silently reporting success.
#
# args: fixture_dir log_path slug
set fixture_dir [lindex $argv 0]
set log_path [lindex $argv 1]
set slug [lindex $argv 2]

set timeout 30
set env(TERM) "xterm-256color"
log_file -a $log_path

proc pump {secs} {
  global spawn_id
  catch {
    expect {
      -timeout $secs
      -re {.+} { exp_continue -continue_timer }
      timeout { }
    }
  }
}

proc safe_send {text} {
  global spawn_id
  if {[catch {send -- $text} err]} {
    puts "PROBE: send failed (process likely exited): $err"
    return 0
  }
  return 1
}

proc wait_for_path {path max_seconds} {
  set waited 0
  while {$waited < $max_seconds} {
    if {[file exists $path] && [file exists [file join [file dirname $path] scenarios.yaml]]} { return 1 }
    pump 1
    incr waited 1
  }
  return 0
}

cd $fixture_dir

spawn mix kogen.shape
catch { stty rows 40 columns 120 < $spawn_out(slave,name) }

set saw_trust 0
catch {
  expect {
    -timeout 20
    -re {Yes, continue|Press enter to continue} {
      set saw_trust 1
      puts "PROBE: saw the fully-rendered workspace trust dialog"
    }
    timeout {
      puts "PROBE: no trust dialog within 20s (already trusted)"
    }
  }
}

if {$saw_trust} {
  # Codex selects the trusted/continue option first; wait for its input loop.
  pump 2
  safe_send "\r"
  pump 3
}

set draft_intent "$fixture_dir/.kogen/intents/drafts/$slug/intent.yaml"
set draft_dir "$fixture_dir/.kogen/intents/drafts/$slug"
set approved_intent "$fixture_dir/.kogen/intents/approved/$slug/intent.yaml"

puts "PROBE: sending directive shaping message"
set directive "For this bounded, single fixture probe: shape exactly one tiny Intent with slug $slug. Title: Shape to build probe. may_change_guarded_paths: only dummy.txt. Exactly one scenario, verified_by check, whose then clause requires dummy.txt to exist at the repo root containing a specific exact value that this scenario text must NOT state -- the future Developer must learn the exact required value only from a genuine Stop-hook block reason, then fix it, then stop again; do not let the Developer discover it any other way. Write the Draft to disk now using your tools. Do not ask me anything else and do not move anything to approved until I explicitly say the single word yes in this conversation."

if {![safe_send $directive]} {
  puts "PROBE: initial send failed"
  exit 3
}
pump 1
safe_send "\r"

puts "PROBE: waiting for real Draft files (up to 150s)"
if {![wait_for_path $draft_intent 150]} {
  puts "PROBE: TIMEOUT waiting for draft intent.yaml at $draft_intent"
  exit 4
}
puts "PROBE: draft intent.yaml exists on disk"

pump 3
puts "PROBE: sending scripted test approval (test data only, not approval of a real feature)"
if {![safe_send "yes"]} {
  puts "PROBE: send of approval failed"
  exit 5
}
pump 1
safe_send "\r"

puts "PROBE: waiting for real Approved files and Draft removal (up to 90s)"
set approved_ok 0
set waited 0
while {$waited < 90} {
  if {[file exists $approved_intent] && ![file isdirectory $draft_dir]} {
    set approved_ok 1
    break
  }
  pump 1
  incr waited 1
}

if {!$approved_ok} {
  puts "PROBE: TIMEOUT waiting for approved files / draft removal"
  exit 6
}
puts "PROBE: approval confirmed on disk (approved present, draft gone)"

catch { safe_send "\x03" }
pump 1
catch { safe_send "\x03" }
pump 2
catch { close }
catch { wait }
puts "PROBE: done"
exit 0
