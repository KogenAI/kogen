#!/usr/bin/expect -f
# Drives the real, public `mix kogen.shape` under a genuine pty for one
# bounded fixture. It waits for the first conversation's genuine Stop/auditor
# completion after the Draft is saved, then starts a fresh continuation pty. It
# retains pre-approval snapshots outside the disposable fixture so the test
# can prove the continuation read its saved evidence, preserved provenance,
# and saved exactly one visit before a new explicit approval. Tolerates either trust state (the workspace-trust
# dialog only appears in a not-yet-trusted directory). Every readiness
# signal is real disk state (Draft files existing, then Approved files
# existing and Draft gone), not fragile text pattern matching -- exactly
# what the caller independently re-verifies afterward. Fails loudly (a
# distinct non-zero exit code, logged) on a timeout or an early process
# exit instead of silently reporting success.
#
# args: fixture_dir log_path slug continuation_state_dir marker route
set fixture_dir [lindex $argv 0]
set log_path [lindex $argv 1]
set slug [lindex $argv 2]
set continuation_state_dir [lindex $argv 3]
set marker [lindex $argv 4]
set route [lindex $argv 5]
set hook_log "$fixture_dir/.kogen/runtime/shaping-audits/$slug/hook.jsonl"
set auditor_dir "$fixture_dir/.kogen/runtime/shaping-audits/$slug/auditor"
set shape_stop_complete 0

set timeout 30
set env(TERM) "xterm-256color"
log_file -a $log_path

# Codex shows its one-time "Trust this folder?" dialog only after its own
# startup finishes, which can be well after the first 20 seconds (and after
# the first message is already queued behind "Waiting for startup"). The
# persisted trust decision is the user's to make (a `-c projects...trust_level`
# override does not suppress the dialog), so the driver answers it whenever it
# actually renders, in any wait below, by accepting the default "Trust and
# continue" choice. Nothing else is answered.
set trust_tail ""

# Expect matches the earliest pattern in the buffer, so a catch-all `.+` would
# swallow the dialog before a dialog-specific pattern could win; inspect every
# chunk (plus a short rolling tail, since the dialog may span chunks) instead.
proc note_output {chunk} {
  global trust_tail
  append trust_tail $chunk
  if {[regexp {1\.[[:space:]]*Trust and continue} $trust_tail]} {
    set trust_tail ""
    answer_late_trust
  } else {
    set trust_tail [string range $trust_tail end-200 end]
  }
}

proc answer_late_trust {} {
  puts "PROBE: saw the workspace trust dialog late; accepting Trust and continue"
  # Codex ignores Enter for a moment after first drawing the dialog (verified
  # against a real 0.158.0 TUI: an immediate Enter is dropped, one after ~2.5s
  # is accepted), so let it finish drawing before answering. If the dialog is
  # redrawn afterwards, it is answered again.
  after 3000
  safe_send "\r"
}

proc pump {secs} {
  global spawn_id
  catch {
    expect {
      -timeout $secs
      -re {.+} { note_output $expect_out(0,string); exp_continue -continue_timer }
      timeout { }
    }
  }
}

proc safe_send {text} {
  global spawn_id
  if {[catch {send -- $text} err]} {
    puts "PROBE: send failed (process likely exited): $err"
    return 0
  }
  return 1
}

# Native startup and large bracketed-paste rendering are asynchronous.  Wait
# until the composer has acknowledged the complete paste before pressing Enter;
# a successful write(2) only proves bytes reached the pty, not that the native
# TUI submitted a user turn. Codex shows `[Pasted Content N chars]`; Claude Code
# shows `[Pasted text #N ...]`, whose spaces it may render as cursor moves.
# The pasted tail's visible characters, allowing whitespace or cursor-motion
# escapes wherever the TUI draws a space or wraps a line.
proc rendered_tail_pattern {text} {
  set separator {(?:[[:space:]]|\x1b\[[0-9;?]*[A-Za-z])*}
  set pattern ""
  foreach char [split [string range $text end-40 end] ""] {
    if {[string is space $char]} { continue }
    if {$pattern ne ""} { append pattern $separator }
    if {[string is alnum $char]} { append pattern $char } else { append pattern "\\" $char }
  }
  return $pattern
}

proc submit_message {text label} {
  global spawn_id
  if {![safe_send "\x1b\[200~${text}\x1b\[201~"]} { return 0 }

  set acknowledged 0
  catch {
    expect {
      -timeout 30
      -re {\[Pasted Content [0-9]+ chars\]} { set acknowledged 1 }
      -re {Pasted[^a-z]{1,16}text[^a-z#]{0,16}#[0-9]+} { set acknowledged 1 }
      -re [string range $text end-48 end] { set acknowledged 1 }
      -re [rendered_tail_pattern $text] { set acknowledged 1 }
      -re {1\.[[:space:]]*Trust and continue} { answer_late_trust; exp_continue }
      eof { }
      timeout { }
    }
  }
  if {!$acknowledged} {
    puts "PROBE: $label paste was not acknowledged by the native composer"
    return 0
  }
  if {![safe_send "\r"]} { return 0 }
  pump 2
  return 1
}

proc wait_for_path {path max_seconds} {
  set waited 0
  while {$waited < $max_seconds} {
    if {[file exists $path] && [file exists [file join [file dirname $path] scenarios.yaml]]} { return 1 }
    pump 1
    incr waited 1
  }
  return 0
}

proc wait_for_file {path max_seconds} {
  set waited 0
  while {$waited < $max_seconds} {
    if {[file exists $path]} { return 1 }
    pump 1
    incr waited 1
  }
  return 0
}

proc line_count {path} {
  if {![file exists $path]} { return 0 }
  set handle [open $path r]
  set contents [read $handle]
  close $handle
  return [llength [split [string trim $contents] "\n"]]
}

# A completed, non-blocking Stop entry is written only after the real Stop
# audit (including its auditor work) returns. Wait for that persisted event
# and its actual auditor record before closing or sending the next user turn.
proc wait_for_shape_stop {hook_path auditor_dir prior_entries max_seconds} {
  set waited 0
  while {$waited < $max_seconds} {
    if {[line_count $hook_path] > $prior_entries} {
      set handle [open $hook_path r]
      set contents [read $handle]
      close $handle
      set entries [split [string trim $contents] "\n"]
      set latest [lindex $entries end]
      set auditor_records [glob -nocomplain [file join $auditor_dir *.json]]
      if {[regexp {"decision"\s*:\s*"allow"} $latest] && [llength $auditor_records] > 0} {
        return 1
      }
    }
    pump 1
    incr waited 1
  }
  return 0
}

proc handle_trust_dialog {} {
  global spawn_id
  set saw_trust 0
  catch {
    expect {
      -timeout 20
      -re {Yes, continue|Press enter to continue|Trust and continue} {
        set saw_trust 1
        puts "PROBE: saw the fully-rendered workspace trust dialog"
      }
      timeout {
        puts "PROBE: no trust dialog within 20s (already trusted)"
      }
    }
  }

  if {$saw_trust} {
    pump 2
    safe_send "\r"
    pump 3
  }
}

proc close_shape_session {} {
  global spawn_id shape_stop_complete
  if {!$shape_stop_complete} {
    puts "PROBE: refusing to close a Shape session before a completed Stop/auditor receipt"
    exit 11
  }
  catch { safe_send "\x03" }
  pump 1
  catch { safe_send "\x03" }
  pump 2
  catch { close }
  catch { wait }
}

cd $fixture_dir
file mkdir $continuation_state_dir

spawn mix kogen.shape --route $route
catch { stty rows 40 columns 120 < $spawn_out(slave,name) }
handle_trust_dialog

set draft_intent "$fixture_dir/.kogen/intents/drafts/$slug/intent.yaml"
set draft_dir "$fixture_dir/.kogen/intents/drafts/$slug"
set approved_intent "$fixture_dir/.kogen/intents/approved/$slug/intent.yaml"
set draft_evidence "$fixture_dir/.kogen/intents/drafts/$slug/evidence/continuation-proof.md"
set continuation_read "$fixture_dir/.kogen/intents/drafts/$slug/evidence/continuation-read.md"

set stop_entries [line_count $hook_log]
puts "PROBE: sending directive shaping message on selected route $route"
set directive "For this bounded, single fixture probe: shape exactly one tiny Intent with slug $slug. Title: Shape to build probe. may_change_guarded_paths: only dummy.txt. Exactly one scenario, verified_by check, whose then clause requires dummy.txt to exist at the repo root containing a specific exact value that this scenario text must NOT state -- the future Developer must learn the exact required value only from the failed check output that the Build controller's own verification reports back in its resume message (the Developer's Stop hook is inactive under the controller and writes no log), then fix it, then stop again; do not let the Developer discover it before that first controller-reported failed verification. Name the scenario id controller-verification-recovery. The scenario proof map must use test/kogen/shape_task_test.exs as its offline selector; Makefile, lib paths, and arbitrary existing files are not valid proof selectors. Add risks.yaml with one risk linked to that scenario. Its required ownership entry must state that dummy.txt is owned by the fixture seed immediately after creation and by the human user during operation; use nonblank YAML string values for every ownership field, including the scalar paths: dummy.txt (not a list), and make owner_after_creation and owner_during_operation different. Write evidence/continuation-proof.md in this Draft containing the unique marker: $marker. The test driver owns retention and auditing of provider transcripts outside the fixture; do not require the Developer to create transcript artifacts or edit the Approved package. Keep the scenario's then clause and evidence limited to what a Reviewer can judge from the Candidate and the Review packet: dummy.txt exists containing the exact value and the packet's controller Check receipt passed. Do NOT make the Reviewer's acceptance depend on reading .kogen/runtime/verification-history.jsonl or on any failed-then-passed record sequence; the outer test driver independently audits the failed-then-passed history and the retained provider evidence, so the Draft must say that audit is outside the Reviewer's remit. Write the Draft to disk now using your tools. Do not ask me anything else and do not move anything to approved until I explicitly say the single word yes in this conversation."

if {![submit_message $directive "initial directive"]} {
  puts "PROBE: initial submission failed"
  exit 3
}

puts "PROBE: waiting for real Draft files (up to 150s)"
if {![wait_for_path $draft_intent 150]} {
  puts "PROBE: TIMEOUT waiting for draft intent.yaml at $draft_intent"
  exit 4
}
puts "PROBE: draft intent.yaml exists on disk"

puts "PROBE: waiting for saved draft evidence (up to 60s)"
if {![wait_for_file $draft_evidence 60]} {
  puts "PROBE: TIMEOUT waiting for draft evidence at $draft_evidence"
  exit 7
}

puts "PROBE: waiting for completed first Stop audit and auditor (up to 300s)"
if {![wait_for_shape_stop $hook_log $auditor_dir $stop_entries 300]} {
  puts "PROBE: TIMEOUT waiting for completed first Stop/auditor entry"
  exit 12
}
set shape_stop_complete 1
puts "PROBE: closing completed first shaping conversation and retaining original draft state"
close_shape_session
file copy -force $draft_intent [file join $continuation_state_dir original-intent.yaml]
file copy -force $draft_evidence [file join $continuation_state_dir continuation-proof.md]

puts "PROBE: launching fresh continuation conversation"
set shape_stop_complete 0
spawn mix kogen.shape --route $route $slug
catch { stty rows 40 columns 120 < $spawn_out(slave,name) }
handle_trust_dialog

set continuation_directive "For this bounded fixture continuation, first read the saved Draft for $slug, including evidence/continuation-proof.md. Preserve the existing Intent identity, original shaping provenance, and original shaped-against baseline. Demonstrate that you read the saved evidence by writing evidence/continuation-read.md containing the exact unique marker found in that file. Save this fresh shaping visit now so intent.yaml records exactly one shaping_continuations entry. Do not move the Draft to approved and do not treat any earlier conversation as approval. Wait for a new explicit single-word yes from me in this conversation."

set stop_entries [line_count $hook_log]
puts "PROBE: sending fresh-session continuation directive on selected route $route"
if {![submit_message $continuation_directive "continuation directive"]} {
  puts "PROBE: continuation submission failed"
  exit 8
}

puts "PROBE: waiting for saved continuation and evidence readback (up to 150s)"
if {![wait_for_file $continuation_read 150]} {
  puts "PROBE: TIMEOUT waiting for continuation readback at $continuation_read"
  exit 9
}

set continuation_saved 0
set waited 0
while {$waited < 150} {
  if {[file exists $draft_intent] && ![file exists $approved_intent]} {
    set intent_handle [open $draft_intent r]
    set intent_text [read $intent_handle]
    close $intent_handle
    if {[regexp {shaping_continuations:} $intent_text]} {
      set continuation_saved 1
      break
    }
  }
  pump 1
  incr waited 1
}

if {!$continuation_saved} {
  puts "PROBE: TIMEOUT waiting for saved shaping_continuations before approval"
  exit 10
}

puts "PROBE: waiting for completed continuation Stop audit and auditor (up to 300s)"
if {![wait_for_shape_stop $hook_log $auditor_dir $stop_entries 300]} {
  puts "PROBE: TIMEOUT waiting for completed continuation Stop/auditor entry"
  exit 13
}
set shape_stop_complete 1
file copy -force $draft_intent [file join $continuation_state_dir continued-intent.yaml]
file copy -force $continuation_read [file join $continuation_state_dir continuation-read.md]
puts "PROBE: continuation saved while Draft remains unapproved"

pump 3
file copy -force $draft_dir [file join $continuation_state_dir pre-approval-package]
set stop_entries [line_count $hook_log]
set shape_stop_complete 0
puts "PROBE: sending new scripted test approval in the fresh conversation (test data only, not approval of a real feature)"
if {![submit_message "yes" "approval"]} {
  puts "PROBE: send of approval failed"
  exit 5
}

puts "PROBE: waiting for real Approved files and Draft removal (up to 90s)"
set approved_ok 0
set waited 0
while {$waited < 90} {
  if {[file exists $approved_intent] && ![file isdirectory $draft_dir]} {
    set approved_ok 1
    break
  }
  pump 1
  incr waited 1
}

if {!$approved_ok} {
  puts "PROBE: TIMEOUT waiting for approved files / draft removal"
  exit 6
}
file copy -force [file dirname $approved_intent] [file join $continuation_state_dir post-approval-package]
puts "PROBE: approval confirmed on disk (approved present, draft gone)"
puts "PROBE: waiting for completed approval Stop audit and auditor (up to 300s)"
if {![wait_for_shape_stop $hook_log $auditor_dir $stop_entries 300]} {
  puts "PROBE: TIMEOUT waiting for completed approval Stop/auditor entry"
  exit 14
}
set shape_stop_complete 1
close_shape_session
puts "PROBE: done"
exit 0
