#!/bin/sh
# Offline Codex fixture: developer NDJSON turns, reviewer structured output,
# and the tracked Stop script, which must stay inactive without a v1 context.
set -eu
script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
response_helper="$script_dir/scenario_response.py"
# The registered Stop script is a bootstrap remnant: without a v1 context it
# must answer continue and record nothing. Verification is the controller's.
stop_check() {
 response="$(printf '{"session_id":"%s","thread_id":"%s","stop_hook_active":false}' "$sid" "$sid" | sh .codex/hooks/check.sh)"
 printf '%s\n' "$response" >> "$state_dir/fake-hook-responses"
 [ "$response" = '{"continue":true}' ] && return 0
 printf 'Unexpected Stop response (expected inactive continue): %s\n' "$response" >&2
 exit 1 # unexpected-stop-response
}
# Scratch state lives in the Build's harness home (inside the write
# boundary, and kept after publication removes the Candidate); outside a
# Build it falls back to the cwd's ignored .kogen/runtime.
state_dir="${KOGEN_HARNESS_HOME:+$KOGEN_HARNESS_HOME/fake-state}"; state_dir="${state_dir:-.kogen/runtime}"; mkdir -p "$state_dir"
log="$state_dir/fake-harness-log"; dev_state="$state_dir/fake-dev-calls"; rev_state="$state_dir/fake-reviewer-calls"
printf 'argv:' >>"$log"; for a in "$@"; do printf ' %s' "$a" >>"$log"; done; printf '\n' >>"$log"
input="$(cat)"
printf '%s' "$input" | python3 "$script_dir/launch_receipt.py" "$@"
reviewer=0; resume_id=; output_file=; previous=; is_resume=0; penultimate=; last=
[ "${KOGEN_ROLE:-}" = reviewer ] && reviewer=1
for a in "$@"; do
 [ "$a" = resume ] && is_resume=1
 [ "$previous" = --output-last-message ] && output_file="$a"
 previous="$a"; penultimate="$last"; last="$a"
done
# Codex places resume's session after the shared flags, immediately before
# the final stdin marker. It is not the argument immediately after `resume`.
[ "$is_resume" -eq 1 ] && resume_id="$penultimate"
if [ "$reviewer" -eq 1 ]; then
 n=0; [ -f "$rev_state" ] && n="$(cat "$rev_state")"; n=$((n+1)); echo "$n" >"$rev_state"
 printf '%s' "$input" > "$state_dir/reviewer-prompt-$n"
 task_context="$(printf '%s' "$input" | python3 -c 'import json,sys; lines=sys.stdin.read().splitlines(); i=max(i for i,v in enumerate(lines) if v=="KOGEN_TASK_CONTEXT"); print(lines[i+1])')"
 tracking_path="$(printf '%s' "$task_context" | python3 -c 'import json,sys; print(json.load(sys.stdin)["tracking_path"])')"
 approved_path="$(printf '%s' "$task_context" | python3 -c 'import json,sys; print(json.load(sys.stdin)["approved_path"])')"
 source_matches=0
 semantic_path="$(python3 - "$tracking_path" <<'PY'
import json, pathlib, sys
record = json.loads(pathlib.Path(sys.argv[1]).read_text())
attempt = record["attempts"][-1]
receipts = [r for r in attempt.get("receipts", attempt.get("targets", [])) if "target_evidence" in r]
if receipts:
    print(receipts[0]["target_evidence"]["required_evidence"][0]["path"])
PY
)"
 if [ -n "$semantic_path" ]; then
  python3 - "$tracking_path" <<'PY' || source_matches=$?
import base64, json, pathlib, sys
record = json.loads(pathlib.Path(sys.argv[1]).read_text())
attempt = record["attempts"][-1]
receipts = [r for r in attempt.get("receipts", attempt.get("targets", [])) if "target_evidence" in r]
entry = receipts[0]["target_evidence"]["required_evidence"][0]
actual = base64.b64decode(entry["content_base64"])
raise SystemExit(0 if actual == b"reviewed behavior\n" else 1)
PY
 elif [ -f "$approved_path/requirement.json" ]; then
  python3 - "$approved_path/requirement.json" <<'PY' || source_matches=$?
import json, pathlib, sys
requirement = json.loads(pathlib.Path(sys.argv[1]).read_text())
actual = pathlib.Path(requirement["path"]).read_text().rstrip("\n")
raise SystemExit(0 if actual == requirement["expected"] else 1)
PY
 elif [ "$n" -le 1 ]; then
  source_matches=1
 fi
 if [ "$source_matches" -ne 0 ]; then
  verdict="$(printf '%s' "$input" | python3 "$response_helper" reviewer rework)"
 else
  verdict="$(printf '%s' "$input" | python3 "$response_helper" reviewer accept)"
 fi
 if [ -n "$semantic_path" ]; then
  verdict="$(printf '%s' "$verdict" | python3 -c 'import json,sys; value=json.load(sys.stdin); evidence=[{"path":sys.argv[1],"locator":"retained semantic behavior bytes"}]; value["scenarios"][0]["evidence"]=evidence; [item.__setitem__("evidence", evidence) for item in value["findings"]]; print(json.dumps(value))' "$semantic_path")"
 fi
 # Record the per-launch verdict schema and answer its `ledger` when required.
 schema_file=; prev=
 for a in "$@"; do [ "$prev" = --output-schema ] && schema_file="$a"; prev="$a"; done
 if [ -n "$schema_file" ]; then
  cp "$schema_file" "$state_dir/reviewer-schema-$n.json"
  [ -f "$script_dir/fake_ledger.py" ] && verdict="$(printf '%s' "$verdict" | python3 "$script_dir/fake_ledger.py" "$schema_file")"
 fi
 printf '%s\n' "$verdict" >"$output_file"
 printf '{"type":"thread.started","thread_id":"reviewer-session-%s"}\n{"type":"turn.completed","thread_id":"reviewer-session-%s"}\n' "$n" "$n"; exit 0
fi
if [ -n "$resume_id" ]; then
 sid="$resume_id"
 printf '{"type":"thread.started","thread_id":"%s"}\n' "$sid"
 # A failed controller verification cycle resumes this same session: repair
 # the Candidate only. A declared-target protocol failure resumes first
 # without changing the Candidate. The later semantic Reviewer finding drives
 # the real repair.
 case "$input" in
  'Controller verification failed after your turn'*)
   printf '%s' "$input" >> "$state_dir/verification-resume-prompts"
   [ "${FAKE_CHECK_FAIL_ALWAYS:-0}" = 1 ] || rm -f .kogen/runtime/kogen_fake_break
   ;;
  *'Rework required (category: declared_target;'*)
   printf '%s' "$input" >> "$state_dir/developer-resume-prompts" ;;
  *)
   printf '%s' "$input" >> "$state_dir/developer-resume-prompts"
   printf 'reviewed fixture value\n' > dummy.txt
   printf 'Reviewer-directed rework applied\n' > reviewer-rework-marker.txt
   ;;
 esac
 [ -n "${KOGEN_MIDBUILD_HOOK:-}" ] && sh "$KOGEN_MIDBUILD_HOOK"
 stop_check
 response="$(printf '%s' "$input" | python3 "$response_helper" developer)"
 if [ -n "$output_file" ]; then printf '%s\n' "$response" > "$output_file"; fi
 printf '{"type":"item.completed","item":{"type":"agent_message","text":%s}}\n' "$(printf '%s' "$response" | python3 -c 'import json,sys; print(json.dumps(sys.stdin.read()))')"
 printf '{"type":"turn.completed","thread_id":"%s"}\n' "$sid"
 exit 0
fi
n=0; [ -f "$dev_state" ] && n="$(cat "$dev_state")"; n=$((n+1)); echo "$n" >"$dev_state"; sid="dev-session-$n"
printf '%s' "$input" > "$state_dir/developer-launch-prompt"
printf '{"type":"thread.started","thread_id":"%s"}\n' "$sid"
printf 'initial fixture value\n' > dummy.txt
# The turn ends with a Candidate whose fixture `check` fails (an ignored
# marker), so the controller's first cycle fails and resumes this session.
[ "${FAKE_CHECK_FAIL:-1}" = 1 ] && mkdir -p .kogen/runtime && printf 'bounded fixture break\n' > .kogen/runtime/kogen_fake_break
# An offline fixture hook: when set, runs inside each Developer turn (fresh
# and resumed) before it ends, so a test can edit .kogen/config.yaml
# mid-Build and assert every later launch still uses the Build's
# already-resolved route.
[ -n "${KOGEN_MIDBUILD_HOOK:-}" ] && sh "$KOGEN_MIDBUILD_HOOK"
stop_check
response="$(printf '%s' "$input" | python3 "$response_helper" developer)"
if [ -n "$output_file" ]; then printf '%s\n' "$response" > "$output_file"; fi
printf '{"type":"item.completed","item":{"type":"agent_message","text":%s}}\n' "$(printf '%s' "$response" | python3 -c 'import json,sys; print(json.dumps(sys.stdin.read()))')"
printf '{"type":"turn.completed","thread_id":"%s"}\n' "$sid"
