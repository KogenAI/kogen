#!/bin/sh
# Offline Codex fixture: developer NDJSON turns, reviewer structured output,
# and real tracked stop-hook invocations.
set -eu
export KOGEN_ROLE=developer
state_dir=.kogen/runtime; mkdir -p "$state_dir"
log="$state_dir/fake-harness-log"; dev_state="$state_dir/fake-dev-calls"; rev_state="$state_dir/fake-reviewer-calls"
printf 'argv:' >>"$log"; for a in "$@"; do printf ' %s' "$a" >>"$log"; done; printf '\n' >>"$log"
cat >/dev/null || true
reviewer=0; resume_id=; output_file=; previous=; is_resume=0; penultimate=; last=
for a in "$@"; do
 [ "$a" = --output-schema ] && reviewer=1
 [ "$a" = resume ] && is_resume=1
 [ "$previous" = --output-last-message ] && output_file="$a"
 previous="$a"; penultimate="$last"; last="$a"
done
# Codex places resume's session after the shared flags, immediately before
# the final stdin marker. It is not the argument immediately after `resume`.
[ "$is_resume" -eq 1 ] && resume_id="$penultimate"
if [ "$reviewer" -eq 1 ]; then
 n=0; [ -f "$rev_state" ] && n="$(cat "$rev_state")"; n=$((n+1)); echo "$n" >"$rev_state"
 if [ "$n" -eq 1 ]; then verdict='{"verdict":"rework","findings":["fake finding: try again"]}'; else verdict='{"verdict":"accept","findings":[]}' ; fi
 printf '%s\n' "$verdict" >"$output_file"
 printf '{"type":"thread.started","thread_id":"reviewer-session-%s"}\n{"type":"turn.completed","thread_id":"reviewer-session-%s"}\n' "$n" "$n"; exit 0
fi
if [ -n "$resume_id" ]; then
 sid="$resume_id"
 printf '{"type":"thread.started","thread_id":"%s"}\n' "$sid"
 # The first independent Reviewer asks for this concrete rework. The resumed
 # Developer thread applies it before its fresh Stop Check.
 printf 'reviewed fixture value\n' > dummy.txt
 printf 'Reviewer-directed rework applied\n' > reviewer-rework-marker.txt
 printf '{"session_id":"%s","thread_id":"%s","stop_hook_active":false}' "$sid" "$sid" | sh .codex/hooks/check.sh >/dev/null
 printf '{"type":"turn.completed","thread_id":"%s"}\n' "$sid"
 exit 0
fi
n=0; [ -f "$dev_state" ] && n="$(cat "$dev_state")"; n=$((n+1)); echo "$n" >"$dev_state"; sid="dev-session-$n"
printf '{"type":"thread.started","thread_id":"%s"}\n' "$sid"
printf 'initial fixture value\n' > dummy.txt
printf 'defmodule Kogen.FakeBreak do\n  this is not valid elixir(((\nend\n' > lib/kogen_fake_break.ex
printf '{"session_id":"%s","thread_id":"%s","stop_hook_active":false}' "$sid" "$sid" | sh .codex/hooks/check.sh >/dev/null
rm -f lib/kogen_fake_break.ex
printf '{"session_id":"%s","thread_id":"%s","stop_hook_active":true}' "$sid" "$sid" | sh .codex/hooks/check.sh >/dev/null
printf '{"type":"turn.completed","thread_id":"%s"}\n' "$sid"
