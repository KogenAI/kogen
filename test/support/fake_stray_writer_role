#!/bin/sh
# Offline Codex-form Developer that leaves stray paths behind and answers the
# controller's guard-rework resume itself; every other call (Reviewer, fresh
# launch, any other resume) goes to the wrapped role.
#
#   FAKE_STRAY_WRAPPED  wrapped role (default: fake_codex_simple_accept)
#   FAKE_STRAY_WRITE    shell command run in the Candidate after the wrapped
#                       role's fresh launch (the stray writes)
#   FAKE_STRAY_EXIT     when set, the fresh launch then exits with this status
#                       (a harness failure)
#   FAKE_STRAY_REWORK   what a guard-rework resume does:
#                       clean (default)      run the prompt's command per path
#                       ignore               change nothing
#                       clean_then_capacity  clean, then (once) print the codex
#                                            capacity marker and exit 1
#                       capacity             (once) print the marker and exit 1
#                                            without cleaning
#
# It records session ids in fake-state/stray-sessions and each guard-rework
# prompt in fake-state/stray-rework-prompt-<n>.
set -eu
script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
wrapped="${FAKE_STRAY_WRAPPED:-$script_dir/fake_codex_simple_accept}"
state_dir="${KOGEN_HARNESS_HOME:+$KOGEN_HARNESS_HOME/fake-state}"; state_dir="${state_dir:-.kogen/runtime}"; mkdir -p "$state_dir"
input_file="$state_dir/stray-input-$$"
cat > "$input_file"

is_resume=0; resume_id=; output_file=; previous=; penultimate=; last=
for a in "$@"; do
 [ "$a" = resume ] && is_resume=1
 [ "$previous" = --output-last-message ] && output_file="$a"
 previous="$a"; penultimate="$last"; last="$a"
done
[ "$is_resume" -eq 1 ] && resume_id="$penultimate"

capacity() {
 printf '{"type":"thread.started","thread_id":"%s"}\n' "$resume_id"
 python3 -B -c 'import json,sys; sys.stdout.write(json.load(open(sys.argv[1]))["output"])' \
  "$script_dir/provider_tails/hjeqtbsg_codex_capacity_stream.json"
 printf '\n'
 : > "$state_dir/stray-capacity-done"
 rm -f "$input_file"
 exit 1
}

if [ "${KOGEN_ROLE:-}" = developer ] && [ "$is_resume" -eq 1 ] &&
 head -n 1 "$input_file" | grep -q '^Guard rework required after your turn'; then
 n=$(( $(cat "$state_dir/stray-reworks" 2>/dev/null || echo 0) + 1 )); echo "$n" > "$state_dir/stray-reworks"
 cp "$input_file" "$state_dir/stray-rework-prompt-$n"
 printf 'rework %s\n' "$resume_id" >> "$state_dir/stray-sessions"
 mode="${FAKE_STRAY_REWORK:-clean}"
 if [ "$mode" = capacity ] && [ ! -f "$state_dir/stray-capacity-done" ]; then capacity; fi
 if [ "$mode" != ignore ]; then
  sed -n 's/^- delete: `\(.*\)`$/\1/p' "$input_file" | while IFS= read -r path; do rm -rf -- "$path"; done
  sed -n 's/^- restore: `\(.*\)`$/\1/p' "$input_file" | while IFS= read -r command; do sh -c "$command"; done
 fi
 if [ "$mode" = clean_then_capacity ] && [ ! -f "$state_dir/stray-capacity-done" ]; then capacity; fi
 rm -f "$input_file"
 message='Removed the listed stray paths.'
 [ -n "$output_file" ] && printf '%s\n' "$message" > "$output_file"
 printf '{"type":"thread.started","thread_id":"%s"}\n' "$resume_id"
 printf '{"type":"item.completed","item":{"type":"agent_message","text":"%s"}}\n' "$message"
 printf '{"type":"turn.completed","thread_id":"%s"}\n' "$resume_id"
 exit 0
fi

fresh=0
[ "${KOGEN_ROLE:-}" = developer ] && [ "$is_resume" -eq 0 ] && fresh=1
output="$state_dir/stray-output-$$"
status=0
"$wrapped" "$@" < "$input_file" > "$output" || status=$?
rm -f "$input_file"
if [ "$fresh" -eq 1 ]; then
 sid="$(sed -n 's/.*"thread.started","thread_id":"\([^"]*\)".*/\1/p' "$output" | head -n 1)"
 printf 'launch %s\n' "$sid" >> "$state_dir/stray-sessions"
 [ -n "${FAKE_STRAY_WRITE:-}" ] && sh -c "$FAKE_STRAY_WRITE"
 [ -n "${FAKE_STRAY_EXIT:-}" ] && status="$FAKE_STRAY_EXIT"
fi
cat "$output"
rm -f "$output"
exit "$status"
