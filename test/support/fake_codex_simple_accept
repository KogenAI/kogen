#!/bin/sh
set -eu
export KOGEN_ROLE=developer
script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
response_helper="$script_dir/scenario_response.py"
mkdir -p .kogen/runtime; log=.kogen/runtime/fake-harness-log
printf 'argv:' >>"$log"; for a in "$@"; do printf ' %s' "$a" >>"$log"; done; printf '\n' >>"$log"
input="$(cat)"
is_reviewer=0; resume_id=; output_file=; previous=; is_resume=0; penultimate=; last=
for a in "$@"; do
 [ "$a" = --output-schema ] && is_reviewer=1
 [ "$a" = resume ] && is_resume=1
 [ "$previous" = --output-last-message ] && output_file="$a"
 previous="$a"; penultimate="$last"; last="$a"
done
[ "$is_resume" -eq 1 ] && resume_id="$penultimate"
if [ "$is_reviewer" -eq 1 ]; then
  n=0; [ -f .kogen/runtime/fake-reviewer-calls ] && n="$(cat .kogen/runtime/fake-reviewer-calls)"; n=$((n + 1)); echo "$n" > .kogen/runtime/fake-reviewer-calls
  printf '%s' "$input" | python3 "$response_helper" reviewer accept >"$output_file"
  printf '{"type":"thread.started","thread_id":"reviewer-session-%s"}\n{"type":"turn.completed","thread_id":"reviewer-session-%s"}\n' "$n" "$n"
  exit 0
fi
sid="${resume_id:-dev-session-1}"; printf '{"type":"thread.started","thread_id":"%s"}\n' "$sid"; printf '{"session_id":"%s","thread_id":"%s","stop_hook_active":false}' "$sid" "$sid" | sh .codex/hooks/check.sh >/dev/null; response="$(printf '%s' "$input" | python3 "$response_helper" developer)"; printf '{"type":"item.completed","item":{"type":"agent_message","text":%s}}\n' "$(printf '%s' "$response" | python3 -c 'import json,sys; print(json.dumps(sys.stdin.read()))')"; printf '{"type":"turn.completed","thread_id":"%s"}\n' "$sid"
