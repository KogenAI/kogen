# The directory Mix will write compiled .beam files to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where 3rd-party dependencies cache their data.
/.fetch

# If the VM crashes, it generates a dump file with a .dump extension.
*.dump

# Make sure we don't accidentally commit our macs
.DS_Store
