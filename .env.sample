# Test harness diagnostics file (optional)
# When set, writes raw output from each codegen-build invocation.
# The {N} placeholder is replaced with invocation count (1, 2, ...).
DIAGNOSTICS_FILE=

# Keep temp directories created by isolated_tmp_dir (optional)
# Set to "1" to preserve temporary test fixtures for inspection.
KEEP_TMP=

# Consumer-supplied build-worker confinement roots (optional).
# Set by the consuming platform when invoking the build worker.
# Codegen hooks treat an unknown boundary (unset) as "not a managed build worker"
# and allow all orchestrator I/O — never enforce on an unknown boundary.
OCG_APPS_ROOT=
OCG_PHOENIX_SEED_DIR=

