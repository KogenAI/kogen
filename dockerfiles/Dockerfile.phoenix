# Use official Ubuntu for ARM64/AMD64 compatibility
FROM ubuntu:24.04 AS base

# Fix potential GPG issues and install system dependencies
RUN rm -rf /var/lib/apt/lists/* && \
    apt-get clean && \
    apt-get update && apt-get install -y \
    bash \
    git \
    git-lfs \
    build-essential \
    curl \
    wget \
    gnupg \
    lsb-release \
    unzip \
    locales \
    ca-certificates \
    openssh-client \
    postgresql-client \
    inotify-tools \
    libncurses5-dev \
    libssl-dev \
    sudo \
    && rm -rf /var/lib/apt/lists/*

# Generate locales
RUN locale-gen en_US.UTF-8
ENV LANG=en_US.UTF-8
ENV LANGUAGE=en_US:en
ENV LC_ALL=en_US.UTF-8

# Install LibreOffice in a separate layer to avoid apt cache issues
# First increase Docker's available space by cleaning up between steps
RUN apt-get update && \
    apt-get install -y --no-install-recommends libreoffice-writer && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/* /tmp/* /var/tmp/*

# Set timezone to Europe/Sarajevo
RUN ln -sf /usr/share/zoneinfo/Europe/Sarajevo /etc/localtime && \
    echo "Europe/Sarajevo" > /etc/timezone
ENV TZ=Europe/Sarajevo

# Install Node.js (v20 LTS)
RUN curl -fsSL https://deb.nodesource.com/setup_20.x | bash - && \
    apt-get install -y nodejs && \
    rm -rf /var/lib/apt/lists/*

# Install Chrome and ChromeDriver for browser testing
# Install additional dependencies for Chrome (Ubuntu 24.04 compatible)
RUN apt-get update && apt-get install -y \
    fonts-liberation \
    libasound2t64 \
    libatk-bridge2.0-0 \
    libatk1.0-0 \
    libatspi2.0-0 \
    libcups2 \
    libdbus-1-3 \
    libdrm2 \
    libgbm1 \
    libgtk-3-0 \
    libnspr4 \
    libnss3 \
    libwayland-client0 \
    libxcomposite1 \
    libxdamage1 \
    libxfixes3 \
    libxkbcommon0 \
    libxrandr2 \
    xdg-utils \
    && rm -rf /var/lib/apt/lists/*

# Install Chromium and ChromeDriver for Wallaby on ARM64
RUN echo "Installing Chromium for ARM64 using Playwright..." && \
    # Playwright version 1129 - Chromium 128.0.6613.18
    wget --no-verbose "https://playwright.azureedge.net/builds/chromium/1129/chromium-linux-arm64.zip" -O /tmp/chrome.zip && \
    unzip -q /tmp/chrome.zip -d /opt && \
    chmod +x /opt/chrome-linux/chrome && \
    # Create symlinks
    ln -s /opt/chrome-linux/chrome /usr/bin/chromium-browser && \
    ln -s /opt/chrome-linux/chrome /usr/bin/google-chrome && \
    ln -s /opt/chrome-linux/chrome /usr/bin/google-chrome-stable && \
    rm /tmp/chrome.zip && \
    # For ChromeDriver, use Electron's version which supports ARM64
    echo "Installing ChromeDriver for ARM64..." && \
    wget --no-verbose "https://github.com/electron/electron/releases/download/v32.2.6/chromedriver-v32.2.6-linux-arm64.zip" -O /tmp/chromedriver.zip && \
    unzip -q /tmp/chromedriver.zip -d /tmp && \
    mv /tmp/chromedriver /usr/local/bin/chromedriver && \
    chmod +x /usr/local/bin/chromedriver && \
    ln -s /usr/local/bin/chromedriver /usr/bin/chromedriver && \
    rm -rf /tmp/chromedriver* && \
    # Verify installations
    echo "Chrome binary: $(which google-chrome-stable)" && \
    echo "ChromeDriver binary: $(which chromedriver)"

# Set environment variables for Wallaby
ENV WALLABY_DRIVER=chrome
ENV WALLABY_CHROME_BINARY=/usr/bin/google-chrome-stable
ENV CHROMEDRIVER_PATH=/usr/bin/chromedriver
ENV CHROME_ARGS="--no-sandbox --disable-dev-shm-usage --disable-gpu --headless"

# Use the existing ubuntu user (UID 1000) which matches most host systems
# Also give ubuntu user sudo access for permission fixes
RUN mkdir -p /workspace && \
    chown -R ubuntu:ubuntu /workspace && \
    echo "ubuntu ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers

# Switch to non-root user
USER ubuntu
WORKDIR /home/ubuntu

# Default Erlang/Elixir versions (can be overridden)
ARG ELIXIR_VERSION=1.18.4
ARG OTP_VERSION=27.3.4

# Add version labels to force cache invalidation when versions change
LABEL elixir.version=${ELIXIR_VERSION}
LABEL otp.version=${OTP_VERSION}

# Install Elixir and Erlang using official installer script
# This provides a clean, simple installation
# Force cache invalidation by echoing the versions first
RUN echo "Installing Elixir ${ELIXIR_VERSION} with OTP ${OTP_VERSION}" && \
    curl -fsSO https://elixir-lang.org/install.sh && \
    chmod +x install.sh && \
    ./install.sh elixir@${ELIXIR_VERSION} otp@${OTP_VERSION} && \
    rm install.sh && \
    echo 'export PATH="$HOME/.elixir-install/installs/otp/${OTP_VERSION}/bin:$PATH"' >> ~/.bashrc && \
    echo 'export PATH="$HOME/.elixir-install/installs/elixir/${ELIXIR_VERSION}-otp-${OTP_VERSION%%.*}/bin:$PATH"' >> ~/.bashrc

# Set up PATH for current RUN commands
ENV PATH="/home/ubuntu/.elixir-install/installs/elixir/${ELIXIR_VERSION}-otp-${OTP_VERSION%%.*}/bin:/home/ubuntu/.elixir-install/installs/otp/${OTP_VERSION}/bin:${PATH}"

# Install Hex and Rebar
RUN mix local.hex --force && \
    mix local.rebar --force

# Install mcp-proxy from GitHub releases (architecture-aware)
RUN ARCH=$(dpkg --print-architecture) && \
    if [ "$ARCH" = "amd64" ]; then \
        MCP_ARCH="x86_64"; \
    elif [ "$ARCH" = "arm64" ]; then \
        MCP_ARCH="aarch64"; \
    else \
        echo "Unsupported architecture: $ARCH" && exit 1; \
    fi && \
    curl -L https://github.com/tidewave-ai/mcp_proxy_rust/releases/latest/download/mcp-proxy-${MCP_ARCH}-unknown-linux-gnu.tar.gz | tar xz && \
    mkdir -p ~/bin && \
    mv mcp-proxy ~/bin/ && \
    chmod +x ~/bin/mcp-proxy

# Set environment for Phoenix
ENV NODE_ENV=development
ENV PATH="/home/ubuntu/bin:/home/ubuntu/.npm-global/bin:${PATH}"

# Set up workspace
WORKDIR /workspace

# AI assistants only require Node.js - no Python dependencies needed

# Set up bash environment with proper umask
RUN echo 'export PS1="\[\033[1;34m\]🐳 \[\033[1;32m\]\u@ocg-\h\[\033[0m\]:\[\033[1;36m\]\w\[\033[0m\]$ "' >> ~/.bashrc && \
    echo 'alias ll="ls -la"' >> ~/.bashrc && \
    echo 'alias phx="mix phx.server"' >> ~/.bashrc && \
    echo 'umask 022' >> ~/.bashrc

# Pre-create common directories and set npm prefix
RUN mkdir -p ~/.mix ~/.hex ~/.cache ~/.npm ~/.npm-global ~/.claude ~/.config/opencode ~/.ocg && \
    npm config set prefix ~/.npm-global && \
    echo 'export PATH="$HOME/.npm-global/bin:$PATH"' >> ~/.bashrc && \
    # Set up default OCG config
    echo '{"default_assistant": "claude", "assistants": {"claude": {"enabled": true}, "opencode": {"enabled": true, "provider": "anthropic"}}}' > ~/.ocg/config.json

# Install global npm packages as user
RUN npm i -g @playwright/mcp@latest && \
    npm i -g @anthropic-ai/claude-code && \
    # Install OpenCode
    curl -fsSL https://opencode.ai/install | bash

# Install Playwright browsers for MCP
# This needs to be done after Playwright is installed
RUN npx playwright install chromium && \
    npx playwright install-deps chromium

# Default command
CMD ["/bin/bash"]