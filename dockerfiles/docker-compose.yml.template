services:
  workspace:
    env_file: ../.env
    image: ocg/phoenix:{{PROJECT_NAME}}
    platform: linux/arm64 # Specify ARM64 for Apple Silicon
    container_name: ocg-{{PROJECT_NAME}}-{{FEATURE_NAME}}
    hostname: ocg-{{PROJECT_NAME}}-{{FEATURE_NAME}}
    volumes:
      - {{WORKSPACE_PATH}}:/workspace:rw
      - {{WORKSPACE_PATH}}/../../..:/repo:rw # Changed to rw for git operations
      # Mount main git directory as read-write for Git LFS
      - {{WORKSPACE_PATH}}/../../../.git:{{WORKSPACE_PATH}}/../../../.git:rw
      - {{HOME}}/.ssh:/home/ubuntu/.ssh:ro
      - ocg-{{PROJECT_NAME}}-deps-{{FEATURE_NAME}}:/workspace/deps
      - ocg-{{PROJECT_NAME}}-build-{{FEATURE_NAME}}:/workspace/_build
      - ocg-{{PROJECT_NAME}}-node-{{FEATURE_NAME}}:/workspace/assets/node_modules
      - ocg-{{PROJECT_NAME}}-plts-{{FEATURE_NAME}}:/workspace/priv/plts
      - ocg-claude-shared:/home/ubuntu/.claude
      - ocg-opencode-shared:/home/ubuntu/.config/opencode
      - ocg-ai-config-shared:/home/ubuntu/.ocg
    environment:
      - CLAUDE_CONFIG_DIR=/home/ubuntu/.claude
      - AI_ASSISTANT={{AI_ASSISTANT}}
      - ANTHROPIC_API_KEY=${ANTHROPIC_API_KEY:-}
      - OPENAI_API_KEY=${OPENAI_API_KEY:-}
      - GOOGLE_API_KEY=${GOOGLE_API_KEY:-}
    ports:
      - '{{PORT}}:{{PORT}}'
      - '{{PORT_TEST}}:{{PORT_TEST}}'
    extra_hosts:
      - 'host.docker.internal:host-gateway'
    stdin_open: true
    tty: true
    working_dir: /workspace
    command: /bin/bash -c "cd /workspace && sleep infinity"

volumes:
  ocg-{{PROJECT_NAME}}-deps-{{FEATURE_NAME}}:
    external: true
  ocg-{{PROJECT_NAME}}-build-{{FEATURE_NAME}}:
    external: true
  ocg-{{PROJECT_NAME}}-node-{{FEATURE_NAME}}:
    external: true
  ocg-{{PROJECT_NAME}}-plts-{{FEATURE_NAME}}:
    external: true
  ocg-claude-shared:
    external: true
  ocg-opencode-shared:
    external: true
  ocg-ai-config-shared:
    external: true
